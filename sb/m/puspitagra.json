ितः कृताङ्गभङ्गा","mahasubhashita","24",2301],["अभिमुखपतयालुभिर्ललाट-","mahasubhashita","24",2315],["अभिमुखपतितैर्गुणप्रकर्षाद्","mahasubhashita","24",2316],["अभिमुखमुपयाति मां स्म किंचित्","mahasubhashita","24",2317],["अभिमुनि सहसा हृते परस्या","mahasubhashita","24",2320],["अभिसरणपरा सदा वराकी","mahasubhashita","24",2345],["अभिसरणमयुक्तमङ्गनानाम्","mahasubhashita","24",2346],["अभिसरणरसः कृशाङ्गयष्टेर्","mahasubhashita","24",2347],["अयमतिजरठाः प्रकामगुर्वीर्","mahasubhashita","27",2685],["अयमुदयमहीध्रधातुरागैर्","mahasubhashita","28",2710],["अयि खलु बधिराधिराज कीरं","mahasubhashita","28",2736],["अयि खलु विषमः पुराकृतानां","mahasubhashita","28",2737],["अरतिरियमुपैति मां न निद्रा","mahasubhashita","29",2836],["अलमलमघृणस्य तस्य नाम्ना","mahasubhashita","32",3138],["अवचयपरिभोगवन्ति हिंस्रैः","mahasubhashita","33",3222],["अवचितकुसुमा विहाय वल्लीर्","mahasubhashita","33",3223],["अवजितमधुना तवाहमक्ष्णो","mahasubhashita","33",3225],["अवनतवदनेन्दुरिच्छतीव","mahasubhashita","33",3254],["अवनतशिरसः प्रयाम शीघ्रं","mahasubhashita","33",3255],["अवसरमधिगम्य तं हरन्त्यो","mahasubhashita","33",3298],["अविदितपरवेदनो मनोभूर्","mahasubhashita","34",3341],["अविरतकुसुमावचायखेदान्","mahasubhashita","34",3367],["अविरततरुणीसहस्रमध्य-","mahasubhashita","34",3368],["अविरलपुलकः सह व्रजन्त्याः","mahasubhashita","34",3381],["अविरलफलिनीवनप्रसूनः","mahasubhashita","34",3382],["अशरणशरणप्रमोदभूतैर्","mahasubhashita","35",3479],["अशिथिलमपरावसज्य कण्ठे","mahasubhashita","35",3491],["असकलकलिकाकुलीकृतालि-","mahasubhashita","37",3647],["असकलनयनावलोकनेन","mahasubhashita","37",3648],["असकलनयनेक्षितानि लज्जा","mahasubhashita","37",3649],["असितभुजगभीषणासिपत्रो","mahasubhashita","38",3760],["अहह किमधुना मुधैव बध्नास्य्","mahasubhashita","41",4070],["अहितहितविचारशून्यबुद्धेः","mahasubhashita","41",4099],["इति गदितवती रुषा जघान","mahasubhashita","58",5800],["इति जगति न रक्षितुं समर्थः","mahasubhashita","59",5803],["इति निखिलमुदारमर्थसार्थ-","mahasubhashita","59",5810],["इति मुषितधियः श्रिया प्रयान्त्या","mahasu