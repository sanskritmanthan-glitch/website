9223],["कस्यांचिद्वाचि कैश्चिन्ननु यदि विहितं दूषणं दुर्दुरूढैश्","mahasubhashita","93",9253],["कह्लारस्पर्शगर्भैः शिशिरपरिगमात्कान्तिमद्भिः कराग्रैश्","mahasubhashita","93",9272],["काकानां प्रीतियोगं चिरसहवसतिं कोकिलापेक्षसे चेत्","mahasubhashita","94",9311],["काकिन्याः पत्रमूलं सहचरसहितं केतकीनां च कन्दं","mahasubhashita","94",9318],["काचित्कीर्णा रजोभिर्दिवमनुविदधे भिन्नवक्रेन्दुलक्ष्मीर्","mahasubhashita","94",9341],["काञ्चीं काञ्ची न धत्ते कलयति न दृशा केरली केलितल्पं","mahasubhashita","94",9362],["काणः कुब्जोऽथ खञ्जः श्रुतिबलविकलो वामनः पङ्गुरन्धः","mahasubhashita","94",9375],["कात्र श्रीः श्रोणिबिम्बे स्रवदुदरपुरावस्तिखद्वारवाच्ये","mahasubhashita","94",9386],["कानि स्थानानि दग्धान्यतिशयगहनाः सन्ति के वा प्रदेशाः","mahasubhashita","94",9399],["कान्तारे दैवगत्या कथमपि गलितान्यन्तरालोक्य भक्ष्याण्य्","mahasubhashita","95",9456],["कान्ते त्वन्नेत्रकान्तं पुरु कमलवनं त्वन्मुखस्योपमेयश्","mahasubhashita","95",9485],["कान्ते यामि, क्व, देशान्तर, मपि शयना, न्नेति, किं सद्मनोऽपि","mahasubhashita","95",9490],["काप्यङ्घ्री रङ्गपत्र्यारुणयति रमणी भूषणैर्भाति काचिद्","mahasubhashita","96",9512],["कामं कूले नदीनामनुगिरि महिषीयूथनीडोपकण्ठे","mahasubhashita","96",9528],["कामं मा कामयध्वं वृषमपि च भृशं माद्रियध्वं न वित्ते","mahasubhashita","96",9553],["कामेनाकृष्य चापं हतपटुपटहं वल्गुभिर्मारवीरैर्","mahasubhashita","97",9667],["काम्बोजाः कम्बुजन्माकरशरणकृतः सह्यकान्तारकच्छा-","mahasubhashita","97",9678],["कारञ्जीः कूजयन्तो निजजठररवव्यञ्जिता बौजकोशिर्","mahasubhashita","97",9696],["कार्णाटीकेलिवाटीविटपिनवदलान्दोलनाश्चोलबाला-","mahasubhashita","98",9715],["कार्णाटी स्वर्णकर्णाभरणपरिमिलन्मौक्तिकेष्वम्बुलेशैर्","mahasubhashita","98",9716],["कार्योपक्षेपमादौ तनुमपि रचयंस्तस्य विस्तारमिच्छन्","mahasubhashita","98",9774],["कालिन्दि, ब्रूहि कुम्भोद्भव, जलधिरहं नाम गृह्णासि कस्माच्","mahasubhashita","99",9841],["कालिन्दीं वीक्ष्य यातां सुललितवदनो मातरं गेहगोपीः","mahasubhashita","99",9842],["कालिन्दीकेशपाशः परिलसति महीनायिकायास्तनूजा","mahasubhashita","99",9844],["कालिन्दीचारुवीचीनिचय इति मुदा गाहिता नैचिकीभिर्","mahasubhashita","99",9845],["कालिन्दीनर्मदाम्भःस्रुतमदसलिलोत्सङ्गिनौ पुष्पवन्तौ","mahasubhashita","99",9848],["कालिन्दीराशिरूर्ध्वं ननु मधुपकुलं मालतीपुञ्जगं वा","mahasubhashita","99",9855],["कालिन्दीवीचिपुञ्जैः कुवलयविपिनैरिन्द्रनीलच्छटाभिः","mahasubhashita","99",9856],["कालीकेलीकलापक्रमकलितकलाकौतुकी कुन्दकान्तिः","mahasubhashita","99",9860],["कावेरीतीरभूमीरुहभुजगवधूभुक्तमुक्तावशिष्टः","mahasubhashita","100",9909],["कावेरीवारिवेल्लल्लहरिपरिकरक्रीडनक्रान्तशीताः","mahasubhashita","100",9910],["कासारे पद्मिनीऽयं मुकुलयुगमनत्यन्तरं यत्र हृद्यम्","mahasubhashita","100",9968]]