[["प्रत्येकानन्तजातिप्रतिवपुरमितावृत्तिजन्मारिजैर्नो","vidyakara","1",9],["शस्त्रोद्यद्बाहुदेहस्फुरदनलमिलद्धूमकल्पान्तपुञ्जः","vidyakara","3",2],["गाढग्रन्थिप्रफुल्लद्गलविकलफणापीठनिर्यद्विषाग्नि-","vidyakara","4",10],["बभ्रुभ्रूश्मश्रुकेशं शिखरमिव गिरेर्लग्नदावाग्निमालं","vidyakara","4",11],["क्षिप्तो हस्तावलग्नः प्रसभमभिहतोऽप्याददानोऽंशुकान्तं","vidyakara","4",20],["केशेषु प्राक्प्रदीपस्त्वचि विकटचटत्कारसारोऽतिमात्रं","vidyakara","4",22],["मौलौ वेगादुदञ्चत्यपि चरणभरन्यञ्चदुर्वीतलत्वाद्","vidyakara","4",27],["पर्यङ्काश्लेषबन्धद्विगुणितभुजगग्रन्थिसंवीतजानोर्","vidyakara","4",28],["पायाद्वारेन्दुमौलेरनवरतभुजावृत्तिवातोर्मिवेग-","vidyakara","4",29],["सिन्दूरश्रीर्ललाटे कनकरसमयः कर्णपाशावतंसो","vidyakara","4",38],["आर्द्रां कण्ठे मुखाब्जस्रजमवनमयत्यम्बिका जानुलम्बां","vidyakara","5",6],["शृङ्गं भृङ्गिन्विमुञ्च त्यज गजवदन त्वं च लाङ्गूलमूलं","vidyakara","5",7],["सानन्दं नन्दिहस्ताहतमुरजरवाहूतकौमारबर्हि-","vidyakara","5",14],["स्वेच्छारम्यं लुठित्वा पितुरुरसि चिताभस्मधूलीचिताङ्गो","vidyakara","5",21],["कस्मात्त्वं तात गेहादपरमभिनवा ब्रूहि का तत्र वार्ता","vidyakara","5",28],["उत्तिष्ठन्त्या रतान्ते भरमुरगपतौ पाणिनैकेन कृत्वा","vidyakara","6",22],["किं किं सिंहस्ततः किं नरसदृशवपुर्देव चित्रं गृहीतो","vidyakara","6",25],["देवस्त्वामेकजङ्घावलयितलगुडो मूर्ध्नि विन्यस्तबाहुर्","vidyakara","6",26],["मिथ्याकण्डूतिसाचीकृतगलसरणिर्येषु जातो गरुत्मान्","vidyakara","6",29],["प्रत्यग्रोन्मेषजिह्मा क्षणमनभिमुखी रत्नदीपप्रभाणां","vidyakara","6",30],["दंष्ट्रापिष्टेषु सद्यः शिखरिषु न कृतः स्कन्धकण्डूविनोदः","vidyakara","6",31],["बीजं ब्रह्मैव देवो मधुजलनिधयः कर्णिका स्वर्णशैलः","vidyakara","6",43],["यस्याधोधस्तथोपर्युपरि निरवधि भ्राम्यतो विश्वमश्वैर्","vidyakara","7",1],["संसक्तं सिक्तमूलादभिनवभुवनोद्यानकौतूहलिन्या","vidyakara","7",4],["तापं स्तम्बेरमस्य प्रकटयति करः शीकरैः कुक्षुमुक्षत्-","vidyakara","9",13],["गम्भीराम्भोधराणामविरलनिपतद्वारिधारानिनादान्","vidyakara","10",16],["धूलीभिः केतकीनां परिमलनसमुद्धूलिताङ्गः समन्ताद्","vidyakara","10",35],["तावद्वाचः प्रयुक्ता मनसि विनिहिता जीविताशापि तावन्","vidyakara","10",49],["कामं कूले नदीनामनुगिरि महिषीयूथनीडोपकण्ठे","vidyakara","10",50],["तोयान्तर्लीनमीनप्रचयविचयनव्यापृतत्रोटिकोटि-","vidyakara","11",10],["इक्षुत्वक्क्षोदसाराः शकटसरणयो धीरधूलीपताकाः","vidyakara","11",17],["सद्यःस्नातानुलिप्ता इव दधति रुचं पल्लवाः कर्दमाङ्काः","vidyakara","11",18],["गर्वायन्ते पलालं प्रति पथिकशतैः पामराः स्तूयमाना","vidyakara","12",5],["वारं वारं तुषारानिलतुलितपलालोष्मणां पामराणां","vidyakara","13",13],["भ्रूशार्ङ्गाकृष्टमुक्ताः कुवलयमधुपस्तोमलक्ष्मीमुषो ये","vidyakara","14",2],["चञ्चच्चोलाञ्चलानि प्रतिसरणरयव्यस्तवेणीनि बाहोः","vidyakara","17",67],["वत्से नैते पयोदाः सुरपतिकरिणो नो बकाः कर्णशङ्काः","vidyakara","22",5],["अम्बा शेतेऽत्र वृद्धा परिणतवयसामग्रणीरत्र तातो","vidyakara","24",6],["आकृष्यादावमन्दग्रहमलकचयं वक्त्रमासज्य वक्त्रे","vidyakara","24",14],["रुद्धे वायौ निषिद्धे तमसि शुभवशोन्मीलितालोकशक्तिः","vidyakara","26",1],["चूडारत्नैः स्फुरद्भिर्विषधरविवराण्युज्ज्वलान्युज्ज्वलानि","vidyakara","27",4],["उत्सर्पद्धूमलेखात्विषि तमसि मनाग्विस्फुलिङ्गायमानैर्","vidyakara","27",10],["व्योम्नस्तापिच्छगुच्छावलिभिरिव तमोवल्लरीभिर्व्रियन्ते","vidyakara","28",9],["उत्तंसः केकिपिच्छैर्मरकतवलयश्यामले दोःप्रकाण्डे","vidyakara","28",12],["शृङ्गारे सूत्रधारः कुसुमशरमुनेराश्रमे ब्रह्मचारी","vidyakara","29",1],["कह्लारस्पर्शिगर्भैः शिशिरपरिगमात्कान्तिमद्भिः कराग्रैश्","vidyakara","29",24],["पत्यौ याते कलानां व्रजति गतिवशादस्तमिन्दौ क्रमेण","vidyakara","30",14],["रथ्यागर्भेषु खेलारसिकशिशुगुणं त्याजयेद्पूर्वकेलीर्","vidyakara","31",6],["उत्कल्लोलस्य लक्ष्मीं लवणजलनिधिर्लम्भितः क्षीरसिन्धोः","vidyakara","32",7],["स्वस्ति क्षीराब्धिमध्यान्निजदयितभुजाभ्यन्तरस्थाब्जहस्ता","vidyakara","32",9],["आसीदुप्तं यदेतद्रणभुवि भवता वैरिमातङ्गकुम्भान्","vidyakara","32",12],["मर्यादाभङ्गभीतेरमितरसतया धैर्यगाम्भीर्ययोगान्","vidyakara","33",30],["अन्ध्रीनीरन्ध्रपीनस्तनतटलुठनायासमन्दप्रचाराश्","vidyakara","34",2],["नाधन्यैः शङ्खपाणेः क्षणधृतगतयः प्रांशुभिश्चन्द्रकान्त-","vidyakara","34",18],["ये दोलाकेलिकाराः किमपि मृगदृशां मन्युतन्तुच्छिदो ये","vidyakara","34",21],["ग्रीवाभङाभिरामं मुहुरनुपतति स्यन्दने दत्तदृष्टिः","vidyakara","35",2],["स्वैरं चक्रानुवृत्त्या मुहुरुपरि परिभ्रम्य सम्यक्कृतास्थः","vidyakara","35",3],["पश्चादङ्घ्री प्रसार्य त्रिकनतिविततं द्राघयित्वाङ्गमुच्चैर्","vidyakara","35",19],["आघ्रातक्षोणिपीठः खुरशिखरसमाकृष्टरेणुस्तुरङ्गः","vidyakara","35",20],["शीर्णक्षुद्रातपत्री जठरवलयितानेकमात्राप्रपञ्चश्ः","vidyakara","35",23],["अर्चिर्मालाकरालाद्दिवमभिलिहतो दाववह्नेरदूराद्","vidyakara","35",40],["तैस्तैर्जीवोपहारैरिह कुहरशिलासंश्रयामर्चयित्वा","vidyakara","35",44],["प्रातर्बाष्पाम्बुबिन्दुव्यतिकरविगलत्क्लिन्नसृक्कः कथंचित्","vidyakara","39",1],["पुण्यानौ पूर्णवाञ्छः प्रथममगणितप्लोषदोषः प्रदोषे","vidyakara","39",2],["त्वद्यन्त्राणां प्रयाणेष्वनवरतवलत्कर्णतालप्रकीर्णैर्","vidyakara","41",2],["यस्य द्वीपं धरित्री स च जलधिरभूद्यस्य गण्डूषतोयं","vidyakara","41",9],["ताडीताडङ्कमात्राभरणपरिणतीन्युल्लसत्सिन्दुवार-","vidyakara","41",25],["ऋक्षस्य क्रोडसन्धिप्रहितमुखतया मण्डलीभूतमूर्तेर्","vidyakara","41",29],["मन्दोद्वृन्तैः शिरोभिर्मणिभरगुरुभिः प्रौढरोमाञ्चदण्ड-","vidyakara","41",35],["देव त्वत्सैन्यभारादवनिमवनतां धर्तुमुत्तब्धदेहः","vidyakara","41",47],["भीमे प्रस्थानभाजि स्फुरदसिजलदापह्नुतद्वेषिवह्नौ","vidyakara","41",51],["कूर्मः पादोऽत्र यष्टिर्भुजगपतिरसौ भाजनं भूतधात्री","vidyakara","41",77],["चञ्चत्पक्षाभिधातग्लपितहुतभुजः प्रौढधाम्नश्चितायाः","vidyakara","44",1],["उद्बुद्धेभ्यः सुदूरं घनरजनितमःपूरितेषु द्रुमेषु","vidyakara","44",2],["उत्कृत्योत्कृत्य कृत्तिं प्रथममथ पृथूच्छोफभूयांसो मांसान्य्","vidyakara","44",3],["चञ्चच्चञ्चूद्वृतार्धच्युतपिशितलवग्राससंवृद्धगर्धैर्","vidyakara","44",9],["अन्यादानाकुलान्तःकरणवशविपद्बाधितप्रेतरङ्कं","vidyakara","44",13],["यद्वर्ग्याभिर्जग्राहे पृथुशकुलकुलास्फालनत्रासहास-","vidyakara","46",1],["मज्जत्यामज्जमज्जन्मणिमसृणफणाचक्रवाले फणीन्द्रे","vidyakara","46",2],["यस्योद्योगे बलानां सकृदपि चलतामुज्जिहानै रजोभिर्","vidyakara","46",3],["जीवाकृष्टिं स चक्रे मृधभुवि धनुषः शत्रुरासीद्गतासुर्","vidyakara","46",11],["सोऽयं कैलासशैलः स्फटिकमणिभुवामंशुजालैर्ज्वलद्भिश्ः","vidyakara","47",5],["एतत्तद्वक्त्रमत्र क्व तदधरमधु क्वायातास्ते कटाक्षाः","vidyakara","48",26],["सन्मार्गे तावदास्ते प्रभवति पुरुषस्तावदेवेन्द्रियाणां","vidyakara","49",40],["किंचिन्निर्मुच्यमाने गगन इव मुखे नाट्यनिद्रापयोदैर्-","subhashitavali","1",45],["मल्लैः शैलेन्द्रकल्पः शिशुरखिलजनैः पुष्पचापोङ्गनाभिर्-","subhashitavali","1",46],["यस्योद्यद्बाणवाहुद्रुमगहनवनच्छेदगोष्ठीकुठारं","subhashitavali","1",51],["आदित्याः किं दशैते प्रलयभयकृतः स्वीकृताकाशदेशाः","subhashitavali","1",53],["लीने श्रोत्रैकदेशे नभसि नयनयोस्तेजसि क्वापि याते","subhashitavali","1",57],["क्वेदानीं दर्पितास्ते घनमदमदिरामोदिनो दिग्धिपेन्द्रा","subhashitavali","1",58],["एकस्थं जीवितेशे त्वयि सकलजगत्सारमालोकयामः","subhashitavali","1",60],["एकं चन्तच्छदस्य स्फुरति जपवशादर्धमन्यत्प्रकोपाद्-","subhashitavali","1",70],["किं स्याद्भास्वान्न भानोरमृतघनरसस्यन्दिनः सन्ति पादाः","subhashitavali","1",75],["उत्तिष्ठन्त्या रतान्ते भरमुरगपतौ पाणिनैकेन कृत्वा","subhashitavali","1",79],["सानन्दं नन्दिहस्ताहतमुरजरवाह्वतकौमारबर्हि-","subhashitavali","1",81],["ब्रह्मा दक्षः कुबेरो यमवरुणमरुद्वह्निचन्द्रेन्द्ररुद्राः","subhashitavali","1",83],["राजा राजार्चिताङ्घ्रेरनुपचितकलो यस्य चूडामणित्वं","subhashitavali","1",97],["अङ्गुल्या कः कवाटे प्रहरति कुटिलो माधवः किं वसन्तो","subhashitavali","2",130],["नम्रत्वेनोन्नमन्तः परगुणनुतिभिः स्वान्गुणान्ख्यापयन्तः","subhashitavali","3",286],["आखुः कैलासशैलं तुलयति करटस्तार्क्ष्यमांसाभिलाषी","subhashitavali","5",465],["मत्वा सारं गुणानां शिरसि यदि शशी स्थापितो दैवयोगा-","subhashitavali","5",494],["माद्यन्मातङ्गकुम्भस्थलबहलवसावासनाविस्रगन्ध-","subhashitavali","7",616],["घासग्रासं गृहाण त्यज गजकलभ प्रेमबन्धं करिण्याः","subhashitavali","7",640],["शृङ्गेणाङ्गं मृगाणां कषति परिचयप्राप्तये निःस्पृहाणां","subhashitavali","7",659],["दावाग्निप्लोषदुःखं खरपवनजलक्लेशमर्काच्च तापं","subhashitavali","9",827],["नो गर्जत्यम्बुराशिस्त्रिजगदधिपतिप्रार्थितार्थप्रदान-","subhashitavali","9",852],["माणिक्योयं महार्घः क्षितितलमहितो दीप्तिमानुच्चजन्मा","subhashitavali","10",910],["पुष्येन्यत्रावकाशो निपुणमपहृतः सौरभालोभनाभिः","subhashitavali","10",934],["सांमुख्यं वस्तुजातं नयति ननु चिदीशस्य यद्दर्शनाढ्यं","subhashitavali","11",1013],["नित्यं तीर्थे निवासः प्रकृतिरतितरां स्निग्धमुग्धस्वभावा","subhashitavali","11",1020],["तेजस्विव्रातसेव्ये नभसि नयसि यत्पांसुपूरं प्रतिष्ठाम्","subhashitavali","11",1032],["श्लाघ्यं जन्म ध्रुवस्य भ्रमति नियमितं यत्र तेजस्विचक्रम्","subhashitavali","11",1033],["भ्रूशार्ङ्गाकृष्टमुक्ताः कुवलयमधुपव्योमलक्ष्मीमुषो ये","subhashitavali","11",1039],["कल्याणानां निधानं कलिमलमथनं पावनं पावनानां","padyavali","1",19],["विष्णोर्नामैव पुंसाः शमलमपहरत्पुण्यमुत्पादयच्च","padyavali","1",24],["अर्च्ये विष्णौ शिलाधीर्गुरुषु नरमतिर्वैष्णवे जातिबुद्धिर्","padyavali","1",114],["मृद्नन्क्षीरादिचौर्यान्मसृणसुरभिणी सृक्वणी पाणिधर्षैर्","padyavali","1",145],["अस्मिन्कुञ्जे विनापि प्रचलति पवनं वर्तते कोऽपि नूनं","padyavali","1",200],["उत्तिष्ठारात्तरौ मे तरुणि मम तरोः शक्तिरारोहणे का","padyavali","1",269],["अङ्गुल्या कः कवाटं प्रहरति कुटिले माधवः किं वसन्तो","padyavali","1",281],["अक्ष्णोर्युग्मं विलोकान्मृदुतनुगुणतस्तर्पयन्ती शरीरं","mahasubhashita","2",156],["अग्रे कुग्रामवर्गः पिशितरसलसच्चण्डचण्डायमानः","mahasubhashita","3",230],["अङ्केकृत्वोत्तमाङ्गं प्लवगबलपतेः पादमक्षस्य हन्तुर्","mahasubhashita","3",257],["अङ्गाः संजातभङ्गाद्यनवनवसतिप्राप्तरङ्गाः कलिङ्गास्","mahasubhashita","3",286],["अङ्गीकुर्वन्ति भङ्गीमखिलगिरिगणास्तप्तजाम्बूनदीयां","mahasubhashita","4",309],["अङ्गुल्या कः कवाटं प्रहरति कुटिले माधवः किं वसन्तो","mahasubhashita","4",322],["अद्यैव श्वः परश्वस्त्रिचतुरदिवसानन्तरं सायमह्नि","mahasubhashita","11",1003],["अद्राक्षुर्ये नरेन्द्रा द्रुपदतनुभुवः केशपाशावकृष्टिं","mahasubhashita","11",1009],["अध्यासीनाश्ववारैरुपजनितभये हेषमाणैस्तुरङ्गैर्","mahasubhashita","12",1156],["अध्वानं नैकचक्रः प्रभवति भुवनभ्रान्तिदीर्घं विलङ्घ्य","mahasubhashita","12",1178],["अन्तः क्रोधोज्जिहानज्वलनभवशिखाकारजिह्वावलीढ-","mahasubhashita","16",1588],["अन्तःसंतोषवाष्पैः स्थगयति न दृशस्ताभिराकर्णयिष्यन्न्","mahasubhashita","16",1600],["अन्तर्विष्णोस्त्रिलोकी निवसति फणिनामीश्वरे सोऽपि शेते","mahasubhashita","17",1655],["अन्दूमुद्धूय बद्धां निजमपि सहसा सूतमुन्मथ्य सद्यो","mahasubhashita","17",1676],["अन्घ्रीनीरन्घ्रपीनस्तनतटलुठनायासमन्दप्रचाराश्","mahasubhashita","18",1702],["अन्यः कः क्षारवार्धे त्वमिव नियमितो वानरैर्वा नरैर्वा","mahasubhashita","18",1738],["अन्यस्यै संप्रतीयं कुरु मदनरिपो स्वाङ्गदानप्रसादं","mahasubhashita","18",1784],["अन्यादानाकुलान्तःकरणवशविपद्बाधितप्रेतरङ्कं","mahasubhashita","18",1787],["अन्योन्यास्फालभिन्नद्विपरुधिरवसामांसमस्तिष्कपङ्के","mahasubhashita","19",1861],["अब्धौ मज्जन्ति मीना इव फणिन इव क्षौणिरन्ध्रं विशन्ति","mahasubhashita","23",2240],["अम्बा शेतेऽत्र वृद्धा परिणतवयसामग्रणीरत्र तातो","mahasubhashita","26",2582],["अम्बेयं नेयमम्बा नहि खरकपिशं श्मश्रु तस्या मुखार्धे","mahasubhashita","26",2587],["अम्भोधिक्षिप्तमुक्तारुचिहरिचरणोद्गीर्णगङ्गाम्बुतुल्यं","mahasubhashita","27",2606],["अम्भोधीनां तमालप्रभवकिसलयश्यामवेलावनानाम्","mahasubhashita","27",2607],["अम्भोधेरेव जाताः कति जगति न ते हन्त सन्तीह शङ्खा","mahasubhashita","27",2608],["अर्चिर्मालाकरालाद्दिवमभिलिहतो दाववह्नेरदूराद्","mahasubhashita","29",2898],["अर्च्ये विष्णौ शिलाधीर्गुरुषु नरमतिर्वैष्णवे जातिबुद्धिर्","mahasubhashita","29",2900],["अर्थानामीशिषे त्वं वयमपि च गिरामीश्महे यावदित्थं","mahasubhashita","30",2973],["अर्थोत्कण्ठावकुण्ठप्रमुषितविनयैर्लुठ्यतां नाकिशुण्ठैः","mahasubhashita","31",3026],["अर्धं दन्तच्छदस्य स्फुरति जपवशादर्धमप्युत्प्रकोपाद्","mahasubhashita","31",3041],["अर्धं नीत्वा निशायाः सरभससुरतायाससंश्लेषयोगैः","mahasubhashita","31",3043],["अर्धप्लुष्टं बहुभ्यः शवपिशितमुपाहृत्य हृष्टश्चिताभ्यो","mahasubhashita","31",3057],["अर्वाञ्चत्पञ्चशाखः स्फुरदुपरिजटामण्डलः संश्रितानां","mahasubhashita","31",3080],["अव्यात्स्वर्लोकचूडामणिपटलशिखाश्रेणिशोणीकृताङ्घ्रिः","mahasubhashita","35",3443],["अव्याद्वो वज्रसारस्फुरदुरुनखरक्रूरचक्रक्रमाग्र-","mahasubhashita","35",3444],["अस्त्येवोद्दामदावानलविकलतरं काननं यत्र तत्र","mahasubhashita","39",3866],["अस्त्रज्वालावलीढप्रतिबलजलधेरन्तरौर्वायमाणे","mahasubhashita","39",3869],["अस्पृष्टे राहुभीत्याहनि निशि च समे कल्मषच्छाययोने","mahasubhashita","39",3900],["अस्मिन्कुञ्जे विनापि प्रचलति पवनं वर्तते कोऽपि नूनं","mahasubhashita","40",3934],["अस्मिन्नम्भोदवृन्दध्वनिजनितरुषि प्रेक्षमाणेऽन्तरिक्षं","mahasubhashita","40",3942],["अस्याः स्वेदाम्बुबिन्दुच्युततिलकतया व्यक्तवक्त्रेन्दुकान्तेर्","mahasubhashita","40",3988],["अस्रस्रोतस्तरङ्गभ्रमिषु तरलिता मांसपङ्के लुठन्तः","mahasubhashita","41",4023],["अस्वाध्यायः पिकानां मदनमखसमारम्भणस्याधिमासो","mahasubhashita","41",4026],["आकाराहीनकान्तिर्निधनविरहितो योगदोल्लासभागी","mahasubhashita","43",4268],["आकाशश्यामिमानं जलधरघटनां वा दधानं सुधांशुं","mahasubhashita","43",4286],["आकाशे पश्य नेमा निबिडघनघटाः संभृताग्नेयचूर्णा","mahasubhashita","43",4292],["आकृष्टश्चक्रवाकैर्नयनकलनया बन्धकीभिर्निरस्तो","mahasubhashita","44",4312],["आकृष्यादावमन्दग्रहमलकचयं वक्त्रमासज्य वक्त्रे","mahasubhashita","44",4320],["आक्रान्ते शैशवेऽस्मिन्नभिनववयसा शासनान्मीनकेतोर्","mahasubhashita","44",4339],["आक्षिप्ता चामरश्रीः प्रसभमपहृतः पौण्डरीको विलासः","mahasubhashita","44",4350],["आखुः कैलासशैलं तुलयति करटस्तार्क्ष्यमांसाभिलाषी","mahasubhashita","44",4354],["आगच्छागच्छ सज्जं कुरु वरतुरगं संनिधेहि द्रुतं मे","mahasubhashita","44",4370],["आग्नेयास्त्रप्रवीणप्रबलमृगभटाः शत्रुसंक्षोभदक्षा","mahasubhashita","44",4400],["आग्नेयीमेति शीतादिव दिशमरुणो वासराः संकुचन्ती-","mahasubhashita","45",4401],["आघ्रातक्षोणिपीठः खुरशिखरसमाकृष्टरेणुस्तुरङ्गः","mahasubhashita","45",4412],["आघ्रायाघ्राय गन्धं विकृतमुखपुटो दर्शयन्दन्तपङ्क्तिं","mahasubhashita","45",4415],["आचार्यौ द्वारिहेतौ शरकलशभरौ द्रोणभूस्तत्समानो","mahasubhashita","45",4458],["आजन्मब्रह्मचारी पृथुलभुजशिलास्तम्भविभ्राजमान-","mahasubhashita","45",4481],["आजन्मब्रह्मचारी सकलरिपुकुलानल्पकालाग्निकल्पः","mahasubhashita","45",4482],["आजौ त्वद्वाजिराजिप्रखरखुरतरन्यासलीलाभिरुर्व्यां","mahasubhashita","45",4498],["आत्ते सीमन्तरत्ने मरकतिनि हृते हेमताटङ्कपत्रे","mahasubhashita","46",4545],["आदायादाय मुक्तास्तदनु शिखिधियादाय माणिक्यवर्गं","mahasubhashita","48",4705],["आदित्याः किं दशैते प्रलयभयकृतः स्वीकृताकाशदेशाः","mahasubhashita","48",4725],["आदौ धर्मे प्रमाणं विविधविधिभिदाशेषतां च प्रयुक्तिं","mahasubhashita","48",4754],["आद्योऽन्तस्थोऽप्यनन्तं दिशति फलमसावद्वितीयं द्वितीयस्","mahasubhashita","48",4789],["आ पूर्वस्माद्विडौजःकरिवमथुपयःसिक्तसानोर्गिरीन्द्राद्","mahasubhashita","50",4958],["आ बाल्याद्देवबालाः सुरवरसदने किंनरीगीयमानं","mahasubhashita","50",4984],["आयातस्ते समीपं तव गुणविमलान्पण्डितो वादकर्ता","mahasubhashita","51",5083],["आयुः कल्लोललोलं कतिपयदिवसस्थायिनी यौवनश्रीर्","mahasubhashita","52",5132],["आरात्कारीषवह्नेः प्रविरचिततृणप्रस्तरान्तर्निषण्णैः","mahasubhashita","52",5190],["आराद्धो मूर्द्धभिर्यत्तुहिनकरकलालंकृतिर्विशतिर्यद्","mahasubhashita","52",5193],["आरूढो वासयष्टिं गृहवलभितले दुष्टमार्जारकेण","mahasubhashita","53",5226],["आर्द्रां कण्ठे मुखाब्जस्रजमवनमयत्यम्बिका जानुलम्बां","mahasubhashita","53",5268],["आ लङ्कानाथनारीस्तनतरलपयोवीचिमुद्रात्समुद्राद्","mahasubhashita","53",5282],["आलापान्भ्रूविलासो विरलयति लसद्बाहुविक्षिप्तियातं","mahasubhashita","54",5310],["आलिङ्गत्यन्यमन्यं रमयति वचसा लीलया वीक्षतेऽन्यं","mahasubhashita","54",5314],["आलोकत्रस्तनारीकृतसभयमहानादधावज्जनौघ-","mahasubhashita","54",5338],["आवर्तः संशयानामविनयभवनं पत्तनं साहसानां","mahasubhashita","54",5371],["आवाचां व्यक्ततायाः कविपदविषयेष्वाचचष्टे समन्यो","mahasubhashita","54",5379],["आवासेऽस्मिन्विदग्धाः क्वचिदपि न विभो नापि निद्रोपभोग-","mahasubhashita","54",5383],["आ विन्ध्यादा हिमाद्रर्विरचितविजयस्तीर्थयात्राप्रसङ्गाद्","mahasubhashita","54",5386],["आविर्भूतानुरागाः क्षणमुदयगिरेरुज्जिहानस्य भानोः","mahasubhashita","54",5393],["आशा निष्ठा प्रतिष्ठा मम किल महिलास्तासु सौख्यं कदा स्याद्","mahasubhashita","55",5430],["आ शैलेन्द्राच्शिलान्तःस्खलितसुरधुनीशीकरासारशीताद्","mahasubhashita","55",5462],["आश्लेषे सुन्दरीणां स्थितवति सहसा सर्वसंतृप्तिहेतौ","mahasubhashita","56",5506],["आसीदासीमभूमीवलयमलयजालेपनेपथ्यकीर्ति ः","mahasubhashita","56",5591],["आसीदुप्तं यदेतद्रणभुवि भवता वैरिमातङ्गकुम्भान्","mahasubhashita","56",5592],["आसीद्गङ्गान्वयायक्षितिपतितिलको राजराजक्षितीशः","mahasubhashita","56",5595],["आसीने पूष्णि तूष्णीं व्यसनिनि शशिनि व्योम्नि कृष्णे सतृष्णे","mahasubhashita","57",5602],["आसीनैः स्वं विमानं कृतपरिवृतिभिः सुन्दरीसंगतैस्तैर्","mahasubhashita","57",5604],["आस्तां तावद्दिगन्तप्रथितसुयशसां संगमः सज्जनानां","mahasubhashita","57",5627],["आस्तीर्यन्तामुपान्ते वनवृतिनिपुणैर्जालिकैर्जालबन्धा","mahasubhashita","57",5646],["आस्ते दामोदरीयामियमुदरदरीं यावलम्ब्य त्रिलोकी","mahasubhashita","57",5650],["आस्यं यस्याः सुधांशुं कलयति नयनाभ्यां जितः पुंसमूहः","mahasubhashita","57",5665],["आहत्याहत्य मूर्ध्ना द्रुतमनुपिबतः प्रस्नुतं मातुरूधः","mahasubhashita","57",5689],["आहूतो हालिकेनाश्रुतमिव वचनं तस्य कृत्वा क्षणैकं","mahasubhashita","58",5728],["इक्षुत्वक्क्षोदसाराः शकटसरणयो धीरधूलीपताकाः","mahasubhashita","58",5737],["इन्दोरस्य त्रियामायुवतिकुचतटीचन्दनस्थासकस्य","mahasubhashita","61",6013],["इन्द्रं वै षण्ढमाहुर्मलिनमुडुपतिं माधवं गोपसूनुं","mahasubhashita","61",6019],["इन्द्रः प्रक्षुब्धचित्तो दिशि दिशि सकलान्दिक्पतीन्सावधानान्","mahasubhashita","61",6020],["इन्द्राद्या लोकपाला हरिविधुतपना नागविद्याधराद्या","mahasubhashita","61",6029],["इन्द्राद्यैः किं प्रदत्तं प्रदिशसि धवलं धाम धन्यं यदेभ्यो","mahasubhashita","61",6030],["ईषन्नासानिकोचः खरमुखरसुखप्रेक्षणं हासलेशः","mahasubhashita","63",6277],["उच्चीयन्ते स्म वेश्मन्यशनविरहिते यत्नतः श्रोत्रियाणां","mahasubhashita","64",6324],["उच्चैः कल्याणवाही करजितवसुधः सर्वदा पूर्णकामो","mahasubhashita","64",6325],["उच्चैरुत्तालखेलद्भुजवनपवनोद्धूतशैलौघपात-","mahasubhashita","64",6338],["उच्चैरुत्तालगण्डस्थलबहुलगलद्दानपानप्रमत्त-","mahasubhashita","64",6339],["उच्चैर्ब्रह्माण्डखण्डद्वितयसहचरं कुम्भयुग्मं दधानः","mahasubhashita","64",6345],["उच्छ्वासः खण्डखण्डस्तरलितहृदये मूकतां भूषणानाम्","mahasubhashita","64",6370],["उज्झन्त्यः स्वर्णकाञ्चीर्झणिति रशनया चम्पकन्यासमय्या","mahasubhashita","64",6387],["उत्कल्लोलस्य लक्ष्मीं लवणजलनिधिर्लम्भितः क्षीरसिन्धोः","mahasubhashita","65",6420],["उत्कृत्योत्कृत्य गर्भानपि शकलयतः क्षत्रसंतानरोषाद्","mahasubhashita","65",6428],["उत्खातच्छिन्नसंध्यारुणकमलवनो व्योमकासारमध्यं","mahasubhashi