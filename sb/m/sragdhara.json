ta","74",7330],["एकं दन्तच्छदस्य स्फुरति जपवशादर्धमन्यत्प्रकोपाद्","mahasubhashita","74",7394],["एकः संग्रामरिङ्गत्तुरगखुररजोराजिभिर्नष्टदृष्टिर्","mahasubhashita","75",7432],["एकस्थं जीवितेशे त्वयि सकलजगत्सारमालोकयामः","mahasubhashita","76",7561],["एका गङ्गा प्रयागे मलयपरिसरे चन्दनं मौक्तिकाली","mahasubhashita","77",7604],["एकाम्भोधीकृतायां भुवि जगदखिलं निर्जनीकृत्य खेलन्","mahasubhashita","77",7634],["एकारौकारयुक्ता हरिहरिजहराः पञ्च बाणाः स्मरस्य","mahasubhashita","77",7636],["एकेनापाति लत्ता पतिवपुषि परेणापि पीतः पिता ते","mahasubhashita","77",7670],["एकेनापाति लत्ता पतिवपुषि परेणापि पीतोऽस्ति तातो","mahasubhashita","77",7671],["एकेनोद्धृत्य खङ्गं हृदि पतितमिषुं पाणिनैकेन भञ्जन्","mahasubhashita","77",7688],["एकैश्वर्ये स्थितोऽपि प्रणतबहुफले यः स्वयं कृत्तिवासाः","mahasubhashita","78",7708],["एको मे शाश्वतात्मा सुखमसुखभुजो ज्ञानदृष्टिस्वभावो","mahasubhashita","78",7743],["एतत्तद्वक्त्रमत्र क्व तदधरमधु क्वायतास्ते कटाक्षाः","mahasubhashita","78",7796],["एतद्दत्तासिघातस्रवदसृगसुहृद्वंशसार्द्रेन्धनैतद्-","mahasubhashita","79",7827],["एतद्भीतारिनारी गिरिबिलविगलद्वासरा निःसरन्ती","mahasubhashita","79",7835],["एतस्मिन्दाक्षिणाशानिलचलितलतालीनमत्तालिमाला-","mahasubhashita","79",7862],["एताः शार्दूलहेलादलितमृगकुलव्यक्तरक्ताभिषिक्त-","mahasubhashita","79",7898],["एताश्चन्द्रोदयेऽस्मिन्नविरलमुशलोत्क्षेपदोलायमान-","mahasubhashita","80",7937],["एते चापीन्द्रतुल्याः क्षितिपतितनया भीमसेनार्जुनाद्याः","mahasubhashita","80",7955],["एते नीवारवप्राः पृथुकुसुमसमित्पार्वतः कन्दरोऽयं","mahasubhashita","80",7968],["एतेनोत्कृत्तकण्ठप्रतिसुभटनटारब्धनाट्याद्भुतानां","mahasubhashita","80",7970],["एते पाटीरवाटीनवविटपनटीलास्यशिक्षातिदक्षा","mahasubhashita","80",7976],["एष क्रीडान्तताम्यत्कुसुमपुरवधूवक्त्रसौरभ्यबन्धुर्","mahasubhashita","82",8112],["एष क्षुभ्नाति पङ्कं दलति कमलिनीमत्ति गुन्द्राप्ररोहान्","mahasubhashita","82",8113],["एष ब्रह्मा सरोजे रजनिकरकलाशेखरः शंकरोऽयं","mahasubhashita","82",8120],["एषा का भुक्तमुक्ता प्रचलितनयना स्वेदलग्नाङ्गवस्त्रा","mahasubhashita","82",8140],["एषा दो