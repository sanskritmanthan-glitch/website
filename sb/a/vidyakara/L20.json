[["छत्रावलम्बि विमलोरुपयःप्रवाह-","vidyakara","10",28,0],["छत्रीकुड्मलकानि रक्षति चिरादण्डभ्रमात्कुक्कुटी","vidyakara","10",5,1],["छदाग्राभिस्त्वग्भिर्वलयितकरीरास्तलभुवः","vidyakara","10",23,3],["छलान्नीतोऽधस्ताद्बलिरणुकरूपेण तदपि","vidyakara","40",31,2],["छाया कापि कपोलयोरनुदिनं तस्याः परं शुष्यति","vidyakara","18",5,3],["छायां कुर्वन्ति चान्यस्य","vidyakara","37",17,0],["छायादाननिराकृतश्रमभरैर्नष्टं मृगैर्भीरुभिः","vidyakara","33",6,1],["छायापथश्च न भवत्ययमस्य सेतुः","vidyakara","29",8,1],["छाया पीतापि यत्र प्रतिकृतिभिरुपस्थाप्यते पादपानाम्","vidyakara","47",5,1],["छायामातपवैरिणीमनुसरन्बिल्वस्य मूलं गतः","vidyakara","40",11,1],["छायेव मैत्री खलसज्जनानाम्","vidyakara","38",24,3],["छित्त्वा पाशमपास्य कूटरचनां भित्त्वा बलाद्वागुरां","vidyakara","42",33,0],["छिद्यन्ते कियता क्षणेन शिखिनां मौनव्रतग्रन्थयः","vidyakara","10",11,3],["छिद्रान्वेषी निपातितः","vidyakara","25",9,3],["छिद्रैरमीभिरुडुभिः किरणव्याजेन चूर्णानि","vidyakara","28",5,0],["छिन्नं छिन्नं हृदयमदयैश्छिद्यतेऽद्यापि यैर्मे","vidyakara","23",45,3],["छिन्नमुन्मथितमग्निसात्कृतम्","vidyakara","40",34,1],["छेत्तुं प्रक्रमिते मयैव तरसा त्रुट्यच्छिरासंततौ","vidyakara","45",5,1],["छेवालाङ्कुरकोटिकोटरकुटीकुड्यान्तरे निर्वृतः","vidyakara","36",16,3],["छैवालाङ्कुरकोटिकोटरकुटीकुड्यान्तरे निर्वृतः","vidyakara","4",8,3],["छ्वासच्छेदतरङ्गितस्तनयुगं प्रीणाति शृङ्गारिणी","vidyakara","19",23,3],["छ्वासोड्डीनविशुष्कपाण्डुबिसिनीपत्रं दिवि भ्राम्यति","vidyakara","18",9,3]]