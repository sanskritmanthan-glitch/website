],["2",17,["ये युध्यन्ते प्रधने","षु शूरासो ये स्वर्तनूत्य","जः ये वा सहस्रद","क्षिणास्तां चिदेवापि गछतात्"],""],["2",18,["सहस्रणीथाः कवयो","ये गोपायन्ति सूर्यम्","ऋषीन्तपस्वतो यम","तपोजां अपि गछतात्"],"अनुष्टुभ्"],["2",19,["स्योनास्मै भव पृथिव्य","नृक्षरा निवेशनी","यछास्मै शर्म सप्रथाः"],"गायत्री"],["2",20,["असंबाधे पृथिव्या","उरौ लोके नि धीयस्व","स्वधा याश्चकृषे जीवन्","तास्ते सन्तु मधुश्चुतः"],"अनुष्टुभ्"],["2",21,["ह्वयामि ते मनसा मन","इहेमान्गृहामुप जुजुषाण एहि","सं गछस्व पितृभिः सं यमेन","स्योनास्त्वा वाता उप वान्तु शग्माः"],""],["2",22,["उत्त्वा वहन्तु मरुत","उदवाहा उदप्रुतः","अजेन कृण्वन्तः शीतं","वर्षेणोक्षन्तु बालिति"],"अनुष्टुभ्"],["2",23,["उदह्वमायुरायुषे","क्रत्वे दक्षाय जीवसे","स्वान्गछतु ते मनो अ","धा पितॄंरुप द्रव"],"अनुष्टुभ्"],["2",24,["मा ते मनो मासोर्माङ्","गानां मा रसस्य ते","मा ते हास्त तन्वः किं चनेह"],""],["2",25,["मा त्वा वृक्षः सं बाधिष्ट","मा देवी पृथिवी मही","लोकं पितृषु वित्त्वै","धस्व यमराजसु"],"अनुष्टुभ्"],["2",26,["यत्ते अङ्गमतिहितं पराचैर","पानः प्राणो य उ वा ते परेतः","तत्ते संगत्य पितरः सनीडा","घासाद्घासं पुनरा वेशयन्तु"],"त्रिष्टुभ्"],["2",27,["अपेमं जीवा अरुधन्गृहेभ्यस्","तं निर्वहत परि ग्रामादितः","मृत्युर्यमस्यासीद्दूतः प्रचेता","असून्पितृभ्यो गमयां चकार"],"त्रिष्टुभ्"],["2",28,["ये दस्यवः पितृषु प्र","विष्टा ज्ञातिमुखा अहुतादश्चरन्ति","परापुरो निपुरो ये भरन्त्य","ग्निष्टानस्मात्प्र धमाति यज्ञात्"],""],["2",29,["सं विशन्त्विह पितरः स्वा नः स्यो","नं कृण्वन्तः प्रतिरन्त आयुः","तेभ्यः शकेम हविषा नक्षमा","णा ज्योग्जीवन्तः शरदः पुरूचीः"],"त्रिष्टुभ्"],["2",30,["यां ते धेनुं निपृणामि","यमु क्षीर ओदनम्","तेना जनस्यासो भर्ता","योऽत्रासदजीवनः"],"अनुष्टुभ्"],["2",31,["अश्वावतीं प्र तर या","सुशेवा र्क्षाकं वा प्रतरं नवीयः","यस्त्वा जघान वध्यः सो अस्तु मा","सो अन्यद्विदत भागधेयम्"],""],["2",32,["यमः परोऽवरो विव","स्वान्ततः परं नाति पश्यामि किं चन","यमे अध्वरो अधि मे","निविष्टो भुवो विवस्वानन्वाततान"],""],["2",33,["अपागूहन्नमृतां मर्त्येभ्यः कृ","त्वा सवर्णामदधुर्विवस्वते","उताश्विनावभरद्यत्तदासीद्","अजहादु द्वा मिथुना सरण्यूः"],"त्रिष्टुभ्"],["2",34,["ये निखाता ये परोप्","ता ये दग्धा ये चोद्धिताः","सर्वांस्तानग्न आ वह","पितॄन्हविषे अत्तवे"],"अनुष्टुभ्"],["2",35,["ये अग्निदग्धा ये अनग्निदग्धा","मध्ये दिवः स्वधया मादयन्ते","त्वं तान्वेत्थ यदि ते जातवेदः","स्वधया यज्ञं स्वधितिं जुषन्ताम्"],"त्रिष्टुभ्"],["2",36,["शं तप माति तपो","अग्ने मा तन्वं तपः","वणेषु शुष्मो अस्तु ते","पृथिव्यामस्तु यद्धरः"],"अनुष्टुभ्"],["2",37,["ददाम्यस्मा अवसानम्","एतद्य एष आगन्मम चेदभूदिह","यमश्चिकित्वान्प्रत्ये","तदाह ममैष राय उप तिष्ठतामिह"],""],["2",38,["इमां मात्रां मिमीमहे","यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",39,["प्रेमां मात्रां मिमीमहे","यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",40,["अपेमां मात्रां मिमी","महे यथापरं न मासातै","शते शरत्सु नो पुरा"],""],["2",41,["वीमां मात्रां मिमीमहे","यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",42,["निरिमां मात्रां मिमीम","हे यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",43,["उदिमां मात्रां मिमीम","हे यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",44,["समिमां मात्रां मिमीम","हे यथापरं न मासातै","शते शरत्सु नो पुरा"],"गायत्री"],["2",45,["अमासि मात्रां स्वर","गामायुष्मान्भूयासम्","यथापरं न मासातै","शते शरत्सु नो पुरा"],"अनुष्टुभ्"],["2",46,["प्राणो अपानो व्यान","आयुश्चक्षुर्दृशये सूर्याय","अपरिपरेण पथा","यमराज्ञः पितॄन्गछ"],""],["2",47,["ये अग्रवः शशमानाः परेयुर्","हित्वा द्वेषांस्यनपत्यवन्तः","ते द्यामुदित्याविदन्त लोकं","नाकस्य पृष्ठे अधि दीध्यानाः"],"त्रिष्टुभ्"],["2",48,["उदन्वती द्यौरवमा","पीलुमतीति मध्यमा","तृतीया ह प्रद्यौरिति","यस्यां पितर आसते"],"अनुष्टुभ्"],["2",49,["ये न पितुः पितरो ये पिताम","हा य आविविशुरुर्वन्तरिक्षम्","य आक्षियन्ति पृथिवीमुत द्यां","तेभ्यः पितृभ्यो नमसा विधेम"],"त्रिष्टुभ्"],["2",50,["इदमिद्वा उ नापरं","दिवि पश्यसि सूर्यम्","माता पुत्रं यथा सि","चाभ्येनं भूम ऊर्णुहि"],"अनुष्टुभ्"],["2",51,["इदमिद्वा उ नापरं","जरस्यन्यदितोऽपरम्","जाया पतिमिव वास","साभ्येनं भूम ऊर्णुहि"],"अनुष्टुभ्"],["2",52,["अभि त्वोर्णोमि पृथिव्या","मातुर्वस्त्रेण भद्रया","जीवेषु भद्रं तन्मयि","स्वधा पितृषु सा त्वयि"],"अनुष्टुभ्"],["2",53,["अग्नीषोमा पथिकृता स्योनं दे","वेभ्यो रत्नं दधथुर्वि लोकम्","उप प्रेष्यन्तं पूषणं यो वहात्यञ्","जोयानैः पथिभिस्तत्र गछतम्"],"त्रिष्टुभ्"],["2",54,["पूषा त्वेतश्च्यावयतु प्र विद्वान्","अनष्टपशुर्भुवनस्य गोपाः","स त्वैतेभ्यः परि ददत्पितृभ्यो","ऽग्निर्देवेभ्यः सुविदत्रियेभ्यः"],"त्रिष्टुभ्"],["2",55,["आयुर्विश्वायुः परि पातु त्वा पू","षा त्वा पातु प्रपथे पुरस्तात्","यत्रासते सुकृतो यत्र त ईयुस्","तत्र त्वा देवः सविता दधातु"],"त्रिष्टुभ्"],["2",56,["इमौ युनज्मि ते वह्नी","असुनीताय वोढवे","ताभ्यां यमस्य सादनं","समितिश्चाव गछतात्"],"अनुष्टुभ्"],["2",57,["एतत्त्वा वासः प्रथमं न्वागन्न","पैतदूह यदिहाबिभः पुरा","इष्टापूर्तमनुसंक्राम विद्वान्य","त्र ते दत्तं बहुधा विबन्धुषु"],"त्रिष्टुभ्"],["2",58,["अग्नेर्वर्म परि गोभिर्व्ययस्व","सं प्रोर्णुष्व मेदसा पीवसा च","नेत्त्वा धृष्णुर्हरसा जर्हृषाणो","दधृग्विधक्षन्परीङ्खयातै"],"त्रिष्टुभ्"],["2",59,["दण्डं हस्तादाददानो गतासोः","सह श्रोत्रेण वर्चसा बलेन","अत्रैव त्वमिह वयं सुवीरा","विश्वा मृधो अभिमातीर्जयेम"],"त्रिष्टुभ्"],["2",60,["धनुर्हस्तादाददानो मृतस्य","सह क्षत्रेण वर्चसा बलेन","समागृभाय वसु भूरि","पुष्टमर्वाङ्त्वमेह्युप जीवलोकम्"],""],["3",1,["इयं नारी पतिलोकं वृणाना","नि पद्यत उप त्वा मर्त्य प्रेतम्","धर्मं पुराणमनुपालयन्ती","तस्यै प्रजां द्रविणं चेह धेहि"],"त्रिष्टुभ्"],["3",2,["उदीर्ष्व नार्यभि जीवलोकं ग","तासुमेतमुप शेष एहि","हस्तग्राभस्य दधिषोस्तवेदं","पत्युर्जनित्वमभि सं बभूथ"],"त्रिष्टुभ्"],["3",3,["अपश्यं युवतिं नीयमानां जी","वां मृतेभ्यः परिणीयमानाम्","अन्धेन यत्तमसा प्रावृतासीत्","प्राक्तो अपाचीमनयं तदेनाम्"],"त्रिष्टुभ्"],["3",4,["प्रजानत्यघ्न्ये जीवलोकं दे","वानां पन्थामनुसंचरन्ती","अयं ते गोपतिस्तं","जुषस्व स्वर्गं लोकमधि रोहयैनम्"],""],["3",5,["उप द्यामुप वेतसम्","अवत्तरो नदीनाम्","अग्ने पित्तमपामसि"],"गायत्री"],["3",6,["यं त्वमग्ने समदहस्","तमु निर्वापय पुनः","क्याम्बूरत्र रोहतु","शाण्डदूर्वा व्यल्कशा"],"अनुष्टुभ्"],["3",7,["इदं त एकम्पुर ऊ त एकं","तृतीयेन ज्योतिषा सं विशस्व","संवेशने तन्वा चारुरेधि प्रि","यो देवानां परमे सधस्थे"],"त्रिष्टुभ्"],["3",8,["उत्तिष्ठ प्रेहि प्र","द्रवौकः कृणुष्व सलिले सधस्थे","तत्र त्वं पितृभिः संविदानः सं","सोमेन मदस्व सं स्वधाभिः"],""],["3",9,["प्र च्यवस्व तन्वं सं भरस्व मा","ते गात्रा वि हायि मो शरीरम्","मनो निविष्टमनुसंविशस्व","यत्र भूमेर्जुषसे तत्र गछ"],"त्रिष्टुभ्"],["3",10,["वर्चसा मां पितरः सोम्यासो अञ्","जन्तु देवा मधुना घृतेन","चक्षुषे मा प्रतरं तारयन्तो","जरसे मा जरदष्टिं वर्धन्तु"],"त्रिष्टुभ्"],["3",11,["वर्चसा मां समनक्त्वग्निर्","मेधां मे विष्णुर्न्यनक्त्वासन्","रयिं मे विश्वे नि यछन्तु देवाः","स्योना मापः पवनैः पुनन्तु"],""],["3",12,["मित्रावरुणा परि मामधाताम्","आदित्या मा स्वरवो वर्धयन्तु","वर्चो म इन्द्रो न्यनक्तु हस्तयोर्","जरदष्टिं मा सविता कृणोतु"],"त्रिष्टुभ्"],["3",13,["यो ममार प्रथमो मर्त्यानां यः","प्रेयाय प्रथमो लोकमेतम्","वैवस्वतं संगमनं जनानां य","मं राजानं हविषा सपर्यत"],"त्रिष्टुभ्"],["3",14,["परा यात पितर आ च","यातायं वो यज्ञो मधुना समक्तः","दत्तो अस्मभ्यं द्रविणेह भद्रं","रयिं च नः सर्ववीरं दधात"],""],["3",15,["कण्वः कक्षीवान्पुरुमीढो अग","स्त्यः श्यावाश्वः सोभर्यर्चनानाः","विश्वामित्रोऽयं जमदग्निरत्रिर्","अवन्तु नः कश्यपो वामदेवः"],"त्रिष्टुभ्"],["3",16,["विश्वामित्र जमदग्ने वसिष्ठ","भरद्वाज गोतम वामदेव","शर्दिर्नो अत्रिरग्रभीन्नमोभिः","सुसंशासः पितरो मृडता नः"],"त्रिष्टुभ्"],["3",17,["कस्ये मृजाना अति यन्ति रिप्रम्","आयुर्दधानाः प्रतरं नवीयः","आप्यायमानाः प्रजया धनेना","ध स्याम सुरभयो गृहेषु"],"त्रिष्टुभ्"],["3",18,["अञ्जते व्यञ्जते समञ्जते क्र","तुं रिहन्ति मधुनाभ्यञ्जते","सिन्धोरुच्छ्वासे पतयन्तमुक्षणं","हिरण्यपावाः पशुमासु गृह्नते"],"त्रिष्टुभ्"],["3",19,["यद्वो मुद्रं पितरः सोम्यं च ते","नो सचध्वं स्वयशसो हि भूत","ते अर्वाणः कवय आ शृणोत","सुविदत्रा विदथे हुयमानाः"],"त्रिष्टुभ्"],["3",20,["ये अत्रयो अङ्गिरसो नवग्वा","इष्टावन्तो रातिषाचो दधानाः","दक्षिणावन्तः सुकृतो य उ स्था","सद्यास्मिन्बर्हिषि मादयध्वम्"],"त्रिष्टुभ्"],["3",21,["अधा यथा नः पितरः परासः","प्रत्नासो अग्न ऋतमाशशानाः","शुचीदयन्दीध्यत उक्थशसः","क्षामा भिन्दन्तो अरुणीरप व्रन्"],"त्रिष्टुभ्"],["3",22,["सुकर्मानः सुरुचो देवयन्तो","अयो न देवा जनिमा धमन्तः","शुचन्तो अग्निं वावृधन्त इन्द्रम्","उर्वीम्गव्यां परिषदं नो अक्रन्"],"त्रिष्टुभ्"],["3",23,["आ यूथेव क्षुमति पश्वो अ","ख्यद्देवानां जनिमान्त्युग्रः","मर्तासश्चिदुर्वशीर्","अकृप्रन्वृधे चिदर्य उपरस्यायोः"],""],["3",24,["अकर्म ते स्वपसो अभूम ऋ","तमवस्रन्नुषसो विभातीः","विश्वं तद्भद्रं यदवन्ति देवा","बृहद्वदेम विदथे सुवीराः"],"त्रिष्टुभ्"],["3",25,["इन्द्रो मा मरुत्वान्प्राच्या दिशः पातु","बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],"त्रिष्टुभ्"],["3",26,["धाता मा निरृत्या दक्षिणाया दिशः पा","तु बाहुच्युता पृथिवी द्यां इवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],"जगती"],["3",27,["अदितिर्मादित्यैः प्रतीच्या दिशः पातु","बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],"जगती"],["3",28,["सोमो मा विश्वैर्देवैरुदीच्या दिशः पा","तु बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],"जगती"],["3",29,["धर्ता ह त्वा धरुणो धारयाता ऊर्","ध्वं भानुं सविता द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],"त्रिष्टुभ्"],["3",30,["प्राच्यां त्वा दिशि पुरा सम्वृतः स्वधायामा द","धामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],""],["3",31,["दक्षिणायां त्वा दिशि पुरा सम्वृतः स्वधायामा दधामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे ये देवानां हुतभागा इह स्थ"],""],["3",32,["प्रतीच्यां त्वा दिशि पुरा संवृतः स्वधायामा","दधामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],""],["3",33,["उदीच्यां त्वा दिशि पुरा सम्वृतः स्वधायामा","दधामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],""],["3",34,["ध्रुवायां त्वा दिशि पुरा संवृतः स्वधायामा","दधामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],""],["3",35,["ऊर्ध्वायां त्वा दिशि पुरा सम्वृतः स्वधायामा","दधामि बाहुच्युता पृथिवी द्यामिवोपरि","लोककृतः पथिकृतो यजामहे","ये देवानां हुतभागा इह स्थ"],""],["3",36,["धर्तासि धरुनोऽसि वंसगोऽसि"],""],["3",37,["उदपूरसि मधुपूर्","असि वातपूरसि"],"द्विपदा"],["3",38,["इतश्च मामुतश्चाव","त