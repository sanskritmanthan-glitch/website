"त्रिष्टुभ्"],["4",45,["सरस्वतीं देवयन्तो हवन्ते","सरस्वतीमध्वरे तायमाने","सरस्वतीं सुकृतो हवन्ते","सरस्वती दाशुषे वार्यं दात्"],"त्रिष्टुभ्"],["4",46,["सरस्वतीं पितरो हवन्ते द","क्षिणा यज्ञमभिनक्षमाणाः","आसद्यास्मिन्बर्हिषि मादयध्वम्","अनमीवा इष आ धेह्यस्मे"],"त्रिष्टुभ्"],["4",47,["सरस्वति या सरथं ययाथोक्थैः","स्वधाभिर्देवि पितृभिर्मदन्ती","सहस्रार्घमिडो अत्र भागं रा","यस्पोषं यजमानाय धेहि"],"त्रिष्टुभ्"],["4",48,["पृथिवीं त्वा पृथिव्यामा वेशया","मि देवो नो धाता प्र तिरात्यायुः","परापरैता वसुविद्","वो अस्त्वधा मृताः पितृषु सं भवन्तु"],""],["4",49,["आ प्र च्यवेथामप तन्मृजे","थां यद्वामभिभा अत्रोचुः","अस्मादेतमघ्न्यौ तद्वशीयो दा","तुः पितृष्विहभोजनौ मम"],""],["4",50,["एयमगन्दक्षिणा भद्रतो ना","अनेन दत्ता सुदुघा वयोधाः","यौवने जीवानुपपृञ्चती जरा","पितृभ्य उपसंपराणयादिमान्"],"त्रिष्टुभ्"],["4",51,["इदं पितृभ्यः प्र भरामि बर्हिर्","जीवं देवेभ्य उत्तरं स्तृणामि","तदा रोह पुरुष मेध्यो भवन्प्र","ति त्वा जानन्तु पितरः परेतम्"],"त्रिष्टुभ्"],["4",52,["एदं बर्हिरसदो मेध्योऽभूः प्र","ति त्वा जानन्तु पितरः परेतम्","यथापरु तन्वं सं भ","रस्व गात्राणि ते ब्रह्मणा कल्पयामि"],""],["4",53,["पर्णो राजापिधानं चरूणामूर्","जो बलं सह ओजो न आगन्","आयुर्जीवेभ्यो विद","धद्दीर्घायुत्वाय शतशारदाय"],""],["4",54,["ऊर्जो भागो य इमं जजाना","श्मान्नानामाधिपत्यं जगाम","तमर्चत विश्वमित्रा हविर्भिः","स नो यमः प्रतरं जीवसे धात्"],"त्रिष्टुभ्"],["4",55,["यथा यमाय हर्म्यम","वपन्पञ्च मानवाः","एवा वपामि हर्म्यं य","था मे भूरयोऽसत"],"अनुष्टुभ्"],["4",56,["इदं हिरण्यं बिभृहि","यत्ते पिताबिभः पुरा","स्वर्गं यतः पितुर्ह","स्तं निर्मृड्ढि दक्षिणम्"],"अनुष्टुभ्"],["4",57,["ये च जीवा ये च मृता","ये जाता ये च यज्ञियाः","तेभ्यो घृतस्य कुल्यैतु","मधुधारा व्युन्दती"],"अनुष्टुभ्"],["4",58,["वृषा मतीनां पवते विचक्षणः","सूरो अह्नां प्रतरीतोषसां दिवः","प्राणः सिन्धूनां कलशां अचिक्रदद्","इन्द्रस्य हार्दिमाविशन्मनीषया"],"त्रिष्टुभ्"],["4",59,["त्वेषस्ते धूम ऊर्णोतु","दिवि षं छुक्र आततः","सूरो न हि द्युता त्वं कृ","पा पावक रोचसे"],"अनुष्टुभ्"],["4",60,["प्र वा एतीन्दुरिन्द्रस्य निष्कृतिं स","खा सख्युर्न प्र मिनाति संगिरः",