{"id":"kena","v":[["1",1,["ॐ केनेषितं पतति प्रेषितं मनः","केन प्राणः प्रथमः प्रैति युक्तः","केनेषितां वाचमिमां वदन्ति","चक्षुः श्रोत्रं क उ देवो युनक्ति"],""],["1",2,["श्रोत्रस्य श्रोत्रं मनसो मनो यद्","वाचो ह वाचं स उ प्राणस्य प्राणः","चक्षुषश्चक्षुरतिमुच्य धीराः","प्रेत्यास्माल्लोकादमृता भवन्ति"],""],["1",3,["न तत्र चक्षुर्गच्छति","न वाग्गच्छति नो मनः","न विद्मो न विजानीमो","यथैतदनुशिष्यात्"],"अनुष्टुभ् (श्लोकः)"],["1",4,["अन्यदेव तद्विदिता","दथो अविदितादधि","इति शुश्रुम पूर्वेषां","ये नस्तद्व्याचचक्षिरे"],"अनुष्टुभ् (श्लोकः)"],["1",5,["यद्वाचाऽनभ्युदितं येन वागभ्युद्यते","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],""],["1",6,["यन्मनसा न मनुते येनाहुर्मनो मतम्","तदेव ब्रह्म त्वं विद्धि नेदं यदिदमुपासते"],""],["1",7,["यच्चक्षुषा न पश्यति","येन चक्षूँषि पश्यति","तदेव ब्रह्म त्वं विद्धि ने","दं यदिदमुपासते"],"अनुष्टुभ् (श्लोकः)"],["1",8,["यच्छ्रोत्रेण न शृणोति","येन श्रोत्रमिदं श्रुतम्","तदेव ब्रह्म त्वं विद्धि ने","दं यदिदमुपासते"],"अनुष्टुभ् (श्लोकः)"],["1",9,["यत्प्राणेन न प्राणिति","येन प्राणः प्रणीयते","तदेव ब्रह्म त्वं विद्धि ने","दं यदिदमुपासते"],"अनुष्टुभ् (श्लोकः)"],["2",1,["यदि मन्यसे सुवेदेति दहरमेवापि  वर्  दभ्रमेवापि","नूनं त्वं वेत्थ ब्रह्मणो रूपम्","यदस्य त्वं यदस्य देवेष्वथ नु","मीमाँस्यमेव ते मन्ये विदितम्"],""],["2",2,["नाहं मन्ये सुवेदेति","नो न वेदेति वेद च","यो नस्तद्वेद तद्वेद","नो न वेदेति वेद च"],"अनुष्टुभ् (श्लोकः)"],["2",3,["यस्यामतं तस्य मतं","मतं यस्य न वेद सः","अविज्ञातं विजानतां","विज्ञातमविजानताम्"],"अनुष्टुभ् (श्लोकः)"],["2",4,["प्रतिबोधविदितं मत","ममृतत्वं हि विन्दते","आत्मना विन्दते वीर्यं","विद्यया विन्दतेऽमृतम्"],"अनुष्टुभ् (श्लोकः)"],["2",5,["इह चेदवेदीदथ सत्यमस्ति","न चेदिहावेदीन्महती विनष्टिः","भूतेषु भूतेषु विचित्य धीराः","प्रेत्यास्माल्लोकादमृता भवन्ति"],""],["3",1,["ब्रह्म ह देवेभ्यो विजिग्ये तस्य ह ब्रह्मणो","विजये देवा अमहीयन्त"],""],["3",2,["त ऐक्षन्तास्माकमेवायं विजयोऽस्माकमेवायं महिमेति","तद्धैषां विजज्ञौ तेभ्यो ह प्रादुर्बभूव तन्न व्यजानत","किमिदं यक्षमिति"],""],["3",3,["तेऽग्निमब्रुवञ्जातवेद एतद्विजानीहि","किमिदं यक्षमिति तथेति"],""],["3",4,["तदभ्यद्रवत्तमभ्यवदत्कोऽसीत्यग्निर्वा","अहमस्मीत्यब्रवीज्जातवेदा वा अहमस्मीति"],""],["3",5,["तस्मिꣳस्त्वयि किं वीर्यमित्यपीदꣳ सर्वं","दहेयं यदिदं पृथिव्यामिति"],""],["3",6,["तस्मै तृणं निदधावेतद्दहेति","तदुपप्रेयाय सर्वजवेन तन्न शशाक दग्धुं स तत एव","निववृते नैतदशकं विज्ञातुं यदेतद्यक्षमिति"],""],["3",7,["अथ वायुमब्रुवन्वायवेतद्विजानीहि","किमेतद्यक्षमिति तथेति"],""],["3",8,["तदभ्यद्रवत्तमभ्य","वदत्कोऽसीति वायुर्वा","अहमस्मीत्यब्रवीन्मात","रिश्वा वा अहमस्मीति"],"अनुष्टुभ् (श्लोकः)"],["3",9,["तस्मिँस्त्वयि किं वीर्यमित्यपीदँ","सर्वमाददीय यदिदं पृथिव्यामिति"],""],["3",10,["तस्मै तृणं निदधावेतदादत्स्वेति","तदुपप्रेयाय सर्वजवेन तन्न शशाकादातुं स तत एव","निववृते नैतदशकं विज्ञातुं यदेतद्यक्षमिति"],""],["3",11,["अथेन्द्रमब्रुवन्मघवन्नेतद्विजानीहि किमेतद्यक्षमिति तथेति","तदभ्यद्रवत्तस्मात्तिरोदधे"],""],["3",12,["स तस्मिन्नेवाकाशे स्त्रियमाजगाम बहुशोभमानामुमाँ","हैमवतीं ताँहोवाच किमेतद्यक्षमिति"],""],["4",1,["सा ब्रह्मेति होवाच ब्रह्मणो वा एतद्विजये महीयध्वमिति","ततो हैव विदाञ्चकार ब्रह्मेति"],""],["4",2,["तस्माद्वा एते देवा अतितरामिवान्यान्देवान्यदग्निर्वायुरिन्द्रस्ते","ह्येनन्नेदिष्ठं पस्पर्शुस्ते ह्येनत्प्रथमो विदाञ्चकार ब्रह्मेति"],""],["4",3,["तस्माद्वा इन्द्रोऽतितरामिवान्यान्देवान्स","ह्येनन्नेदिष्ठं पस्पर्श स ह्येनत्प्रथमो विदाञ्चकार ब्रह्मेति"],""],["4",4,["तस्यैष आदेशो यदेतद्विद्युतो व्यद्युतदा३","(ऐऌत्र `आऽकार् इस् उसेद् इन् त्हे सेन्से ओऋ चोम्परिसोन्)","इतीन् न्यमीमिषदा३ इत्यधिदैवतम्"],""],["4",5,["अथाध्यात्मं यद्देतद्गच्छतीव च मनोऽनेन","चैतदुपस्मरत्यभीक्ष्णँ सङ्कल्पः"],""],["4",6,["तद्ध तद्वनं नाम तद्वनमित्युपासितव्यं स य एतदेवं वेदाभि","हैनꣳ सर्वाणि भूतानि संवाञ्छन्ति"],""],["4",7,["उपनिषदं भो ब्रूहीत्युक्ता त उपनिषद्ब्राह्मीं वाव त","उपनिषदमब्रूमेति"],""],["4",8,["तसै तपो दमः कर्मेति प्रतिष्ठा वेदाः सर्वाङ्गानि","सत्यमायतनम्"],""],["4",9,["यो वा एतामेवं वेदापहत्य पाप्मानमनन्ते स्वर्गे","लोके ज्येये प्रतितिष्ठति प्रतितिष्ठति"],""]]}