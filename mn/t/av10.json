{"id":"av10","v":[["1",1,["यां कल्पयन्ति वहतौ वधूमिव","विश्वरूपां हस्तकृतां चिकित्सवः","सारादेत्वप नुदाम एनाम्"],"विराट्"],["1",2,["शीर्षण्वती नस्वती कर्णिणी कृ","त्याकृता संभृता विश्वरूपा","सारादेत्वप नुदाम एनाम्"],"विराट्"],["1",3,["शूद्रकृता राजकृता","स्त्रीकृता ब्रह्मभिः कृता","जाया पत्या नुत्तेव","कर्तारं बन्ध्वृछतु"],"अनुष्टुभ्"],["1",4,["अनयाहमोषध्या सर्","वाः कृत्या अदूदुषम्","यां क्षेत्रे चक्रुर्यां","गोषु यां वा ते पुरुषेषु"],""],["1",5,["अघमस्त्वघकृते श","पथः शपथीयते","प्रत्यक्प्रतिप्रहिण्मो य","था कृत्याकृतं हनत्"],"अनुष्टुभ्"],["1",6,["प्रतीचीन आङ्गिरसो","ऽध्यक्षो नः पुरोहितः","प्रतीचीः कृत्या आकृत्या","मून्कृत्याकृतो जहि"],"अनुष्टुभ्"],["1",7,["यस्त्वोवाच परेहीति","प्रतिकूलमुदाय्यम्","तं कृत्येऽभिनिवर्तस्व","मास्मानिछो अनागसः"],"अनुष्टुभ्"],["1",8,["यस्ते परूंषि संदधौ","रथस्येव र्भुर्धिया","तं गछ तत्र तेऽयनम्","अज्ञातस्तेऽयं जनः"],"अनुष्टुभ्"],["1",9,["ये त्वा कृत्वालेभिरे वि","द्वला अभिचारिणः","शंभ्विदं कृत्यादूषणं प्रतिवर्त्म","पुनःसरं तेन त्वा स्नपयामसि"],""],["1",10,["यद्दुर्भगां प्रस्नपितां","मृतवत्सामुपेयिम","अपैतु सर्वं मत्पापं","द्रविणं मोप तिष्ठतु"],"अनुष्टुभ्"],["1",11,["यत्ते पितृभ्यो ददतो","यज्ञे वा नाम जगृहुः","संदेश्यात्सर्वस्मात्पापाद्","इमा मुञ्चन्तु त्वौषधीः"],"अनुष्टुभ्"],["1",12,["देवैनसात्पित्र्यान्नामग्रा","हात्संदेश्यादभिनिष्कृतात्","मुञ्चन्तु त्वा वीरुधो वीर्येण ब्रह्","मणा ऋग्भिः पयसा ऋषीणाम्"],""],["1",13,["यथा वातश्च्यावयति","भूम्या रेणुमन्तरिक्षाच्चाभ्रम्","एवा मत्सर्वं दुर्भूतं","ब्रह्मनुत्तमपायति"],""],["1",14,["अप क्राम नानदती","विनद्धा गर्दभीव","कर्तॄन्नक्षस्वेतो","नुत्ता ब्रह्मणा वीर्यावता"],""],["1",15,["अयं पन्थाः कृत्येति त्वा नयामो","ऽभिप्रहितां प्रति त्वा प्र हिण्मः","तेनाभि याहि भञ्जत्यनस्वतीव","वाहिनी विश्वरूपा कुरूतिनी"],"त्रिष्टुभ्"],["1",16,["पराक्ते ज्योतिरपथं","ते अर्वागन्यत्रास्मदयना कृणुष्व","परेणेहि नवतिं नाव्या अति","दुर्गाः स्रोत्या मा क्षणिष्ठाः परेहि"],""],["1",17,["वात इव वृक्षान्नि मृणीहि पादय","मा गामश्वं पुरुषमुच्छिष एषाम्","कर्तॄन्निवृत्येतः कृत्ये","ऽप्रजास्त्वाय बोधय"],""],["1",18,["यां ते बर्हिषि यां श्मशाने क्षे","त्रे कृत्यां वलगं वा निचख्नुः","अग्नौ वा त्वा गार्हपत्येऽभिचेरुः पा","कं सन्तं धीरतरा अनागसम्"],"त्रिष्टुभ्"],["1",19,["उपाहृतमनुबुद्धं नि","खातं वैरं त्सार्यन्वविदाम कर्त्रम्","तदेतु यत आभृतं तत्राश्व इव","वि वर्ततां हन्तु कृत्याकृतः प्रजाम्"],""],["1",20,["स्वायसा असयः सन्ति नो गृहे","विद्मा ते कृत्ये यतिधा परूंषि","उत्तिष्ठैव परेहीतो","ऽज्ञाते किमिहेछसि"],""],["1",21,["ग्रीवास्ते कृत्ये पा","दौ चापि कर्त्स्यामि निर्द्रव","इन्द्राग्नी अस्मान्रक्षतां","यौ प्रजानां प्रजावती"],""],["1",22,["सोमो राजाधिपा मृ","डिता च भूतस्य नः पतयो मृडयन्तु"],""],["1",23,["भवाशर्वावस्यतां","पापकृते कृत्याकृते","दुष्कृते विद्युतं देवहेतिम्"],""],["1",24,["यद्येयथ द्विपदी चतुष्पदी","कृत्याकृता संभृता विश्वरूपा","सेतोऽष्टापदी भूत्वा पु","नः परेहि दुछुने"],""],["1",25,["अभ्यक्ताक्ता स्वरंकृ","ता सर्वं भरन्ती दुरितं परेहि","जानीहि कृत्ये कर्तारं","दुहितेव पितरं स्वम्"],""],["1",26,["परेहि कृत्ये मा तिष्ठो","विद्धस्येव पदं नय","मृगः स मृगयुस्त्वं न","त्वा निकर्तुमर्हति"],"अनुष्टुभ्"],["1",27,["उत हन्ति पूर्वासिनं","प्रत्यादायापर इष्वा","उत पूर्वस्य निघ्नतो","नि हन्त्यपरः प्रति"],"अनुष्टुभ्"],["1",28,["एतद्धि शृणु मे वचो","ऽथेहि यत एयथ","यस्त्वा चकार तं प्रति"],"गायत्री"],["1",29,["अनागोहत्या वै भीमा कृत्ये","मा नो गामश्वं पुरुषं वधीः","यत्रयत्रासि निहिता ततस्त्वोत्था","पयामसि पर्णाल्लघीयसी भव"],"त्रिष्टुभ्"],["1",30,["यदि स्थ तमसावृता","जालेनभिहिता इव","सर्वाः संलुप्येतः कृत्याः","पुनः कर्त्रे प्र हिण्मसि"],"अनुष्टुभ्"],["1",31,["कृत्याकृतो वलगिनो","ऽभिनिष्कारिणः प्रजाम्","मृणीहि कृत्ये मोच्छिषो","ऽमून्कृत्याकृतो जहि"],"अनुष्टुभ्"],["1",32,["यथा सूर्यो मुच्यते तमसस्प","रि रात्रिं जहात्युषसश्च केतून्","एवाहं सर्वं दुर्भूतं कर्त्रं कृत्याकृता","कृतं हस्तीव रजो दुरितं जहामि"],""],["2",1,["केन पार्ष्णी आभृते पूरुषस्य","केन मांसं संभृतं केन गुल्फौ","केनाङ्गुलीः पेशनीः केन खानि","केनोच्छ्लङ्खौ मध्यतः कः प्रतिष्ठाम्"],"त्रिष्टुभ्"],["2",2,["कस्मान्नु गुल्फावधरावकृण्वन्न्","अष्ठीवन्तावुत्तरौ पुरुषस्य","जङ्घे निरृत्य न्यदधुः क्व स्विज्जा","नुनोः संधी क उ तच्चिकेत"],"त्रिष्टुभ्"],["2",3,["चतुष्टयं युजते संहितान्तं","जानुभ्यामूर्ध्वं शिथिरं कबन्धम्","श्रोणी यदूरू क उ तज्जजान","याभ्यां कुसिन्धं सुदृढं बभूव"],"त्रिष्टुभ्"],["2",4,["कति देवाः कतमे त आसन्य","उरो ग्रीवाश्चिक्युः पुरुषस्य","कति स्तनौ व्यदधुः कः कफोदौ","कति स्कन्धान्कति पृष्टीरचिन्वन्"],"त्रिष्टुभ्"],["2",5,["को अस्य बाहू समभ","रद्वीर्यां करवादिति","अंसौ को अस्य तद्देवः","कुसिन्धे अध्या दधौ"],"अनुष्टुभ्"],["2",6,["कः सप्त खानि वि ततर्द शीर्षणि","कर्णाविमौ नासिके चक्षणी मुखम्","येषां पुरुत्रा विजयस्य मह्ननि","चतुष्पादो द्विपदो यन्ति यामम्"],"त्रिष्टुभ्"],["2",7,["हन्वोर्हि जिह्वामदधात्पुरूचीम्","अधा महीमधि शिश्राय वाचम्","स आ वरीवर्ति भुवनेष्वन्तर्","अपो वसानः क उ तच्चिकेत"],"त्रिष्टुभ्"],["2",8,["मस्तिष्कमस्य यतमो ललातं","ककाटिकां प्रथमो यः कपालम्","चित्वा चित्यं हन्वोः पूरुषस्य दि","वं रुरोह कतमः स देवः"],"त्रिष्टुभ्"],["2",9,["प्रियाप्रियाणि बहुला","स्वप्नं संबाधतन्द्यः","आनन्दानुग्रो नन्दांश्च","कस्माद्वहति पूरुषः"],"अनुष्टुभ्"],["2",10,["आर्तिरवर्तिर्निरृतिः","कुतो नु पुरुषेऽमतिः","राद्धिः समृद्धिरव्यृद्धिर्","मतिरुदितयः कुतः"],"अनुष्टुभ्"],["2",11,["को अस्मिन्नापो व्यदधात्विषूवृतः","पुरूवृतः सिन्धुसृत्याय जाताः","तीव्रा अरुणा लोहिनीस्ताम्रधूम्रा","ऊर्ध्वा अवाचीः पुरुषे तिरश्चीः"],"त्रिष्टुभ्"],["2",12,["को अस्मिन्रूपमदधात्","को मह्मानं च नाम च","गातुं को अस्मिन्कः केतुं","कश्चरित्रानि पुरुषे"],"अनुष्टुभ्"],["2",13,["को अस्मिन्प्राणं अव","यत्को अपानं व्यानमु","समानमस्मिन्को देवो","ऽधि शिश्राय पुरुषे"],"अनुष्टुभ्"],["2",14,["को अस्मिन्यज्ञमदधाद्","एको देवोऽधि पुरुषे","को अस्मिन्त्सत्यं कोऽनृतं","कुतो मृत्युः कुतोऽमृतम्"],"अनुष्टुभ्"],["2",15,["को अस्मै वासः पर्य्","अदधात्को अस्यायुरकल्पयत्","बलं को अस्मै प्रायछत्","को अस्याकल्पयज्जवम्"],""],["2",16,["केनापो अन्वतनुत","केनाहरकरोद्रुचे","उषसं केनान्वैन्द्ध के","न सायंभवं ददे"],"अनुष्टुभ्"],["2",17,["को अस्मिन्रेतो न्यदधात्","तन्तुरा तायतामिति","मेधां को अस्मिन्नध्यौहत्","को बाणं को नृतो दधौ"],"अनुष्टुभ्"],["2",18,["केनेमां भूमिमौर्णोत्के","न पर्यभवद्दिवम्","केनाभि मह्ना पर्वतान्","केन कर्माणि पुरुषः"],"अनुष्टुभ्"],["2",19,["केन पर्जन्यमन्वेति","केन सोमं विचक्षणम्","केन यज्ञम्च श्रद्धां च","केनास्मिन्निहितं मनः"],"अनुष्टुभ्"],["2",20,["केन श्रोत्रियमाप्नोति","केनेमं परमेष्ठिनम्","केनेममग्निं पूरुषः","केन संवत्सरं ममे"],"अनुष्टुभ्"],["2",21,["ब्रह्म श्रोत्रियमाप्नोति","ब्रह्मेमं परमेष्ठिनम्","ब्रह्मेममग्निं पूरुषो","ब्रह्म संवत्सरं ममे"],"अनुष्टुभ्"],["2",22,["केन देवां अनु क्षिय","ति केन दैवजनीर्विशः","केनेदमन्यन्नक्षत्रं","केन सत्क्षत्रमुच्यते"],"अनुष्टुभ्"],["2",23,["ब्रह्म देवां अनु क्षिय","ति ब्रह्म दैवजनीर्विशः","ब्रह्मेदमन्यन्नक्षत्रं","ब्रह्म सत्क्षत्रमुच्यते"],"अनुष्टुभ्"],["2",24,["केनेयं भूमिर्विहिता","केन द्यौरुत्तरा हिता","केनेदमूर्ध्वं तिर्यक्चान्","तरिक्षम्व्यचो हितम्"],"अनुष्टुभ्"],["2",25,["ब्रह्मणा भूमिर्विहिता","ब्रह्म द्यौरुत्तरा हिता","ब्रह्मेदमूर्ध्वं तिर्यक्चान्","तरिक्षं व्यचो हितम्"],"अनुष्टुभ्"],["2",26,["मूर्धानमस्य संसीव्या","थर्वा हृदयं च यत्","मस्तिष्कादूर्ध्वः प्रैरयत्","पवमानोऽधि शीर्षतः"],"अनुष्टुभ्"],["2",27,["तद्वा अथर्वणः शिरो","देवकोशः समुब्जितः","तत्प्राणो अभि रक्षति","शिरो अन्नमथो मनः"],"अनुष्टुभ्"],["2",28,["ऊर्ध्वो नु सृष्टास्तिर्यङ्नु सृष्टास्सर्","वा दिशः पुरुष आ बभूवां","पुरं यो ब्रह्मणो वेद","यस्याः पुरुष उच्यते"],""],["2",29,["यो वै तां ब्रह्मणो वेदा","मृतेनावृतां पुरम्","तस्मै ब्रह्म च ब्राह्माश्च","चक्षुः प्राणं प्रजां ददुः"],"अनुष्टुभ्"],["2",30,["न वै तम्चक्षुर्जहाति","न प्राणो जरसः पुरा","पुरं यो ब्रह्मणो वेद","यस्याः पुरुष उच्यते"],"अनुष्टुभ्"],["2",31,["अष्टाचक्रा नवद्वारा","देवानां पूरयोध्या","तस्यां हिरण्ययः को","शः स्वर्गो ज्योतिषावृतः"],"अनुष्टुभ्"],["2",32,["तस्मिन्हिरण्यये को","शे त्र्यरे त्रिप्रतिष्ठिते","तस्मिन्यद्यक्षमात्मन्वत्","तद्वै ब्रह्मविदो विदुः"],"अनुष्टुभ्"],["2",33,["प्रभ्राजमानां हरिणीं","यशसा संपरीवृताम्","पुरं हिरण्ययीं ब्रह्मा","विवेशापराजिताम्"],"अनुष्टुभ्"],["3",1,["अयं मे वरणो मणिः","सपत्नक्षयणो वृषा","तेना रभस्व त्वं शत्रून्","प्र मृणीहि दुरस्यतः"],"अनुष्टुभ्"],["3",2,["प्रैणान्छृणीहि प्र मृणा रभस्व म","णिस्ते अस्तु पुरएता पुरस्तात्","अवारयन्त वरणेन","देवा अभ्याचारमसुराणां श्वःश्वः"],""],["3",3,["अयं मणिर्वरणो विश