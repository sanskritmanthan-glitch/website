्ताभ्यां पादाभ्यां","वाचा श्रोत्रेण चक्षुषा","यस्मै देवाः सदा बलिं प्रयछन्ति विमिते","ऽमितं स्कम्भं तं ब्रूहि कतमः स्विदेव सः"],""],["7",40,["अप तस्य हतं तमो","व्यावृत्तः स पाप्मना","सर्वाणि तस्मिन्ज्योतींषि","यानि त्रीणि प्रजापतौ"],"अनुष्टुभ्"],["7",41,["यो वेतसं हिरण्ययं","तिष्ठन्तं सलिले वेद","स वै गुह्यः प्रजापतिः"],"गायत्री"],["7",42,["तन्त्रमेके युवती विरूपे अ","भ्याक्रामं वयतः षण्मयूखम्","प्रान्या तन्तूंस्तिरते धत्ते अन्या","नाप वृञ्जाते न गमातो अन्तम्"],"त्रिष्टुभ्"],["7",43,["तयोरहं परिनृत्यन्","त्योरिव न वि जानामि यतरा परस्तात्","पुमानेनद्वयत्युद्गृणन्ति पु","मानेनद्वि जभाराधि नाके"],""],["7",44,["इमे मयूखा उप तस्तभुर्दिवं","सामानि चक्रुस्तसराणि वातवे"],"द्विपदा"],["8",1,["यो भूतं च भव्यं च सर्","वं यश्चाधितिष्ठति स्वर्","यस्य च केवलं तस्मै","ज्येष्ठाय ब्रह्मणे नमः"],"अनुष्टुभ्"],["8",2,["स्कम्भेनेमे विष्टभिते","द्यौश्च भूमिश्च तिष्ठतः","स्कम्भ इदं सर्वमात्मन्वद्","यत्प्राणन्निमिषच्च यत्"],"अनुष्टुभ्"],["8",3,["तिस्रो ह प्रजा अत्यायमायन्न्य्","अन्या अर्कमभितोऽविशन्त","बृहन्ह तस्थौ रजसो","विमानो हरितो हरिणीरा विवेश"],""],["8",4,["द्वादश प्रधयश्चक्रम्","एकं त्रीणि नभ्यानि क उ तच्चिकेत","तत्राहतास्त्रीणि शतानि शङ्कवः","षष्टिश्च खीला अविचाचला ये"],""],["8",5,["इदं सवितर्वि जानी","हि षड्यमा एक एकजः","तस्मिन्हापित्वमिछन्ते","य एषामेक एकजः"],"अनुष्टुभ्"],["8",6,["आविः सन्निहितं गुहा","जरन्नाम महत्पदम्","तत्रेदं सर्वमार्पितम्","एजत्प्राणत्प्रतिष्ठितम्"],"अनुष्टुभ्"],["8",7,["एकचक्रं वर्तत एकनेमि","सहस्राक्षरं प्र पुरो नि पश्चा","अर्धेन विश्वं भुवनं जजा","न यदस्यार्धं क्व तद्बभूव"],"त्रिष्टुभ्"],["8",8,["पञ्चवाही वहत्यग्रमेषां प्र","ष्टयो युक्ता अनुसंवहन्ति","अयातमस्य ददृशे न","यातं परं नेदीयोऽवरं दवीयः"],""],["8",9,["तिर्यग्बिलश्चमस ऊर्ध्वबुध्नस्","तस्मिन्यशो निहितं विश्वरूपम्","तदासत ऋषयः सप्त साकं","ये अस्य गोपा महतो बभूवुः"],"त्रिष्टुभ्"],["8",10,["या पुरस्ताद्युज्यते या च पश्चाद्या","विश्वतो युज्यते या च सर्वतः","यया यज्ञः प्राङ्ताय","ते तां त्वा पृछामि कतमा सा ऋचाम्"],""],["8",11,["यदेजति पतति यच्च तिष्ठति","प्राणदप्राणन्निमिषच्च यद्भुवत्","तद्दाधार पृथिवीं विश्वरूपं","तत्संभूय भवत्येकमेव"],"त्रिष्टुभ्"],["8",12,["अनन्तं विततं पुरु","त्रानन्तमन्तवच्चा समन्ते","ते नाकपालश्चरति","विचिन्वन्विद्वान्भूतमुत भव्यमस्य"],""],["8",13,["प्रजापतिश्चरति गर्भे अन्तर","दृश्यमानो बहुधा वि जायते","अर्धेन विश्वं भुवनं जजान","यदस्यार्धं कतमः स केतुः"],"त्रिष्टुभ्"],["8",14,["ऊर्ध्वं भरन्तमुदकं","कुम्भेनेवोदहार्यम्","पश्यन्ति सर्वे चक्षुषा","न सर्वे मनसा विदुः"],"अनुष्टुभ्"],["8",15,["दूरे पूर्णेन वसति","दूर ऊनेन हीयते","महद्यक्षं भुवनस्य","मध्ये तस्मै बलिं राष्ट्रभृतो भरन्ति"],"बृहती"],["8",16,["यतः सूर्यः उदेत्य","स्तं यत्र च गछति","तदेव मन्येऽहं ज्येष्ठं","तदु नात्येति किं चन"],"अनुष्टुभ्"],["8",17,["ये अर्वाङ्मध्य उत वा पुराणं","वेदं विद्वांसमभितो वदन्ति","आदित्यमेव ते परि वदन्ति सर्","वे अग्निं द्वितीयं त्रिवृतं च हंसम्"],"त्रिष्टुभ्"],["8",18,["सहस्राह्ण्यं वियतावस्य पक्षौ","हरेर्हंसस्य पततः स्वर्गम्","स देवान्त्सर्वानुरस्युपदद्य","संपश्यन्याति भुवनानि विश्वा"],"त्रिष्टुभ्"],["8",19,["सत्येनोर्ध्वस्तपति ब्रह्","मणार्वाङ्वि पश्यति","प्राणेन तिर्यङ्प्राणति","यस्मिन्ज्येष्ठमधि श्रितम्"],"अनुष्टुभ्"],["8",20,["यो वै ते विद्यादरणी","याभ्यां निर्मथ्यते वसु","स विद्वान्ज्येष्ठं मन्येत","स विद्याद्ब्राह्मणं महत्"],"अनुष्टुभ्"],["8",21,["अपादग्रे समभवत्","सो अग्रे स्वराभरत्","चतुष्पाद्भूत्वा भोग्यः सर्","वमादत्त भोजनम्"],"अनुष्टुभ्"],["8",22,["भोग्यो भवदथो अन्नमदद्बहु","यो देवमुत्तरावन्तम्","उपासातै सनातनम्"],"उष्णिक्"],["8",23,["सनातनमेनमाहुर्","उताद्य स्यात्पुनर्णवः","अहोरात्रे प्र जायेते","अन्यो अन्यस्य रूपयोः"],"अनुष्टुभ्"],["8",24,["शतं सहस्रमयुतं न्यर्बुदम्","असंख्येयं स्वमस्मिन्निविष्टम्","तदस्य घ्नन्त्यभिपश्य","त एव तस्माद्देवो रोचतेष एतत्"],""],["8",25,["बालादेकमणीयस्कम्","उतैकं नेव दृश्यते","ततः परिष्वजीयसी","देवता सा मम प्रिया"],"अनुष्टुभ्"],["8",26,["इयं कल्याण्यजरा","मर्त्यस्यामृता गृहे","यस्मै कृता शये स यश्","चकार जजार सः"],"अनुष्टुभ्"],["8",27,["त्वं स्त्री त्वं पुमानसि","त्वं कुमार उत वा कुमारी","त्वं जीर्णो दण्डेन वञ्चसि त्वं","जातो भवसि विश्वतोमुखः"],""],["8",28,["उतैषां पितोत वा पुत्र एषाम्","उतैषां ज्येष्ठ उत वा कनिष्ठः","एको ह देवो मनसि प्रविष्टः","प्रथमो जातः स उ गर्भे अन्तः"],"त्रिष्टुभ्"],["8",29,["पूर्णात्पूर्णमुदचति","पूर्णं पूर्णेन सिच्यते","उतो तदद्य विद्याम","यतस्तत्परिषिच्यते"],"अनुष्टुभ्"],["8",30,["एषा सनत्नी सनमेव जातै","षा पुराणी परि सर्वं बभूव","मही देव्युषसो विभा","ती सैकेनैकेन मिषता वि चष्टे"],""],["8",31,["अविर्वै नाम देवतर्","तेनास्ते परीवृता","तस्या रूपेणेमे वृक्षा","हरिता हरितस्रजः"],"अनुष्टुभ्"],["8",32,["अन्ति सन्तं न जहात्यन्","ति सन्तं न पश्यति","देवस्य पश्य काव्यं न","ममार न जीर्यति"],"अनुष्टुभ्"],["8",33,["अपूर्वेणेषिता वाचस्","ता वदन्ति यथायथम्","वदन्तीर्यत्र गछन्ति","तदाहुर्ब्राह्मणं महत्"],"अनुष्टुभ्"],["8",34,["यत्र देवाश्च मनुष्याश्","चारा नाभाविव श्रिताः","अपां त्वा पुष्पं पृछामि","यत्र तन्मायया हितम्"],"अनुष्टुभ्"],["8",35,["येभिर्वात इषितः प्रवाति ये","ददन्ते पञ्च दिशः सध्रीचीः","य आहुतिमत्यमन्यन्त देवा","अपां नेतारः कतमे त आसन्"],"त्रिष्टुभ्"],["8",36,["इमामेषां पृथिवीं वस्त ए","कोऽन्तरिक्षं पर्येको बभूव","दिवमेषां ददते यो विधर्ता","विश्वा आशाः प्रति रक्षन्त्येके"],"त्रिष्टुभ्"],["8",37,["यो विद्यात्सूत्रं विततं","यस्मिन्नोताः प्रजा इमाः","सूत्रं सूत्रस्य यो विद्याद्","स विद्याद्ब्राह्मणं महत्"],"अनुष्टुभ्"],["8",38,["वेदाहं सूत्रं विततं","यस्मिन्नोताः प्रजा इमाः","सूत्रं सूत्रस्याहं","वेदाथो यद्ब्राह्मणं महद्"],""],["8",39,["यदन्तरा द्यावापृथि","वी अग्निरैत्प्रदहन्विश्वदाव्यः","यत्रातिष्ठन्नेकपत्नीः परस्तात्","क्वेवासीन्मातरिश्वा तदानीम्"],""],["8",40,["अप्स्वासीन्मातरिश्वा प्रविष्टः","प्रविष्टा देवाः सलिलान्यासन्","बृहन्ह तस्थौ रजसो विमानः","पवमानो हरित आ विवेश"],"त्रिष्टुभ्"],["8",41,["उत्तरेणेव गयत्रीम्","अमृतेऽधि वि चक्रमे","साम्ना ये साम संविदुर्","अजस्तद्ददृशे क्व"],"अनुष्टुभ्"],["8",42,["निवेशनः संगमनो वसूनां","देव इव सविता सत्यधर्मा","इन्द्रो न तस्थौ समरे धनानाम्"],"विराट्"],["8",43,["पुण्डरीकं नवद्वारं","त्रिभिर्गुणेभिरावृतम्","तस्मिन्यद्यक्षमात्मन्वत्","तद्वै ब्रह्मविदो विदुः"],"अनुष्टुभ्"],["8",44,["अकामो धीरो अमृतः स्वयंभू","रसेन तृप्तो न कुतश्चनोनः","तमेव विद्वान्न बिभाय मृत्योर्","आत्मानं धीरमजरं युवानम्"],"त्रिष्टुभ्"],["9",1,["अघायतामपि नह्या","मुखानि सपत्नेषु वज्रमर्पयैतम्","इन्द्रेण दत्ता प्रथमा शतौदना","भ्रातृव्यघ्नी यजमानस्य गातुः"],""],["9",2,["वेदिष्टे चर्म भवतु","बर्हिर्लोमानि यानि ते","एषा त्वा रशनाग्रभीद्","ग्रावा त्वैषोऽधि नृत्यतु"],"अनुष्टुभ्"],["9",3,["बालास्ते प्रोक्षणीः सन्तु","जीह्वा सं मार्ष्टु अघ्न्ये","शुद्धा त्वं यज्ञिया भूत्वा","दिवं प्रेहि शतौदने"],"अनुष्टुभ्"],["9",4,["यः शतौदनां पचति","कामप्रेण स कल्पते","प्रीता ह्यस्य ऋत्विजः सर्","वे यन्ति यथायथम्"],"अनुष्टुभ्"],["9",5,["स स्वर्गमा रोहति य","त्रादस्त्रिदिवं दिवः","अपूपनाभिं कृत्वा यो","ददाति शतौदनाम्"],"अनुष्टुभ्"],["9",6,["स तांल्लोकान्त्समाप्नोति","ये दिव्या ये च पार्थिवाः","हिरण्यज्योतिषं कृत्वा","यो ददाति शतौदनाम्"],"अनुष्टुभ्"],["9",7,["ये ते देवि शमितारः","पक्तारो ये च ते जनाः","ते त्वा सर्वे गोप्स्यन्","ति मैभ्यो भैषीः शतौदने"],""],["9",8,["वसवस्त्वा दक्षिणत","उत्तरान्मरुतस्त्वा","आदित्याः पश्चाद्गोप्स्यन्ति","साग्निष्टोममति द्रव"],"अनुष्टुभ्"],["9",9,["देवाः पितरो मनुष्या","गन्धर्वाप्सरसश्च ये","ते त्वा सर्वे गोप्स्यन्ति सा","तिरात्रमति द्रव"],"अनुष्टुभ्"],["9",10,["अन्तरिक्षं दिवं भूमिम्","आदित्यान्मरुतो दिशः","लोकान्त्स सर्वानाप्नोति","यो ददाति शतौदनाम्"],"अनुष्टुभ्"],["9",11,["घृतं प्रोक्षन्ती सुभगा","देवी देवान्गमिष्यति","पक्तारमघ्न्ये मा हिंसीर्","दिवं प्रेहि शतौदने"],"अनुष्टुभ्"],["9",12,["ये देवा दिविषदो अन्तरिक्ष","सदश्च ये ये चेमे भूम्यामधि","तेभ्यस्त्वं धुक्ष्व सर्वदा","क्षीरं सर्पिरथो मधु"],""],["9",13,["यत्ते शिरो यत्ते मुखं","यौ कर्णौ ये च ते हनू","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",14,["यौ त ओष्ठौ ये नासिके","ये शृङ्गे ये च तेऽक्षिणी","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",15,["यत्ते क्लोमा यद्धृदयं","पुरीतत्सहकण्ठिका","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",16,["यत्ते यकृद्ये मतस्ने","यदान्त्रम्याश्च ते गुदाः","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",17,["यस्ते प्लाशिर्यो वनिष्ठुर्","यौ कुक्षी यच्च चर्म ते","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",18,["यत्ते मज्जा यदस्थि","यन्मंसं यच्च लोहितम्","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",19,["यौ ते बाहू ये दोषणी","यावंसौ या च ते ककुत्","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",20,["यास्ते ग्रीवा ये स्कन्","धा याः पृष्टीर्याश्च पर्शवः","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],""],["9",21,["यौ त उरू अष्ठीवन्तौ","ये श्रोणी या च ते भसत्","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",22,["यत्ते पुछं ये ते बाला","यदूधो ये च ते स्तनाः","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",23,["यास्ते जङ्घाः याः कुष्ठिका","ऋछरा ये च ते शफाः","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",24,["यत्ते चर्म शतौद","ने यानि लोमान्यघ्न्ये","आमिक्षां दुह्रतां दात्रे","क्षीरं सर्पिरथो मधु"],"अनुष्टुभ्"],["9",25,["क्रोडौ ते स्तां पुरोदाशाव्","आज्येनाभिघारितौ","तौ पक्षौ देवि कृत्वा सा","पक्तारं दिवं वह"],"अनुष्टुभ्"],["9",26,["उलूखले मुसले यश्","च चर्मणि यो वा शूर्पे तण्डुलः कणः","यं वा वातो मातरिश्वा पवमानो म","माथाग्निष्टद्धोता सुहुतं कृणोतु"],""],["9",27,["अपो देवीर्मधुमतीर्घृतश्चुतो ब्रह्","मणां हस्तेषु प्रपृथक्सादयामि","यत्काम इदमभिषिञ्चामि वोऽहं तन्मे सर्","वं सं पद्यतां वयं स्याम पतयो रयीणाम्"],""],["10",1,["नमस्ते जायमानायै","जाताया उत ते नमः","बालेभ्यः शफेभ्यो रूपायाघ्न्ये ते नमः"],"उष्णिक्"],["10",2,["यो विद्यात्सप्त प्रवतः","सप्त विद्यात्परावतः","शिरो यज्ञस्य यो विद्यात्","स वशां प्रति गृह्णीयात्"],"अनुष्टुभ्"],["10",3,["वेदाहं सप्त प्रवतः","सप्त वेद परावतः","शिरो यज्ञस्याहं वेद","सोमं चास्यां विचक्षणम्"],"अनुष्टुभ्"],["10",4,["यया द्यौर्यया पृथिवी","ययापो गुपिता इमाः","वशां सहस्रधारां ब्रह्","मणाछावदामसि"],"अनुष्टुभ्"],["10",5,["शतं कंसाः शतं दोग्धारः श","तं गोप्तारो अधि पृष्ठे अस्याः","ये देवास्तस्यां प्राणन्ति","ते वशां विदुरेकधा"],""],["10",6,["यज्ञपदीराक्षीरा","स्वधाप्राणा महीलुका","वशा पर्जन्यपत्नी","देवां अप्येति ब्रह्मणा"],"अनुष्टुभ्"],["10",7,["अनु त्वाग्निः प्राविशद्","अनु सोमो वशे त्वा","ऊधस्ते भद्रे पर्जन्यो","विद्युतस्ते स्तना वशे"],"अनुष्टुभ्"],["10",8,["अपस्त्वं धुक्षे प्रथमा","उर्वरा अपरा वशे","तृतीयं राष्ट्रं धुक्षेऽन्नं क्षीरं वशे त्वम्"],"उष्णिक्"],["10",9,["यदादित्यैर्हूयमानो","पातिष्ठ ऋतवरि","इन्द्रः सहस्रं पात्रान्त्सो","मं त्वापाययद्वशे"],"अनुष्टुभ्"],["10",10,["यदनूचीन्द्रमैरात्त्वा ऋषभोऽह्वयत्","तस्मात्ते वृत्रहा पयः","क्षीरं क्रुद्धोऽहरद्वशे"],"उष्णिक्"],["10",11,["यत्ते क्रुद्धो धनपतिर्","आ क्षीरमहरद्वशे","इदं तदद्य नाकस्त्रि","षु पात्रेषु रक्षति"],"अनुष्टुभ्"],["10",12,["त्रिषु पात्रेषु तं सोमम्","आ देव्यहरद्वशा","अथर्वा यत्र दीक्षितो","बर्हिष्यास्त हिरण्यये"],"अनुष्टुभ्"],["10",13,["सं हि सोमेनागत सम्","उ सर्वेण पद्वता","वशा समुद्रमध्यष्ठद्","गन्धर्वैः कलिभिः सह"],"अनुष्टुभ्"],["10",14,["सं हि वातेनागत सम्","उ सर्वैः पतत्रिभिः","वशा समुद्रे प्रानृत्यद्","ऋचः सामानि बिभ्रती"],"अनुष्टुभ्"],["10",15,["सं हि सूर्येणागत सम्","उ सर्वेण चक्षुषा","वशा समुद्रमत्यख्यद्","भद्रा ज्योतींषि बिभ्रती"],"अनुष्टुभ्"],["10",16,["अभीवृता हिरण्येन","यदतिष्ठ ऋतावरि","अश्वः समुद्रो भूत्वाध्यस्कन्दद्वशे त्वा"],"उष्णिक्"],["10",17,["तद्भद्राः समगछन्त","वशा देष्ट्र्यथो स्वधा","अथर्वा यत्र दीक्षितो","बर्हिष्यास्त हिरण्यये"],"अनुष्टुभ्"],["10",18,["वशा माता राजन्यस्य","वशा माता स्वधे तव","वशाया यज्ञ आयुधं","ततश्चित्तमजायत"],"अनुष्टुभ्"],["10",19,["ऊर्ध्वो बिन्दुरुदचरद्","ब्रह्मणः ककुदादधि","ततस्त्वं जज्ञिषे वशे","ततो होताजायत"],"अनुष्टुभ्"],["10",20,["आस्नस्ते गाथा अभ","वन्नुष्णिहाभ्यो बलं वशे","पाजस्याज्जज्ञे य","ज्ञ स्तनेभ्यो रश्मयस्तव"],""],["10",21,["ईर्माभ्यामयनं जातं","सक्थिभ्यां च वशे तव","आन्त्रेभ्यो जज्ञिरे अत्रा","उदरादधि वीरुधः"],"अनुष्टुभ्"],["10",22,["यदुदरं वरुणस्या","नुप्राविशथा वशे","ततस्त्वा ब्रह्मोदह्वयत्","स हि नेत्रमवेत्तव"],"अनुष्टुभ्"],["10",23,["सर्वे गर्भादवेपन्त","जायमानादसूस्वः","ससूव हि तामाहु वशेति","ब्रह्मभिः कॢप्तः स ह्यस्या बन्धुः"],""],["10",24,["युध एकः सं सृजति","यो अस्या एक इद्वशी","तरांसि यज्ञा अभवन्","तरसां चक्षुरभवद्वशा"],""],["10",25,["वशा यज्ञं प्रत्यगृह्णाद्","वशा सूर्यमधारयत्","वशायामन्तरविशद्","ओदनो ब्रह्मणा सह"],"अनुष्टुभ्"],["10",26,["वशामेवामृतमाहुर्","वशां मृत्युमुपासते","वशेदं सर्वमभवद्","देवा मनुष्या असुराः पितर ऋषयः"],""],["10",27,["य एवं विद्यात्स वशां प्रति गृह्णीयात्","तथा हि यज्ञः सर्वपाद्","दुहे दात्रेऽनपस्फुरन्"],"उष्णिक्"],["10",28,["तिस्रो जिह्वा वरुण","स्यान्तर्दीद्यत्यासनि","तासां या मध्ये राजति","सा वशा दुष्प्रतिग्रहा"],"अनुष्टुभ्"],["10",29,["चतुर्धा रेतो अभवद्वशायाः","आपस्तुरीयममृतं तुरीयं","यज्ञस्तुरीयं पशवस्तुरीयम्"],"विराट्"],["10",30,["वशा द्यौर्वशा पृथिवी","वशा विष्णुः प्रजापतिः","वशाया दुग्धमपिबन्त्","साध्या वसवश्च ये"],"अनुष्टुभ्"],["10",31,["वशाया दुग्धं पीत्वा","साध्या वसवश्च ये","ते वै ब्रध्नस्य विष्टपि","पयो अस्या उपासते"],"अनुष्टुभ्"],["10",32,["सोममेनामेके दुह्रे","घृतमेक उपासते","य एवं विदुषे वशां","ददुस्ते गतास्त्रिदिवं दिवः"],""],["10",33,["ब्राह्मणेभ्यो वशां दत्त्वा","सर्वांल्लोकान्त्समश्नुते","ऋतं ह्यस्यामार्पितम्","अपि ब्रह्माथो तपः"],"अनुष्टुभ्"],["10",34,["वशां देवा उप जीवन्","ति वशां मनुष्या उत","वशेदं सर्वमभवद्","यावत्सूर्यो विपश्यति"],"अनुष्टुभ्"]]}