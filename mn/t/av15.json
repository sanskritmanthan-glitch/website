{"id":"av15","v":[["1",1,["व्रात्य आसीदीयमा","न एव स प्रजापतिं समैरयत्"],""],["1",2,["स प्रजापतिः सुवर्णम्","आत्मन्नपश्यत्तत्प्राजनयत्"],""],["1",3,["तदेकमभवत्तल्ललाममभवत्तन्महदभवत्तज्ज्येष्ठमभवत्तद्ब्रह्माभवत्तत्तपोऽभवत्तत्सत्यमभवत्तेन प्राजायत"],""],["1",4,["सोऽवर्धत स महानभ","वत्स महादेवोऽभवत्"],"द्विपदा"],["1",5,["स देवानामीशां पर्य्","ऐत्स ईशानोऽभवत्"],"द्विपदा"],["1",6,["स एकव्रात्योऽभवत्","स धनुरादत्त तदेवेन्द्रधनुः"],""],["1",7,["नीलमस्योदरं लोहितं पृष्ठम्"],""],["1",8,["नीलेनैवाप्रियं भ्रातृव्यं प्रोर्णोति लोहितेन द्विषन्तं विध्यतीति ब्रह्मवादिनो वदन्ति"],""],["3",1,["स संवत्सरमूर्ध्वोऽतिष्ठत्तं देवा","अब्रुवन्व्रात्य किं नु तिष्ठसीति"],"द्विपदा"],["3",2,["सोऽब्रवीदासन्दीं मे सं भरन्त्विति"],""],["3",3,["तस्मै व्रात्यायासन्दीं समभरन्"],""],["3",4,["तस्या ग्रीष्मश्च वसन्तश्च द्वौ पा","दावास्तां शरच्च वर्षाश्च द्वौ"],"द्विपदा"],["3",5,["बृहच्च रथन्तरं चानूच्ये आस्तां य","ज्ञायज्ञियं च वामदेव्यं च तिरश्च्ये"],""],["3",6,["ऋचः प्राञ्चस्तन्तवो यजूंषि तिर्यञ्चः"],""],["3",7,["वेद आस्तरणं ब्रह्मोपबर्हणम्"],""],["3",8,["सामासाद उद्गीथोऽपश्रयः"],""],["3",9,["तामासन्दीं व्रात्य आरोहत्"],""],["3",10,["तस्य देवजनाः परिष्कन्दा आसन्त्संकल्","पाः प्रहाय्या विश्वानि भूतान्युपसदः"],""],["3",11,["विश्वान्येवास्य भूतान्युपस","दो भवन्ति य एवं वेद"],""],["7",1,["स महिमा सद्रुर्भूत्वान्तं पृ","थिव्या अगछत्समुद्रोऽभवत्"],"द्विपदा"],["7",2,["तं प्रजापतिश्च परमेष्ठी च पिता च पितामहश्चापश्च श्रद्धा च वर्षं भूत्वानुव्यवर्तयन्त"],""],["7",3,["ऐनमापो गछन्त्यैनं श्रद्धा गछत्य्","ऐनं वर्षं गछति य एवं वेद"],"द्विपदा"],["7",4,["तं श्रद्धा च यज्ञश्च लोकश्चान्नं चान्न्","आद्यं च भूत्वाभिपर्यावर्तन्त"],"द्विपदा"],["7",5,["ऐनं श्रद्धा गछत्यैनं यज्ञो गछत्यैनं लोको गछत्यैनमन्नं गछत्यैनमन्नाद्यं गछति य एवं वेद"],""],["8",1,["सोऽरज्यत ततो राजन्योऽजायत"],""],["8",2,["स विशः सबन्धूनन्नम्","अन्नाद्यमभ्युदतिष्ठत्"],"द्विपदा"],["8",3,["विशां च वै स सबन्धूनां चान्नस्य चान्नाद्य","स्य च प्रियं धाम भवति य एवं वेद"],""],["9",1,["स विशोऽनु व्यचलत्"],""],["9",2,["तं सभा च समितिश्च से","ना च सुरा चानुव्यचलन्"],"द्विपदा"],["9",3,["सभायाश्च वै स समितेश्च सेनायाश्च सु","रायाश्च प्रियं धाम भवति य एवं वेद"],""],["10",1,["तद्यस्यैवं विद्वान्","व्रात्यो राज्ञोऽतिथिर्गृहानागछेत्"],""],["10",2,["श्रेयांसमेनमात्मनो मानयेत्तथा क्षत्रा","य ना वृश्चते तथा राष्ट्राय ना वृश्चते"],""],["10",3,["अतो वै ब्रह्म च क्षत्रं चोदतिष्ठ","तां ते अब्रूतां कं प्र विशावेति"],"द्विपदा"],["10",4,["बृहस्पतिमेव ब्रह्म प्रवि","शत्विन्द्रं क्षत्रं तथा वा इति"],"द्विपदा"],["10",5,["अतो वै बृहस्पतिमे","व ब्रह्म प्राविशदिन्द्रं क्षत्रम्"],""],["10",6,["इयं वा उ पृथिवी बृ","हस्पतिर्द्यौरेवेन्द्रः"],"द्विपदा"],["10",7,["अयं वा उ अग्निर्ब्रह्","मासावादित्यः क्षत्रम्"],"द्विपदा"],["10",8,["ऐनं ब्रह्म गछति ब्रह्","मवर्चसी भवति"],"द्विपदा"],["10",9,["यः पृथिवीं बृहस्प","तिमग्निं ब्रह्म वेद"],"द्विपदा"],["10",10,["ऐनमिन्द्रियं गछ","तीन्द्रियवान्भवति"],"द्विपदा"],["10",11,["य आदित्यं क्षत्रं दिवमिन्द्रं वेद"],""],["11",1,["तद्यस्यैवं विद्वान्","व्रात्योऽतिथिर्गृहानागछेत्"],""],["11",2,["स्वयमेनमभ्युदेत्य ब्रूयाद्व्रात्य क्वावात्सीर्व्रात्योदकं व्रात्य तर्पयन्तु व्रात्य यथा ते प्रियं तथास्तु व्रात्य यथा ते वशस्तथास्तु व्रात्य यथा ते निकामस्तथास्त्विति"],""],["11",3,["यदेनमाह व्रात्य क्वावात्सीरिति प","थ एव तेन देवयानानव रुन्धे"],""],["11",4,["यदेनमाह व्रात्यो","दकमित्यप एव तेनाव रुन्धे"],""],["11",5,["यदेनमाह व्रात्य तर्पयन्त्विति प्रा","णमेव तेन वर्षीयांसं कुरुते"],""],["11",6,["यदेनमाह व्रात्य यथा ते प्रियं त","थास्त्विति प्रियमेव तेनाव रुन्धे"],""],["11",7,["ऐनं प्रियं गछति प्रि","यः प्रियस्य भवति य एवं वेद"],""],["11",8,["यदेनमाह व्रात्य यथा ते वशस्त","थास्त्विति वशमेव तेनाव रुन्धे"],""],["11",9,["ऐनं वशो गछति वशी व","शिनां भवति य एवं वेद"],"द्विपदा"],["11",10,["यदेनमाह व्रात्य यथा ते निकामस्त","थास्त्विति निकाममेव तेनाव रुन्धे"],""],["11",11,["ऐनं निकामो गछति निकामे नि","कामस्य भवति य एवं वेद"],"द्विपदा"],["12",1,["तद्यस्यैवं विद्वान्व्रात्य उद्धृतेष्वग्निष्व","धिश्रितेऽग्निहोत्रेऽतिथिर्गृहानागछेत्"],""],["12",2,["स्वयमेनमभ्युदेत्य","ब्रूयाद्व्रात्याति सृज होष्यामीति"],""],["12",3,["स चातिसृजेज्जुहुयान्न","चातिसृजेन्न जुहुयात्"],"द्विपदा"],["12",4,["स य एवं विदुषा व्रा","त्येनातिसृष्टो जुहोति"],"द्विपदा"],["12",5,["प्र पितृयाणं पन्थां जा","नाति प्र देवयानम्"],"द्विपदा"],["12",6,["न देवेष्वा वृश्चते","हुतमस्य भवति"],"द्विपदा"],["12",7,["पर्यस्यास्मिंल्लोक आयतनं शिष्यते य","एवं विदुषा व्रात्येनातिसृष्टो जुहोति"],""],["12",8,["अथ य एवं विदुषा व्रा","त्येनानतिसृष्टो जुहोति"],"द्विपदा"],["12",9,["न पितृयाणं पन्थां जा","नाति न देवयानम्"],"द्विपदा"],["12",10,["आ देवेषु वृश्चते अ","हुतमस्य भवति"],"द्विपदा"],["12",11,["नास्यास्मिंल्लोक आयतनं शिष्यते य ए","वं विदुषा व्रात्येनानतिसृष्टो जुहोति"],""],["15",1,["तस्य व्रात्यस्य"],""],["15",2,["सप्त प्राणाः सप्तापानाः सप्त व्यानाः"],""],["15",3,["योऽस्य प्रथमः प्राण ऊर्","ध्वो नामायं सो अग्निः"],"द्विपदा"],["15",4,["योऽस्य द्वितीयः प्राणः प्रौ","ढो नामासौ स आदित्यः"],"द्विपदा"],["15",5,["योऽस्य तृतीयः प्राणोऽभ्यू","ढो नामासौ स चन्द्रमाः"],"द्विपदा"],["15",6,["योऽस्य चतुर्थः प्राणो","विभूर्नामायं स पवमानः"],""],["15",7,["योऽस्य पञ्चमः प्राणो यो","निर्नाम ता इमा आपः"],"द्विपदा"],["15",8,["योऽस्य षष्ठः प्राणः प्रियो","नाम त इमे पशवः"],"द्विपदा"],["15",9,["योऽस्य सप्तमः प्राणो","ऽपरिमितो नाम ता इमाः प्रजाः"],""],["16",1,["योऽस्य प्रथमोऽपानः सा पौर्णमासी"],""],["16",2,["योऽस्य द्वितीयोऽपानः साष्टका"],""],["16",3,["योऽस्य तृतीयोऽपानः सामावास्या"],""],["16",4,["योऽस्य चतुर्थोऽपानः सा श्रद्धा"],""],["16",5,["योऽस्य पञ्चमोऽपानः सा दीक्षा"],""],["16",6,["योऽस्य षष्ठोऽपानः स यज्ञः"],""],["16",7,["योऽस्य सप्तमोऽपानस्ता इमा दक्षिणाः"],""],["17",1,["योऽस्य प्रथमो व्यानः सेयं भूमिः"],""],["17",2,["योऽस्य द्वितीयो व्यानस्तदन्तरिक्षम्"],""],["17",3,["योऽस्य तृतीयो व्यानः सा द्यौः"],""],["17",4,["योऽस्य चतुर्थो व्यानस्तानि नक्षत्राणि"],""],["17",5,["योऽस्य पञ्चमो व्यानस्त ऋतवः"],""],["17",6,["योऽस्य षष्ठो व्यानस्त आर्तवाः"],""],["17",7,["योऽस्य सप्तमो व्यानः स संवत्सरः"],""],["17",8,["समानमर्थं परि यन्ति देवाः संवत्सरं","वा एतदृतवोऽनुपरियन्ति व्रात्यं च"],""],["17",9,["यदादित्यमभिसंविशन्त्यमा","वास्यां चैव तत्पौर्णमासीं च"],"द्विपदा"],["17",10,["एकं तदेषाममृत","त्वमित्याहुतिरेव"],"द्विपदा"],["18",1,["तस्य व्रात्यस्य"],""],["18",2,["यदस्य दक्षिणमक्ष्यसौ स आदित्यो","यदस्य सव्यमक्ष्यसौ स चन्द्रमाः"],""],["18",3,["योऽस्य दक्षिणः कर्णोऽयं सो अग्निर्यो","ऽस्य सव्यः कर्णोऽयं स पवमानः"],"द्विपदा"],["18",4,["अहोरात्रे नासिके दितिश्चादितिश्","च शीर्षकपाले संवत्सरः शिरः"],"द्विपदा"],["18",5,["अह्ना प्रत्यङ्व्रात्यो","रात्र्या प्राङ्नमो व्रात्याय"],""]]}