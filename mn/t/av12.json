अनुष्टुभ्"],["4",19,["दुरदभ्नैनमा शये","याचितां च न दित्सति","नास्मै कामाः समृध्यन्ते","यामदत्त्वा चिकीर्षति"],"अनुष्टुभ्"],["4",20,["देवा वशामयाचन्","मुखं कृत्वा ब्राह्मणम्","तेषां सर्वेषामद","दद्धेडं न्येति मानुषः"],"अनुष्टुभ्"],["4",21,["हेडं पशूनां न्येति ब्राह्","मणेभ्योऽददद्वशाम्","देवानां निहितं भागं","मर्त्यश्चेन्निप्रियायते"],"अनुष्टुभ्"],["4",22,["यदन्ये शतं याचेयुर्","ब्राह्मणा गोपतिं वशाम्","अथैनां देवा अब्रुवन्न्","एवं ह विदुषो वशा"],"अनुष्टुभ्"],["4",23,["य एवं विदुषेऽदत्त्वा","थान्येभ्यो ददद्वशाम्","दुर्गा तस्मा अधिष्ठाने","पृथिवी सहदेवता"],"अनुष्टुभ्"],["4",24,["देवा वशामयाचन्","यस्मिन्नग्रे अजायत","तामेतां विद्यान्नारदः","सह देवैरुदाजत"],"अनुष्टुभ्"],["4",25,["अनपत्यमल्पपशुं","वशा कृणोति पूरुषम्","ब्राह्मणैश्च याचिताम","थैनां निप्रियायते"],"अनुष्टुभ्"],["4",26,["अग्नीषोमाभ्यां कामाय","मित्राय वरुणाय च","तेभ्यो याचन्ति ब्राह्","मणास्तेष्वा वृश्चतेऽददत्"],""],["4",27,["यावदस्या गोपतिर्नो","पशृणुयादृचः स्वयम्","चरेदस्य तावद्गोषु","नास्य श्रुत्वा गृहे वसेत्"],"अनुष्टुभ्"],["4",28,["यो अस्या ऋच उपश्रु","त्याथ गोष्वचीचरत्","आयुश्च तस्य भूतिं च","देवा वृश्चन्ति हीडिताः"],"अनुष्टुभ्"],["4",29,["वशा चरन्ती बहुधा","देवानां निहितो निधिः","आविष्कृणुष्व रूपाणि","यदा स्थाम जिघांसति"],"अनुष्टुभ्"],["4",30,["आविरात्मानं कृणुते","यदा स्थाम जिघांसति","अथो ह ब्रह्मभ्यो वशा","याञ्च्याय कृणुते मनः"],"अनुष्टुभ्"],["4",31,["मनसा सं कल्पयति","तद्देवां अपि गछति","ततो ह ब्रह्माणो वशाम्","उपप्रयन्ति याचितुम्"],"अनुष्टुभ्"],["4",32,["स्वधाकारेण पितृभ्यो","यज्ञेन देवताभ्यः दा","नेन राजन्यो व शाया","मातुर्हेडम्न गछति"],"अनुष्टुभ्"],["4",33,["वशा माता राजन्यस्य","तथा संभूतमग्रशः","तस्या आहुरनर्पणं","यद्ब्रह्मभ्यः प्रदीयते"],"अनुष्टुभ्"],["4",34,["यथाज्यं प्रगृहीतमा","लुम्पेत्स्रुचो अग्नये ए","वा ह ब्रह्मभ्यो वशाम","ग्नय आ वृश्चतेऽददत्"],"अनुष्टुभ्"],["4",35,["पुरोडाशवत्सा सुदु","घा लोकेऽस्मा उप तिष्ठति","सास्मै सर्वान्कामान्व","शा प्रददुषे दुहे"],"अनुष्टुभ्"],["4",36,["सर्वान्कामान्यमराज्ये","वशा प्रददुषे दुहे","अथाहुर्नारकं लोकं","निरुन्धानस्य याचिताम्"],"अनुष्टुभ्"],["4",37,["प