{"id":"av09","v":[["1",1,["दिवस्पृथिव्या अन्तरिक्षात्समुद्राद्","अग्नेर्वातान्मधुकशा हि जज्ञे","तां चायित्वामृतं वसानां हृद्","भिः प्रजाः प्रति नन्दन्ति सर्वाः"],"त्रिष्टुभ्"],["1",2,["महत्पयो विश्वरूपम्","अस्याः समुद्रस्य त्वोत रेत आहुः","यत ऐति मधुकशा ररा","णा तत्प्राणस्तदमृतं निविष्टम्"],""],["1",3,["पश्यन्त्यस्याश्चरितं पृथिव्यां पृ","थङ्नरो बहुधा मीमांसमानाः","अग्नेर्वातान्मधुकशा हि","जज्ञे मरुतामुग्रा नप्तिः"],""],["1",4,["मातादित्यानां दुहिता वसूनां","प्राणः प्रजानाममृतस्य नाभिः","हिरण्यवर्णा मधुकशा घृता","ची महान्भर्गश्चरति मर्त्येषु"],"त्रिष्टुभ्"],["1",5,["मधोः कशामजनयन्त देवास्","तस्या गर्भो अभवद्विश्वरूपः","तं जातं तरुणं पिपर्ति माता","स जातो विश्वा भुवना वि चष्टे"],"त्रिष्टुभ्"],["1",6,["कस्तं प्र वेद क उ तं चिकेत यो अ","स्या हृदः कलशः सोमधानो अक्षितः","ब्रह्मा सुमेधाः सो अस्मिन्मदेत"],"विराट्"],["1",7,["स तौ प्र वेद स उ तौ चिकेत याव्","अस्याः स्तनौ सहस्रधारावक्षितौ","ऊर्जं दुहाते अनपस्फुरन्तौ"],"विराट्"],["1",8,["हिङ्करिक्रती बृहती","वयोधा उच्चैर्घोषाभ्येति या व्रतम्","त्रीन्घर्मानभि वावशाना मि","माति मायुं पयते पयोभिः"],""],["1",9,["यामापीनामुपसीदन्त्यापः","शाक्वरा वृषभा ये स्वराजः","ते वर्षन्ति ते वर्ष","यन्ति तद्विदे काममूर्जमापः"],""],["1",10,["स्तनयित्नुस्ते वाक्प्रजापते वृ","षा शुष्मं क्षिपसि भूम्यामधि","अग्नेर्वातान्मधुकशा हि","जज्ञे मरुतामुग्रा नप्तिः"],""],["1",11,["यथा सोमः प्रातःस","वने अश्विनोर्भवति प्रियः","एवा मे अश्विना वर्","च आत्मनि ध्रियताम्"],""],["1",12,["यथा सोमो द्वितीये स","वन इन्द्राग्न्योर्भवति","प्रियः एवा म इन्द्राग्नी","वर्च आत्मनि ध्रियताम्"],"अनुष्टुभ्"],["1",13,["यथा सोमस्तृतीये स","वन ऋभूणां भवति","प्रियः एवा म ऋभवो","वर्च आत्मनि ध्रियताम्"],"अनुष्टुभ्"],["1",14,["मधु जनिषीय मधु वंसिषीय","पयस्वानग्न आगमं","तं मा सं सृज वर्चसा"],"उष्णिक्"],["1",15,["सं माग्ने वर्चसा सृज","सं प्रजया समायुषा","विद्युर्मे अस्य देवा इन्","द्रो विद्यात्सह ऋषिभिः"],"अनुष्टुभ्"],["1",16,["यथा मधु मधुकृतः","संभरन्ति मधावधि","एवा मे अश्विना वर्","च आत्मनि ध्रियताम्"],"अनुष्टुभ्"],["1",17,["यथा मक्षाः इदं मधु","न्यञ्जन्ति मधावधि","एवा मे अश्विना वर्चस्ते","जो बलमोजश्च ध्रियताम्"],"अनुष्टुभ्"],["1",18,["यद्गिरिषु पर्वतेषु","गोष्वश्वेषु यन्मधु","सुरायां सिच्यमानायां","यत्तत्र मधु तन्मयि"],"अनुष्टुभ्"],["1",19,["अश्विना सारघेण मा","मधुनाङ्क्तं शुभस्पती","यथा वर्चस्वतीं वाचम्","आवदानि जनां अनु"],"अनुष्टुभ्"],["1",20,["स्तनयित्नुस्ते वाक्प्रजापते वृ","षा शुष्मं क्षिपसि भूम्यां दिवि","तां पशव उप जीवन्ति","सर्वे तेनो सेषमूर्जं पिपर्ति"],""],["1",21,["पृथिवी दण्डोऽन्तरिक्षं गर्भो द्यौः क","शा विद्युत्प्रकशो हिरण्ययो बिन्दुः"],"द्विपदा"],["1",22,["यो वै कशायाः सप्त","मधूनि वेद मधुमान्भवति","ब्राह्मणश्च राजा च धेनुश्चानड्वांश्","च व्रीहिश्च यवश्च मधु सप्तमम्"],""],["1",23,["मधुमान्भवति मधु","मदस्याहार्यं भवति","मधुमतो लोकान्ज","यति य एवं वेद"],"अनुष्टुभ्"],["1",24,["यद्वीध्रे स्तनयति प्रजापतिर्","एव तत्प्रजाभ्यः प्रादुर्भवति","तस्मात्प्राचीनोपवीतस्तिष्ठे","प्रजापतेऽनु मा बुध्यस्वेति","अन्वेनं प्रजा अनु","प्रजापतिर्बुध्यते य एवं वेद"],""],["2",1,["सपत्नहनमृषभं घृतेन","कामं शिक्षामि हविषाज्येन","नीचैः सपत्नान्मम प","दय त्वमभिष्टुतो महता वीर्येण"],""],["2",2,["यन्मे मनसो न प्रियं चक्षुषो","यन्मे बभस्ति नाभिनन्दति","तद्दुष्वप्न्यं प्रति मुञ्चामि सप","त्ने कामं स्तुत्वोदहं भिदेयम्"],"त्रिष्टुभ्"],["2",3,["दुष्वप्न्यं काम दुरितं च कमा","प्रजस्तामस्वगतामवर्तिम्","उग्र ईशानः प्रति मुञ्च तस्मिन्","यो अस्मभ्यमंहूरणा चिकित्सात्"],"त्रिष्टुभ्"],["2",4,["नुदस्व काम प्र णुद","स्व कामावर्तिं यन्तु मम ये सपत्नाः","तेषां नुत्तानामध","मा तमांस्यग्ने वास्तूनि निर्दह त्वम्"],""],["2",5,["सा ते काम दुहिता धेनुरुच्यते","यामाहुर्वाचं कवयो विराजम्","तया सपत्नान्परि वृङ्ग्धि ये मम पर्य्","एनान्प्राणः पशवो जीवनं वृणक्तु"],"जगती"],["2",6,["कामस्येन्द्रस्य वरुणस्य राज्ञो","विष्णोर्बलेन सवितुः सवेन","अग्नेर्होत्रेण प्र णुदे सपत्नां","छम्बीव नावमुदकेषु धीरः"],"त्रिष्टुभ्"],["2",7,["अध्यक्षो वाजी मम काम उग्रः","कृणोतु मह्यमसपत्नमेव","विश्वे देवा मम नाथं भवन्तु सर्","वे देवा हवमा यन्तु म इमम्"],"त्रिष्टुभ्"],["2",8,["इदमाज्यं घृतवज्जुषाणाः","कामज्येष्ठा इह मादयध्वम्","कृण्वन्तो मह्यमसपत्नमेव"],"विराट्"],["2",9,["इन्द्राग्नी काम सरथं हि भूत्वा","नीचैः सपत्नान्मम पादयाथः","तेषां पन्नानामध","मा तमांस्यग्ने वास्तून्यनुनिर्दह त्वम्"],""],["2",10,["जहि त्वम्काम मम ये","सपत्ना अन्धा तमांस्यव पादयैनान्","निरिन्द्रिया अरसाः सन्तु सर्वे","मा ते जीविषुः कतमच्चनाहः"],""],["2",11,["अवधीत्कामो मम ये सपत्ना उ","रुं लोकमकरन्मह्यमेधतुम्","मह्यं नमन्तां प्रदिशश्चतस्रो","मह्यं षडुर्वीर्घृतमा वहन्तु"],"त्रिष्टुभ्"],["2",12,["तेऽधराञ्चः प्र प्लवन्तां","छिन्ना नौरिव बन्धनात्","न सायकप्रणुत्तानां","पुनरस्ति निवर्तनम्"],"अनुष्टुभ्"],["2",13,["अग्निर्यव इन्द्रो यवः सोमो यवः","यवयावानो देवा यवयन्त्वेनम्"],"द्विपदा"],["2",14,["असर्ववीरश्चरतु प्रणुत्तो","द्वेष्यो मित्रानां परिवर्ग्यः स्वानाम्","उत पृथिव्यामव स्यन्ति विद्युत","उग्रो वो देवः प्र मृणत्सपत्नान्"],"त्रिष्टुभ्"],["2",15,["च्युता चेयं बृहत्यच्युता च वि","द्युद्बिभर्ति स्तनयित्नूंश्च सर्वान्","उद्यन्नादित्यो द्रविणेन तेजसा","नीचैः सपत्नान्नुदतां मे सहस्वान्"],"त्रिष्टुभ्"],["2",16,["यत्ते काम शर्म त्रिवरूथमुद्भु ब्रह्","म वर्म विततमनतिव्याध्यं कृतम्","तेन सपत्नान्परि वृङ्ग्धि ये मम पर्य्","एनान्प्राणः पशवो जीवनं वृणक्तु"],"जगती"],["2",17,["येन देवा असुरान्प्राणुदन्त ये","नेन्द्रो दस्यूनधमं तमो निनाय","तेन त्वं काम मम ये सपत्नास्","तानस्माल्लोकात्प्र णुदस्व दूरम्"],"त्रिष्टुभ्"],["2",18,["यथा देवा असुरान्प्राणुदन्त य","थेन्द्रो दस्यूनधमं तमो बबाधे","तथा त्वं काम मम ये सपत्नास्","तानस्माल्लोकात्प्र णुदस्व दूरम्"],"त्रिष्टुभ्"],["2",19,["कामो जज्ञे प्रथमो","नैनं देवा आपुः पितरो न मर्त्याः","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृनोमि"],""],["2",20,["यावती द्यावापृथिवी वरिम्णा","यावदापः सिष्यदुर्यावदग्निः","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृणोमि"],"त्रिष्टुभ्"],["2",21,["यावतीर्दिशः प्रदिशो विषूचीर्या","वतीराशा अभिचक्षणा दिवः","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृणोमि"],"त्रिष्टुभ्"],["2",22,["यावतीर्भृङ्गा जत्वः कुरूरवो या","वतीर्वघा वृक्षसर्प्यो बभूवुः","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृणोमि"],"त्रिष्टुभ्"],["2",23,["ज्यायान्निमिषतोऽसि ति","ष्ठतो ज्यायान्त्समुद्रादसि काम मन्यो","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृनोमि"],""],["2",24,["न वै वातश्चन कामम्","आप्नोति नाग्निः सूर्यो नोत चन्द्रमाः","ततस्त्वमसि ज्यायान्विश्वहा महांस्","तस्मै ते काम नम इत्कृणोमि"],""],["2",25,["यास्ते शिवास्तन्वः काम भद्रा या","भिः सत्यं भवति यद्वृणिषे","ताभिष्ट्वमस्मां अभिसंविशस्वा","न्यत्र पापीरप वेशया धियः"],"त्रिष्टुभ्"],["3",1,["उपमितां प्रतिमिताम्","अथो परिमितामुत","शालाया विश्ववाराया","नद्धानि वि चृतामसि"],"अनुष्टुभ्"],["3",2,["यत्ते नद्धं विश्ववारे","पाशो ग्रन्थिश्च यः कृतः","बृहस्पतिरिवाहं बलं","वाचा वि स्रंसयामि तत्"],"अनुष्टुभ्"],["3",3,["आ ययाम सं बबर्ह","ग्रन्थींश्चकार ते दृढान्","परूंषि विद्वां छस्तेवेन्","द्रेण वि चृतामसि"],"अनुष्टुभ्"],["3",4,["वंशानां ते नहनानां","प्राणाहस्य तृणस्य च","पक्षाणां विश्ववारे ते","नद्धानि वि चृतामसि"],"अनुष्टुभ्"],["3",5,["संदंशानां पलदा","नां परिष्वञ्जल्यस्य च","इदं मानस्य पत्न्या नद्","धानि वि चृतामसि"],"अनुष्टुभ्"],["3",6,["यानि तेऽन्तः शिक्यान्याबेधू रण्याय कम्","प्र ते तानि चृतामसि शिवा मान","स्य पत्नि न उद्धिता तन्वे भव"],"विराट्"],["3",7,["हविर्धानमग्निशालं","पत्नीनां सदनं सदः","सदो देवानामसि देवि शाले"],"उष्णिक्"],["3",8,["अक्षुमोपशं विततं","सहस्राक्षं विषूवति","अवनद्धमभिहितं","ब्रह्मणा वि चृतामसि"],"अनुष्टुभ्"],["3",9,["यस्त्वा शाले प्रतिगृह्णा","ति येन चासि मिता त्वम्","उभौ मानस्य पत्नि तौ","जीवतां जरदष्टी"],"अनुष्टुभ्"],["3",10,["अमुत्रैनमा गछताद्","दृढा नद्धा परिष्कृता","यस्यास्ते विचृतामस्य्","अङ्गमङ्गं परुष्परुः"],"अनुष्टुभ्"],["3",11,["यस्त्वा शाले निमिमाय","संजभार वनस्पतीन्","प्रजायै चक्रे त्वा शाले","परमेष्ठी प्रजापतिः"],"अनुष्टुभ्"],["3",12,["नमस्तस्मै नमो दात्रे","शालापतये च कृण्मः","नमोऽग्नये प्रचरते","पुरुषाय च ते नमः"],"अनुष्टुभ्"],["3",13,["गोभ्यो अश्वेभ्यो नमो यच्","छालायां विजायते","विजावति प्रजावति","वि ते पाशांश्चृतामसि"],"अनुष्टुभ्"],["3",14,["अग्निमन्तश्छादयसि","पुरुषान्पशुभिः सह","विजावति प्रजावति","वि ते पाशांश्चृतामसि"],"अनुष्टुभ्"],["3",15,["अन्तरा द्यां च पृथिवीं च यद्व्यचस्","तेन शालां प्रति गृह्णामि त इमाम्","यदन्तरिक्षं रजसो विमानं","तत्कृण्वेऽहमुदरं शेवधिभ्यः","तेन शालां प्रति गृ