{"id":"av11","v":[["1",1,["अग्ने जायस्वादितिर्नाथितेयं","ब्रह्मौदनं पचति पुत्रकामा","सप्तऋषयो भूतकृतस्ते","त्वा मन्थन्तु प्रजया सहेह"],"त्रिष्टुभ्"],["1",2,["कृणुत धूमं वृषणः स","खायोऽद्रोघाविता वाचमछ","अयमग्निः पृतनाषाट्","सुवीरो येन देवा असहन्त दस्यून्"],""],["1",3,["अग्नेऽजनिष्ठा महते वीर्याय ब्रह्","मौदनाय पक्तवे जातवेदः","सप्तऋषयो भूतकृतस्ते त्वाजीज","नन्नस्यै रयिं सर्ववीरं नि यछ"],"जगती"],["1",4,["समिद्धो अग्ने समिधा समिध्यस्व","विद्वान्देवान्यज्ञियां एह वक्षः","तेभ्यो हविः श्रपयं जातवेद","उत्तमं नाकमधि रोहयेमम्"],"त्रिष्टुभ्"],["1",5,["त्रेधा भागो निहितो यः पुरा","वो देवानां पितॄणां मर्त्यानाम्","अंशां जानीध्वं वि भजामि तान्वो","यो देवानां स इमां पारयाति"],"त्रिष्टुभ्"],["1",6,["अग्ने सहस्वानभिभूरभीद","सि नीचो न्युब्ज द्विषतः सपत्नान्","इयं मात्रा मीयमाना मिता च","सजातांस्ते बलिहृतः कृणोतु"],"त्रिष्टुभ्"],["1",7,["साकं सजातैः पयसा सहैध्य्","उदुब्जैनां महते वीर्याय","ऊर्ध्वो नाकस्याधि रोह विष्टपं","स्वर्गो लोक इति यं वदन्ति"],"त्रिष्टुभ्"],["1",8,["इयं मही प्रति गृह्णा","तु चर्म पृथिवी देवी सुमनस्यमाना","अथ गछेम सुकृतस्य लोकम्"],""],["1",9,["एतौ ग्रावाणौ सयुजा युङ्धि चर्म","णि निर्बिन्ध्यंशून्यजमानाय साधु","अवघ्नती नि जहि य इमां पृत","न्यव ऊर्ध्वं प्रजामुद्भरन्त्युदूह"],"त्रिष्टुभ्"],["1",10,["गृहाण ग्रावाणौ सकृतौ वीर ह","स्त आ ते देवा यज्ञिया यज्ञमगुः","त्रयो वरा यतमांस्त्वं वृणीषे","तास्ते समृद्धीरिह राधयामि"],"त्रिष्टुभ्"],["1",11,["इयं ते धीतिरिदमु ते जनित्रं","गृह्णातु त्वामदितिः शूरपुत्रा","परा पुनीहि य इमां पृतन्य","वोऽस्यै रयिं सर्ववीरं नि यछ"],"त्रिष्टुभ्"],["1",12,["उपश्वसे द्रुवये सीदता यू","यं वि विच्यध्वं यज्ञियासस्तुषैः","श्रिया समानानति सर्","वान्त्स्यामाधस्पदं द्विषतस्पादयामि"],""],["1",13,["परेहि नारि पुनरेहि क्षिप्रम","पां त्वा गोष्ठो अध्यरुक्षद्भराय","तासां गृह्णीताद्यतमा यज्ञिया अ","सन्विभाज्य धीरीतरा जहीतात्"],"त्रिष्टुभ्"],["1",14,["एमा अगुर्योषितः शुम्भमाना","उत्तिष्ठ नारि तवसं रभस्व","सुपत्नी पत्या प्रजया प्रजावत्या","त्वागन्यज्ञः प्रति कुम्भं गृभाय"],"त्रिष्टुभ्"],["1",15,["ऊर्जो भागो निहितो यः पुरा व","ऋषिप्रशिष्टाप आ भरैताः","अयं यज्ञो गातुविन्नाथवित्प्रजा","विदुग्रः पशुविद्वीरविद्वो अस्तु"],"त्रिष्टुभ्"],["1",16,["अग्ने चरुर्यज्ञियस्त्वाध्यरुक्षच्","छुचिस्तपिष्ठस्तपसा तपैनम्","आर्षेया दैवा अभिसंगत्य भागम्","इमं तपिष्ठा ऋतुभिस्तपन्तु"],"त्रिष्टुभ्"],["1",17,["शुद्धाः पूता योषितो यज्ञिया इमा","आपश्चरुमव सर्पन्तु शुभ्राः","अदुः प्रजां बहुलां पशून्नः पक्","तौदनस्य सुकृतामेतु लोकम्"],"त्रिष्टुभ्"],["1",18,["ब्रह्मणा शुद्धा उत पूता घृतेन सो","मस्यांशवस्तण्डुला यज्ञिया इमे","अपः प्र विशत प्रति गृह्णातु वश्च","रुरिमं पक्त्वा सुकृतामेत लोकम्"],"जगती"],["1",19,["उरुः प्रथस्व महता महिम्ना","सहस्रपृष्ठः सुकृतस्य लोके","पितामहाः पितरः प्रजोपजा","हं पक्ता पञ्चदशस्ते अस्मि"],"त्रिष्टुभ्"],["1",20,["सहस्रपृष्ठः शतधारो अक्षि","तो ब्रह्मौदनो देवयानः स्वर्गः","अमूंस्त आ दधामि प्रजया रेषयै","नान्बलिहाराय मृडतान्मह्यमेव"],"जगती"],["1",21,["उदेहि वेदिं प्रजया वर्धयैनां","नुदस्व रक्षः प्रतरं धेह्येनाम्","श्रिया समानानति सर्","वान्त्स्यामाधस्पदं द्विषतस्पादयामि"],""],["1",22,["अभ्यावर्तस्व पशुभिः सहैनां","प्रत्यङ्ङेनां देवताभिः सहैधि","मा त्वा प्रापच्छपथो माभिचारः","स्वे क्षेत्रे अनमीवा वि राज"],"त्रिष्टुभ्"],["1",23,["ऋतेन तष्टा मनसा हितैषा ब्रह्","मौदनस्य विहिता वेदिरग्रे","अंसध्रीं शुद्धामुप धेहि नारि","तत्रौदनं सादय दैवानाम्"],"त्रिष्टुभ्"],["1",24,["अदितेर्हस्तां स्रुचमेतां द्वितीयां सप्","तऋषयो भूतकृतो यामकृण्वन्","सा गात्राणि विदुष्योदनस्य","दर्विर्वेद्यामध्येनं चिनोतु"],""],["1",25,["शृतं त्वा हव्यमुप सीदन्तु दैवा","निःसृप्याग्नेः पुनरेनान्प्र सीद","सोमेन पूतो जठरे सीद ब्रह्म","णामार्षेयास्ते मा रिषन्प्राशितारः"],"त्रिष्टुभ्"],["1",26,["सोम राजन्त्संज्ञानमा वपैभ्यः","सुब्राह्मणा यतमे त्वोपसीदान्","ऋषीनार्षेयांस्तपसोऽधि जातान्","ब्रह्मौदने सुहवा जोहवीमि"],"त्रिष्टुभ्"],["1",27,["शुद्धाः पूता योषितो यज्ञिया इमा ब्रह्","मणां हस्तेषु प्रपृथक्सादयामि","यत्काम इदमभिषिञ्चामि वोऽहम्","इन्द्रो मरुत्वान्त्स ददादिदं मे"],"जगती"],["1",28,["इदं मे ज्योतिरमृतं हिरण्यं","पक्वं क्षेत्रात्कामदुघा म एषा","इदं धनं नि दधे ब्राह्","मणेषु कृण्वे पन्थां पितृषु यः स्वर्गः"],""],["1",29,["अग्नौ तुषाना वप जातवेदसि","परः कम्बूकां अप मृड्ढि दूरम्","एतं शुश्रुम गृहराजस्य भागम्","अथो विद्म निरृतेर्भागधेयम्"],"त्रिष्टुभ्"],["1",30,["श्राम्यतः पचतो विद्धि","सुन्वतः पन्थां स्वर्गमधि रोहयैनम्","येन रोहात्परमापद्य यद्व","य उत्तमं नाकं परमं व्योम"],""],["1",31,["बभ्रेरध्वर्यो मुखमेतद्वि मृड्ढ्य्","आज्याय लोकं कृणुहि प्रविद्वान्","घृतेन गात्रानु सर्वा वि मृड्ढि","कृण्वे पन्थां पितृषु यः स्वर्गः"],"त्रिष्टुभ्"],["1",32,["बभ्रे रक्षः समदमा वपैभ्यो","ऽब्राह्मणा यतमे त्वोपसीदान्","पुरीषिणः प्रथमानाः पुरस्ताद्","आर्षेयास्ते मा रिषन्प्राशितारः"],"त्रिष्टुभ्"],["1",33,["आर्षेयेषु नि दध ओदन","त्वा नानार्षेयाणामप्यस्त्यत्र","अग्निर्मे गोप्ता मरुतश्च सर्वे","विश्वे देवा अभि रक्षन्तु पक्वम्"],"त्रिष्टुभ्"],["1",34,["यज्ञं दुहानं सदमित्प्रपीनं","पुमांसं धेनुं सदनं रयीणाम्","प्रजामृतत्वमुत दीर्घमायू","रायश्च पोषैरुप त्वा सदेम"],"त्रिष्टुभ्"],["1",35,["वृषभोऽसि स्वर्ग ऋषीनार्षेयान्गछ","सुकृतां लोके सीद तत्र नौ संस्कृतम्"],""],["1",36,["समाचिनुष्वानुसंप्र","याह्यग्ने पथः कल्पय देवयानान्","एतैः सुकृतैरनु गछेम यज्ञं","नाके तिष्ठन्तमधि सप्तरश्मौ"],""],["1",37,["येन देवा ज्योतिषा द्यामुदायन्ब्रह्","मौदनं पक्त्वा सुकृतस्य लोकम्","तेन गेष्म सुकृतस्य लोकं स्वर्","आरोहन्तो अभि नाकमुत्तमम्"],"त्रिष्टुभ्"],["2",1,["भवाशर्वौ मृडतं माभि यातं","भूतपती पशुपती नमो वाम्","प्रतिहितामायतां मा वि स्राष्टं मा","नो हिंसिष्टं द्विपदो मा चतुष्पदः"],"त्रिष्टुभ्"],["2",2,["शुने क्रोष्ट्रे मा शरीराणि कर्तमलिक्ल","वेभ्यो गृध्रेभ्यो ये च कृष्णा अविष्यवः","मक्षिकास्ते पशुपते","वयांसि ते विघसे मा विदन्त"],""],["2",3,["क्रन्दाय ते प्राणाय याश्","च ते भव रोपयः","नमस्ते रुद्र कृण्मः","सहस्राक्षायामर्त्य"],"अनुष्टुभ्"],["2",4,["पुरस्तात्ते नमः कृण्म","उत्तरादधरादुत","अभीवर्गाद्दिवस्पर्य्","अन्तरिक्षाय ते नमः"],"अनुष्टुभ्"],["2",5,["मुखाय ते पशुपते","यानि चक्षूंषि ते भव","त्वचे रूपाय संदृशे","प्रतीचीनाय ते नमः"],"अनुष्टुभ्"],["2",6,["अङ्गेभ्यस्त उदराय","जिह्वाया आस्याय ते","दद्भ्यो गन्धाय ते नमः"],"गायत्री"],["2",7,["अस्त्रा नीलशिखण्डेन","सहस्राक्षेण वाजिना","रुद्रेणार्धकघातिना","तेन मा समरामहि"],"अनुष्टुभ्"],["2",8,["स नो भवः परि वृणक्तु विश्वत आ","प इवाग्निः परि वृणक्तु नो भवः","मा नोऽभि मांस्त नमो अस्त्वस्मै"],""],["2",9,["चतुर्नमो अष्टकृत्वो भवाय","दश कृत्वः पशुपते नमस्ते","तवेमे पञ्च पशवो विभक्ता","गावो अश्वाः पुरुषा अजावयः"],"त्रिष्टुभ्"],["2",10,["तव चतस्रः प्रदिशस्तव द्यौस्तव","पृथिवी तवेदमुग्रोर्वन्तरिक्षम्","तवेदं सर्वमात्मन्वद्","यत्प्राणत्पृथिवीमनु"],""],["2",11,["उरुः कोशो वसुधानस्तवायं यस्मिन्निमा विश्वा भुवनान्यन्तः","स नो मृड पशुपते नमस्ते परः क्रोष्टारो अभिभाः श्वानः परो यन्त्वघरुदो विकेश्यः"],""],["2",12,["धनुर्बिभर्षि हरितं हि","रण्ययं सहस्रघ्निं शतवधं शिखण्डिन्","रुद्रस्येषुश्चरति देवहेतिस्","तस्यै नमो यतमस्यां दिशीतः"],""],["2",13,["योऽभियातो निलयते","त्वां रुद्र निचिकीर्षति","पश्चादनुप्रयुङ्क्षे तं","विद्धस्य पदनीरिव"],"अनुष्टुभ्"],["2",14,["भवारुद्रौ सयुजा सं","विदानावुभावुग्रौ च","रतो वीर्याय ताभ्यां न","मो यतमस्यां दिशीतः"],"अनुष्टुभ्"],["2",15,["नमस्ते अस्त्वायते न","मो अस्तु परायते","नमस्ते रुद्र तिष्ठत","आसीनायोत ते नमः"],"अनुष्टुभ्"],["2",16,["नमः सायं नमः प्रातर्","नमो रात्र्या नमो दिवा","भवाय च शर्वाय चो","भाभ्यामकरं नमः"],"अनुष्टुभ्"],["2",17,["सहस्राक्षमतिपश्यं पुरस्ताद्रु","द्रमस्यन्तं बहुधा विपश्चितम्","मोपाराम जिह्वयेयमानम्"],"विराट्"],["2",18,["श्यावाश्वं कृष्णमसितं","मृणन्तं भीमं रथं के","शिनः पादयन्तम्पूर्वे","प्रतीमो नमो अस्त्वस्मै"],"अनुष्टुभ्"],["2",19,["मा नोऽभि स्रा मत्यं देव","हेतिं मा नः क्रुधः पशु","पते नमस्ते अन्यत्रा","स्मद्दिव्यां शाखां वि धूनु"],"अनुष्टुभ्"],["2",20,["मा नो हिंसीरधि नो","ब्रूहि परि णो वृङ्धि मा क्रुधः","मा त्वया समरामहि"],""],["2",21,["मा नो गोषु पुरुषेषु","मा गृधो नो अजाविषु","अन्यत्रोग्र वि वर्तय","पियारूणां प्रजां जहि"],"अनुष्टुभ्"],["2",22,["यस्य तक्मा कासिका","हेतिरेकमश्वस्येव वृष","णः क्रन्द एति अभिपूर्","वं निर्णयते नमो अस्त्वस्मै"],""],["2",23,["योऽन्तरिक्षे तिष्ठति वि","ष्टभितोऽयज्वनः प्रमृ","णन्देवपीयून्तस्मै न","मो दशभिः शक्वरीभिः"],"अनुष्टुभ्"],["2",24,["तुभ्यमारण्याः पशवो मृगा वने हि","ता हंसाः सुपर्णाः शकुना वयांसि","तव यक्षं पशुपते अप्स्वन्तस्","तुभ्यं क्षरन्ति दिव्या आपो वृधे"],"जगती"],["2",25,["शिंशुमारा अजगराः पुरीकया जषा मत्स्या र