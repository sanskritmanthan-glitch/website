{"id":"isha","v":[["1",1,["ईशा वास्यमिदं सर्वं","यत्किञ्च जगत्यां जगत्","तेन त्यक्तेन भुञ्जीथा","मा गृधः कस्य स्विद्धनम्"],"अनुष्टुभ् (श्लोकः)"],["1",2,["कुर्वन्नेवेह कर्माणि","जिजीविषेच्छतं समाः","एवं त्वयि नान्यथेतोऽस्ति","न कर्म लिप्यते नरे"],"अनुष्टुभ् (श्लोकः)"],["1",3,["असुर्या नाम ते लोका","अन्धेन तमसावृताः","तांस्ते प्रेत्याभिगच्छन्ति","ये के चात्महनो जनाः"],"अनुष्टुभ् (श्लोकः)"],["1",4,["अनेजदेकं मनसो जवीयो नैनद्देवा आप्नुवन्पूर्वमर्षत्","तद्धावतोऽन्यानत्येति तिष्ठत्तस्मिन्नपो मातरिश्वा दधाति"],""],["1",5,["तदेजति तन्नैजति","तद्दूरे तद्वन्तिके तद्","अन्तरस्य सर्वस्य तद्","उ सर्वस्यास्य बाह्यतः"],"अनुष्टुभ् (श्लोकः)"],["1",6,["यस्तु सर्वाणि भूतान्य्","आत्मन्येवानुपश्यति","सर्वभूतेषु चात्मानं","ततो न विजुगुप्सते"],"अनुष्टुभ् (श्लोकः)"],["1",7,["यस्मिन्सर्वाणि भूतान्या","त्मैवाभूद्विजानतः","तत्र को मोहः कः शोक","एकत्वमनुपश्यतः"],"अनुष्टुभ् (श्लोकः)"],["1",8,["स पर्यगाच्छुक्रमकायमव्रणमस्नाविरं शुद्धमपापविद्धम्","कविर्मनीषी परिभूः स्वयम्भूर्याथातथ्यतोर्ऽथान्व्यदधाच्छाश्वतीभ्यः समाभ्यः"],""],["1",9,["अन्धं तमः प्रविशन्ति","येऽविद्यामुपासते","ततो भूय इव ते त","मो य उविद्यायां रताः"],"अनुष्टुभ् (श्लोकः)"],["1",10,["अन्यदेवाहुर्विद्ययान्","यदाहुरविद्यया","इति शुश्रुम धीराणां","ये नस्तद्विचचक्षिरे"],"अनुष्टुभ् (श्लोकः)"],["1",11,["विद्यां चाविद्यां च यस्तद्वेदोभयं सह","अविद्यया मृत्युं तीर्त्वा विद्ययामृतमश्नुते"],""],["1",12,["अन्धं तमः प्रविशन्ति","येऽसम्भूतिमुपासते","ततो भूय इव ते त","मो य उ सम्भूत्यां रताः"],"अनुष्टुभ् (श्लोकः)"],["1",13,["अन्यदेवाहुः संभवाद्","अन्यदाहुरसंभवात्","इति शुश्रुम धीराणां","ये नस्तद्विचचक्षिरे"],"अनुष्टुभ् (श्लोकः)"],["1",14,["संभूतिं च विनाशं च","यस्तद्वेदोभयं सह","विनाशेन मृत्युं तीर्त्वा","संभूत्यामृतमश्नुते"],"अनुष्टुभ् (श्लोकः)"],["1",15,["हिरण्मयेन पात्रेण","सत्यस्यापिहितं मुखम्","तत्त्वं पूषन्नपावृणु","सत्यधर्माय दृष्टये"],"अनुष्टुभ् (श्लोकः)"],["1",16,["पूषन्नेकर्षे यम सूर्य प्राजापत्य व्यूह रश्मीन्समूह तेजः","यत्ते रूपं कल्याणतमं तत्ते पश्यामि योऽसावसौ पुरुषः सोऽहमस्मि"],""],["1",17,["वायुरनिलममृतमथेदं भस्मान्तं शरीरम्","ॐ क्रतो स्मर कृतं स्मर क्रतो स्मर कृतं स्मर"],""],["1",18,["अग्ने नय सुपथा राये अस्मान्विश्वानि देव वयुनानि विद्वान्","युयोध्यस्मज्जुहुराणमेनो भूयिष्ठां ते नम उक्तिं विधेम"],""]]}