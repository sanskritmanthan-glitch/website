{"id":"av05","v":[["1",1,["ऋधङ्मन्त्रो योनिं य आबभूवा","मृतासुर्वर्धमानः सुजन्मा","अदब्धासुर्भ्राजमानोऽहेव","त्रितो धर्ता दाधार त्रीणि"],""],["1",2,["आ यो धर्माणि प्रथमः ससाद","ततो वपूंषि कृणुषे पुरूणि","धास्युर्योनिं प्रथम आ विवेशा","यो वाचमनुदितां चिकेत"],"त्रिष्टुभ्"],["1",3,["यस्ते शोकाय तन्वं रिरेच","क्षरद्धिरण्यं शुचयोऽनु स्वाः","अत्रा दधेते अमृतानि नामा","स्मे वस्त्राणि विश एरयन्ताम्"],"त्रिष्टुभ्"],["1",4,["प्र यदेते प्रतरं पूर्व्","यं गुः सदःसद आतिष्ठन्तो अजुर्यम्","कविः शुषस्य मातरा रिहाणे","जाम्यै धुर्यं पतिमेरयेथाम्"],""],["1",5,["तदू षु ते महत्पृथु","ज्मन्नमः कविः काव्येना कृणोमि","यत्सम्यञ्चावभियन्तावभि क्षाम","त्रा मही रोधचक्रे वावृधेते"],""],["1",6,["सप्त मर्यादाः कवयस्ततक्षुस्","तासामिदेकामभ्यंहुरो गात्","आयोर्ह स्कम्भ उपमस्य नीडे","पथां विसर्गे धरुणेषु तस्थौ"],"त्रिष्टुभ्"],["1",7,["उतामृतासुर्व्रत एमि कृन्वन्न्","असुरात्मा तन्वस्तत्सुमद्गुः","उत वा शक्रो रत्नं","दधात्यूर्जया वा यत्सचते हविर्दाः"],""],["1",8,["उत पुत्रः पितरं क्षत्रमीडे","ज्येष्ठं मर्यादमह्वयन्त्स्वस्तये","दर्शन्नु ता वरुण यास्ते विष्ठा","आवर्व्रततः कृणवो वपूंषि"],"त्रिष्टुभ्"],["1",9,["अर्धमर्धेन पयसा","पृणक्ष्यर्धेन शुष्म वर्धसे अमुर","अविं वृधाम शग्मियं","सखायं वरुणं पुत्रमदित्या इषिरम्","कविशस्तान्यस्मै वपूंष्यवो","चाम रोदसी सत्यवाचा"],""],["2",1,["तदिदास भुवनेषु ज्येष्ठम्","यतो यज्ञ उग्रस्त्वेषनृम्णः","सद्यो जज्ञानो नि रिणाति शत्रून","नु यदेनं मदन्ति विश्व ऊमाः"],"त्रिष्टुभ्"],["2",2,["ववृधानः शवसा भूर्","योजाः शत्रुर्दासाय भियसं दधाति","अव्यनच्च व्यनच्च सस्नि सं","ते नवन्त प्रभृता मदेषु"],""],["2",3,["त्वे क्रतुमपि पृञ्चन्ति भूरि","द्विर्यदेते त्रिर्भवन्त्यूमाः","स्वदोः स्वादीयः स्वादु","ना सृजा समदः सु मधु मधुनाभि योधीः"],""],["2",4,["यदि चिन्नु त्वा धना ज","यन्तं रणेरणे अनुमदन्ति विप्राः","ओजीयः शुष्मिन्त्स्थिरमा तनुष्व","मा त्वा दभन्दुरेवासः कशोकाः"],""],["2",5,["त्वया वयं शाशद्महे रणेषु","प्रपश्यन्तो युधेन्यानि भूरि","चोदयामि त आयुधा वचोभिः","सं ते शिशामि ब्रह्मणा वयांसि"],"त्रिष्टुभ्"],["2",6,["नि तद्दधिषेऽवरे परे च","यस्मिन्नाविथावसा दुरोणे","आ स्थापयत मातरं","जिगत्नुमत इन्वत कर्वराणि भूरि"],""],["2",7,["स्तुष्व वर्ष्मन्पुरुवर्त्मानं समृ","भ्वाणमिनतममाप्तमाप्त्यानाम्","आ दर्शति शवसा भूर्","योजाः प्र सक्षति प्रतिमानं पृथिव्याः"],""],["2",8,["इमा ब्रह्म बृहद्दिवः","कृणवदिन्द्राय शूषमग्रियः स्वर्षाः","महो गोत्रस्य क्षयति स्वराजा","तुरश्चिद्विश्वमर्णवत्तपस्वान्"],""],["2",9,["एवा महान्बृहद्दिवो अथर्","वावोचत्स्वां तन्वमिन्द्रमेव","स्वसारौ मातरिभ्वरी अरिप्रे हि","न्वन्ति चैने शवसा वर्धयन्ति च"],"त्रिष्टुभ्"],["3",1,["ममाग्ने वर्चो विहवेष्वस्तु","वयं त्वेन्धानास्तन्वम्पुषेम","मह्यं नमन्तां प्रदिशश्चतस्रस्","त्वयाध्यक्षेण पृतना जयेम"],"त्रिष्टुभ्"],["3",2,["अग्ने मन्युं प्रतिनुदन्परेषां","त्वं नो गोपाः परि पाहि विश्वतः","अपाञ्चो यन्तु निवता दुरस्य","वोऽमैषां चित्तं प्रबुधां वि नेशत्"],"त्रिष्टुभ्"],["3",3,["मम देवा विहवे सन्तु सर्व","इन्द्रवन्तो मरुतो विष्णुरग्निः","ममान्तरिक्षमुरुलोकमस्तु","मह्यं वातः पवतां कामायास्मै"],"त्रिष्टुभ्"],["3",4,["मह्यं यजन्तां मम यानीष्टा","कूतिः सत्या मनसो मे अस्तु","एनो मा नि गां कतमच्चनाहं","विश्वे देवा अभि रक्षन्तु मेह"],"त्रिष्टुभ्"],["3",5,["मयि देवा द्रविणमा यजन्तां म","यि आशीरस्तु मयि देवहूतिः","दैवाः होतारः सनिषन्न एतद्","अरिष्टाः स्याम तन्वा सुवीराः"],"त्रिष्टुभ्"],["3",6,["दैवीः षडुर्वीरुरु नः कृणोत","विश्वे देवास इह मादयध्वम्","मा नो विददभिभा मो अशस्तिर्","मा नो विदद्वृजिना द्वेष्या या"],"त्रिष्टुभ्"],["3",7,["तिस्रो देवीर्महि नः शर्म यछ","त प्रजायै नस्तन्वे यच्च पुष्टम्","मा हास्महि प्रजया मा तनूभिर्","मा रधाम द्विषते सोम राजन्"],"त्रिष्टुभ्"],["3",8,["उरुव्यचा नो महिषः शर्म यछत्व्","अस्मिन्हवे पुरुहूतः पुरुक्षु","स नः प्रजायै हर्य","श्व मृडेन्द्र मा नो रीरिषो मा परा दाः"],""],["3",9,["धाता विधाता भुवनस्य यस्प","तिर्देवः सविताभिमातिषाहः","आदित्या रुद्रा अश्विनोभा दे","वाः पान्तु यजमानं निरृथात्"],"त्रिष्टुभ्"],["3",10,["ये नः सपत्ना अप ते भवन्त्विन्","द्राग्निभ्यामव बाधामह एनान्","आदित्या रुद्रा उपरिस्पृशो नो उ","ग्रं चेत्तारमधिराजमक्रत"],"त्रिष्टुभ्"],["3",11,["अर्वाञ्चमिन्द्रममुतो हवाम","हे यो गोजिद्धनजिदश्वजिद्यः","इमं नो यज्ञं विहवे शृणोत्व्","अस्माकमभूर्हर्यश्व मेदी"],"त्रिष्टुभ्"],["4",1,["यो गिरिष्वजायथा वी","रुधां बलवत्तमः","कुष्ठेहि तक्मनाशन","तक्मानं नाशयन्नितः"],"अनुष्टुभ्"],["4",2,["सुपर्णसुवने गिरौ","जातं हिमवतस्परि","धनैरभि श्रुत्वा यन्ति","विदुर्हि तक्मनाशनम्"],"अनुष्टुभ्"],["4",3,["अश्वत्थो देवसदनस्","तृतीयस्यामितो दिवि","तत्रामृतस्य चक्षणं","देवाः कुष्ठमवन्वत"],"अनुष्टुभ्"],["4",4,["हिरण्ययी नौरचरद्","धिरण्यबन्धना दिवि","तत्रामृतस्य पुष्पं दे","वाः कुष्ठमवन्वत"],"अनुष्टुभ्"],["4",5,["हिरण्ययाः पन्थान आसन्न्","अरित्राणि हिरण्यया","नावो हिरण्ययीरासन्","याभिः कुष्ठं निरावहन्"],"अनुष्टुभ्"],["4",6,["इमं मे कुष्ठ पूरुषं","तमा वह तं निष्कुरु","तमु मे अगदं कृधि"],"गायत्री"],["4",7,["देवेभ्यो अधि जातोऽसि","सोमस्यासि सखा हितः","स प्राणाय व्याना","य चक्षुषे मे अस्मै मृड"],""],["4",8,["उदङ्जातो हिमवतः","स प्राच्यां नीयसे जनम्","तत्र कुष्ठस्य नामान्युत्","तमानि वि भेजिरे"],"अनुष्टुभ्"],["4",9,["उत्तमो नाम कुष्ठस्य्","उत्तमो नाम ते पिता","यक्ष्मं च सर्वं नाशय","तक्मानं चारसं कृधि"],"अनुष्टुभ्"],["4",10,["शीर्षामयमुपह","त्यामक्ष्योस्तन्वो रपः","कुष्ठस्तत्सर्वं निष्","करद्दैवं समह वृष्ण्यम्"],""],["5",1,["रात्री माता नभः पि","तार्यमा ते पितामहः","सिलाची नाम वा असि","सा देवानामसि स्वसा"],"अनुष्टुभ्"],["5",2,["यस्त्वा पिबति जीवति","त्रायसे पुरुषं त्वम्","भर्त्री हि शश्वतामसि","जनानां च न्यञ्चनी"],"अनुष्टुभ्"],["5",3,["वृक्षंवृक्षमा रोहसि","वृषण्यन्तीव कन्यला","जयन्ती प्रत्यातिष्ठन्ती","स्परणी नाम वा असि"],"अनुष्टुभ्"],["5",4,["यद्दण्डेन यदिष्वा यद्","वारुर्हरसा कृतम्","तस्य त्वमसि निष्कृतिः","सेमं निष्कृधि पूरुषम्"],"अनुष्टुभ्"],["5",5,["भद्रात्प्लक्षान्निस्ति","ष्ठस्यश्वत्थात्खदिराद्धवात्","भद्रान्न्यग्रोधात्पर्णात्","सा न एह्यरुन्धति"],""],["5",6,["हिरण्यवर्णे सुभगे","सूर्यवर्णे वपुष्टमे","रुतं गछासि निष्कृते","निष्कृतिर्नाम वा असि"],"अनुष्टुभ्"],["5",7,["हिरण्यवर्णे सुभगे","शुष्मे लोमशवक्षने","अपामसि स्वसा लाक्षे","वातो हात्मा बभूव ते"],"अनुष्टुभ्"],["5",8,["सिलाची नाम कानीनो","ऽजबभ्रु पिता तव","अश्वो यमस्य यः श्या","वस्तस्य हास्नास्युक्षिता"],"अनुष्टुभ्"],["5",9,["अश्वस्यास्नः संपतिता","सा वृक्षां अभि सिष्यदे","सरा पतत्रिणी भूत्वा","सा न एह्यरुन्धति"],"अनुष्टुभ्"],["6",1,["ब्रह्म जज्ञानं प्रथमं पुरस्ताद्","वि सीमतः सुरुचो वेन आवः","स बुध्न्या उपमा अस्य","विष्ठाः सतश्च योनिमसतश्च वि वः"],""],["6",2,["अनाप्ता ये वः प्रथमा","यानि कर्माणि चक्रिरे","वीरान्नो अत्र मा दभन्","तद्व एतत्पुरो दधे"],"अनुष्टुभ्"],["6",3,["सहस्रधार एव ते समस्वरन्","दिवो नाके मधुजिह्वा असश्चतः","तस्य स्पशो न नि मिषन्ति भूर्णयः","पदेपदे पाशिनः सन्ति सेतवे"],"त्रिष्टुभ्"],["6",4,["पर्यू षु प्र धन्वा वाजसात","ये परि वृत्राणि सक्षणिः","द्विषस्तदध्यर्णवेनेयसे सनिस्रसो","नामासि त्रयोदशो मास इन्द्रस्य गृहः"],""],["6",5,["न्वेतेनारात्सीरसौ स्वाहा","तिग्मायुधौ तिग्महेती सुशेवौ","सोमारुद्राविह सु मृडतं नः"],""],["6",6,["अवैतेनारात्सीरसौ","स्वाहा तिग्मायुधौ तिग्म","हेती सुशेवौ सोमारु","द्राविह सु मृडतं नः"],"अनुष्टुभ्"],["6",7,["अपैतेनारात्सीरसौ","स्वाहा तिग्मायुधौ तिग्म","हेती सुशेवौ सोमारु","द्राविह सु मृडतं नः"],"अनुष्टुभ्"],["6",8,["मुमुक्तमस्मान्दुरितादवद्याज्जु","षेथाम्यज्ञममृतमस्मासु धत्तम्"],"द्विपदा"],["6",9,["चक्षुषो हेते मनसो हेते ब्रह्","मणो हेते तपसश्च हेते","मेन्या मेनिरस्यमे","नयस्ते सन्तु येऽस्मां अभ्यघायन्ति"],""],["6",10,["योऽस्मांश्चक्षुषा मनसा चित्त्याकू","त्या च यो अघायुरभिदासात्","त्वं तानग्ने मेन्यामेनीन्कृणु स्वाहा"],"विराट्"],["6",11,["इन्द्रस्य गृहोऽसि","तं त्वा प्र पद्ये तं त्वा प्र विशामि सर्वगुः सर्वपूरुषः सर्वात्मा सर्वतनूः सह यन्मेऽस्ति तेन"],""],["6",12,["इन्द्रस्य शर्मासि","तं त्वा प्र पद्ये तं त्वा प्र विशामि सर्वगुः सर्वपूरुषः सर्वात्मा सर्वतनूः सह यन्मेऽस्ति तेन"],""],["6",13,["इन्द्रस्य वर्मासि","तं त्वा प्र पद्ये तं त्वा प्र विशामि सर्वगुः सर्वपूरुषः सर्वात्मा सर्वतनूः सह यन्मेऽस्ति तेन"],""],["6",14,["इन्द्रस्य वरूथमसि","तं त्वा प्र पद्ये तं त्वा प्र विशामि सर्वगुः सर्वपूरुषः सर्वात्मा सर्वतनूः सह यन्मेऽस्ति तेन"],""],["7",1,["आ नो भर मा परि ष्ठा अराते","मा नो रक्षीर्दक्षिणां नीयमानाम्","नमो वीर्त्साया असमृद्ध","ये नमो अस्त्वरातये"],""],["7",2,["यमराते पुरोधत्से","पुरुषं परिरापिणम्","नमस्ते तस्मै कृण्मो मा","वनिं व्यथयीर्मम"],"अनुष्टुभ्"],["7",3,["प्र णो वनिर्देवकृता","दिवा नक्तं च कल्पताम्","अरातिमनुप्रेमो व","यं न