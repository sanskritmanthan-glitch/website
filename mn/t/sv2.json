{"id":"sv2","v":[["0.0",586,["इन्द्र ज्येष्ठं न आ भर","ओजिष्ठं पुपुरि श्रवः","यद्दिधृक्षेम वज्रहस्त रो","दसी ओभे सुशिप्र पप्राः"],""],["0.0",587,["इन्द्रो राजा जगतश्चर्षणीना","मधिक्षमा विश्वरूपं यदस्य","ततो ददाति दाशुषे वसूनि","चोदद्राध उपस्तुतं चिदर्वाक्"],"त्रिष्टुभ्"],["0.0",588,["यस्येदमा रजोयुज","स्तुजे जने वनं स्वः","इन्द्रस्य रन्त्यं बृहत्"],"गायत्री"],["0.0",589,["उदुत्तमं वरुण पाशमस्म","दवाधमं वि मध्यमं श्रथाय","अथादित्य व्रते वयं तवा","नागसो अदितये स्याम"],""],["0.0",590,["त्वया वयं पवमाने","न सोम भरे कृतं वि चिनुयाम शश्वत्","तन्नो मित्रो वरुणो मामहन्ता","मदितिः सिन्धुः पृथिवी उत द्यौः"],""],["0.0",591,["इमं वृषणं कृणुतैकमिन्माम्"],""],["0.0",592,["स न इन्द्राय यज्यवे","वरुणाय मरुद्भ्यः","वरिवोवित्परिस्रव"],"गायत्री"],["0.0",593,["एना विश्वान्यर्य आ","द्युम्नानि मानुषाणाम्","सिषासन्तो वनामहे"],"गायत्री"],["0.0",594,["अहमस्मि प्रथमजा ऋ","तस्य पूर्वं देवेभ्यो अमृतस्य नाम","यो मा ददाति स इदेवमाव","दहमन्नमन्नमदन्तमद्मि"],""],["0.0",595,["त्वमेतदधारयः कृष्","णासु रोहिणीषु च","परुष्णीषु रुशत्पयः"],"गायत्री"],["0.0",596,["अरूरुचदुषसः पृश्निरग्रिय","उक्षा मिमेति भुवनेषु वाजयुः","मायाविनो ममिरे अस्य मायया","नृचक्षसः पितरो गर्भमादधुः"],"त्रिष्टुभ्"],["0.0",597,["इन्द्र इद्धर्योः सचा","सम्मिश्ल आ वचोयुजा","इन्द्रो वज्री हिरण्ययः"],"गायत्री"],["0.0",598,["इन्द्र वाजेषु नोऽव स","हस्रप्रधनेषु च","उग्र उग्राभिरूतिभिः"],"गायत्री"],["0.0",599,["प्रथश्च यस्य सप्रथ","श्च नामानुष्टुभस्य हविषो हविर्यत्","धातुर्द्युतानात्सवितुश्च विष्णो","रथन्तरमा जभारा वसिष्ठः"],""],["0.0",600,["नियुत्वान्वायवा ग","ह्ययं शुक्रो अयामि ते","गन्तासि सुन्वतो गृहम्"],"गायत्री"],["0.0",601,["यज्जायथा अपूर्व्य म","घवन्वृत्रहत्याय","तत्पृथिवीमप्रथय","स्तदस्तभ्ना उतो दिवम्"],"अनुष्टुभ्"],["0.0",602,["मयि वर्चो अथो यशो","ऽथो यज्ञस्य यत्पयः","परमेष्ठी प्रजापतिर्","दिवि द्यामिव दृंहतु"],"अनुष्टुभ्"],["0.0",603,["सं ते पयांसि समु यन्","तु वाजाः सं वृष्ण्यान्यभिमातिषाहः","आप्यायमानो अमृताय सोम","दिवि श्रवांस्युत्तमानि धिष्व"],""],["0.0",604,["त्वमिमा ओषधीः सोम","विश्वास्त्वमपो अजनयस्त्वं गाः","त्वमातनोरुर्वान्तरिक्षं त्वं","ज्योतिषा वि तमो ववर्थ"],""],["0.0",605,["अग्निमीडे पुरोहितं","यज्ञस्य देवमृत्विजम्","होतारं रत्नधातमम्"],"गायत्री"],["0.0",606,["ते मन्वत प्रथमं नाम गोनां","त्रिः सप्त परमं नाम जनान्","ता जानतीरभ्यनूषत क्षा आ","विर्भुवन्नरुणीर्यशसा गावः"],"त्रिष्टुभ्"],["0.0",607,["समन्या यन्त्युपयन्त्यन्याः स","मानमूर्वं नद्यस्पृणन्ति","तमू शुचिं शुचयो दी","दिवांसमपान्नपातमुप यन्त्यापः"],""],["0.0",608,["आ प्रागाद्भद्रा युवति","रह्नः केतून्त्समीर्त्सति","अभूद्भद्रा निवेशनी","विश्वस्य जगतो रात्री"],"अनुष्टुभ्"],["0.0",609,["प्रक्षस्य वृष्णो अरुषस्य नू महः","प्र नो वचो विदथा जातवेदसे","वैश्वानराय मतिर्नव्यसे शुचिः","सोम इव पवते चारुरग्नये"],"त्रिष्टुभ्"],["0.0",610,["विश्वे देवा मम शृण्वन्तु यज्ञमु","भे रोदसी अपां नपाच्च मन्म","मा वो वचांसि परिचक्ष्याणि वो","चं सुम्नेष्विद्वो अन्तमा मदेम"],"त्रिष्टुभ्"],["0.0",611,["यशो मेन्द्रबृहस्पती","यशो भगस्य विन्दतु","यशो मा प्रतिमुच्यताम्","यशस्व्यास्याः सं सदोऽहं प्रवदिता स्याम्"],"बृहती"],["0.0",612,["इन्द्रस्य नु वीर्याणि प्रवोचं या","नि चकार प्रथमानि वज्री","अहन्नहिमन्वपस्ततर्द प्र","वक्षणा अभिनत्पर्वतानाम्"],"त्रिष्टुभ्"],["0.0",613,["अग्निरस्मि जन्मना जातवेदा","घृतं मे चक्षुरमृतं म आसन्","त्रिधातुरर्को रजसो","विमानोऽजस्रं ज्योतिर्हविरस्मि सर्वम्"],""],["0.0",614,["पात्यग्निर्विपो अग्रं पदं वेः","पाति यह्वश्चरणं सूर्यस्य","पाति नाभा सप्तशीर्षाणमग्निः"],"विराट्"],["0.0",615,["भ्राजन्त्यग्ने समिधा","न दीदिवो जिह्वा चरत्यन्तरासनि","स त्वं नो अग्ने पय","सा वसुविद्रयिं वर्चो दृशेऽदाः"],""],["0.0",616,["वसन्त इन्नु रन्त्यो ग्रीष्म इन्नु रन्त्यः","वर्षाण्यनु शरदो हे","मन्तः शिशिर इन्नु रन्त्यः"],"उष्णिक्"],["0.0",617,["सहस्रशीर्षा पुरुषः","सहस्राक्षः सहस्रपात्","स भूमिं सर्वतो वृत्वा","त्यतिष्ठद्दशाङ्गुलम्"],"अनुष्टुभ्"],["0.0",618,["त्रिपादूर्ध्व उदैत्पुरु","षः पदोऽस्येहाभवत्पु","नः तथा विष्वङ्व्यक्राम","द शनानशने अभि"],"अनुष्टुभ्"],["0.0",619,["पुरुष एवेदं सर्वं","यद्भूतं यच्च भाव्यम्","पादोऽस्य सर्वा भूतानि","त्रिपादस्यामृतं दिवि"],"अनुष्टुभ्"],["0.0",620,["तावानस्य महिमा त","तो ज्यायांश्च पूरुषः","उतामृतत्वस्येशानो","यदन्नेनातिरोहति"],"अनुष्टुभ्"],["0.0",621,["ततो विराडजायत","विराजो अधि पूरुषः","स जातो अत्यरिच्यत","पश्चाद्भूमिमथो पुरः"],"अनुष्टुभ्"],["0.0",622,["मन्ये वां द्यावापृथिवी सुभोजसौ ये","अप्रथेथाममितमभि योजनम्","द्यावापृथिवी भवतं","स्योने ते नो मुञ्चतमंहसः"],""],["0.0",623,["हरी त इन्द्र श्मश्रूण्यु","तो ते हरितौ हरि","तं त्वा स्तुवन्ति कवयः","पुरुषासो वनर्गवः"],"अनुष्टुभ्"],["0.0",624,["यद्वर्चो हिरण्यस्य","यद्वा वर्चो गवामुत","सत्यस्य ब्रह्मणो वर्च","स्तेन मा सं सृजामसि"],"अनुष्टुभ्"],["0.0",625,["सहस्तन्न इन्द्र दद्ध्योज ई","शे ह्यस्य महतो विरप्शिन्","क्रतुं न नृम्णं स्थविरं च वाजं","वृत्रेषु शत्रून्त्सुहना कृधी नः"],""],["0.0",626,["सहर्षभाः सहवत्सा उदेत","विश्वा रूपाणी बिभ्रतीर्द्व्यूद्नीः","उरुः पृथुरयं वो अस्तु लोक","इमा आपः सुप्रपाणा इह स्त"],"त्रिष्टुभ्"],["0.0",627,["अग्न आयूंषि पवस","आसुवोर्जमिषं च नः","आरे बाधस्व दुच्छुनाम्"],"गायत्री"],["0.0",628,["विभ्राङ्बृहत्पिबतु सोम्यं मध्वा","युर्दधद्यज्ञपतावविह्रुतम्","वातजूतो यो अभिरक्षति त्मना","प्रजाः पिपर्ति बहुधा वि राजति"],"त्रिष्टुभ्"],["0.0",629,["चित्रं देवानामुदगादनीकं","चक्षुर्मित्रस्य वरुणस्याग्नेः","आप्रा द्यावापृथिवी अन्तरिक्षं","सूर्य आत्मा जगतस्तस्थुषश्च"],"त्रिष्टुभ्"],["0.0",630,["आयं गौः पृश्निरक्रमी","दसदन्मातरं पुरः","पितरं च प्रयन्त्स्वः"],"गायत्री"],["0.0",631,["अन्तश्चरति रोचना","स्य प्राणादपानती","व्यख्यन्महिषो दिवम्"],"गायत्री"],["0.0",632,["त्रिंषद्धाम वि राजति","वाक्पतङ्गाय धीयते","प्रति वस्तोरह द्युभिः"],"गायत्री"],["0.0",633,["अप त्ये तायवो यथा","नक्षत्रा यन्त्यक्तुभिः","सूराय विश्वचक्षसे"],"गायत्री"],["0.0",634,["अदृश्रन्नस्य केतवो","वि रश्मयो जनां अनु","भ्राजन्तो अग्नयो यथा"],"गायत्री"],["0.0",635,["तरणिर्विश्वदर्शतो","ज्योतिष्कृदसि सूर्य","विश्वमाभासि रोचनम्"],"गायत्री"],["0.0",636,["प्रत्यङ्देवानां विशः प्र","त्यङ्ङुदेषि मानुषान्","प्रत्यङ्विश्वं स्वर्दृशे"],"गायत्री"],["0.0",637,["येना पावक चक्षसा","भुरण्यन्तं जनां अनु","त्वं वरुण पश्यसि"],"गायत्री"],["0.0",638,["उद्द्यामेषि रजः पृ","थ्वहा मिमानो अक्तुभिः","पश्यञ्जन्मानि सूर्य"],"गायत्री"],["0.0",639,["अयुक्त सप्त शुन्ध्युवः","सूरो रथस्य नप्त्र्यः","ताभिर्याति स्वयुक्तिभिः"],"गायत्री"],["0.0",640,["सप्त त्वा हरितो रथे","वहन्ति देव सूर्य","शोचिष्केशं विचक्षण"],"गायत्री"]]}