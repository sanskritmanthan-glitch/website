{"id":"nadabindu","v":[["1",1,["अकारो दक्षिणः पक्ष","उकारस्तूत्तरः स्मृतः","मकारस्तस्य पुच्छं वा","अर्धमात्रा शिरस्तथा"],"अनुष्टुभ् (श्लोकः)"],["1",2,["पादौ रजस्तमस्तस्य","शरीरं सत्त्वमुच्यते","धर्मश्च दक्षिणं चक्षुर्","अधर्मश्चोत्तरं स्मृतम्"],"अनुष्टुभ् (श्लोकः)"],["1",3,["भूर्लोकः पादयोस्तस्य","भुवर्लोकस्तु जानुनोः","स्वर्लोकः कटिदेशे तु","नाभिदेशे महर्जगत्"],"अनुष्टुभ् (श्लोकः)"],["1",4,["जनलोकस्तु हृदये","कण्ठदेशे तपस्ततः","भ्रुवोर्ललाटमध्ये तु","सत्यलोको व्यवस्थितः"],"अनुष्टुभ् (श्लोकः)"],["1",5,["सहस्रमिति चात्र मन्","त्र एव प्रदर्शितः","एवमेनं समारूढो","हंसं योगविचक्षणः"],"अनुष्टुभ् (श्लोकः)"],["1",6,["न बध्यते कर्मचारी","पापकोटिशतैरपि","आग्नेयी प्रथमा मात्रा","वायव्यैषा वशानुगा"],"अनुष्टुभ् (श्लोकः)"],["1",7,["भानुमण्डलसंकाशा","भवेन्मात्रा तथोत्तरा","परमा चार्धमात्रा च","वारुणीं तां विदुर्बुधाः"],"अनुष्टुभ् (श्लोकः)"],["1",8,["कलात्रयानना वापि","तासां मात्राप्रतिष्ठिता","एष ओंकार आख्यातो","धारणाभिर्निबोधत"],"अनुष्टुभ् (श्लोकः)"],["1",9,["योषिणी प्रथमा मात्रा","विद्युन्माला तथापरा","पतंगी च तृतीया स्याच्","चतुर्थी वायुवेगिनी"],"अनुष्टुभ् (श्लोकः)"],["1",10,["पञ्चमीनामधेया च","षष्ठी चैन्द्री विधीयते","सप्तमी वैष्णवी नाम","शंकरी च तथाष्टमी"],"अनुष्टुभ् (श्लोकः)"],["1",11,["नवमी महती नाम","ध्रुवेति दशमी मता","एकादशी भवेन्मौनी","ब्राह्मीति द्वादशी मता"],"अनुष्टुभ् (श्लोकः)"],["1",12,["प्रथमायां तु मात्रायां","यदि प्राणैर्वियुज्यते","स राजा भारते वर्षे","सार्वभौमः प्रजायते"],"अनुष्टुभ् (श्लोकः)"],["1",13,["द्वितीयायां समुत्क्रान्तो","भवेद्यक्षो महात्मवान्","विद्याधरस्तृतीयायां","गन्धर्वस्तु चतुर्थिकाम्"],"अनुष्टुभ् (श्लोकः)"],["1",14,["पञ्चम्यामथ मात्रायां","यदि प्राणैर्वियुज्यते","उषितः सहदेवत्वं","सोमलोके महीयते"],"अनुष्टुभ् (श्लोकः)"],["1",15,["षष्ठ्यामिन्द्रस्य सायुज्यं","सप्तम्यां वैष्णवं पदम्","अष्टम्यां व्रजते रुद्रं","पशूनां च पतिं तथा"],"अनुष्टुभ् (श्लोकः)"],["1",16,["नवम्यां च महर्लोकं","दशम्यां च ध्रुवं व्रजेत्","एकादश्यां तपोलोकं","द्वादश्यां ब्रह्म शाश्वतम्"],"अनुष्टुभ् (श्लोकः)"],["1",17,["ततः परं शुद्धं व्यापकं निष्कलं शिवम्","सदोदितं परं ब्रह्म ज्योतिषामुदयो यतः"],""],["1",18,["अतीन्द्रियं गुणातीतं","मनो लीनं यदा भवेत्","अनौपम्यमभावं च","योगयुक्तं तदादिशेत्"],"अनुष्टुभ् (श्लोकः)"],["1",19,["तद्भक्तस्तत्समासक्तः","शनैर्मुञ्चेत्कलेवरम्","सुस्थितो योगचारेण","सर्वसङ्गविवर्जितः"],"अनुष्टुभ् (श्लोकः)"],["1",20,["ततो विलीनपाशोऽसौ","विमलः केवलः प्रभुः","तेनैव ब्रह्मभावेन","परमानन्दमश्नुते"],"अनुष्टुभ् (श्लोकः)"]]}