{"id":"av01","v":[["1",1,["ये त्रिषप्ताः परियन्ति","विश्वा रूपाणि बिभ्रतः","वाचस्पतिर्बला तेषां","तन्वो अद्य दधातु मे"],"अनुष्टुभ्"],["1",2,["पुनरेहि वचस्पते","देवेन मनसा सह","वसोष्पते नि रमय","मय्येवास्तु मयि श्रुतम्"],"अनुष्टुभ्"],["1",3,["इहैवाभि वि तनू","भे आर्त्नी इव ज्यया","वाचस्पतिर्नि यछतु","मय्येवास्तु मयि श्रुतम्"],"अनुष्टुभ्"],["1",4,["उपहूतो वाचस्पतिर्","उपास्मान्वाचस्पतिर्ह्वयताम्","सं श्रुतेन गमेमहि","मा श्रुतेन वि राधिषि"],""],["2",1,["विद्मा शरस्य पितरं","पर्जन्यं भूरिधायसम्","विद्मो ष्वस्य मातरं पृ","थिवीं भूरिवर्पसम्"],"अनुष्टुभ्"],["2",2,["ज्याके परि णो नमाश्मानं तन्वं कृधि","वीडुर्वरीयोऽरातीर्","अप द्वेषांस्या कृधि"],"उष्णिक्"],["2",3,["वृक्षं यद्गावः परिष","स्वजाना अनुस्फुरं श","रं अर्चन्त्यृभुम्शरुम","स्मद्यावय दिद्युमिन्द्र"],"अनुष्टुभ्"],["2",4,["यथा द्यां च पृथिवीं चान्","तस्तिष्ठति तेजनम्","एवा रोगं चास्रा","वं चान्तस्तिष्ठतु मुञ्ज इत्"],""],["3",1,["विद्मा शरस्य पितरं","पर्जन्यं शतवृष्ण्यं","तेना ते तन्वे शं करं पृथिव्यां ते","निषेचनं बहिष्टे अस्तु बालिति"],""],["3",2,["विद्मा शरस्य पित","रं मित्रं शतवृष्ण्यं","तेना ते तन्वे शं करं पृथिव्यां ते","निषेचनं बहिष्टे अस्तु बालिति"],""],["3",3,["विद्मा शरस्य पितरं","वरुणं शतवृष्ण्यं","तेना ते तन्वे शं करं पृथिव्यां ते","निषेचनं बहिष्टे अस्तु बालिति"],""],["3",4,["विद्मा शरस्य पित","रं चन्द्रं शतवृष्ण्यं","तेना ते तन्वे शं करं पृथिव्यां ते","निषेचनं बहिष्टे अस्तु बालिति"],""],["3",5,["विद्मा शरस्य पित","रं सूर्यं शतवृष्ण्यं","तेना ते तन्वे शं करं पृथिव्यां ते","निषेचनं बहिष्टे अस्तु बालिति"],""],["3",6,["यदान्त्रेषु गवीन्योर्यद्","वस्तावधि संश्रितम्","एवा ते मूत्रं मुच्यतां","बहिर्बालिति सर्वकम्"],"अनुष्टुभ्"],["3",7,["प्र ते भिनद्मि मेहनं","वर्त्रं वेशन्त्या इव","एवा ते मूत्रं मुच्यतां","बहिर्बालिति सर्वकम्"],"अनुष्टुभ्"],["3",8,["विषितं ते वस्तिबिलं","समुद्रस्योदधेरिव","एवा ते मूत्रं मुच्यतां","बहिर्बालिति सर्वकम्"],"अनुष्टुभ्"],["3",9,["यथेषुका परापतद्","अवसृष्टाधि धन्वनः","एवा ते मूत्रं मुच्यतां","बहिर्बालिति सर्वकम्"],"अनुष्टुभ्"],["4",1,["अम्बयो यन्त्यध्वभिर्","जामयो अध्वरीयताम्","पृञ्चतीर्मधुना पयः"],"गायत्री"],["4",2,["अमूर्या उप सूर्ये","याभिर्वा सूर्यः सह","ता नो हिन्वन्त्वध्वरम्"],"गायत्री"],["4",3,["अपो देवीरुप ह्वये","यत्र गावः पिबन्ति नः","सिन्धुभ्यः कर्त्वं हविः"],"गायत्री"],["4",4,["अप्स्वन्तरमृतमप्सु भेषजम्","अपामुत प्रशस्तिभिरश्वा भव","थ वाजिनो गावो भवथ वाजिनीः"],"विराट्"],["5",1,["आपो हि ष्ठा मयोभुवस्","ता न ऊर्जे दधातन","महे रणाय चक्षसे"],"गायत्री"],["5",2,["यो वः शिवतमो रसस्","तस्य भाजयतेह नः","उशतीरिव मातरः"],"गायत्री"],["5",3,["तस्मा अरं गमाम वो","यस्य क्षयाय जिन्वथ","आपो जनयथा च नः"],"गायत्री"],["5",4,["ईशाना वार्याणां क्षयन्तीश्चर्षणीनाम्","अपो याचामि भेषजम्"],""],["6",1,["शं नो देवीरभिष्टय","आपो भवन्तु पीतये","शं योरभि स्रवन्तु नः"],"गायत्री"],["6",2,["अप्सु मे सोमो अब्रवीद्","अन्तर्विश्वानि भेषजा","अग्निं च विश्वशंभुवम्"],"गायत्री"],["6",3,["आपः पृणीत भेषजं","वरूथं तन्वे मम","ज्योक्च सूर्यं दृशे"],""],["6",4,["शं न आपो धन्वन्याः शमु सन्त्वनूप्याः","शं नः खनित्रिमा आपः","शमु याः कुम्भ आभृताः","शिवा नः सन्तु वार्षिकीः"],"बृहती"],["7",1,["स्तुवानमग्न आ वह","यातुधानं किमीदिनम्","त्वं हि देव वन्दितो हन्","ता दस्योर्बभूविथ"],"अनुष्टुभ्"],["7",2,["आज्यस्य परमेष्ठिन्जा","तवेदस्तनूवशिन्","अग्ने तौलस्य प्राशान","यातुधानान्वि लापय"],"अनुष्टुभ्"],["7",3,["वि लपन्तु यातुधाना","अत्त्रिणो ये किमीदिनः","अथेदमग्ने नो हविर्","इन्द्रश्च प्रति हर्यतम्"],"अनुष्टुभ्"],["7",4,["अग्निः पूर्व आ रभतां","प्रेन्द्रो नुदतु बाहुमान्","ब्रवीतु सर्वो यातु","मानयमस्मीत्येत्य"],"अनुष्टुभ्"],["7",5,["पश्याम ते वीर्यं जातवेदः प्र","णो ब्रूहि यातुधानान्नृचक्षः","त्वया सर्वे परितप्ताः पुरस्तात्","त आ यन्तु प्रब्रुवाणा उपेदम्"],"त्रिष्टुभ्"],["7",6,["आ रभस्व जातवेदो","ऽस्माकार्थाय जज्ञिषे","दूतो नो अग्ने भू","त्वा यातुधानान्वि लापय"],""],["7",7,["त्वमग्ने यातुधानानु","पबद्धां इहा वह","अथैषामिन्द्रो वज्रेणा","पि शीर्षाणि वृश्चतु"],"अनुष्टुभ्"],["8",1,["इदं हविर्यातुधानान्","नादी फेनमिवा वहत्","य इदं स्त्री पुमानकर्","इह स स्तुवतां जनः"],"अनुष्टुभ्"],["8",2,["अयं स्तुवान आगमद्","इमं स्म प्रति हर्यत","बृहस्पते वशे लब्ध्वा","ग्नीषोमा वि विध्यतम्"],"अनुष्टुभ्"],["8",3,["यातुधानस्य सोमप","जहि प्रजां नयस्व च","नि स्तुवानस्य पातय","परमक्ष्युतावरम्"],"अनुष्टुभ्"],["8",4,["यत्रैषामग्ने जनिमानि वेत्थ","गुहा सतामत्त्रिणां जातवेदः","तांस्त्वं ब्रह्मणा वावृ","धानो जह्येषां शततर्हमग्ने"],""],["9",1,["अस्मिन्वसु वसवो धारयन्त्विन्","द्रः पूषा वरुणो मित्रो अग्निः","इममादित्या उत विश्वे च देवा","उत्तरस्मिन्ज्योतिषि धारयन्तु"],"त्रिष्टुभ्"],["9",2,["अस्य देवाः प्रदिशि ज्योतिरस्तु","सूर्यो अग्निरुत वा हिरण्यम्","सपत्ना अस्मदधरे","भवन्तूत्तमं नाकमधि रोहयेमम्"],""],["9",3,["येनेन्द्राय समभरः पयांस्युत्","तमेन ब्रह्मणा जातवेदः","तेन त्वमग्न इह वर्धयेमं","सजातानां श्रैष्ठ्य आ धेह्येनम्"],"त्रिष्टुभ्"],["9",4,["ऐषां यज्ञमुत वर्चो ददेऽहं","रायस्पोषमुत चित्तान्यग्ने","सपत्ना अस्मदधरे","भवन्तूत्तमं नाकमधि रोहयेमम्"],""],["10",1,["अयं देवानामसुरो वि राजति","वशा हि सत्या वरुणस्य राज्ञः","ततस्परि ब्रह्मणा शाशदान","उग्रस्य मन्योरुदिमं नयामि"],"त्रिष्टुभ्"],["10",2,["नमस्ते रजन्वरुणास्तु मन्य","वे विश्वं ह्युग्र निचिकेषि द्रुग्धम्","सहस्रमन्यान्प्र सुवामि साकं","शतं जीवाति शरदस्तवायम्"],"त्रिष्टुभ्"],["10",3,["यदुवक्थानृतम्जि","ह्वया वृजिनं बहु","राज्ञस्त्वा सत्यधर्मणो","मुञ्चामि वरुणादहम्"],"अनुष्टुभ्"],["10",4,["मुञ्चामि त्वा वैश्वानराद्","अर्णवान्महतस्परि","सजातानुग्रेहा वद","ब्रह्म चाप चिकीहि नः"],"अनुष्टुभ्"],["11",1,["वषट्ते पूषन्नस्मिन्त्सूतावर्","यमा होता कृणोतु वेधाः","सिस्रतां नार्यृतप्रजाता वि","पर्वाणि जिहतां सूतवा उ"],""],["11",2,["चतस्रो दिवः प्रदिशश्","चतस्रो भूम्या उत","देवा गर्भं समैरयन्","तं व्यूर्णुवन्तु सूतवे"],"अनुष्टुभ्"],["11",3,["सूषा व्यूर्णोतु वि योनिं हापयामसि","श्रथया सूषणे त्वम","व त्वं बिष्कले सृज"],"उष्णिक्"],["11",4,["नेव मांसे न पीवसि","नेव मज्जस्वाहतमवैतु","पृश्नि शेवलं शुने ज","राय्वत्तवेऽव जरायु पद्यताम्"],""],["11",5,["वि ते भिनद्मि मेहनं","वि योनिं वि गवीनिके","वि मातरं च पुत्रं च वि कुमारं","जरायुणाव जरायु पद्यताम्"],""],["11",6,["यथा वातो यथा मनो","यथा पतन्ति पक्षिणः","एवा त्वं दशमास्य साकं जरा","युणा पताव जरायु पद्यताम्"],""],["12",1,["जरायुजः प्रथम उस्रियो वृषा","वाताभ्रजा स्तनयन्नेति वृष्ट्या","स नो मृडाति तन्व ऋजुगो रुजन्","य एकमोजस्त्रेधा विचक्रमे"],"त्रिष्टुभ्"],["12",2,["अङ्गेअङ्गे शोचिषा शिश्रियाणं","नमस्यन्तस्त्वा हविषा विधेम","अङ्कान्त्समङ्कान्हविषा विधेम","यो अग्रभीत्पर्वास्या ग्रभीता"],"त्रिष्टुभ्"],["12",3,["मुञ्च शीर्षक्त्या उत कास एनं","परुष्परुराविवेशा यो अस्य","यो अभ्रजा वातजा यश्च शुष्मो","वनस्पतीन्त्सचतां पर्वतांश्च"],"त्रिष्टुभ्"],["12",4,["शं मे परस्मै गात्राय","शमस्त्ववराय मे","शं मे चतुर्भ्यो अङ्गेभ्यः","शमस्तु तन्वे मम"],"अनुष्टुभ्"],["13",1,["नमस्ते अस्तु विद्युते","नमस्ते स्तनयित्नवे","नमस्ते अस्त्वश्मने","येना दूडाशे अस्यसि"],"अनुष्टुभ्"],["13",2,["नमस्ते प्रवतो नपाद्","यतस्तपः समूहसि","मृडया नस्तनूभ्यो","मयस्तोकेभ्यस्कृधि"],"अनुष्टुभ्"],["13",3,["प्रवतो नपान्नम एवास्तु तुभ्यं","नमस्ते हेतये तपुषे च कृण्मः","विद्म ते धाम परमं गुहा यत्","समुद्रे अन्तर्निहितासि नाभिः"],"त्रिष्टुभ्"],["13",4,["यां त्वा देवा असृजन्","त विश्व इषुं कृण्वाना असनाय धृष्णुम्","सा नो मृड विदथे गृणाना","तस्यै ते नमो अस्तु देवि"],""],["14",1,["भगमस्या वर्च आदिष्य्","अधि वृक्षादिव स्रजम्","महाबुध्न इव पर्","वतो ज्योक्पितृष्वास्ताम्"],"अनुष्टुभ्"],["14",2,["एषा ते राजन्क","न्या वधूर्नि धूयताम्यम","सा मातुर्बध्यतां गृ","हेऽथो भ्रातुरथो पितुः"],""],["14",3,["एषा ते कुलपा राजन्","तामु ते परि दद्मसि","ज्योक्पितृष्वासाता आ शीर्ष्णः शमोप्यात्"],"उष्णिक्"],["14",4,["असितस्य ते ब्रह्मणा","कश्यपस्य गयस्य च","अन्तःकोशमिव जाम","योऽपि नह्यामि ते भगम्"],"अनुष्टुभ्"],["15",1,["सं सं स्रवन्तु सिन्धवः","सं वाताः सं पतत्रिणः","इमं यज्ञं प्रदिवो मे जुषन्तां","संस्राव्येण हविषा जुहोमि"],""],["15",2,["इहैव हवमा यात म इह सं","स्रावणा उतेमं वर्धयता गिरः","इहैतु सर्वो यः पशुर्","अस्मिन्तिष्ठतु या रयिः"],""],["15",3,["ये नदीनां संस्रवन्त्य्","उत्सासः सदमक्षिताः","तेभिर्मे सर्वैः संस्रावैर्","धनं सं स्रावयामसि"],"अनुष्टुभ्"],["15",4,["ये सर्पिषः संस्रवन्ति","क्षीरस्य चोदकस्य च","तेभिर्मे सर्वैः संस्रावैर्","धनं सं स्रावयामसि"],"अनुष्टुभ्"],["16",1,["येऽमावास्यां रात्रिमु","दस्थुर्व्राजमत्त्रिणः","अग्निस्तुरीयो यातुहा","सो अस्मभ्यमधि ब्रवत्"],"अनुष्टुभ्"],["16",2,["सीसायाध्याह वरुणः","सीसायाग्निरुपावति","सीसं म इन्द्रः प्रायछत्","तदङ्ग यातुचातनम्"],"अनुष्टुभ्"],["16",3,["इदं विष्कन्धं सहत","इदं बाधते अत्त्रिणः","अनेन विश्वा ससहे","या जातानि पिशाच्याः"],"अनुष्टुभ्"],["16",4,["यदि नो गां हंसि यद्य्","अश्वं यदि पूरुषम्","तं त्वा सीसेन विध्यामो","यथा नोऽसो अवीरहा"],"अनुष्टुभ्"],["17",1,["अमूर्या यन्ति योषितो","हिरा लोहितवाससः","अभ्रातर इव जामयस्","तिष्ठन्तु हतवर्चसः"],"अनुष्टुभ्"],["17",2,["तिष्ठावरे तिष्ठ पर","उत त्वं तिष्ठ मध्यमे","कनिष्ठिका च तिष्ठति","तिष्ठादिद्धमनिर्मही"],"अनुष्टुभ्"],["17",3,["शतस्य धमनीनां","सहस्रस्य हिराणाम्","अस्थुरिन्मध्यमा इमाः","साकमन्ता अरंसत"],"अनुष्टुभ्"],["17",4,["परि वः सिकतावती","धनूर्बृहत्यक्रमीत्","तिष्ठतेलयता सु कम्"],"गायत्री"],["18",1,["निर्लक्ष्म्यं ललाम्यं निर","रातिं सुवामसि अथ","या भद्रा तानि नः प्र जा","या अरातिं नयामसि"],"अनुष्टुभ्"],["18",2,["निररणिं सविता साविषक्पदोर्","निर्हस्तयोर्वरुणो मित्रो अर्यमा","निरस्मभ्यमनुमती रराणा प्रे","मां देवा असाविषुः सौभगाय"],"त्रिष्टुभ्"],["18",3,["यत्त आत्मनि तन्वां घोरमस्ति","यद्वा केशेषु प्रतिचक्षणे वा","सर्वं तद्वाचाप हन्मो वयं","देवस्त्वा सविता सूदयतु"],"त्रिष्टुभ्"],["18",4,["रिश्यपदीं वृषदतीं","गोषेधां विधमामुत","विलीढ्यं ललाम्यं ता","अस्मन्नाशयामसि"],"अनुष्टुभ्"],["19",1,["मा नो विदन्विव्याधिनो","मो अभिव्याधिनो विदन्","आराच्छरव्या अस्मद्वि","षूचीरिन्द्र पातय"],"अनुष्टुभ्"],["19",2,["विष्वञ्चो अस्मच्छर वः","पतन्तु ये अस्ता ये चा","स्याः दैवीर्मनुष्येसवो","म मामित्रान्वि विध्यत"],"अनुष्टुभ्"],["19",3,["यो नः स्वो यो अरणः सजात उ","त निष्ट्यो यो अस्मां अभिदासति","रुद्रः शरव्ययैतान्म","मामित्रान्वि विध्यतु"],""],["19",4,["यः सपत्नो योऽसपत्नो","यश्च द्विषन्छपाति नः","देवास्तं सर्वे धूर्वन्तु","ब्रह्म वर्म ममान्तरम्"],"अनुष्टुभ्"],["20",1,["अदारसृद्भवतु देव","सोमास्मिन्यज्ञे मरुतो मृडता नः","मा नो विददभिभा मो अशस्तिर्","मा नो विदद्वृजिना द्वेष्या या"],""],["20",2,["यो अद्य सेन्यो वधो","ऽघायूनामुदीरते","युवं तं मित्रावरुणाव्","अस्मद्यावयतं परि"],"अनुष्टुभ्"],["20",3,["इतश्च यदमुतश्च","यद्वधं वरुण याव","य वि महच्छर्म यछ","व रीयो यावया वधम्"],"अनुष्टुभ्"],["20",4,["शास इत्था महां अस्य्","अमित्रसाहो अस्तृतः","न यस्य हन्यते सखा","न जीयते कदा चन"],"अनुष्टुभ्"],["21",1,["स्वस्तिदा विशां पतिर्वृ","त्रहा विमृधो वशी","वृषेन्द्रः पुर एतु नः","सोमपा अभयंकरः"],"अनुष्टुभ्"],["21",2,["वि न इन्द्र मृधो जहि","नीचा यछ पृतन्यतः","अधमं गमया तमो","यो अस्मां अभिदासति"],"अनुष्टुभ्"],["21",3,["वि रक्षो वि मृधो जहि","वि वृत्रस्य हनू रुज","वि मन्युमिन्द्र वृत्रहन्न्","अमित्रस्याभिदासतः"],"अनुष्टुभ्"],["21",4,["अपेन्द्र द्विषतो मनो","ऽप जिज्यासतो वधम्","वि महच्छर्म यछ व","रीयो यावया वधम्"],"अनुष्टुभ्"],["22",1,["अनु सूर्यमुदयतां","हृद्द्योतो हरिमा च ते","गो रोहितस्य वर्णेन","तेन त्वा परि दध्मसि"],"अनुष्टुभ्"],["22",2,["परि त्वा रोहितैर्वर्णैर्","दीर्घायुत्वाय दध्मसि","यथायमरपा असद्","अथो अहरितो भुवत्"],"अनुष्टुभ्"],["22",3,["या रोहिणीर्देवत्या गा","वो या उत रोहिणीः","रूपंरूपं वयोवयस्","ताभिष्ट्वा परि दध्मसि"],"अनुष्टुभ्"],["22",4,["शुकेषु ते हरिमाणं","रोपणाकासु दध्मसि","अथो हारिद्रवेषु ते","हरिमाणं नि दध्मसि"],"अनुष्टुभ्"],["23",1,["नक्तंजातासि ओषधे","रामे कृष्णे असिक्नि च","इदं रजनि रजय","किलासं पलितं च यत्"],"अनुष्टुभ्"],["23",2,["किलासं च पलितं च","निरितो नाशया पृषत्","आ त्वा स्वो विशतां वर्णः","परा शुक्लानि पातय"],"अनुष्टुभ्"],["23",3,["असितं ते प्रलयनम्","आस्थानमसितं तव","असिक्नी अस्योषधे निर्","इतो नाशया पृषत्"],"अनुष्टुभ्"],["23",4,["अस्थिजस्य किलासस्य","तनूजस्य च यत्त्वचि","दूष्या कृतस्य ब्रह्मणा","लक्ष्म श्वेतमनीनशम्"],"अनुष्टुभ्"],["24",1,["सुपर्णो जातः प्रथमस्","तस्य त्वं पित्तमासिथ","तदासुरी युधा जिता","रूपं चक्रे वनस्पतीन्"],"अनुष्टुभ्"],["24",2,["आसुरी चक्रे प्रथमेदं किलास","भेषजमिदं किलासनाशनम्","अनीनशत्किलासं स","रूपामकरत्त्वचम्"],""],["24",3,["सरूपा नाम ते माता","सरूपो नाम ते पिता","सरूपकृत्त्वमोषधे","सा सरूपमिदं कृधि"],"अनुष्टुभ्"],["24",4,["श्यामा सरूपंकरणी","पृथिव्या अध्युद्भृता","इदमू षु प्र साधय","पुना रूपाणि कल्पय"],"अनुष्टुभ्"],["25",1,["यदग्निरापो अदहत्प्रविश्य","यत्राकृण्वन्धर्मधृतो नमांसि","तत्र त आहुः परमं जनित्रं","स नः संविद्वान्परि वृङ्ग्धि तक्मन्"],"त्रिष्टुभ्"],["25",2,["यद्यर्चिर्यदि वासि शोचिः श","कल्येषि यदि वा ते जनित्रम्","ह्रूडुर्नामासि हरितस्य देव","स नः संविद्वान्परि वृङ्ग्धि तक्मन्"],"त्रिष्टुभ्"],["25",3,["यदि शोको यदि वाभिशोको य","दि वा राज्ञो वरुणस्यासि पुत्रः","ह्रूडुर्नामासि हरितस्य देव","स नः संविद्वान्परि वृङ्ग्धि तक्मन्"],"त्रिष्टुभ्"],["25",4,["नमः शीताय तक्मने नमो","रूराय शोचिषे कृणोमि","यो अन्येद्युरुभयद्युरभ्येति तृ","तीयकाय नमो अस्तु तक्मने"],""],["26",1,["आरेऽसावस्मदस्तु","हेतिर्देवासो असत्","आरे अश्मा यमस्यथ"],"गायत्री"],["26",2,["सखासावस्मभ्यम","स्तु रातिः सखेन्द्रो भगः","सविता चित्रराधाः"],"गायत्री"],["26",3,["यूयम्नः प्रवतो नपान्","मरुतः सूर्यत्वचसः","शर्म यछथ सप्रथाः"],"गायत्री"],["26",4,["सुषूदत मृडत","मृडया नस्तनूभ्यो","मयस्तोकेभ्यस्कृधि"],"गायत्री"],["27",1,["अमूः पारे पृदाक्वस्","त्रिषप्ता निर्जरायवः","तासाम्जरायुभिर्वयमक्ष्यावपि","व्ययामस्यघायोः परिपन्थिनः"],""],["27",2,["विषूच्येतु कृन्तती पि","नाकमिव बिभ्रती","विष्वक्पुनर्भुवा मनो","ऽसमृद्धा अघायवः"],"अनुष्टुभ्"],["27",3,["न बहवः समशकन्","नार्भका अभि दाधृषुः","वेणोरद्गा इवाभि","तोऽसमृद्धा अघायवः"],"अनुष्टुभ्"],["27",4,["प्रेतं पादौ प्र स्फुरतं","वहतं पृणतो गृहान्","इन्द्रान्येतु प्रथमा","जीतामुषिता पुरः"],"अनुष्टुभ्"],["28",1,["उप प्रागाद्देवो अग्नी","रक्षोहामीवचातनः","दहन्नप द्वयाविनो","यातुधानान्किमीदिनः"],"अनुष्टुभ्"],["28",2,["प्रति दह यातुधानान्","प्रति देव किमीदिनः","प्रतीचीः कृष्णवर्तने","सं दह यातुधान्यः"],"अनुष्टुभ्"],["28",3,["या शशाप शपनेन","याघं मूरमादधे","या रसस्य हरणाय जा","तमारेभे तोकमत्तु सा"],"अनुष्टुभ्"],["28",4,["पुत्रमत्तु यातुधानीः","स्वसारमुत नप्त्यम्","अधा मिथो विकेश्यो वि घ्नतां या","तुधान्यो वि तृह्यन्तामराय्यः"],""],["29",1,["अभीवर्तेन मणिना","येनेन्द्रो अभिववृधे","तेनास्मान्ब्रह्मणस्पते","ऽभि राष्ट्राय वर्धय"],"अनुष्टुभ्"],["29",2,["अभिवृत्य सपत्नान","भि या नो अरातयः","अभि पृतन्यन्तं तिष्ठा","भि यो नो दुरस्यति"],"अनुष्टुभ्"],["29",3,["अभि त्वा देवः सविता","भि षोमो अवीवृधत्","अभि त्वा विश्वा भूतान्य","भीवर्तो यथाससि"],"अनुष्टुभ्"],["29",4,["अभीवर्तो अभिभवः","सपत्नक्षयणो मणिः","राष्ट्राय मह्यं बध्यतां","सपत्नेभ्यः पराभुवे"],"अनुष्टुभ्"],["29",5,["उदसौ सूर्यो अगादुद्","इदं मामकं वचः","यथाहं शत्रुहोऽसान्य","सपत्नः सपत्नहा"],"अनुष्टुभ्"],["29",6,["सपत्नक्षयणो वृषा","भिरष्ट्रो विषासहिः","यथाहमेषां वीराणां","विराजानि जनस्य च"],"अनुष्टुभ्"],["30",1,["विश्वे देवा वसवो रक्षतेमम्","उतादित्या जागृत यूयमस्मिन्","मेमं सनाभिरुत वान्यनाभिर्","मेमं प्रापत्पौरुषेयो वधो यः"],"त्रिष्टुभ्"],["30",2,["ये वो देवाः पितरो ये च पुत्राः","सचेतसो मे शृणुतेदमुक्तम्","सर्वेभ्यो वः परि ददाम्येतं","स्वस्त्येनं जरसे वहाथ"],""],["30",3,["ये देवा दिवि ष्ठ ये पृथिव्यां ये अन्","तरिक्ष ओषधीषु पशुष्वप्स्वन्तः","ते कृणुत जरसमायुरस्मै","शतमन्यान्परि वृणक्तु मृत्यून्"],"त्रिष्टुभ्"],["30",4,["येषां प्रयाजा उत वानुयाजा","हुतभागा अहुतादश्च देवाः","येषां वः पञ्च प्रदिशो विभक्तास्","तान्वो अस्मै सत्रसदः कृणोमि"],"त्रिष्टुभ्"],["31",1,["आशानामाशापा","लेभ्यश्चतुर्भ्यो अमृतेभ्यः","इदं भूतस्याध्यक्षेभ्यो","विधेम हविषा वयम्"],""],["31",2,["य आशानामाशापालाश्","चत्वार स्थन देवाः","ते नो निरृत्याः पाशेभ्यो","मुञ्चतांहसोअंहसः"],"अनुष्टुभ्"],["31",3,["अस्रामस्त्वा हविषा","यजाम्यश्लोणस्त्वा घृतेन जुहोमि","य आशानामाशापालस्तुरीयो","देवः स नः सुभूतमेह वक्षत्"],""],["31",4,["स्वस्ति मात्र उत पित्रे नो अस्तु","स्वस्ति गोभ्यो जगते पुरुषेभ्यः","विश्वम्सुभूतम्सुविदत्रं नो","अस्तु ज्योगेव दृशेम सूर्यम्"],"त्रिष्टुभ्"],["32",1,["इदं जनासो विदथ","महद्ब्रह्म वदिष्यति","न तत्पृथिव्यां नो दिवि","येन प्राणन्ति वीरुधः"],"अनुष्टुभ्"],["32",2,["अन्तरिक्ष आसां स्था","म श्रान्तसदामिव","आस्थानमस्य भूतस्य","विदुष्टद्वेधसो न वा"],"अनुष्टुभ्"],["32",3,["यद्रोदसी रेजमाने","भूमिश्च निरतक्षतम्","आर्द्रं तदद्य सर्वदा","समुद्रस्येव श्रोत्याः"],"अनुष्टुभ्"],["32",4,["विश्वमन्यामभीवार","तदन्यस्यामधि श्रितम्","दिवे च विश्ववेदसे","पृथिव्यै चाकरं नमः"],"अनुष्टुभ्"],["33",1,["हिरण्यवर्णाः शुचयः पावका","यासु जातः सविता यास्वग्निः","या अग्निं गर्भं दधिरे सुवर्णास्","ता न आपः शं स्योना भवन्तु"],"त्रिष्टुभ्"],["33",2,["यासां राजा वरुणो याति मध्ये","सत्यानृते अवपश्यन्जनानाम्","या अग्निं गर्भं दधिरे सुवर्णास्","ता न आपः शं स्योना भवन्तु"],"त्रिष्टुभ्"],["33",3,["यासां देवा दिवि कृण्वन्ति भक्षं","या अन्तरिक्षे बहुधा भवन्ति","या अग्निं गर्भं दधिरे सुवर्णास्","ता न आपः शं स्योना भवन्तु"],"त्रिष्टुभ्"],["33",4,["शिवेन मा चक्षुषा पश्यतापः शि","वया तन्वोप स्पृशत त्वचं मे","घृतश्चुतः शुचयो याः पावकास्","ता न आपः शं स्योना भवन्तु"],"त्रिष्टुभ्"],["34",1,["इयं वीरुन्मधुजाता","मधुना त्वा खनामसि","मधोरधि प्रजातासि","सा नो मधुमतस्कृधि"],"अनुष्टुभ्"],["34",2,["जिह्वाया अग्रे मधु मे","जिह्वामूले मधूलकम्","ममेदह क्रतावसो","मम चित्तमुपायसि"],"अनुष्टुभ्"],["34",3,["मधुमन्मे निक्रमणं","मधुमन्मे परायणम्","वाचा वदामि मधुमद्","भूयासं मधुसंदृशः"],"अनुष्टुभ्"],["34",4,["मधोरस्मि मधुतरो","मदुघान्मधुमत्तरः","मामित्किल त्वं वनाः शा","खां मधुमतीमिव"],"अनुष्टुभ्"],["34",5,["परि त्वा परितत्नुने","क्षुणागामविद्विषे","यथा मां कमिन्यसो य","था मन्नापगा असः"],"अनुष्टुभ्"],["35",1,["यदाबध्नन्दाक्षायणा हिरण्यं","शतानीकाय सुमनस्यमानाः","तत्ते बद्नाम्यायुषे वर्चसे बला","य दीर्घायुत्वाय शतशारदाय"],"त्रिष्टुभ्"],["35",2,["नैनं रक्षांसि न पिशाचाः सहन्ते","देवानामोजः प्रथमजम्ह्येतत्","यो बिभर्ति दाक्षायणं हिरण्यं","स जीवेषु कृणुते दीर्घमायुः"],"त्रिष्टुभ्"],["35",3,["अपां तेजो ज्योतिरो","जो बलं च वनस्पतीनामुत वीर्याणि","इन्द्र इवेन्द्रियाण्यधि धारयामो अ","स्मिन्तद्दक्षमाणो बिभरद्धिरण्यम्"],""],["35",4,["समानां मासामृतुभिष्ट्वा वयं","संवत्सरस्य पयसा पिपर्मि","इन्द्राग्नी विश्वे दे","वास्तेऽनु मन्यन्तामहृणीयमानाः"],""]]}