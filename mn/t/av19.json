े","सर्वा दिशो अभयास्ते भवन्तु","ध्रुवस्तिष्ठासि सविते","व चार्य इमा विशो अभि हरन्तु ते बलिम्"],""],["45",5,["आक्ष्वैकं मणिमेकं","क्र्णुष्व स्नाह्येकेना पिबैकमेषाम्","चतुर्वीरं नैरृतेभ्यश्चतुर्भ्यो","ग्राह्या बन्धेभ्यः परि पात्वस्मान्"],""],["45",6,["अग्निर्माग्निनावतु","प्राणायापा नायायुषे","वर्चस ओजसे तेज","से स्वस्तये सुभूतये स्वाहा"],""],["45",7,["इन्द्रो मेन्द्रियेणावतु प्राणाया","पानायायुषे वर्चस ओजसे","तेजसे स्वस्तये सुभूतये स्वाहा"],"विराट्"],["45",8,["सोमो मा सौम्येनावतु प्राणाया","पानायायुषे वर्चस ओजसे","तेजसे स्वस्तये सुभूतये स्वाहा"],"विराट्"],["45",9,["भगो म भगेनावतु","प्राणाया पानायायुषे","वर्चस ओजसे तेज","से स्वस्तये सुभूतये स्वाहा"],""],["45",10,["मरुतो मा गणैरवन्","तु प्राणायापा नायुषे","वर्चस ओजसे तेज","से स्वस्तये सुभूतये स्वाहा"],""],["46",1,["प्रजापतिष्ट्वा बध्नात्","प्रथममस्तृतं वीर्याय कम्","तत्ते बध्नाम्यायुषे वर्चस ओजसे","च बलाय चास्तृतस्त्वाभि रक्षतु"],""],["46",2,["ऊर्ध्वस्तिष्ठतु रक्षन्नप्रमादमस्तृ","तेमम्मा त्वा दभन्पणयो यातुधानाः","इन्द्र इव दस्यूनव धूनुष्व पृतन्यतः","सर्वां छत्रून्वि षहस्वास्तृतस्त्वाभि रक्षतु"],""],["46",3,["शतं च न प्रहरन्तो","निघ्नन्तो न तस्तिरे","तस्मिन्निन्द्रः पर्यदत्त चक्षुः प्राणम्","अथो बलमस्तृतस्त्वाभि रक्षतु"],""],["46",4,["इन्द्रस्य त्वा वर्मणा परि धापया","मो यो देवानामधिराजो बभूव","पुनस्त्वा देवाः प्र णयन्तु","सर्वेऽस्तृतस्त्वाभि रक्षतु"],""],["46",5,["अस्मिन्मणावेकशतं वीर्याणि","सहस्रं प्राणा अस्मिन्नस्तृते","व्याघ्रः शत्रूनभि तिष्ठ सर्वान्यस्त्वा पृत","न्यादधरः सो अस्त्वस्तृतस्त्वाभि रक्षतु"],""],["46",6,["घृतादुल्लुप्तो मधुमान्पयस्वान्त्स","हस्रप्राणः शतयोनिर्वयोधाः","शम्भूश्च मयोभूश्चोर्जस्वांश्च प","यस्वांश्चास्तृतस्त्वाभि रक्षतु"],"त्रिष्टुभ्"],["46",7,["यथा त्वमुत्तरोऽसो अ","सपत्नः सपत्नहा सजातानाम्","असद्वशी तथा त्वा स","विता करदस्तृतस्त्वाभि रक्षतु"],""],["47",1,["आ रात्रि पार्थिवं रजः","पितुरप्रायि धामभिः","दिवः सदांसि बृहती वि","तिष्ठस आ त्वेषं वर्तते तमः"],"बृहती"],["47",2,["न यस्याः पारं ददृशे न योयुवद्","विश्वमस्यां नि विशते यदेजति","अरिष्टासस्त उर्वि तमस्वति रात्रि पा","रमशीमहि भद्रे पारमशीम