{"id":"av19","v":[["1",1,["संसं स्रवन्तु नद्यः","सं वाताः सं पतत्रिणः","यज्ञमिमं वर्धयता","गिरः संस्राव्येण हविषा जुहोमि"],"बृहती"],["1",2,["इमं होमा यज्ञमवतेमं संस्रावणा उत यज्ञमिमं वर्धयता गिरः संस्राव्येण हविषा जुहोमि"],""],["1",3,["रूपंरूपं वयोवयः","संरभ्यैनं परि ष्वजे","यज्ञमिमं चतस्रः प्रदिशो वर्ध","यन्तु संस्राव्येण हविषा जुहोमि"],""],["2",1,["शं त आपो हैमव","तीः शमु ते सन्तूत्स्याः","शं ते सनिष्यदा आ","पः शमु ते सन्तु वर्ष्याः"],"अनुष्टुभ्"],["2",2,["शं त आपो धन्वन्याः शं ते सन्त्वनूप्याः","शं ते खनित्रिमा आपः","शं याः कुम्भेभिराभृताः"],"उष्णिक्"],["2",3,["अनभ्रयः खनमाना","विप्रा गम्भीरे अपसः","भिषग्भ्यो भिषक्तरा आ","पो अछा वदामसि"],"अनुष्टुभ्"],["2",4,["अपामह दिव्यानामपां स्रोतस्यानाम्","अपामह प्रणेजने","ऽश्वा भवथ वाजिनः"],"उष्णिक्"],["2",5,["ता अपः शिवा अपो","ऽयक्ष्मंकरणीरपः","यथैव तृप्यते मयस्","तास्त आ दत्त भेसजीः"],"अनुष्टुभ्"],["3",1,["दिवस्पृथिव्याः पर्यन्तरिक्षाद्","वनस्पतिभ्यो अध्योषधीभ्यः","यत्रयत्र विभृतो जातवेदास्","तत स्तुतो जुषमाणो न एहि"],"त्रिष्टुभ्"],["3",2,["यस्ते अप्सु महिमा यो वनेषु","य ओषधीषु पशुष्वप्स्वन्तः","अग्ने सर्वास्तन्वः सं रभस्व ता","भिर्न एहि द्रविणोदा अजस्रः"],"त्रिष्टुभ्"],["3",3,["यस्ते देवेषु महिमा स्वर्गो","या ते तनुः पितृष्वाविवेश","पुष्टिर्या ते मनुष्येषु पप्रथे","ऽग्ने तया रयिमस्मासु धेहि"],"त्रिष्टुभ्"],["3",4,["श्रुत्कर्णाय कवये वेद्याय व","चोभिर्वाकैरुप यामि रातिम्","यतो भयमभयं तन्नो अस्त्व","व देवानां यज हेडो अग्ने"],"त्रिष्टुभ्"],["4",1,["यामाहुतिं प्रथमामथर्वा या जा","ता या हव्यमकृणोज्जातवेदाः","तां त एतां प्रथमो जोहवीमि ताभिष्टुप्","तो वहतु हव्यमग्निरग्नये स्वाह"],""],["4",2,["आकूतिं देवीं सुभगां पुरो दधे","चित्तस्य माता सुहवा नो अस्तु","यामाशामेमि केवली सा मे अस्तु","विदेयमेनां मनसि प्रविष्टाम्"],"त्रिष्टुभ्"],["4",3,["आकूत्या नो बृहस्पत","आकूत्या न उपा गहि","अथो भगस्य नो धेह्य","थो नः सुहवो भव"],"अनुष्टुभ्"],["4",4,["बृहस्पतिर्म आकूतिम्","आङ्गिरसः प्रति जानातु वाचमेताम्","यस्य देवा देवताः संबभूवुः","स सुप्रणीताः कामो अन्वेत्वस्मान्"],""],["5",1,["इन्द्रो राजा जगतश्चर्षणीनाम्","अधि क्षमि विषुरूपं यदस्ति","ततो ददाति दाशुषे वसूनि","चोदद्राध उपस्तुतश्चिदर्वाक्"],"त्रिष्टुभ्"],["6",1,["सहस्रबाहुः पुरुषः","सहस्राक्षः सहस्रपात्","स भूमिं विश्वतो वृत्वात्य्","अतिष्ठद्दशाङ्गुलम्"],"अनुष्टुभ्"],["6",2,["त्रिभिः पद्भिर्द्यामरोहत्","पादस्येहाभवत्पुनः","तथा व्यक्रामद्विष्वङ","शनानशने अनु"],"अनुष्टुभ्"],["6",3,["तावन्तो अस्य महिमानस्","ततो ज्यायांश्च पूरुषः","पादोऽस्य विश्वा भूतानि","त्रिपादस्यामृतं दिवि"],"अनुष्टुभ्"],["6",4,["पुरुष एवेदं सर्वं","यद्भूतं यच्च भाव्यम्","उतामृतत्वस्येश्वरो","यदन्येनाभवत्सह"],"अनुष्टुभ्"],["6",5,["यत्पुरुषं व्यदधुः","कतिधा व्यकल्पयन्","मुखं किमस्य किम्बाहू","किमूरू पादा उच्यते"],"अनुष्टुभ्"],["6",6,["ब्राह्मणोऽस्य मुखमासीद्","बाहू राजन्योऽभवत्","मध्यं तदस्य यद्वैश्यः","पद्भ्यां शूद्रो अजायत"],"अनुष्टुभ्"],["6",7,["चन्द्रमा मनसो जातश्","चक्षोः सूर्यो अजायत","मुखादिन्द्रश्चाग्निश्च प्रा","णाद्वायुरजायत"],"अनुष्टुभ्"],["6",8,["नाभ्या आसीदन्तरिक्षं","शीर्ष्णो द्यौः समवर्तत","पद्भ्यां भूमिर्दिशः श्रोत्रात्","तथा लोकां अकल्पयन्"],"अनुष्टुभ्"],["6",9,["विराडग्रे समभवद्","विराजो अधि पूरुषः","स जातो अत्यरिच्यत","पश्चाद्भूमिमथो पुरः"],"अनुष्टुभ्"],["6",10,["यत्पुरुषेण हविषा","देवा यज्ञमतन्वत","वसन्तो अस्यासीदाज्यं","ग्रीष्म इध्मः शरद्धविः"],"अनुष्टुभ्"],["6",11,["तं यज्ञं प्रावृषा प्रौक्षन्","पुरुषं जातमग्रशः","तेन देवा अयजन्त","साध्या वसवश्च ये"],"अनुष्टुभ्"],["6",12,["तस्मादश्वा अजायन्त","ये च के चोभयादतः","गावो ह जज्ञिरे तस्मात्","तस्माज्जाता अजावयः"],"अनुष्टुभ्"],["6",13,["तस्माद्यज्ञात्सर्वहुत","ऋचः सामानि जज्ञिरे","छन्दो ह जज्ञिरे तस्माद्","यजुस्तस्मादजायत"],"अनुष्टुभ्"],["6",14,["तस्माद्यज्ञात्सर्वहुतः","संभृतं पृषदाज्यम्","पशूंस्तांश्चक्रे वायव्यान्","आरण्या ग्राम्याश्च ये"],"अनुष्टुभ्"],["6",15,["सप्तास्यासन्परिधयस्","त्रिः सप्त समिधः कृताः","देवा यद्यज्ञं तन्वाना","अबध्नन्पुरुषं पशुम्"],"अनुष्टुभ्"],["6",16,["मूर्ध्नो देवस्य बृहतो","अंशवः सप्त सप्ततीः","राज्ञः सोमस्याजायन्त","जातस्य पुरुषादधि"],"अनुष्टुभ्"],["7",1,["चित्राणि साकं दिवि रोचनानि","सरीसृपाणि भुवने जवानि","तुर्मिशं सुमतिमिछमा","नो अहानि गीर्भिः सपर्यामि नाकम्"],""],["7",2,["सुहवमग्ने कृत्तिका रोहिणी","चास्तु भद्रं मृगशिरः शमार्द्रा","पुनर्वसू सूनृता चारु पुष्यो","भानुराश्लेषा अयनं मघा मे"],"त्रिष्टुभ्"],["7",3,["पुण्यं पूर्वा फल्गुन्यौ चात्र हस्तश्","चित्रा शिवा स्वाति सुखो मे अस्तु","राधे विशाखे सुहवानुराधा","ज्येष्ठा सुनक्षत्रमरिष्ट मूलम्"],"त्रिष्टुभ्"],["7",4,["अन्नं पूर्वा रासतां मे अषाधा","ऊर्जं देव्युत्तरा आ वहन्तु","अभिजिन्मे रासतां पुण्यमेव श्र","वणः श्रविष्ठाः कुर्वतां सुपुष्टिम्"],"त्रिष्टुभ्"],["7",5,["आ मे महच्छतभिषग्वरीय","आ मे द्वया प्रोष्ठपदा सुशर्म","आ रेवती चाश्वयुजौ भगं म","आ मे रयिं भरण्य आ वहन्तु"],"त्रिष्टुभ्"],["8",1,["यानि नक्षत्राणि दिव्यन्तरिक्षे","अप्सु भूमौ यानि नगेषु दिक्षु","प्रकल्पयंश्चन्द्रमा यान्येति सर्","वाणि ममैतानि शिवानि सन्तु"],"त्रिष्टुभ्"],["8",2,["अष्टाविंशानि शिवा","नि शग्मानि सह योगं भजन्तु मे","योगं प्र पद्ये क्षेमं च क्षेमं प्र प","द्ये योगं च नमोऽहोरात्राभ्यामस्तु"],""],["8",3,["स्वस्तितं मे सुप्रातः सुसायं सुदि","वं सुमृगं सुशकुनं मे अस्तु","सुहवमग्ने स्वस्त्यमर्","त्यं गत्वा पुनरायाभिनन्दन्"],""],["8",4,["अनुहवं परिहवं","परिवादं परिक्षवम्","सर्वैर्मे रिक्तकुम्भान्प","रा तान्त्सवितः सुव"],"अनुष्टुभ्"],["8",5,["अपपापं परिक्षवं","पुण्यं भक्षीमहि क्षवम्","शिवा ते पाप नासिकां","पुण्यगश्चाभि मेहताम्"],"अनुष्टुभ्"],["8",6,["इमा या ब्रह्मणस्पते","विषुचीर्वात ईरते","सध्रीचीरिन्द्र ताः कृत्वा","मह्यं शिवतमास्कृधि"],"अनुष्टुभ्"],["8",7,["स्वस्ति नो अस्त्वभयं नो अ","स्तु नमोऽहोरत्राभ्यामस्तु"],"द्विपदा"],["9",1,["शान्ता द्यौः शान्ता पृथि वी","शान्तमिदमुर्वन्तरि","क्षम्शान्ता उदन्वतीरा","पः शान्ता नः सन्त्वोषधीः"],"अनुष्टुभ्"],["9",2,["शान्तानि पूर्वरूपा","णि शान्तं नो अस्तु कृताकृतम्","शान्तं भूतं च भव्यं च","सर्वमेव शमस्तु नः"],""],["9",3,["इयं या परमेष्ठिनी","वाग्देवी ब्रह्मसंशिता","ययैव ससृजे घोरं","तयैव शान्तिरस्तु नः"],"अनुष्टुभ्"],["9",4,["इदं यत्परमेष्ठिनं","मनो वां ब्रह्मसंशितम्","येनैव ससृजे घोरं","तेनैव शान्तिरस्तु नः"],"अनुष्टुभ्"],["9",5,["इमानि यानि पञ्चेन्द्रियानि मनःष","ष्ठानि मे हृदि ब्रह्मणा संशितानि","यैरेव ससृजे घोरं","तैरेव शान्तिरस्तु नः"],""],["9",6,["शं नो मित्रः शं वरुणः","शं विष्णुः शं प्रजापतिः","शं न इन्द्रो बृहस्पतिः","शं नो भवत्वर्यमा"],"अनुष्टुभ्"],["9",7,["शं नो मित्रः शं वरुणः","शं विवस्वां छमन्तकः","उत्पाताः पार्थिवान्त","रिक्षाः शं नो दिविचरा ग्रहाः"],""],["9",8,["शं नो भूमिर्वेप्यमाना","शमुल्का निर्हतं च यत्","शं गावो लोहितक्षीराः","शं भूमिरव तीर्यतीः"],"अनुष्टुभ्"],["9",9,["नक्षत्रमुल्काभिहतं शमस्तु नः","शं नोऽभिचाराः शमु सन्तु कृत्याः","शं नो निखाता वल्गाः शमुल्का दे","शोपसर्गाः शमु नो भवन्तु"],"त्रिष्टुभ्"],["9",10,["शं नो ग्रहाश्चान्द्रमसाः","शमादित्यश्च राहुणा","शं नो मृत्युर्धूमकेतुः","शं रुद्रास्तिग्मतेजसः"],"अनुष्टुभ्"],["9",11,["शं रुद्राः शं वसवः","शमादित्याः शमग्नयः","शं नो महर्षयो देवाः","शं देवाः शं बृहस्पतिः"],"अनुष्टुभ्"],["9",12,["ब्रह्म प्रजापतिर्धा","ता लोका वेदाः सप्तऋषयोऽग्नयः","तैर्मे कृतं स्वस्त्ययनमिन्द्रो मे शर्","म यछतु ब्रह्मा मे शर्म यछतु","विश्वे मे देवाः शर्म यछन्तु","सर्वे मे देवाः शर्म यछन्तु"],""],["9",13,["यानि कानि चिच्छान्ता","नि लोके सप्तऋषयो विदुः","सर्वाणि शं भवन्तु मे शं","मे अस्त्वभयं मे अस्तु"],""],["9",14,["पृथिवी शान्तिरन्तरिक्षं शान्तिर्द्यौः शान्तिरापः शान्तिरोषधयः शान्तिर्वनस्पतयः शान्तिर्विश्वे मे देवाः शान्तिः सर्वे मे देवाः शान्तिः शान्तिः शान्तिः शान्तिभिः","यदिह घोरं यदिह क्रूरं यदिह पापं तच्छान्तं तच्छिवं सर्वमेव शमस्तु नः"],""],["10",1,["शं न इन्द्राग्नी भवतामवोभिः","शं न इन्द्रावरुणा रातहव्या","शमिन्द्रासोमा सुविताय शं योः","शं न इन्द्रापूषणा वाजसातौ"],"त्रिष्टुभ्"],["10",2,["शं नो भगः शमु नः शंसो अस्तु","शं नः पुरंधिः शमु सन्तु रायः","शं नः सत्यस्य सुयमस्य शंसः","शं नो अर्यमा पुरुजातो अस्तु"],"त्रिष्टुभ्"],["10",3,["शं नो धाता शमु धर्ता नो अस्तु","शं न उरूची भवतु स्वधाभिः","शं रोदसी बृहती शं नो अद्रिः","शं नो देवानां सुहवानि सन्तु"],"त्रिष्टुभ्"],["10",4,["शं नो अग्निर्ज्योतिरनीको अस्तु","शं नो मित्रावरुणावश्विना शम्","शं नः सुकृतां सुकृतानि सन्तु","शं न इषिरो अभि वातु वातः"],"त्रिष्टुभ्"],["10",5,["शं नो द्यावापृथिवी पूर्वहूतौ","शमन्तरिक्षं दृशये नो अस्तु","शं न ओषधीर्वनिनो","भवन्तु शं नो रजसस्पतिरस्तु जिष्णुः"],""],["10",6,["शं न इन्द्रो वसुभिर्देवो अस्तु","शमादित्येभिर्वरुणः सुशंसः","शं