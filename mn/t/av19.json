ुष्टुभ्"],["52",4,["कामेन मा काम आगन्","हृदयाद्धृदयं परि","यदमीषामदो मनस्","तदैतूप मामिह"],"अनुष्टुभ्"],["52",5,["यत्काम कामयमाना","इदं कृण्मसि ते हविः","तन्नः सर्वं समृध्य","तामथैतस्य हविषो वीहि स्वाहा"],"बृहती"],["53",1,["कालो अश्वो वहति सप्तरश्मिः","सहस्राक्षो अजरो भूरिरेताः","तमा रोहन्ति कवयो विपश्चि","तस्तस्य चक्रा भुवनानि विश्वा"],"त्रिष्टुभ्"],["53",2,["सप्त चक्रान्वहति का","ल एष सप्तास्य नाभीरमृतं न्वक्षः","स इमा विश्वा भुवनान्यञ्जत्का","लः स ईयते प्रथमो नु देवः"],""],["53",3,["पूर्णः कुम्भोऽधि काल आहितस्तं","वै पश्यामो बहुधा नु सन्तम्","स इमा विश्वा भुवनानि प्रत्यङ्","कालं तमाहुः परमे व्योमन्"],"त्रिष्टुभ्"],["53",4,["स एव सं भुवनान्या","भरत्स एव सं भुवनानि पर्यैत्","पिता सन्नभवत्पुत्र एषां त","स्माद्वै नान्यत्परमस्ति तेजः"],""],["53",5,["कालोऽमूं दिवमजनयत्","काल इमाः पृथिवीरुत","काले ह भूतं भव्यं चे","षितं ह वि तिष्ठते"],"अनुष्टुभ्"],["53",6,["कालो भूतिमसृजत","काले तपति सूर्यः","काले ह विश्वा भूतानि","काले चक्षुर्वि पश्यति"],"अनुष्टुभ्"],["53",7,["काले मनः काले प्राणः","काले नाम समाहितम्","कालेन सर्वा नन्दन्त्या","गतेन प्रजा इमाः"],"अनुष्टुभ्"],["53",8,["काले तपः काले ज्येष्ठम्","काले ब्रह्म समाहितम्","कालो ह सर्वस्येश्वरो","यः पितासीत्प्रजापतेः"],"अनुष्टुभ्"],["53",9,["तेनेषितं तेन जातं","तदु तस्मिन्प्रतिष्ठितम्","कालो ह ब्रह्म भूत्वा बि","भर्ति परमेष्ठिनम्"],"अनुष्टुभ्"],["53",10,["कालः प्रजा असृजत","कालो अग्रे प्रजापतिम्","स्वयंभूः कश्यपः कालात्","तपः कालादजायत"],"अनुष्टुभ्"],["54",1,["कालादापः समभवन्","कालाद्ब्रह्म तपो दिशः","कालेनोदेति सूर्यः का","ले नि विशते पुनः"],"अनुष्टुभ्"],["54",2,["कालेन वातः पवते","कालेन पृथिवी मही","द्यौर्मही काल आहिता"],"गायत्री"],["54",3,["कालो ह भूतं भव्यं च","पुत्रो अजनयत्पुरा","कालादृचः समभवन्","यजुः कालादजायत"],"अनुष्टुभ्"],["54",4,["कालो यज्ञं समैरयद्","देवेभ्यो भागमक्षितम्","काले गन्धर्वाप्सरसः","काले लोकाः प्रतिष्ठिताः"],"अनुष्टुभ्"],["54",5,["कालेऽयमङ्गिरा दे","वोऽथर्वा चाधि तिष्ठतः","इमं च लोकं परमं च लोकं","पुण्यांश्च लोकान्विधृतीश्च पुण्याः","सर्वांल्लोकानभिजित्य ब्रह्मणा का","लः स ईयते परमो नु देवः"],""],["55",1,["रात्रिंरात्रिमप्रयातं भरन्तो","ऽश्वायेव तिष्ठते घासमस्मै","रायस्पोषेण समिषा मदन्तो","मा ते अग्ने प्रतिवेशा रिषाम"],"त्रिष्टुभ्"],["55",2,["या ते वसोर्वात इषुः सा","त एषा तया नो मृड","रायस्पोषेण समिषा मदन्तो","मा ते अग्ने प्रतिवेशा रिषाम"],""],["55",3,["सायंसायं गृहपतिर्नो अग्निः","प्रातःप्रातः सौमनसस्य दाता","वसोर्वसोर्वसुदान एधि","वयं त्वेन्धानास्तन्वं पुषेम"],"त्रिष्टुभ्"],["55",4,["प्रातःप्रातर्गृहपतिर्नो अग्निः","सायंसायं सौमनसस्य दाता","वसोर्वसोर्वसुदान एधीन्","धानास्त्वा शतंहिमा ऋधेम"],"त्रिष्टुभ्"],["55",5,["अन्नादायान्नपतये","रुद्राय नमो अग्नये","सभ्यः सभां मे पाहि","ये च सभ्याः सभासदः"],"अनुष्टुभ्"],["55",6,["त्वामिन्द्रा पुरुहूत","विश्वमायुर्व्यश्नवन्","अहरहर्बलिमित्ते ह","रन्तोऽश्वायेव तिष्ठते घासमग्ने"],"बृहती"],["56",1,["यमस्य लोकादध्या बभूविथ","प्रमदा मर्त्यान्प्र युनक्षि धीरः","एकाकिना सरथं यासि विद्वान्त्","स्वप्नं मिमानो असुरस्य योनौ"],"त्रिष्टुभ्"],["56",2,["बन्धस्त्वाग्रे विश्वचया अपश्यत्","पुरा रात्र्या जनितोरेके अह्नि","ततः स्वप्नेदमध्या बभूविथ","भिषग्भ्यो रूपमपगूहमानः"],"त्रिष्टुभ्"],["56",3,["बृहद्गावासुरेभ्यो","ऽधि देवानुपावर्तत महिमानमिछन्","तस्मै स्वप्नाय दधुराधिपत्यं","त्रयस्त्रिंशासः स्वरानशानाः"],""],["56",4,["नैतां विदुः पितरो नोत देवा","येषां जल्पिश्चरत्यन्तरेदम्","त्रिते स्वप्नमदधुराप्त्ये नर","आदित्यासो वरुणेनानुशिष्टाः"],"त्रिष्टुभ्"],["56",5,["यस्य क्रूरमभजन्त","दुष्कृतोऽस्वप्नेन सुकृतः पुण्यमायुः","स्वर्मदसि परमेण बन्","धुना तप्यमानस्य मनसोऽधि जज्ञिषे"],""],["56",6,["विद्म ते सर्वाः परिजाः पुरस्ताद्","विद्म स्वप्न यो अधिपा इहा ते","यशश्विनो नो यशसे","ह पाह्याराद्द्विषेभिरप याहि दूरम्"],""],["57",1,["यथा कलां यथा शफं","यथा र्णं सम्नयन्ति","एवा दुष्वप्न्यं सर्","वमप्रिये सं नयामसि"],""],["57",2,["सं राजानो अगुः समृणाम्यगुः","सं कुष्ठा अगुः सं कला अगुः","समस्मासु यद्दुष्व","प्न्यं निर्द्विषते दुष्वप्न्यं सुवाम"],""],["57",3,["देवानां पत्नीनां","गर्भ यमस्य कर यो भद्रः स्वप्न","स मम यः पापस्तद्द्विषते प्र हिण्मः","मा तृष्टानामसि कृष्णशकुनेर्मुखम्"],""],["57",4,["तं त्वा स्वप्न तथा सं विद्म स त्वं स्वप्ना","श्व इव कायमश्व इव नीनाहम्","अनास्माकं देवपीयुं पियारुं वप यद्","अस्मासु दुष्वप्न्यं यद्गोषु यच्च नो गृहे"],""],["57",5,["अनास्माकस्तद्देवपीयुः पिया","रुर्निष्कमिव प्रति मुञ्चताम्","नवारत्नीनपमया","अस्माकं ततः परि","दुष्वप्न्यं सर्वं द्विषते निर्दयामसि"],""],["58",1,["घृतस्य जूतिः समना सदेवा","संवत्सरं हविषा वर्धयन्ती","श्रोत्रं चक्षुः प्राणोऽछिन्नो नो अस्त्व","छिन्ना वयमायुषो वर्चसः"],"त्रिष्टुभ्"],["58",2,["उपास्मान्प्राणो ह्वयताम्","उप प्राणं हवामहे","वर्चो जग्राह पृथिव्यन्तरिक्षं","वर्चः सोमो बृहस्पतिर्विधत्ता"],""],["58",3,["वर्चसो द्यावापृथिवी संग्रहणी बभूव","थुर्वर्चो गृहीत्वा पृथिवीमनु सं चरेम","यशसम्गावो गोपतिमुप तिष्ठन्त्यायतीर्","यशो गृहीत्वा पृथिवीमनु सं चरेम"],""],["58",4,["व्रजं कृणुध्वं स हि वो नृपाणो","वर्मा सीव्यध्वं बहुला पृथूनि","पुरः कृणुध्वमायसीरधृष्टा","मा वः सुस्रोच्चमसो दृंहत तम्"],"त्रिष्टुभ्"],["58",5,["यज्ञस्य चक्षुः प्रभृतिर्मुखं च","वाचा श्रोत्रेण मनसा जुहोमि","इमं यज्ञं विततं विश्वकर्म","णा देवा यन्तु सुमनस्यमानाः"],"त्रिष्टुभ्"],["58",6,["ये देवानामृत्विजो ये च यज्ञिया","येभ्यो हव्यं क्रियते भागधेयम्","इमं यज्ञं सह पत्नीभिरेत्य या","वन्तो देवास्तविषा मादयन्ताम्"],"त्रिष्टुभ्"],["59",1,["त्वमग्ने व्रतपा अ","सि देव आ मर्त्येष्वा","त्वं यज्ञेष्वीड्यः"],""],["59",2,["यद्वो वयं प्रमिनाम व्रतानि","विदुषां देवा अविदुष्टरासः","अग्निष्टद्विश्वादा पृणातु विद्वान्त्","सोमस्य यो ब्राह्मणां आविवेश"],"त्रिष्टुभ्"],["59",3,["आ देवानामपि पन्थामगन्म","यच्छक्नवाम तदनुप्रवोढुम्","अग्निर्विद्वान्त्स यजात्स इद्धोता","सोऽध्वरान्त्स ऋतून्कल्पयाति"],"त्रिष्टुभ्"],["60",1,["वाङ्म आसन्नसोः प्रा","णश्चक्षुरक्ष्णोः श्रोत्रं कर्णयोः","अपलिताः केशा अशो","णा दन्ता बहु बाह्वोर्बलम्"],""],["60",2,["ऊर्वोरोजो जङ्घयोर्जवः पादयोः","प्रतिष्ठा अरिष्टानि","मे सर्वात्मानिभृष्टः"],"उष्णिक्"],["61",1,["तनूस्तन्वा मे सहे द","तः सर्वमायुरशीय","स्योनं मे सीद पुरुः पृ","णस्व पवमानः स्वर्गे"],"अनुष्टुभ्"],["62",1,["प्रियं मा कृणु देवेषु","प्रियं राजसु मा कृणु","प्रियं सर्वस्य पश्यत","उत शूद्र उतार्ये"],"अनुष्टुभ्"],["63",1,["उत्तिष्ठ ब्रह्मणस्प","ते देवान्यज्ञेन बोधय","आयुः प्राणं प्रजां प","शून्कीर्तिं यजमा