{"id":"sv3","v":[["0.0",641,["विदा मघवन्विदा गा","तुमनुशंसिषो दिशः","शिक्षा शचीनां पते","पूर्वीणां पुरूवसो"],"अनुष्टुभ्"],["0.0",642,["आभिष्ट्वमभिष्टिभिः स्वाऽर्न्नांशुः","प्रचेतन प्रचेतयेन्","द्र द्युम्नाय न इषे"],""],["0.0",643,["एवा हि शक्रो राये वाजाय वज्रिवः","शविष्ठ वज्रिन्नृञ्जसे","मंहिष्ठ वज्रिन्नृञ्जस","आ याहि पिब मत्स्व"],"बृहती"],["0.0",644,["विदा राये सुवीर्यं","भवो वाजानां पतिर्वशां अनु","मंहिष्ठ वज्रिन्नृञ्ज","से यः शविष्ठः शूराणाम्"],""],["0.0",645,["यो मंहिष्ठो मघोनाम्ंशुर्न्न शोचिः","चिकित्वो अभि नो नयें","द्रो विदे तमु स्तुहि"],"उष्णिक्"],["0.0",646,["ईशे हि शक्रस्तमू","तये हवामहे जेतारम","पराजितम्स नः स्वर्ष","दति द्विषः क्रतुश्छन्द ऋतं बृहत्"],""],["0.0",647,["इन्द्रं धनस्य सातये हवा","महे जेतारमपराजितम्","स नः स्वर्षदति द्विषः","स नः स्वर्षदति द्विषः"],""],["0.0",648,["पूर्वस्य यत्ते अद्रिवोंऽशुर्मदाय","सुम्न आ धेहि नो वसो","पूर्तिः शविष्ठ शस्यते","वशी हि शक्रो नूनं तन्नव्यं संन्यसे"],""],["0.0",649,["प्रभो जनस्य वृत्रहन्त्","समर्येषु ब्रवावहै","शूरो यो गोषु गच्छति","सखा सुशेवो अद्वयुः"],"अनुष्टुभ्"],["0.0",650,["एवाह्योऽऽऽवा एवा ह्यग्ने एवाहीन्द्र","एवा हि पूषनेवा","हि देवाः ॐ एवाहि देवाः"],""]]}