[["ततः सर्गेषु लोकेषु","katha","2.3",4,2],["ततो मया नाचिकेतश्चितोऽग्निरनित्यैर्द्रव्यैः प्राप्तवानस्मि नित्यम्","katha","1.2",10,1],["तत्त्वभावः प्रसीदति","katha","2.3",13,3],["तत्त्वभावेन चोभयोः","katha","2.3",13,1],["तथारसं नित्यमगन्धवच्च यत्","katha","1.3",15,1],["तदानन्त्याय कल्पत इति","katha","1.3",17,3],["तदानन्त्याय कल्पते","katha","1.3",17,2],["तदेतदिति मन्यन्ते","katha","2.2",14,0],["तद्विष्णोः परमं पदम्","katha","1.3",9,3],["तं दुर्दर्शं गूढमनुप्रविष्टं गुहाहितं गह्वरेष्ठं पुराणम्","katha","1.2",12,0],["तमक्रतुः पश्यति वीतशोको धातुप्रसादान्महिमानमात्मनः","katha","1.2",20,1],["तमब्रवीत्प्रीयमाणो महात्मा वरं तवेहाद्य ददामि भूयः","katha","1.1",16,0],["तमात्मस्थं येऽनुपश्यन्ति धीरास्तेषं शान्तिः शाश्वती नेतरेषाम्","katha","2.2",13,1],["तमात्मस्थं येऽनुपश्यन्ति धीरास्तेषां सुखं शाश्वतं नेतरेषाम्","katha","2.2",12,1],["तमेव भान्तमनु भाति सर्वं तस्य भासा सर्वमिदं विभाति","katha","2.2",15,1],["तं विद्याच्छुक्रममृतं तं विद्याच्छुक्रममृतमिति","katha","2.3",17,2],["तं स्वाच्छरीरात्प्रवृहेन्मुञ्जादिवेषीकां धैर्येण","katha","2.3",17,1],["तं ह कुमारं सन्तं दक्षिणासु नीयमानासु श्रद्धाविवेश","katha","1.1",2,0],["तं होवाच मृत्यवे त्वा ददामीति","katha","1.1",4,2],["तयोर्ध्वमायन्नमृतत्वमेति विष्वङ्ङन्या उत्क्रमणे भवति","katha","2.3",16,1],["तयोः श्रेय आददानस्य साधु भवति हीयतेऽर्थाद्य उ प्रेयो वृणीते","katha","1.2",1,1],["तवैव नाम्ना भवितायमग्निः सृङ्कां चेमामनेकरूपां गृहाण","katha","1.1",16,1],["तस्य ह नचिकेता नाम पुत्र आस","katha","1.1",1,1],["तस्येन्द्रियाणि वश्यानि","katha","1.3",6,2],["तस्येन्द्रियाण्यवश्यानि","katha","1.3",5,2],["तस्यैतां शान्तिं कुर्वन्ति","katha","1.1",7,2],["तानेवानु विधावति","katha","2.1",14,3],["तान्स गच्छति ता ददत्","katha","1.1",3,3],["तामाहुः परमां गतिम्","katha","2.3",10,3],["तां योगमिति मन्यन्ते","katha","2.3",11,0],["ति युक्तेन मनसा सदा","katha","1.3",6,1],["ति योगो हि प्रभवाप्ययौ","katha","2.3",11,3],["ति समनस्कः सदा शुचिः","katha","1.3",8,1],["तिस्रो रात्रीर्यदवत्सीर्गृहे मे अनश्नन्ब्रह्मन्नतिथिर्नमस्यः","katha","1.1",9,0],["ते सस्यमिवाजायत