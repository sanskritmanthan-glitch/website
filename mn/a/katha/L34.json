[["पञ्चाग्नयो ये च त्रिणाचिकेताः","katha","1.3",1,3],["पराचः कामाननुयन्ति बालास्ते मृत्योर्यन्ति विततस्य पाशम्","katha","2.1",2,0],["पराञ्चि खानि व्यतृणत्स्वयंभूस्तस्मात्पराङ्पश्यति नान्तरात्मन्","katha","2.1",1,0],["पर्वतेषु विधावति","katha","2.1",14,1],["पीतोदका जग्धतृणा","katha","1.1",3,0],["पुरुशान्न परं किंचित्","katha","1.3",11,2],["पृथगुत्पद्यमानानां","katha","2.3",6,2],["प्रज्ञानेनैनमाप्नुयात्","katha","1.2",24,3],["प्रतिपश्य तथापरे","katha","1.1",6,1],["प्र ते ब्रवीमि तदु मे निबोध स्वर्ग्यमग्निं नचिकेतः प्रजानन्","katha","1.1",14,0],["प्रयतः श्राद्धकाले वा","katha","1.3",17,1],["प्राक्शरीरस्य विस्रसः","katha","2.3",4,1],["प्राप्तुं शक्यो न चक्षुषा","katha","2.3",12,1]]