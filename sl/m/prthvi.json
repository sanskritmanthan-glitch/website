्यपूजाविधिं","narayaniya",85,7],["ततः सपदि चेदिपो मुनिनृपेषु तिष्ठत्स्वहो","narayaniya",85,8],["निवार्य निजपक्षगानभिमुखस्य विद्वेषिणस्-","narayaniya",85,9],["ततः सुमाहितो त्वया क्रतुवरे निरूढे जनो","narayaniya",85,10],["तदा हसितमुत्थितं द्रुपदन्दनाभीमयो-","narayaniya",85,11],["भृगुं किल सरस्वतीनिकटवासिनस्तापसा-","narayaniya",89,7],["विलोक्य सलिलोच्चयानधिसमुद्रमभ्रंलिहान्","bhattikavya",7,108],["किलैकचुलुकेन यो मुनिरपारमब्धिं पपौ","bhallatashataka",1,88],["प्रसह्य मणिमुद्धरेन्मकरवक्त्रदंष्ट्रान्तरात्","shatakatraya",1,4],["शशी दिवसधूसरो गलितयौवना कामिनी","shatakatraya",1,56],["इतः स्वपिति केशवः कुलमितस्तदीयद्विषाम्","shatakatraya",1,77],["गले कलितकालिम प्रकटितेन्दु भालस्थले","shivastuti",1,1],["वृषोपरिपरिस्फुरद्धवलधाम धामश्रिया","shivastuti",1,2],["उदित्वरविलोचनत्रयविसृत्वरज्योतिषा","shivastuti",1,3],["विहाय कमलालयाविलसितानि विद्युन्नटी","shivastuti",1,4],["भवद्भवनदेहलीविकटातुण्डदण्डाहति","shivastuti",1,5],["त्वदर्चनपरायणप्रमथकन्यकालुण्ठित","shivastuti",1,6],["न जातु हर यातु मे विषयदुर्विलासं मनो","shivastuti",1,7],["विभूषणसुरापगाशुचितरालवालावली","shivastuti",1,8],["बहिर्विषयसंगतिप्रतिनिवर्तिताक्षावलेः","shivastuti",1,9],["त्वदीयसुरवाहिनीविमलवारिधारावलज्","shivastuti",1,10],["दधद्भिरभितस्तटौ विकचवारिजाम्बूनदैर्","shishupalavadha",4,66]]