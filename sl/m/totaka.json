[["अथ वारिणि घोरतरं फणिनं","narayaniya",55,1],["अथ दिक्षु विदिक्षु परिक्षुभित","narayaniya",55,4],["फणशृङ्गसहस्रविनिःसृमर","narayaniya",55,5],["ज्वलदक्षिपरिक्षरदुग्रविष","narayaniya",55,6],["अविलोक्य भवन्तमथाकुलिते","narayaniya",55,7],["अखिलेषु विभो! भवदीयदशा","narayaniya",55,8],["अधिरुह्य ततः फणिराजफणान्","narayaniya",55,9],["जहृषुः पशुपास्तुतुषुर्मुनयो","narayaniya",55,10],["सरसां सरसां परिमुच्य तनुं","bhattikavya",10,4],["न च कांचन काञ्चनसद्मचितिं","bhattikavya",10,5],["न गजा नगजा दयिता दयिता,","bhattikavya",10,9],["स तथेति विनेतुरुदारमतेः","raghuvamsha",8,91],["वपुरम्बुविहारमिहं शुचिना","shishupalavadha",6,71]]