[["क्षिप्तो हस्तावलग्नः प्रसभमभिहतोऽप्याददानोंशुकान्तं","amarushataka",1,2],["नीत्वोच्चैर्विक्षिपन्तः कृततुहिनकणासारसङ्गान्परागान्","amarushataka",1,54],["श्रुत्वा तन्व्या निशीथे नवघनरसितं विश्लथाङ्कं पतित्वा","amarushataka",1,55],["श्रुत्वा नामापि यस्य स्फुटघनपुलकं जायतेऽङ्गं समन्तात्","amarushataka",1,57],["चक्षुःप्रीतिप्रसक्ते मनसि परिचये चिन्त्यमानाभ्युपाये","amarushataka",1,103],["सानन्दं नन्दसूनुर्दिशतु मितपरं संमदं मन्दमन्दं","gitagovinda",11,34],["व्यालोलः केशपाशस्तरलितमलकैः स्वेदमोक्षौ कपोलौ","gitagovinda",12,14],["साध्वी माध्वीक चिन्ता न भवति भवतः शर्करे कर्कशासि","gitagovinda",12,31],["कन्दर्पस्य त्रिलोकीहठविजयमहासाहसोत्साहहेतुर्","navasahasankacarita",15,74],["सान्द्रानन्दावबोधात्मकमनुपमितं कालदेशावधिभ्यां","narayaniya",1,1],["एवं दुर्लभ्यवस्तुन्यपि सुलभतया हस्तलब्धे यदन्यत्","narayaniya",1,2],["सत्त्वं यत्तत्पुराभ्यामपरिकलनतो मिर्मलं तेन तावद्","narayaniya",1,3],["निष्कम्पे नित्यपूर्णे निरवधि परमानन्दपीयूषरूपे","narayaniya",1,4],["निर्व्यापारोऽपि निष्कारणमज! भजसे यत्क्रियामीक्षणाख्यां","narayaniya",1,5],["तत्ते प्रत्यग्रधाराधरललितकलायावलीकेलिकारं","narayaniya",1,6],["कष्ता ते सृष्टिचेष्टा बहुतरभवखेदावहा जीवभाजा","narayaniya",1,7],["नम्राणां सन्निधत्ते सततमपि पुरस्तैरनभ्यार्थितान","narayaniya",1,8],["एश्वर्यं शङ्करादीश्वरविनियमनं विश्वतेजोहराणां","narayaniya",1,10],["गीर्वाणैरर्थ्यमानो दशमुखनिधनं कोसलेष्वृश्यशृङ्गे","narayaniya",34,1],["कोदण्डी कौशिकस्य क्रतुवरमवितुं लक्ष्मणेनानुयातो","narayaniya",34,2],["मारीचं द्रावयित्वा मखशिरसि शरैरन्यरक्षांसि निघ्नन्","narayaniya",34,3],["आरुन्धाने रुषान्धे भृगुकुलतिलके संक्रमय्य स्वतेजो","narayaniya",34,4],["तातोक्या यातुकामो वनमनुजवधूसंयुतश्चापधारः","narayaniya",34,5],["श्रुत्वा पुत्रार्तिखिन्नं खलु भरतमुखात्स्वर्गयातं स्वतातं","narayaniya",34,6],["नत्वागस्त्यं समस्ताशरनिकरसपत्राकृतिं तापसेभ्यः","narayaniya",34,7],["सोदर्याप्रोक्तवार्ताविवशदशमुखादिष्टमारीचमाया-","narayaniya",34,9],["भूयस्तन्वीं विचिन्वन्नहृत दशमुखस्त्वद्वधूं मद्वधेने-","narayaniya",34,10],["सुग्रीवेणानुजोक्त्या सभयमभियता व्यूहितां वाहिनीं ता-","narayaniya",35,2],["त्वद्वार्ताकर्णनोद्यद्गरुदुरुजवसम्पातिसम्पातिवाक्य-","narayaniya",35,3],["त्वं सुग्रीवाङ्गदादिप्रबलकपिचमूचक्रविक्रान्तभूमि-","narayaniya",35,4],["कीशैराशान्तरोपाहृतगिरिनिकरैः सेतुमाधाप्य यातो","narayaniya",35,5],["सौमित्रिस्त्वत्र शक्तिप्रहृतिगलदसुर्वातजानीतशैल-","narayaniya",35,6],["गृह्णन्जम्भारिसम्प्रेषितरथकवचौ रावणेनाभियुध्यन्","narayaniya",35,7],["प्रीतो दिव्याभिषेकैरयुतसमधिकान्वत्सरान्पर्यरंसीर्-","narayaniya",35,8],["वाल्मीकेस्त्वत्सुतोद्गापितमधुरकृतेराज्ञया यज्ञवाटे","narayaniya",35,9],["सोऽयं मर्त्यावतारस्तव खलु नियतं मर्त्यशिक्षार्थमेवं","narayaniya",35,10],["प्रातः सन्त्रस्तभोजक्षितिपतिवचसा प्रस्तुते मल्लतूर्ये","narayaniya",75,1],["पापिष्ठापेहि मार्गाद्द्रुतमिति वचसा निष्टुरक्रुद्धबुद्धे-","narayaniya",75,2],["हस्तप्राप्योऽप्यगम्यो झटिति मुनिजनस्येव धावन्गजेन्द्रं","narayaniya",75,3],["गृह्णानं दन्तमंसे युतमथ हलिना रङ्गमङ्गाविशन्तं","narayaniya",75,4],["पूर्णं ब्रह्मैव साक्षान्निरवधिपरमानन्दसान्द्रप्रकाशं","narayaniya",75,5],["चाणूरो मल्लवीरस्तदनु नृपगिरा मुष्टिको मुष्टिशाली","narayaniya",75,6],["हा धिक्कष्टं कुमआरौ सुललितवपुषौ मल्लवीरौ कठोरौ","narayaniya",75,7],["सद्यो निष्पिष्टसन्धिं भुवि नरपतिमापात्य तस्योपरिष्टात्","narayaniya",75,9],["तद्भ्रात्नष्ट पिष्ट्वा द्रुतमथ पितरौ सन्नमन्नुग्रसेनं","narayaniya",75,10],["पद्भ्यां त्वं पद्ममाली चकितिव पुरान्निर्गतो धावमानो","narayaniya",77,10],["एक्ष्वाकोऽहं विरक्तोऽस्म्यखिलनृपसुखे त्वत्प्रसादैककाङ्क्षी","narayaniya",77,11],["कल्पद्रुं सत्यभामाभवनभुवि सृजन्द्व्यष्टसाहस्रयोषाः","narayaniya",81,10],["प्रद्युम्नो रौक्मिणेयः स खलु तव कला शम्बरेणाहृतस्तं","narayaniya",82,1],["चापानां पञ्चशत्या प्रसभमुपगते छिन्नचापेऽथ बाणे","narayaniya",82,7],["बाणं नानायुधोग्रं पुनरभिपतितं दुर्पदोषाद्वितन्वन्","narayaniya",82,8],["साम्बं कौरव्यपुत्रीहरणनियमितं सान्त्वनार्थी कुरूणां","narayaniya",83,10],["साल्वो भैष्मीविवाहे यदुबलविजितश्चन्द्रचूडाद्विमानं","narayaniya",86,1],["तावत्त्वं रामशाली त्वरितमुपगतः खण्डितप्रायसैन्यं","narayaniya",86,2],["क्षिप्त्वा सौभं गदाचूर्णितमुदकनिधौ मङ्क्षु साल्वेऽपि चक्रे-","narayaniya",86,3],["त्वय्यायातेऽथ जाते किल कुरुसदसि द्यूतके संयतायाः","narayaniya",86,4],["युद्धोद्योगेऽथ मन्त्रे मिलति सति वृतः फल्गुनेन त्वमेकः","narayaniya",86,5],["जिष्णोस्त्वं कृष्ण! सूतः खलु समरमुखे बन्धुघाते दयालुं","narayaniya",86,6],["भक्तोत्तंसेऽथ भीष्मे तव धरणिभरक्षेपकृत्यैकसक्ते","narayaniya",86,7],["युद्धे द्रोणस्य हस्तिस्थिररणभगदत्तेरितं वैष्णवास्त्रं","narayaniya",86,8],["युद्धादौ तीर्थगामि स खलु हलधरो नैमिशक्षेत्रमृच्छ-","narayaniya",86,9],["संसुप्तद्रौपदेयक्षपणहतधियं द्रौणिमेत्य त्वदुक्त्या","narayaniya",86,10],["धर्मौघं धर्मसूनोरभिदधदखिलं छन्दमृत्युः स भीष्मस्-","narayaniya",86,11],["प्रागेवाचार्यपुत्राहृतिनिशमनया स्वीयषट्सूनुवीक्षां","narayaniya",88,1],["भूयोऽथ द्वारवत्यां द्विजतनयमृतिं तत्प्रलापानपि त्वं","narayaniya",88,4],["नष्टा अष्टास्य पुत्राः पुनरपि तव तूपेक्षया कष्टवादः","narayaniya",88,5],["मानी स त्वामपृष्ट्वा द्विजनिलयगतो बाणजालैर्महास्त्रै","narayaniya",88,6],["सार्धं तेन प्रतीचीं दिशमतिजविना स्यन्दनेनाभियातो","narayaniya",88,7],["तत्रासीनं भुजङ्गाधिपशयनतले दिव्यभूषायुधाद्यै-","narayaniya",88,8],["एवं नानाविहारैर्जगदभिरमयन्वृष्णिवंशं प्रपुष्ण-","narayaniya",88,10],["प्रायेण द्वारवत्यामवृतदयि तदी नारदस्त्वद्रसार्द्रस्-","narayaniya",88,11],["सोऽयं कृष्णावतारो जयति तव विभो! यत्र सौहार्दभीति-","narayaniya",88,12],["मोक्तारं बन्धमुक्तो हरिणपतिरिव प्राद्रवत्सोऽथ रुद्रं","narayaniya",89,5],["भद्रं ते शाकुनेय! भ्रमसि किमधुना त्वं पिशाचस्य वाचा","narayaniya",89,6],["श्रीकृष्ण! त्वत्पदोपासनमभयतमं बद्धमिथ्यार्थदृष्टेर्-","narayaniya",91,1],["भूमन्! कायेन वाचा मुहुरपि मनसा त्वद्बलप्रेरितात्मा","narayaniya",91,2],["भीतिर्नाम द्वितीयाद्भवति ननु मनःकल्पितं च द्वितीयं","narayaniya",91,3],["भक्तेरुत्पत्तिवृद्धी तव चरणजुषं सङ्गमेनैव पुंसा-","narayaniya",91,4],["श्रेयोमार्गेषु भक्तावधिकबहुमतिर्जन्मकर्माणि भूयो","narayaniya",91,5],["भूतान्येतानि भूतात्मकमपि सकलं पक्षिमत्स्यान्मृगादीन्","narayaniya",91,6],["नो मुह्यन्क्षुत्तृडाद्यैर्भवसरणिभवैस्त्वन्निलीनाशयत्वा-","narayaniya",91,7],["भूतेष्वेषु त्वदैक्यस्मृतिसमधिगतौ नाधिकारोऽधुना चेत्","narayaniya",91,8],["आवृत्य त्वत्स्वरूपं क्षितिजलमरुदाद्यात्मना विक्षिपन्ती","narayaniya",91,9],["दुःखान्यालोक्य जन्तुष्वलमुदितविवेकोऽहमाचार्यवर्या-","narayaniya",91,10],["वैदैः सर्वाणि कर्माण्यफलपरतया वर्णितानीति बुद्ध्वा","narayaniya",92,1],["यस्त्वन्यः कर्मयोमस्तव भजनमयस्तत्र चाभीष्टमूर्तिं","narayaniya",92,2],["स्त्रीशूद्रास्त्वत्कथादिश्रवणविरहिता आसतां ते दयार्हास्-","narayaniya",92,3],["पपोऽयं कृष्ण! रामेत्यभिलपति निजं गूहितुं दिश्चारित्रं","narayaniya",92,4],["श्वेतच्छायं कृते त्वां मुनिवरवपुषं प्रीणयन्ते तपोभि-","narayaniya",92,5],["सोऽयं कालेयकालो जयति मुररिपो! यत्र सङ्कीर्तनाद्यैर्-","narayaniya",92,6],["भक्तास्तावत्कलौ स्पुर्द्रमिलभुवि ततो भूरिशस्तत्र चोच्चैः","narayaniya",92,7],["दृष्ट्वा धर्मद्रुहं तं कलिमपकरुणं प्राङ्महीक्षित्परीक्षि-","narayaniya",92,8],["गङ्गा गीता च गायत्र्यपि च तुलसिका गोपिकाचन्दनं तत्","narayaniya",92,9],["बन्धुस्नेहं विजह्यां तव हि करुणया त्वय्युपावेशितात्मा","narayaniya",93,1],["क्षुत्तृष्णालोपमात्रे सततकृतधियो जन्तघः सन्त्यनन्ता-","narayaniya",93,2],["त्वत्कारुण्ये प्रवृत्ते क इव न हि गुरुर्लोकवृत्तेऽपि भूमन्!","narayaniya",93,3],["स्वच्छः स्यां पावनोऽहं मधुर उदकवद्वह्निवन्मा स्म गृह्णां","narayaniya",93,4],["स्नेहाद्व्याधास्तपुत्रप्रणयमृतकपोतीयितो मा स्म भूवं","narayaniya",93,5],["मा बध्यासं तरुण्या गज इव वशया नार्जयेयं धनौघं","narayaniya",93,6],["वर्तेय त्यक्तमानः सुखमतिशिशुवन्निस्सहायश्चरेयं","narayaniya",93,7],["ही ही मे देहमोहं त्यज पवनपुराधीश! यत्प्रेमहेतोर्-","narayaniya",93,9],["दुर्वारो देहमोहो यदि पुनरधुना तर्हि निश्शेषरोगान्","narayaniya",93,10],["आचार्याख्याधरस्थारणिसमनुमिलच्छिष्यरूपोत्तरारे-","narayaniya",94,2],["एवं त्वत्प्राप्तितोऽन्यो नहि खलु निखिलक्लेशहानेरुपायो","narayaniya",94,3],["त्वल्लोकादन्यलोकः क्व नु भयरहितो यत्परार्धद्वयान्ते","narayaniya",94,4],["जीवन्मुक्तत्वमेवंविधमिति वचसा किं फलं दूरदूरे","narayaniya",94,6],["शब्दब्रह्मण्यपीह प्रयतितमनसस्त्वां न जानन्ति केचित्","narayaniya",94,7],["यो यावान्यादृशो वा त्वमिति किमपि नैवावगच्छामि भूम-","narayaniya",94,8],["यद्यल्लभ्येत तत्तत्तव समुपहृतं देव! दासोऽस्मि तेऽहं","narayaniya",94,9],["एक्यं ते दानोहिमव्रतनियमतपस्साङ्ख्ययोगैर्दुरापं","narayaniya",94,10],["आदौ हैरण्यगभीं तनुमविकलजीवात्मिकामास्थितस्त्वं","narayaniya",95,1],["सत्त्वोन्मेषात्कदाचित्खलु विषयरसे दोषबोधेऽपि भूमन्!","narayaniya",95,2],["सन्ति श्रेयांसि भूयांस्यपि रुचिभिदया कर्मिणां निर्मितानि","narayaniya",95,3],["त्वद्भक्त्या तुष्टबुद्धेः सुखमिह चरतो विच्युताशस्य चाशाः","narayaniya",95,4],["त्वद्भक्तो बाध्यमानोऽपि च विषयरसैरिन्द्रियाशान्तिहेतोर्-","narayaniya",95,5],["चित्तार्द्रीभाववमुच्चैर्वपुषि च पुलकं हर्षबाष्यं च हित्वा","narayaniya",95,6],["ध्यानं ते शीलयेयं समतनुसुखबद्धासनो नासिकाग्र-","narayaniya",95,7],["आनीलश्लक्ष्णकेशं ज्वलितमकरसत्कुण्डलं मन्दहास-","narayaniya",95,8],["सर्वाङ्गेष्वङ्ग! रङ्गत्कुतुकमतिमुहुर्धारयन्नीश! चित्तं","narayaniya",95,9],["इत्थं त्वद्ध्यानयोगे सति पुनरणिमाद्यष्टसंसिद्धयस्ता","narayaniya",95,10],["त्वं हि ब्रह्मैव साक्षात्परमुरुमहिमन्नक्षराणामकार-","narayaniya",96,1],["ब्रह्मण्यानां बलिस्त्वं क्रतुषु च जपयज्ञोऽसो वीरेषु पार्थो","narayaniya",96,2],["धर्मं वर्णाश्रमाणां श्रुतिपथविहितं त्वत्परत्वेन भक्त्या","narayaniya",96,3],["ज्ञानं कर्मापि भक्तिस्त्रितयमिह भवत्प्रापकं तत्र तावद्","narayaniya",96,4],["ज्ञानं त्वद्भक्ततां वा लघु सुकृतवशान्मर्त्यलोके लभन्ते","narayaniya",96,5],["अव्यक्तं मार्गयन्तः श्रुतिभिरपि नयैः केवलज्ञानलुब्धाः","narayaniya",96,6],["ज्ञानायैवातियत्नं मुनिरपवदते ब्रह्मतत्त्वं तु शृण्वन्","narayaniya",96,7],["निर्विण्णः कर्ममार्गे खलु विषमतमे त्वत्कथादौ च गाढं","narayaniya",96,8],["कश्चित्क्लेशार्जितार्थक्षयविमलमतिर्नुद्यमानो जनौधैः","narayaniya",96,9],["एलः प्रागुर्वशीं प्रत्यतिविवशमनाः सेवमानश्चिरं तां","narayaniya",96,10],["त्रैगुण्याद्भिन्नरूपं भवति हि भुवने हीनमध्योत्तमं य-","narayaniya",97,1],["त्वय्येव न्यस्तचित्तः सुखमयि विचरन्सर्वचेष्टास्त्वदर्थं","narayaniya",97,2],["त्वद्भावो यावदेषु स्फुरति न विशदं तावदेवं ह्युपास्तिं","narayaniya",97,3],["तं चैनं भक्तियोगं द्रढयितुमयि! मे साध्यमारोग्यमायुर्-","narayaniya",97,4],["मार्कण्डेयश्चिरायुः स खलु पुनरपि त्वत्परः पुष्पभद्रा-","narayaniya",97,5],["प्रीत्या नारायणाख्यस्त्वमथ नरसखः प्राप्तवानस्य पार्श्वं","narayaniya",97,6],["याते त्वय्याशु वाताकुलजलदगलत्तोतपूर्णातिघूर्ण-","narayaniya",97,7],["दृष्ट्वा त्वां हृष्टरोमा त्वरितमभिगतः स्प्रष्टुकामो मुनीन्द्रः","narayaniya",97,8],["गौर्या सार्धं तदग्रे पुरभिदथ गतस्त्वत्प्रियप्रेक्षणार्थी","narayaniya",97,9],["त्र्यंशेऽस्मिन्सत्यलोके विधिहरिपुरभिन्मन्दिराण्यूर्ध्वमूर्ध्वं","narayaniya",97,10],["यस्मिन्नेतद्विभातं यत इदमभवद्येन चेदं य एतद्","narayaniya",98,1],["जन्माथो कर्म नाम स्फुटमिह गुणदोषादिकं वा न यस्मिन्","narayaniya",98,2],["नो तिर्यञ्चं न मर्त्यं न च सुरमसुरं न स्त्रियं नो पुमांसं","narayaniya",98,3],["मायायां बिम्बितस्त्वं सृजसि महदहङ्कारतन्मात्रभेदैर्-","narayaniya",98,4],["शब्दब्रह्मेति कर्मेत्यणुरिति भगवन्! काल इत्यालपन्ति","narayaniya",98,5],["सत्त्वेनासत्तया वा न च खलु सदसत्त्वेन निर्वाच्यरूपा","narayaniya",98,6],["भूषासु स्वर्णवद्वा जगति घटशरावादिके मृत्तिकावत्","narayaniya",98,7],["यद्भीत्योदेति सूर्यो दहति च दहनो वाति वायुस्तथान्ये","narayaniya",98,8],["त्रैलोक्यं भावयन्तं त्रिगुणमयमिदं त्र्यक्षरस्यैकवाच्यं","narayaniya",98,9],["सत्यं शुद्धं विबुद्धं जयति तव वपुर्नित्यमुक्तं निरीहं","narayaniya",98,10],["दुर्वारं द्वादशारं त्रिशतपरिमिलत्षष्टिपर्वाभिवीतं","narayaniya",98,11],["विष्णोर्वीर्याणि को वा कथयतु धरणेः कश्च रेणून्मिमीते","narayaniya",99,1],["हे स्तोतारः! कवीन्द्रास्तमिह खलु यथा चेतयध्वे तथैव","narayaniya",99,3],["विष्णोः कर्माणि सम्पश्यत मनसि सदा यैः स धर्मानबध्नाद्","narayaniya",99,4],["नो जातो जायमानोऽपि च समधिगतस्त्वन्महिम्नोऽवसानं","narayaniya",99,5],["आपः सृष्ट्यादिजन्याः प्रथममयि विभो! गर्भदेशे दधुस्त्वां","narayaniya",99,6],["हे लोका विष्णुरेतद्भवनमजनयत्तन्न जानीथ यूयं","narayaniya",99,7],["मूर्ध्नामक्षणां पदानां वहसि खलु सहस्राणि सम्पूर्य विश्वं","narayaniya",99,8],["यत्तु त्रैलोक्यरूपं दधदपि च ततोनिर्गतानन्तशुद्ध-","narayaniya",99,9],["अव्यक्तं ते स्वरूपं दुरधिगमतमं तत्तु शुद्धैकसत्त्वं","narayaniya",99,10],["अग्रे पश्यामि तेजो निबिडतरकलायावलीलोभनीयं","narayaniya",100,1],["नीलाभं कुञ्चिताग्रं घनममलतरं संयतं चारुभङ्ग्या","narayaniya",100,2],["हृद्यं पूर्णानुकम्पार्णवमृदुलहरीचञ्चलभ्रूविलासै-","narayaniya",100,3],["उत्तुङ्गोल्लासिनासं हरिमणिमुकुरप्रोल्लसद्गण्डपाली-","narayaniya",100,4],["बाहुद्वन्द्वेन रत्नोज्ज्वलवलयभृता शोणपाणिप्रवाले-","narayaniya",100,5],["उत्सर्पत्कौस्तुभश्रूततिभिररुणितं कोमलं कण्ठदेशं","narayaniya",100,6],["अङ्गे पञ्चाङ्करागैरतिशयविकसत्सौरभाकृष्टलोकं","narayaniya",100,7],["ऊरू चारू तवोरू घनमसृणरुचौ चित्तचोरौ रमाया","narayaniya",100,8],["मञ्जीरं मञ्जुनादैरिव पदभजनं श्रेय इत्यालपन्तं","narayaniya",100,9],["योगीन्द्राणां त्वदङ्गेष्वधिकसुमधुरं मुक्तिभाजां निवासो","narayaniya",100,10],["अज्ञात्वा ते महत्त्वं यदिह निगदितं विश्वनाथ! क्षमेथाः","narayaniya",100,11],["स्थानं नः पूर्वजानामियमधिकमसौ प्रेयसी पूरयोध्या,","bhattikavya",22,28],["अस्थानोद्योगदुःखं जहिहि न हि नभः पङ्गुसंचारयोग्यं","bhallatashataka",1,86],["कोऽयं भ्रान्तिप्रकारस्तव पवन पदं लोकपादाहतीनां","bhallatashataka",1,95],["मा द्राक्षं क्षीणपुण्यान्क्षणमपि भवतो भक्तिहीनान्पदाब्जे","mukundamala",1,23],["शत्रुच्छेदैकमन्त्रं सकलमुपनिषद्वाक्यसंपूज्यमन्त्रं","mukundamala",1,29],["ओंकारः साहसानां निजगुणनिपुणप्रत्यवेक्षा सुखानां","mugdhopadesha",1,62],["प्राणाघातान्निवृत्तिः परधनहरणे संयमः सत्यवाक्यं","shatakatraya",1,26],["नम्रत्वेनोन्नमन्तः परगुणकथनैः स्वान्गुणान्ख्यापयन्तः","shatakatraya",1,70],["राजस्तृष्णाम्बुराशेर्न हि जगति गतः कश्चिदेवावसानं","shatakatraya",2,28],["संसारेऽस्मिन्नसारे कुनृपतिभवनद्वारसेवाकलङ्क","shatakatraya",2,31],["संसारे स्वप्नसारे परिणतितरले द्वे गती पण्डितानां","shatakatraya",2,37],["आवर्तः संशयानामविनयभुवनं पट्टणं साहसानां","shatakatraya",2,45],["सन्मार्गे तावदास्ते प्रभवति च नरस्तावदेवेन्द्रियाणां","shatakatraya",2,74],["अर्धं सुप्त्वा निशायाः सरभससुरतायाससन्नश्लथाङ्ग","shatakatraya",2,96],["प्रदुयत्प्रौढप्रियङ्गुद्युतिभृति विकसत्कुन्दमाद्यद्द्विरेफे","shatakatraya",2,98],["चुम्बन्तो गण्डभित्तीरलकवति मुखे सीत्कृतान्यादधाना","shatakatraya",2,99],["पुण्ये ग्रामे वने वा महति सितपटच्छन्नपाली कपालिं","shatakatraya",3,23],["किं कन्दाः कन्दरेभ्यः प्रलयमुपगता निर्झरा वा गिरिभ्यः","shatakatraya",3,25],["आयुः कल्लोललोलं कतिपयदिवसस्थायिनी यौवनश्रीर्","shatakatraya",3,36],["कृच्छ्रेणामेध्यमध्ये नियमिततनुभिः स्थीयते गर्भवासे","shatakatraya",3,37],["अर्थानामीशिषे त्वं वयमपि च गिरामीश्महे यावदर्थं","shatakatraya",3,52],["स्नात्वा गाङ्गैः पयोभिः शुचिकुसुमफलैरर्चयित्वा विभो त्वा","shatakatraya",3,88],["पाणिः पात्रं पवित्रं भ्रमणपरिगतं भैक्ष्यमक्षय्यमन्नं","shatakatraya",3,99],["काचित्कीर्णा रजोभिर्दिवमनुविदधे भिन्नवक्त्रेन्दुलक्ष्मीर्","shishupalavadha",15,96],["पद्मद्रोहोद्धुराणां धवलितहरितामैन्दवीनां द्युतीनां","sudhalahari",1,2],["त्रातामीवार्तलक्षाः प्रतिदिनविहितानेकगीर्वाणरक्षा","sudhalahari",1,3],["प्रालेयानां करालाः कवलितजगतीमण्डलध्वान्तजालाः","sudhalahari",1,4],["निर्भिद्ये क्ष्मारुहाणामतिघनमुदरं येषु गोत्रां गतेषु","sudhalahari",1,5],["अह्नि क्रीडोचितानां सरसिरुहलसन्मन्दिराणां प्रभाते","sudhalahari",1,6],["आलेपा हिङ्गुलानामिव धरणिभुजामच्छसौधाग्रमौलि","sudhalahari",1,7],["कीलालैः कुङ्कुमानां निखिलमपि जगज्जालमेतन्निषिक्तं","sudhalahari",1,8],["या सूते सवभूतेष्वनुदिनमुदये चेतनाया विलासा","sudhalahari",1,9],["नीहारैर्नीरजानां निबिडतमतमोराशिभिर्लोचनानां","sudhalahari",1,10],["शीते शोकं शशाङ्के कृशतमरुचितामाशुनाशं निशायां","sudhalahari",1,11],["स्वापं स्वापाकुलानां गदमथ गदिनामन्धकारं त्रिलोक्याः","sudhalahari",1,12],["अन्तर्नीरं नदीनामनुदिनमुदये बिम्बिता ये समन्ता","sudhalahari",1,13],["प्रत्यग्रोढाः प्रगल्भा युवतिपरिषदः प्रोषितप्राणनाथा","sudhalahari",1,14],["त्राणं त्रैविष्टपानां तरणमथ पयस्तोमताम्यत्तनूनां","sudhalahari",1,16],["गीर्वाणग्रामणीभिर्गगनतलगतैर्गीर्भिरुद्गीथगाभि","sudhalahari",1,17],["जीवातुर्जाड्यजालाधिकजनितरुजां तप्तजाम्बूनदाभं","sudhalahari",1,18],["प्रातर्निर्गत्य गोभिः सह रुचिविषये संचरन्त्योऽह्नि ताभिः","sudhalahari",1,19],["वृन्दैर्वृन्दारकाणां दनुतनुजनुषां रक्षसां च क्षपान्ते","sudhalahari",1,20],["आ पाथोजासनायुः क्षणलवघटिकाद्यात्मकं कालचक्रं","sudhalahari",1,21],["अङ्गानि ब्राह्मणानामुषसि हिमभरासङ्गतो भङ्गुराणि","sudhalahari",1,22],["विश्रान्तिं ब्राह्मणानां सुखमतिशयितं कामिनां स्थायिलीला","sudhalahari",1,23],["द्रागाहत्य प्रभाते रजनिहिमवतः कौमुदीः कौतुकेन","sudhalahari",1,24],["द्रागद्वैतं वितन्वंस्त्रिभुवनमभितः कौङ्कुमीनां द्युतीनां","sudhalahari",1,25],["शुद्धं ब्रह्मालवालं प्रकृतिशबलितं यस्य मूलं करास्त","sudhalahari",1,26],["नीहारं निम्नगाभ्यो निखिलनयनतो नीरजेभ्यश्च निद्रां","sudhalahari",1,27],["संहृत्य द्राग्बहिःस्थं तिमिरकुलमथाभ्यन्तरं हर्तुकामा","sudhalahari",1,28],["ब्रह्माण्डं मण्डयन्तो वियति वलयिनो मण्डलैरण्डजानां","sudhalahari",1,29],["ऊर्ध्वं पापावलिभ्यः स्थित इति जगदे यस्य वेदैरुदाख्या","sudhalahari",1,30]]