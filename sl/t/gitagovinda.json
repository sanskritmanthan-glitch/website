{"id":"gitagovinda","v":[[1,1,["मेघैर्मेदुरं अम्बरं वनभुवः श्यामास्तमालद्रुमैर्","नक्तं भीरुरयं त्वमेव तदिमं राधे गृहं प्रापय","इत्थं नन्दनिदेशतश्चलितयोः प्रत्यध्वकुञ्जद्रुमं","राधामाधवयोर्जयन्ति यमुनाकूले रहःकेलयः"],"शार्दूलविक्रीडितम्"],[1,2,["वाग्देवताचरितचित्रितचित्तसद्मा","पद्मावतीचरणचारणचक्रवर्ती","श्रीवासुदेवरतिकेलिकथासमेतं","एतं करोति जयदेवकविः प्रबन्धं"],"वसन्ततिलका"],[1,3,["यदि हरिस्मरणे सरसं मनो","यदि विलासकलासु कुतूहलं","मधुरकोमलकान्तपदावलीं","शृणु तदा जयदेवसरस्वतीम्"],"द्रुतविलम्बितम्"],[1,4,["वचः पल्लवयत्युमापतिधरः सन्दर्भशुद्धिं गिरां","जानीतेजयदेव एव शरणः श्लाघ्यो दुरूहद्रुतेः","शृङ्गारोत्तरसत्प्रमेयरचनैराचार्यगोवर्धन","स्पर्धी कोऽपि न विश्रुतः स्रुतिधरो धोयी कविक्ष्मापतिः"],"शार्दूलविक्रीडितम्"],[1,5,["प्रलयपयोधिजले धृतवानसि वे","दं विहितवहित्रचरित्रमखेदम्","केशव धृतमीनशरी","र जय जगदीश हरे"],""],[1,6,["क्षितिरतिविपुलतरे तव तिष्ठति पृ","ष्ठे धरणीधरणकिणचक्रगरिष्ठे","केशव धृतकच्छपरू","प जय जगदीश हरे"],""],[1,7,["वसति दशनशिखरे धरणी तव","लग्ना शशिनि कलङ्ककलेव निमग्ना","केशव धृतसूकररू","प जय जगदीश हरे"],""],[1,8,["तव करकमलवरे नखं अद्भुतशृङ्","गं दलितहिरण्यकशिपुतनुभृङ्गं","केशव धृतनरहरिरू","प जय जगदीश हरे"],""],[1,9,["छलयसि विक्रमणे बलिमद्भुतवाम","न पदनखनीरजनितजनपावन","केशव धृतवामनरु","प जय जगदीश हरे"],""],[1,10,["क्षत्रीयरुधिरमये जगदपगतपा","पं स्नपयसि पयसि शमितभवतापम्","केशव धृतभृगुपतिरू","प जय जगदीश हरे"],""],[1,11,["वितरसि दिक्षु रणे दिक्पतिकमनी","यं दशमुखमौलिबलि रमणीयम्","केशव धृतरामशरी","र जय जगदीश हरे"],""],[1,12,["वहसि वपुषि विशदे वसनं जलदा","भं हलहतिभीतिमिलितयमुनाभम्","केशव धृतहलधररू","प जय जगदीश हरे"],""],[1,13,["निन्दसि यज्ञविधेरह","ह श्रुतिजातम्सदयहृदय दर्शित","पशुघातम्केशव धृत","बुद्धशरी र जय जगदीश हरे"],"गीतिः"],[1,14,["म्लेच्छनिवहनिधने कलयसि कर","वालं धूमकेतुमिव किमपि करालम्","केशव धृतकल्किशरी","र जय जगदीश हरे"],""],[1,15,["श्रीजयदेवकवेरिदमुदितमुदा","रं शृणु सुखदं शुभदं भवसारम्","केशव धृतदशविधरू","प जय जगदीश हरे"],""],[1,16,["वेदानुद्धरते जगन्ति वहते भूगोलमुद्बिभ्रते","दैत्यं दारयते बलिं छलयते क्षत्रक्षयं कुर्वते","पौलस्त्यं जयते हलं कलयते कारुण्यमातन्वते","म्लेच्छान्मूर्च्छयते दशाकृतिकृते कृष्णाय तुभ्यं नमः"],"शार्दूलविक्रीडितम्"],[1,17,["श्रितकमलाकुचमण्","डल धृतकुण्डल ए","कलितललितवनमाल","जय जय देव हरे"],"अनुष्टुभ् (श्लोकः)"],[1,18,["दिनमणिमण्डलमण्डन","भवखण्डन ए","मुनिजनमानसहंस","जय जय देव हरे"],""],[1,19,["कालियविषधरगञ्जन","जनरञ्जन ए","यदुकुलनलिनदिनेश","जय जय देव हरे"],""],[1,20,["मधुमुरनरकविनाशन","गरुडासन ए","सुरकुलकेलिनिदान","जय जय देव हरे"],""],[1,21,["अमलकमलदललोचन","भवमोचन ए","त्रिभुवनभुवननिधान","जय जय देव हरे"],""],[1,22,["जनकसुताकृतभूषण","जितदूषण ए","समरशमितदशकण्ठ","जय जय देव हरे"],""],[1,23,["अभिनवजलधरसुन्दर","धृतमन्दर ए","श्रीमुखचन्द्रचकोर","जय जय देव हरे"],""],[1,24,["तव चरणं प्रणता वयम्","इति भावय ए","कुरु कुशलं प्रणतेषु","जय जय देव हरे"],""],[1,25,["श्रीजयदेवकवेरिदं","कुरुते मुदमे","मङ्गलमुज्ज्वलगीतं","जय जय देव हरे"],""],[1,26,["पद्मापयोधरतटीपरिरम्भलग्न","काश्मीरमुद्रितमुरो मधुसूदनस्य","व्यक्तानुरागमिव खेलदनङ्गखेद","स्वेदाम्बुपूरमनुपूरयतु प्रियं वः"],"वसन्ततिलका"],[1,27,["वसन्ते वासन्तीकुसुमसुकुमारैरवयवैर्","भ्रमन्तीं कान्तारे बहुविहितकृष्णानुसरणाम्","अमन्दं कन्दर्पज्वरजनितचिन्ताकुलतया","वलद्बाधां राधां सरसमिदमूचे सहचरी"],"शिखरिणी"],[1,28,["ललितलवङ्गलतापरि","शीलनकोमलमलयसमीरे मधु","करनिकरकरम्बित को","किलकूजितकुञ्जकुटीरे"],"आर्या"],[1,29,["उन्मदमदनमनोरथ","पथिकवधूजनजनितविलापे अलि","कुलसङ्कुलकुसुमस मू","हनिराकुलबकुलकलापे"],"आर्या"],[1,30,["मृगमदसौरभरभसव","शंवदनवदलमालतमाले युव","जनहृदयविदारण मन","सिजनखरुचिकिंशुकजाले"],"आर्या"],[1,31,["मदनमहीपतिकनकदण्ड","रुचिकेशरकुसुमविकाशे","मिलितशिलिमुखपाटलप","टलकृतस्मरतूणविलासे"],""],[1,32,["विगलितलज्जितजगदव","लोकनतरुणकरुणकृतहासे विर","हिनिकृन्तनकुन्तमु खा","कृतिकेतकदन्तुरिताशे"],"आर्या"],[1,33,["माधविकापरिमलललि","ते नवमालतिजातिसुगन्धौ","मुनिमनसामपि मो","हनकारीणि तरुण","-करणबन्धौ"],""],[1,34,["स्फुरदतिमुक्तलतापरि","रम्भनमुकुलितपुलकितचूते","वृन्दावनवीपिने प","रीसरपरिगतयमुनाजलपूते"],""],[1,35,["श्रीजयदेवभणितमिदम्","उदयति हरिचरणस्मृतिसारम्","सरसवसन्तसमयवन","वर्णनमनुगतमदनविकारम्"],""],[1,36,["दरविदलितमल्लीवल्लिचञ्चत्पराग","प्रकटितपटवासैर्वासयन्काननानि","इह हि दहत