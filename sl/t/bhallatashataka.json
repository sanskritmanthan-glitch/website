ामेको निलय इति रत्नाकर इति","श्रितोऽस्माभिस्तृष्णातरलितमनोभिर्जलनिधिः","क एवं जानीते निजकरपुटीकोटरगतं","क्षणादेनं ताम्यत्तिमिनिकरमापास्यति मुनिः"],"शिखरिणी"],[1,101,["विशालं शाल्मल्या नयनसुभगं वीक्ष्य कुसुमं","शुकस्यासीद्बुद्धिः फलमपि भवेदस्य सदृशम्","चिरासीनं तस्मिंश्च फलमपि दैवात्परिणतं","विपाके तूलोऽन्तः सपदि मरुता सोऽप्यपहृतः"],"शिखरिणी"],[1,102,["सर्वप्रजाहितकृते पुरुषोत्तमस्य","वासे समस्तविबुधप्रथितेष्टसिद्धौ","चन्द्रांशुवृन्दविततद्युतिमत्यमुष्मिन्-","हे कालकूट तव जन्म कथं पयोधौ"],"वसन्ततिलका"],[1,103,["फलितघनविटपविघटित","पटुदिनकरमहसि लसतिकल्पतरौ","छायार्थी कः पशुरपि","भवति जरद्वीरुधां प्रणयी"],"आर्या"]]}