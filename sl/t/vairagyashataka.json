{"id":"vairagyashataka","v":[[1,1,["आस्ते कश्चन भिक्षुः सं","गृह्णन्नव्ययानि दश","न ममेत्यव्यययुगलं","याचामस्तं किमस्त्यन्यत्"],"अनुष्टुभ् (श्लोकः)"],[1,2,["धीसचिवं धैर्यबलं","संकल्पविरोधि शान्तिधनम्","विश्वत्रयविषयमिदं","वैराग्यं नाम साम्राज्यम्"],"उपगीतिः"],[1,3,["राज्ञो बिभेति लोको","राजानः पुनरितोऽपि वैरिभ्यः","आ ब्रह्मणः कृतान्ता","दकुतोभयमस्पृहाराज्यम्"],"आर्या"],[1,4,["भिक्षाप्रदा जनन्यः","पितरो गुरवः कुमारकाः शिष्याः","एकान्तरमणहेतुः","शान्तिर्दयिता विरक्तस्य"],"आर्या"],[1,5,["ये न किमपि चेष्टन्ते","कार्यप्रतिकर्ययोर्विरहात्","सन्तस्त एव मुक्ताः","संदेहे गौतमः साक्षी"],"उपगीतिः"],[1,6,["पततु नभः स्फुटतु मही","चलन्तु गिरयो मिलन्तु वारिधयः","अधरोत्तरमस्तु जग","त्का हानिर्वीतरागस्य"],"आर्या"],[1,7,["के चोराः के पिशुना","ह के रिपवः केऽपि दायादाः","जगदखिलं तस्य वशे","यस्य वशे स्यादिदं चेतः"],""],[1,8,["विषया उपतिष्ठन्तां","विषयैर्वा समवयन्तु करणानि","आन्तरमेकं करणं","शान्तं यदि का ततश्चिन्ता"],"आर्या"],[1,9,["किं विषयान्परिहर्तुं","वस्तव्यं मेरुकंदरेष्वबुधैः","नह्यद्भिरनासेक्तुं धा","तुषु रोहन्ति पद्मानि"],"अनुष्टुभ् (श्लोकः)"],[1,10,["अज्ञानमिह निदानं","प्राग्रूपं जननमेव भवरोगे","परिपाकः संसरणं","भैषज्यं नैष्ठिकी शान्तिः"],"अनुष्टुभ् (श्लोकः)"],[1,11,["स्वेनोपभुक्तमर्थं","सूकरजातिस्मरो मनुष्य","इव दूरे जुगुप्समा","नो धी रो वैराग्यमद्रियते"],"उद्गीतिः"],[1,12,["शैशवमिव कौमारे","तत्तरुणिम्नीव स इव वृद्धत्वे","न स्वदते धीराणां का","मस्य विचेष्टितं शान्तौ"],"अनुष्टुभ् (श्लोकः)"],[1,13,["शतशः परीक्ष्य विषया","न्सद्यो जहति क्वचित्क्वचिद्धव्याः","काका इव वान्ताशन","मन्ये तानेव सेवन्ते"],"आर्या"],[1,14,["चरमौ मातापितरौ","चरमा गृहिणी सुताश्चरमाः","कर्तव्येऽपि प्रेमणि","कथमिह धीरा विरज्यन्ते"],"उपगीतिः"],[1,15,["तृणवद्भ्रमन्ति चपलाः","स्त्रीनामनि चण्डमारुते चलति","धरणिधरा इव सन्त","स्तत्र न किंचित्प्रकम्पन्ते"],"आर्या"],[1,16,["कामिजनपरमभोग्ये","कामसुखे धारयन्ति बीभत्सम्","सन्तः शमसुखरसिकाः","सुधाशनाः सूकरान्न इव"],"आर्या"],[1,17,["विक्षेपमात्रभाजो वि","कासकाष्टागतज्ञानाः","स्वस्यापि चेष्टितानि स्व","यमीक्षन्ते परस्येव"],"अनुष्टुभ् (श्लोकः)"],[1,18,["अस्थानेऽभिनिविष्टा","न्मूर्खानस्थान एव संतुष्टान्","अनुवर्तन्ते धीराः","पितर इव क्रीडतो बालान्"],"आर्या"],[1,19,["पुष्णति पुरुषे सलिलै","र्मुष्णति पुष्पं फलं च तरव इव","वर्तन्ते सन्तः सम","मुपकर्तरि चापकर्तरि च"],"आर्या"],[1,20,["नित्यानित्यविवेकः","सर्वेषां घटघटत्वयोरास्ते","स विवेको यः शान्तिकृ","दविवेकोऽन्यः समस्तोऽपि"],"आर्या"],[1,21,["अनधिगते कामसुखे","कालेन यथा प्रवर्तते तरुणः","एवं ब्रह्मसुखेऽपि","प्रवर्तते कोऽपि भाग्यवशात्"],"आर्या"],[1,22,["पुत्रगुणाः स्वातन्त्र्ये","दारगुणाश्चाधिवेदनावसरे","भ्रातृगुणा दायविधौ","द्रष्टव्या मोक्ष्यमाणेन"],"आर्या"],[1,23,["का मे गतिरिति पृच्छति","चरमश्वासेऽपि यः स्वार्थम्","तस्य जनस्यापि कृते","पापाः पापानि कुर्वन्ति"],"उपगीतिः"],[1,24,["पितृभिः कलहायन्ते","पुत्रानध्यापयन्ति पितृभक्तिम्","परदारानुपयन्तः","पठन्ति शास्त्राणि दारेषु"],"आर्या"],[1,25,["शान्तिरलभ्यादुपरति","रपात्रभावः प्रतिग्रहनिवृत्तिः","क्षान्तिर्दुर्बलतेति च","निवृत्तिधर्माः कलावेते"],"आर्या"],[1,26,["नीतिज्ञा नियतिज्ञा","वेदज्ञा अपि भवन्ति शास्त्रज्ञाः","ब्रह्मज्ञा अपि लभ्याः","स्वा ज्ञानज्ञानिनो विरलाः"],"आर्या"],[1,27,["कलिकलुषे मनसि स्वे","कथमिव जगदार्जवं लभते","चक्षुर्दोषे जाग्रति","चन्द्रद्वित्वं कुतो यातु"],"उपगीतिः"],[1,28,["विषयाननुकूलयितुं","विष यिणि हृदये विधीयतां यत्नः","दृशि देयमौषधं को","दृश्ये दत्त्वा सुखी भवति"],"आर्या"],[1,29,["दाराः पुत्रेषु रताः","पुत्राः पितृधनपरिग्रहव्यग्राः","रोदनशरणा जननी","परलोकगतस्य को बन्धुः"],"आर्या"],[1,30,["पश्यन्ति म्रियमाणा","न्मरिष्यतोऽनुमिमते स्मरन्ति मृतान्","कथयन्ते चैवमस","च्चेष्टन्ते नित्यवत्तु परम्"],"आर्या"],[1,31,["कलहायन्ते मूढाः","कः प्रतिभूः श्वः प्रभात इति","तस्यामेव रजन्यां कः","प्रतिभूः स्वस्य सत्तायाम्"],""],[1,32,["कुल्याः कृता विशालाः कु","ड्यान्युपलैर्निबद्धानि","क्रीता बलिनो महिपाः","कृतकृत्याः स्म इति मन्यन्ते"],"अनुष्टुभ् (श्लोकः)"],[1,33,["आ प्रपदमा शिरस्कं","चान्तः कलिमलमलीमसे वपुषि","विफलं गङ्गाजलमपि","मद्यघटे दर्भमुष्टिरिव"],"आर्या"],[1,34,["दण्ड्यं यत्सुखहेतोः","पुष्णन्ति जनाः कथं तदेव वपुः","नहि शर्कराभिलाषिभि","रिक्षोः काण्डानि पूज्यन्ते"],"आर्या"],[1,35,["प्रायो मुह्यति चेतः","प्राणभृतः प्राणनिर्गमावसरे","पुण्येन यदि न मुह्यति","पुत्रानेव स्मरन्म्रियते"],"आर्या"],[1,36,["शमयितुमौदरमग्निं","संसाराख्याम्बुधौ निमज्जन्ति","तुहिनव्यथानिवृत्त्यै","नहि वेश्मनि पावको देयः"],"आर्या"],[1,37,["आहृत्य परित्यक्ता ज","नयन्त्यर्थाः सुखाभासम्","अत्यन्तपरित्यक्ताः प","रमानन्दाय कल्पन्ते"],"अनुष्टुभ् (श्लोकः)"],[1,38,["अर्थानामधिकानां","राज्ञा चौरेण वा नाशः","अन्ने खल्वतिमुक्ते व","मनं वा स्याद्विरेको वा"],"अनुष्टुभ् (श्लोकः)"],[1,39,["प्रणमति परिसान्त्वयति","पतति सदा परिभ्रमति","आविष्ट इव पिशाच्या","पुरुषस्तृष्णावशं यातः"],""],[1,40,["जननादृष्टात्पितरौ","पुत्रा जामातरोऽप्ययादृष्टात्","कलहादृष्टाज्ज्ञातय","इति निर्णीते किमेष्टव्यम्"],"आर्या"],[1,41,["स्वपितुः परलोकाय","स्वयमनुदिवसं यदाचरति","क्रियतामिदमुपमानं","किं नालं पुत्रवैराग्ये"],"उपगीतिः"],[1,42,["अननुगते दारिद्र्ये","किमनुगतं लक्षणं दृष्टम्","कामस्यापूर्तिर्यदि","कृपणं जगदा चतुर्वदनात्"],"उपगीतिः"],[1,43,["न खलु धनत्वं जाति","र्यस्य यदिष्टं तदेव तस्य धनम्","तत्तदिव पामराणा","माकिंचन्यं धनं विदुषाम्"],"आर्या"],[1,44,["स्वीक्रियते यदि तृष्णा","स्वीकर्तव्यं जगत्समस्तमपि","स्वीक्रियते यदि शान्तिः","स्वात्मापि स्वस्य भवति न वा"],"आर्या"],[1,45,["यद्दातारं वशयति","यत्परिजनमस्य सान्त्वयति","यदपत्रपते नान्त","र्भावालाभः स कस्य समः"],"उपगीतिः"],[1,46,["प्रादेशमात्रमुदरं","परिपूरयितुं कियानयं यत्नः","चुलकेनाम्भः पातुं स्व","नितव्यः किं तटाकोऽपि"],"अनुष्टुभ् (श्लोकः)"],[1,47,["यामार्धमसंस्कारा","द्यामद्वयमनशनाच्च सुव्यक्ते","शारीरे सौन्दर्ये","ऽप्यभि निविशन्ते कियन्मूढाः"],"आर्या"],[1,48,["वन्ध्येत्याहुस्तरुणीं","जरतीति परित्यजन्ति बहुपुत्राम्","अभिनिन्दन्त्यल्पसुतां","का गृहिणी कामिनो हृद्या"],"आर्या"],[1,49,["यान्ति शुचमकृतदारा","द्वे भार्ये नेति कृतदाराः","ते परदारा नेति","स्त्रीभिस्तृप्तान्न पश्यामः"],"उपगीतिः"],[1,50,["मदनस्याज्ञाकरणे","मन्ये जगदखिलमेकरूपमिदम्","तिर्यञ्च इति नरा इति","देवा इत्यन्यतो भेदः"],"आर्या"],[1,51,["शुक्रविमोकस्थानं","मलमूत्रत्यागदेशवत्किमपि","स्त्रिय इति विहितं विधिना","कियदत्र जना निमज्जन्ति"],"आर्या"],[1,52,["वेदानधीत्य विधिव","न्मीमांसित्वा तदर्थं च","दाराः कर्तव्या इति","केनेदं प्रहसनं कथितम्"],"उपगीतिः"],[1,53,["दुःखेनोपार्ज्यन्ते","पाल्य न्ते प्रत्यहं च लाल्यन्ते","वामाः स्त्रियो विमूढै","रुपभुञ्जानाः सुखं विगुणम्"],"आर्या"],[1,54,["अश्नीत पिबत स्वाद","त जाग्रत संविशत तिष्ठत वा","सकृदपि चिन्तयताह्नः","सावधिको देहबन्ध इति"],""],[1,55,["किं विजितया पृथिव्या","किं काञ्चनभूभृता करस्थेन","किं दिव्याभिः स्त्रीभि","र्मर्तव्ये ब्रह्मणा लिखिते"],"आर्या"],[1,56,["जीवति कतिचिन्निमिषा","न्कतिचित्तेषु श्रुतीरधीत इव","तावत्सैवाकुलयति","तन्त्राणि नवानि चातनुते"],"आर्या"],[1,57,["स्वल्पो जीवनकालः","स्व ल्पा धीः परिचयः स्वल्पः","तदपि तरेम कथंचि","च्छ्रुतयो यदि नोपजायन्ते"],"उपगीतिः"],[1,58,["कुत आगतं न जाने","क्व नु वा गन्तव्यमिदमपि न जाने","संचरसि क्वेदानीं","संसारपथे महातमसि"],"आर्या"],[1,59,["तमसावृत्ताश्चरन्तः सवि","धे दूरे च नावयन्त्यर्थान्","अवयन्ति तु विस्पष्टं","तडिताभिहते शिरसि मूढाः"],""],[1,60,["निमिषन्त्यत्र तरुण्य","स्तत्र तरुण्यो न निमिषन्ति","ईदृक्षो हि विशेषः स्व","र्गः स्वर्ग इति किं तत्र"],"अनुष्टुभ् (श्लोकः)"],[1,61,["कोपो मैत्रावरुणेः शा","पो वा तार्किकस्य मुनेः","संस्मर्यते यदि सकृ","च्छत्रोरपि मास्तु शक्रपदम्"],"अनुष्टुभ् (श्लोकः)"],[1,62,["गच्छत्यमरावत्यां","गच्छतु चतुराननस्य वा नगरे","पुनरागन्तव्यं यदि","पुंसा किं साधितं भवति"],"आर्या"],[1,63,["भुक्ता बहवो दारा","लब्धाः पुत्राश्च पौत्राश्च","नीतं शतमप्यायुः","सत्यं वद मर्तुमस्ति मनः"],"उपगीतिः"],[1,64,["विश्लेषणस्वभावा","न्पश्यन्विषयान्करोति को ममताम्","नश्यदवस्थापन्नं","कः क्रीणीते धनैरश्वम्"],"आर्या"],[1,65,["अन्नाभावे मृत्युः","शालिभिरन्नानि शालयो वृष्ट्या","वृष्टिस्तपसेति वद","न्नमृत्यवे तत्तपश्चरतु"],"आर्या"],[1,66,["किं न निगृह्णन्ति मनः","किं न भजन्ते जनाः शिवं शरणम्","अभिसंधिभेदमात्रा","न्मोक्षोपाये न बध्यन्ते"],"अनुष्टुभ् (श्लोकः)"],[1,67,["भोगाय पामराणां","योगाय विवेकिनां शरीरमिदम्","भोगाय च योगाय च","न कल्पते दुर्विदग्धानाम्"],"आर्या"],[1,68,["ब्राह्मणचण्डाला इ","त्याह मुनिर्यन्महापथिकान्","भवमार्गमहापथिका","नधिकृत्यैव प्रवर्तितं चैतत्"],"उद्गीतिः"],[1,69,["एकद्वाः क्षितिपतिषु","द्वित्रा देवेषु पञ्चषा द्रुहिणे","एतावन्तो जगति ब्र","ह्मानन्दार्णवस्य कणाः"],"अनुष्टुभ् (श्लोकः)"],[1,70,["अज्ञानेना