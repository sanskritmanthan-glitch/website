{"id":"mandukyakarika","v":[["1",1,["बहिष्प्रज्ञो विभुर्विश्वो ह्य्","अन्तःप्रज्ञस्तु तैजसः","घनप्रज्ञस्तथा प्राज्ञ","एक एव त्रिधा स्मृतः"],"अनुष्टुभ् (श्लोकः)"],["1",2,["दक्षिणाक्षिमुखे विश्वो","मनस्यन्तस्तु तैजसः","आकाशे च हृदि प्राज्ञस्","त्रिधा देहे व्यवस्थितः"],"अनुष्टुभ् (श्लोकः)"],["1",3,["विश्वो हि स्थूलभुङ्नित्यं","तैजसः प्रविविक्तभुक्","आनन्दभुक्तथा प्राज्ञस्","त्रिधा भोगं निबोधत"],"अनुष्टुभ् (श्लोकः)"],["1",4,["स्थूलं तर्पयते विश्वं","प्रविविक्तं तु तैजसम्","आनन्दश्च तथा प्राज्ञं","त्रिधा तृप्तिं निबोधत"],"अनुष्टुभ् (श्लोकः)"],["1",5,["त्रिषु धामसु यद्भोज्यं","भोक्ता यश्च प्रकीर्तितः","वेदैतदुभयं यस्तु","स भुञ्जानो न लिप्यते"],"अनुष्टुभ् (श्लोकः)"],["1",6,["प्रभवः सर्वभावानां","सतामिति विनिश्चयः","सर्वं जनयति प्राणश्चे","तोअंशून्पुरुषः पृथक्"],"अनुष्टुभ् (श्लोकः)"],["1",7,["विभूतिं प्रसवं त्वन्ये","मन्यन्ते सृष्टिचिन्तकाः","स्वप्नमायासरूपेति","सृष्टिरन्यैर्विकल्पिता"],"अनुष्टुभ् (श्लोकः)"],["1",8,["इच्छामात्रं प्रभोः सृष्टिर्","इति सृष्टौ विनिश्चिताः","कालात्प्रसूतिं भूतानां","मन्यन्ते कालचिन्तकाः"],"अनुष्टुभ् (श्लोकः)"],["1",9,["भोगार्थं सृष्तिरित्यन्ये","क्रीडार्थमिति चापरे","देवस्यैष स्वभावोऽयम्","आप्तकामस्य का स्पृहा"],"अनुष्टुभ् (श्लोकः)"],["1",10,["निवृत्तेः सर्वदुःखानाम्","ईशानः प्रभुरव्ययः","अद्वैतः सर्वभावानां","देवस्तुर्यो विभुः स्मृतः"],"अनुष्टुभ् (श्लोकः)"],["1",11,["कार्यकारणबद्धौ ताव्","इष्येते विश्वतैजसौ","प्राज्ञः कारणबद्धस्तु","द्वौ तौ तुर्ये न सिध्यतः"],"अनुष्टुभ् (श्लोकः)"],["1",12,["नात्मानं न परांश्चैव","न सत्यं नापि चानृतम्","प्राज्ञः किंचन संवेत्ति","तुर्यं तत्सर्वदृक्सदा"],"अनुष्टुभ् (श्लोकः)"],["1",13,["द्वैतस्याग्रहणं तुल्यम्","उभयोः प्राज्ञतुर्ययोः","बीजनिद्रायुतः प्राज्ञः","सा च तुर्ये न विद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",14,["स्वप्ननिद्रायुतावाद्यौ","प्राज्ञस्त्वस्वप्ननिद्रया","न निद्रां नैव च स्वप्नं","तुर्ये पश्यन्ति निश्चिताः"],"अनुष्टुभ् (श्लोकः)"],["1",15,["अन्यथा गृह्णतः स्वप्नो","निद्रा तत्त्वमजानतः","विपर्यासे तयोः क्षीणे","तुरीयं पदमश्नुते"],"अनुष्टुभ् (श्लोकः)"],["1",16,["अनादिमायया सुप्तो","यदा जीवः प्रबुध्यते","अजमनिद्रमस्वप्नम्","अद्वैतं बुध्यते तदा"],"अनुष्टुभ् (श्लोकः)"],["1",17,["प्रपञ्चो यदि विद्येत","निवर्तेत न संशयः","मायामात्रमिदं द्वैतम्","अद्वैतं परमार्थतः"],"अनुष्टुभ् (श्लोकः)"],["1",18,["विकल्पो विनिवर्तेत","कल्पितो यदि केनचित्","उपदेशादयं वादो","ज्ञाते द्वैतं न विद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",19,["विश्वस्यात्वविवक्षायाम्","आदिसामान्यमुत्कटम्","मात्रासंप्रतिपत्तौ स्याद्","आप्तिसामान्यमेव च"],"अनुष्टुभ् (श्लोकः)"],["1",20,["तैजसस्योत्वविज्ञाने","उत्कर्षो दृश्यते स्फुटम्","मात्रासंप्रतिपत्तौ स्याद्","उभयत्वं तथाविधम्"],"अनुष्टुभ् (श्लोकः)"],["1",21,["मकारभावे प्राज्ञस्य","मानसामान्यमुत्कटम्","मात्रासंप्रतिपत्तौ तु","लयसामान्यमेव च"],"अनुष्टुभ् (श्लोकः)"],["1",22,["त्रिषु धामसु यत्तुल्यं","सामान्यं वेत्ति निश्चितः","स पूज्यः सर्वभूतानां","वन्द्यश्चैव महामुनिः"],"अनुष्टुभ् (श्लोकः)"],["1",23,["अकारो नयते विश्वम्","उकारश्चापि तैजसम्","मकारश्च पुनः प्राज्ञं","नामात्रे विद्यते गतिः"],"अनुष्टुभ् (श्लोकः)"],["1",24,["ओंकारं पादशो विद्यात्","पादा मात्रा न संशयः","ओंकारं पादशो ज्ञात्वा","न किंचिदपि चिन्तयेत्"],"अनुष्टुभ् (श्लोकः)"],["1",25,["युञ्जीत प्रणवे चेतः","प्रणवो ब्रह्म निर्भयम्","प्रणवे नित्ययुक्तस्य","न भयं विद्यते क्वचित्"],"अनुष्टुभ् (श्लोकः)"],["1",26,["प्रणवो ह्यपरं ब्रह्म","प्रणवश्च परः स्मृतः","अपूर्वोऽनन्तरोऽबा","ह्यो अनपरः प्रणवोऽव्ययः"],""],["1",27,["सर्वस्य प्रणवो ह्यादिर्","मध्यमन्तस्तथैव च","एवं हि प्रणवं ज्ञात्वा","व्यश्नुते तदनन्तरम्"],"अनुष्टुभ् (श्लोकः)"],["1",28,["प्रणवं हीश्वरं विद्यात्","सर्वस्य हृदि संस्थितम्","सर्वव्यापिनमोंकारं","मत्वा धीरो न शोचति"],"अनुष्टुभ् (श्लोकः)"],["1",29,["अमात्रोऽनन्तमात्रश्च","द्वैतस्योपशमः शिवः","ओंकारो विदितो येन","स मुनिर्नेतरो जनः"],"अनुष्टुभ् (श्लोकः)"],["2",1,["वैतथ्यं सर्वभावानां","स्वप्ने आहुर्मनीषिणः","अन्तःस्थानात्तु भावानां","संवृतत्वेन हेतुना"],"अनुष्टुभ् (श्लोकः)"],["2",2,["अदीर्घत्वाच्च कालस्य","गत्वा देशान्न पश्यति","प्रतिबुद्धश्च वै सर्वस्","तस्मिन्देशे न विद्यते"],"अनुष्टुभ् (श्लोकः)"],["2",3,["अभावश्च रथादीनां","श्रूयते न्यायपूर्वकम्","वैतथ्यं तेन वै प्राप्तं","स्वप्ने आहुः प्रकाशितम्"],"अनुष्टुभ् (श्लोकः)"],["2",4,["अन्तःस्थानात्तु भेदानां","तस्माज्जागरिते स्मृतम्","यथा तत्र तथा स्वप्ने","संवृतत्वेन भिद्यते"],"अनुष्टुभ् (श्लोकः)"],["2",5,["स्वप्नजागरितस्थाने ह्य्","एकमाहुर्मनीषिणः","भेदानां हि समत्वेन","प्रसिद्धेनैव हेतुना"],"अनुष्टुभ् (श्लोकः)"],["2",6,["आदावन्ते च यन्नास्ति","वर्तमानेऽपि तत्तथा","वितथैः सदृशाः सन्तो अ","वितथा इव लक्षिताः"],"अनुष्टुभ् (श्लोकः)"],["2",7,["सप्रयोजनता तेषां","स्वप्ने विप्रतिपद्यते","तस्मादाद्यन्तवत्त्वेन","मिथ्यैव खलु ते स्मृताः"],"अनुष्टुभ् (श्लोकः)"],["2",8,["अपूर्वं स्थानिधर्मो हि","यथा स्वर्गनिवासिनाम्","तानयं प्रेक्षते गत्वा","यथैवेह सुशिक्षितः"],"अनुष्टुभ् (श्लोकः)"],["2",9,["स्वप्नवृत्तावपि त्वन्तश्","चेतसा कल्पितं त्वसत्","बहिश्चेतोगृहीतं सद्","दृष्टं वैतथ्यमेतयोः"],"अनुष्टुभ् (श्लोकः)"],["2",10,["जाग्रद्वृत्तावपि त्वन्तश्","चेतसा कल्पितं त्वसत्","बहिश्चेतोगृहीतं सद्","युक्तं वैतथ्यमेतयोः"],"अनुष्टुभ् (श्लोकः)"],["2",11,["उभयोरपि वैतथ्यं","भेदानां स्थानयोर्यदि","क एतान्बुध्यते भेदान्","को वै तेषां विकल्पकः"],"अनुष्टुभ् (श्लोकः)"],["2",12,["कल्पयत्यात्मनात्मानम्","आत्मा देवः स्वमायया","स एव बुध्यते भेदान्","इति वेदान्तनिश्चयः"],"अनुष्टुभ् (श्लोकः)"],["2",13,["विकरोत्यपरान्भावान्","अन्तश्चित्ते व्यवस्थितान्","नियतांश्च बहिश्चित्ते","एवं कल्पयते प्रभुः"],"अनुष्टुभ् (श्लोकः)"],["2",14,["चित्तकाला हि येऽन्तस्तु","द्वयकालाश्च ये बहिः","कल्पिता एव ते सर्वे","विशेषो नान्यहेतुकः"],"अनुष्टुभ् (श्लोकः)"],["2",15,["अव्यक्ता एव येऽन्तस्तु","स्फुटा एव च ये बहिः","कल्पिता एव ते सर्वे","विशेषस्त्विन्द्रियान्तरे"],"अनुष्टुभ् (श्लोकः)"],["2",16,["जीवं कल्पयते पूर्वं","ततो भावान्पृथग्विधान्","बाह्यानाध्यात्मिकांश्चैव","यथाविद्यस्तथास्मृतिः"],"अनुष्टुभ् (श्लोकः)"],["2",17,["अनिश्चिता यथा रज्जुर्","अन्धकारे विकल्पिता","सर्पधारादिभिर्भावैस्","तद्वदात्मा विकल्पितः"],"अनुष्टुभ् (श्लोकः)"],["2",18,["निश्चितायां यथा रज्ज्वां","विकल्पो विनिवर्तते","रज्जुरेवेति चाद्वैतं","तद्वदात्मविनिश्चयः"],"अनुष्टुभ् (श्लोकः)"],["2",19,["प्राणादिभिरनन्तैश्च","भावैरेतैर्विकल्पितः","मायैषा तस्य देवस्य","यया संमोहितः स्वयम्"],"अनुष्टुभ् (श्लोकः)"],["2",20,["प्राण इति प्राणविदो","भूतानीति च तद्विदः","गुणा इति गुणविदस्","तत्त्वानीति च तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",21,["पादा इति पादविदो","विषया इति तद्विदः","लोका इति लोकविदो","देवा इति च तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",22,["वेदा इति वेदविदो","यज्ञा इति च तद्विदः","भोक्तेति च भोक्तृविदो","भोज्यमिति च तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",23,["सूक्ष्म इति सूक्ष्मविदः","स्थूल इति च तद्विदः","मूर्त इति मूर्तविदो अ","मूर्त इति च तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",24,["काल इति कालविदो","दिश इति च तद्विदः","वादा इति वादविदो","भुवनानीति तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",25,["मन इति मनोविदो","बुद्धिरिति च तद्विदः","चित्तमिति चित्तविदो","धर्माधर्मौ च तद्विदः"],"अनुष्टुभ् (श्लोकः)"],["2",26,["पञ्चविंशक इत्येके","षड्विंश इति चापरे","एकत्रिंशक इत्याहुर्","अनन्त इति चापरे"],"अनुष्टुभ् (श्लोकः)"],["2",27,["लोकांल्लोकविदः प्राहुर्","आश्रमा इति तद्विदः","स्त्रीपुंनपुंसकं लैङ्गाः","परापरमथापरे"],"अनुष्टुभ् (श्लोकः)"],["2",28,["सृष्टिरिति सृष्टिविदो","लय इति च तद्विदः","स्थितिरिति स्थितिविदः","सर्वे चेह तु सर्वदा"],"अनुष्टुभ् (श्लोकः)"],["2",29,["यं भावं दर्शयेद्यस्य","तं भावं स तु पश्यति","तं चावति स भूत्वासौ","तद्ग्रहः समुपैति तम्"],"अनुष्टुभ् (श्लोकः)"],["2",30,["एतैरेषो अपृथग्","भावैः पृथगेवेति लक्षितः","एवं यो वेद तत्त्वेन","कल्पयेत्सोऽविशङ्कितः"],""],["2",31,["स्वप्नमाये यथा दृष्टे","गन्धर्वनगरं यथा","तथा विश्वमिदं दृष्टं","वेदान्तेषु विचक्षणैः"],"अनुष्टुभ् (श्लोकः)"],["2",32,["न निरोधो न चोत्पत्तिर्","न बद्धो न च साधकः","न मुमुक्षुर्न वै मुक्त","इत्येषा परमार्थता"],"अनुष्टुभ् (श्लोकः)"],["2",33,["भावैरसद्भिरेवायम्","अद्वयेन च कल्पितः","भावा अप्यद्वयेनैव","तस्मादद्वयता शिवा"],"अनुष्टुभ् (श्लोकः)"],["2",34,["नात्मभावेन नानेदं","न स्वेनापि कथंचन","न पृथङ्नापृथक्किंचिद्","इति तत्त्वविदो विदुः"],"अनुष्टुभ् (श्लोकः)"],["2",35,["वीतरागभयक्रोधैर्","मुनिभिर्वेदपारगैः","निर्विकल्पो ह्ययं दृष्टः","प्रपञ्चोपशमोऽद्वयः"],"अनुष्टुभ् (श्लोकः)"],["2",36,["तस्मादेवं विदित्वैनम्","अद्वैते योजयेत्स्मृतिम्","अद्वैतं समनुप्राप्य","जडवल्लोकमाचरेत्"],"अनुष्टुभ् (श्लोकः)"],["2",37,["निःस्तुत