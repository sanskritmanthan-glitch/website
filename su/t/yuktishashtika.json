{"id":"yuktishashtika","v":[["1",1,["भावाभावव्यतिक्रान्ता","मतिर्येषामनाश्रिता","तैर्गम्भीरो निरलम्बः","प्रत्ययार्थः प्रतीयते"],"अनुष्टुभ् (श्लोकः)"],["1",2,["सर्वदोषाकरस्ताव","दभावो विनिवारितः","निर्वर्त्यते यथा युक्","तया भावोऽपि श्र्ववणं कुरु"],""],["1",3,["भावो यदि भवेत्सत्य्य","था बालैर्विकल्पितः","विमोक्षस्तदभावेन","को नेच्छेत्किम्न कार्नात्"],""],["1",4,["विमोक्षो नास्ति भावेन","भावो नास्ति ह्यभावतः","भावाभावपरिज्ञानान्","महात्माऽपि विमुच्यते"],"अनुष्टुभ् (श्लोकः)"],["1",5,["निर्वाणम्चैव लोकं च","मन्यन्ते तत्त्वदर्शिनः","नैव लोकं न निर्वानं","मन्यन्ते तत्त्वदर्शिनः"],"अनुष्टुभ् (श्लोकः)"],["1",6,["निर्वानं च भवश्चैव","द्वयमेव न विद्यते","परिज्ञानं भवस्यैव","निर्वाणमिति कथ्यते"],"अनुष्टुभ् (श्लोकः)"],["1",7,["सम्भवविभवे भावे","निरोधः कल्पितो यथा","मायाकृतो निरोधोऽयम्","सद्भिस्तथैवमिष्यते"],"अनुष्टुभ् (श्लोकः)"],["1",8,["सम्स्कृतो न परिज्ञातो","निरोधो विभवे सति","प्रत्यक्षम्भूयते कस्मिन्","विभवो ज्ञायते कथम्"],"अनुष्टुभ् (श्लोकः)"],["1",9,["यदि स्कन्धनिरोधेन","भवेन्न क्लेशसम्क्षयः","यदा चायं निरुद्धः स्यात्","तदा मोक्षो भविस्यति"],"अनुष्टुभ् (श्लोकः)"],["1",10,["अविद्या प्रत्ययोत्पन्नम्","सम्यग्ज्ञानेन पश्यतः","नोत्पादश्च निरोधस्च","युक्तः कोऽप्युपलभ्यते"],"अनुष्टुभ् (श्लोकः)"],["1",11,["एवम्पश्यति धर्मः यो","निर्वानम्वा कतम्तथा","धर्मज्ञानम्परं यत्र","भेदस्तु तत्र विद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",12,["अतिसुक्ष्मस्य भावस्य","जातिर्येन विकल्पिता","प्रत्ययोद्भवमर्थम्न","पश्यति सोऽविचक्षणः"],"अनुष्टुभ् (श्लोकः)"],["1",13,["सम्क्लेसक्षीनभिक्षूणाम्","सम्साराच्चेन्निवार्यते","कुतः सम्पन्नबुद्धैश्च","तस्यारम्भो न भाषितः"],"अनुष्टुभ् (श्लोकः)"],["1",14,["आरम्भे सति चैकान्","ते भवेदृष्टिपरिग्रः","यः प्रतीत्यसमुत्पाद","स्तस्य पुर्वं परं वा किम्"],"अनुष्टुभ् (श्लोकः)"],["1",15,["समुत्पन्नं कथं पुर्वं","पश्चात्पुनर्निवार्यते","पुर्वापरान्तविहीनो","मोक्षः ख्यातिर्मायोपमः"],"अनुष्टुभ् (श्लोकः)"],["1",16,["भवतीदम्यदा माया","नम्क्ष्यतीति तदैव हि","मायाज्ञानपराभूतो","मायाज्ञानेन मोहितः"],"अनुष्टुभ् (श्लोकः)"],["1",17,["यथा मरीचिका माया भ","वम्बुद्धया हि पश्यति","पुर्वान्तम्वापरान्तम्वा न","दृष्टया परिक्लिश्यते"],""],["1",18,["सम्स्कृतम्ये हि मन्यन्ते","भन्गोत्पादविकल्पितम्","प्रतीत्योत्पादचक्रेण","विजानन्ति न ते जगत्"],"अनुष्टुभ् (श्लोकः)"],["1",19,["तदाश्रित्य यदुत्पन्नं","नोत्पन्नं स्वयमेवहि","स्वयम्यदा यदुत्पन्न","मुत्पन्नम्नाम तत्कथम्"],"अनुष्टुभ् (श्लोकः)"],["1",20,["शान्तम्हेतुक्षयादेव","क्षीणम्नामावबुध्यते","स्वभावेन हि यत्क्षीणम्","तत्क्षीणमुच्यते कथम्"],"अनुष्टुभ् (श्लोकः)"],["1",21,["न कश्चिदनुत्पन्नम्नि","रोधोऽपि न वै तथा","उत्पादभन्गकर्मणा","भिप्रायार्थः प्रदर्शितः"],"अनुष्टुभ् (श्लोकः)"],["1",22,["उत्पादज्ञानतो भङ्गो","भङ्गज्ञानादनित्यता","अनित्यत्वावबोधाच्च","सद्धर्मो हि विबोधितः"],"अनुष्टुभ् (श्लोकः)"],["1",23,["यः प्रतीत्यसमुत्पाद","उत्पादभङ्गवर्जितम्","परिजानाति तेनैव","नुत्तीर्यत भवाबुधिः"],"अनुष्टुभ् (श्लोकः)"],["1",24,["सदसद्भिर्विपर्यस्ता","आत्मभावाः पृथग्जनाः","क्लेशवम्शगताः सत्त्वा","आत्मचिन्त्तेन वञ्चिताः"],"अनुष्टुभ् (श्लोकः)"],["1",25,["विवुधैर्भाव्यते भावेह्","शुन्योऽनित्योऽनात्मकः","मोषधर्मचयश्चैव","विविक्त इति दृश्यते"],"अनुष्टुभ् (श्लोकः)"],["1",26,["अमूलत्वात्स्थितिर्नैव","निरालम्बो निराश्रयः","अविद्याहेतुसम्भूत","आदिमध्यान्तवर्जितः"],"अनुष्टुभ् (श्लोकः)"],["1",28,["कदलीवसारम्यद्गन्धर्वनगरम्यथा","मोहपुर्यामिविवन्नौ यो मायावत्पश्यति जगत्","अत्र ब्रह्मादिलोको वै सत्य इवावभासने","सत्यन्मृषेत्युक्तमार्येन तत्र का शिष्यते परा"],""],["1",29,["लोकोऽविद्यान्धभूतोऽसौ","तृष्नास्त्रोतसा चालितः","तृष्नारहितविज्ञस्य","पुण्यदृष्टि समा कुतः"],"अनुष्टुभ् (श्लोकः)"],["1",30,["आदौ तत्त्वमिदं दृ","ष्टम्सर्वम्स्तीति कथ्यते","जानन्नर्थान्नसक्तोऽपि","पश्चान्नुनम्विविच्यते"],"अनुष्टुभ् (श्लोकः)"],["1",31,["न जानाति विविक्तार्थ","श्रुतिमात्रम्प्रवर्तते","येषाम्पुण्यमविच्छिन्न","मुत्सन्ना इतरे जनाः"],"अनुष्टुभ् (श्लोकः)"],["1",32,["कर्मानि फलयुक्तानि","प्रोक्तम्सम्यगिदम्जगत्","तत्स्वभावपरिज्ञान","मनुत्पन्नम्हि देसितम्"],"अनुष्टुभ् (श्लोकः)"],["1",33,["अहम्ममेति कथितम्","यथाकर्यवशाज्जनैः","तथा कार्यवशात्प्रोक्ताः","स्कन्धायतनधातवः"],"अनुष्टुभ् (श्लोकः)"],["1",34,["महाभूतादय ख्याता","विज्ञाने निचयस्तथा","तज्ज्ञानेन वियुक्त्तेन","मृषैव न विकल्पितम्"],"अनुष्टुभ् (श्लोकः)"],["1",35,["निर्वानम्सत्यमेकम्हि","जिनैर्यदभिधीयते","नाव शिष्टम्तदा सत्य","मेवम्विज्ञेन कल्पितम्"],"अनुष्टुभ् (श्लोकः)"],["1",36,["यावचित्तस्य विक्षेप","स्तावन्मारस्य गोचरः","एवम्भूतो भवेद्यत्र","ना दोषो जायते कथं"],"अनुष्टुभ् (श्लोकः)"],["1",37,["अविद्याप्रत्ययो लोको","यस्माद्बुद्धैः प्रकीर्तितः","विकल्पस्तेन लोकोऽय","मिति किम्नोपपद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",38,["अविद्यायाम्निरुद्धायाम्","निरोधो जायते यथा","अज्ञानतो हि सम्कल्प","इति किम्न विधीयते"],"अनुष्टुभ् (श्लोकः)"],["1",39,["हेतुतः सम्भवो यस्य","स्थिति र्न प्रत्ययैर्विना","विगमः प्रत्ययाभावात्","सोऽस्तीत्यवगतः कुतः"],"अनुष्टुभ् (श्लोकः)"],["1",40,["परमम्भावामश्रित्य","स्थितिश्चेद्भाववादिनः","तदैव हि स्थिता मार्गे न","कश्चिदितस्मयस्ततः"],"अनुष्टुभ् (श्लोकः)"],["1",41,["बुद्धमार्गे श्रिताः सर्वे","ऽनित्यमिति वादिनः","केन वादेन गृह्यन्ते","भावाः सन्ति परा इति"],"अनुष्टुभ् (श्लोकः)"],["1",42,["एष वासाविति यत्र","विमर्शो नोपलभ्यते","इदम्सत्यमदो वेति","पण्डितैः कथमुच्यतै"],"अनुष्टुभ् (श्लोकः)"],["1",43,["नानुपादाय तैश्चापि","लोको वात्माभिकाङ्क्षते","नित्यानित्यादेरूत्पादह्","मिथ्यादृष्ट्या तु हारितः"],"अनुष्टुभ् (श्लोकः)"],["1",44,["येषाम्भावास्मुपादाय","तत्त्वा स्तेषाम्प्रसादिताः","तत्र लिङ्गादयो दोषाः","प्रजायन्ते न वा कथं"],"अनुष्टुभ् (श्लोकः)"],["1",45,["यान्हि धर्मानुपादाय","दृष्टश्चन्द्रो जले यथा","तत्र सत्यम्मृषा नैव","कामं दृष्ट्या न हारितः"],"अनुष्टुभ् (श्लोकः)"],["1",46,["रागद्वेषोद्भवस्तीव्र","दुष्टदृष्टिपरिग्रः","विवादास्तत्समुत्थाश्च","भावाभ्युपगमे सति"],"अनुष्टुभ् (श्लोकः)"],["1",47,["स हेतुः सर्वदृष्टीनाम्","क्लेशोत्पत्ति र्न तम्विना","तस्मात्त्स्मिन्परिज्ञाते दृ","ष्टिक्लेशपरिक्षयः"],"अनुष्टुभ् (श्लोकः)"],["1",48,["परिज्ञाञ्च केनेति","प्रतीत्योत्पाददर्शनात्","प्रतीत्य जातञ्चऽजात","माह तत्त्वविदाम्वरः"],"अनुष्टुभ् (श्लोकः)"],["1",49,["मिथ्याज्ञाने परिभूय","योऽसत्ये सत्यधारकः","परिग्रहो वितर्कादेः","क्रमाद्रागक्रिया मता"],"अनुष्टुभ् (श्लोकः)"],["1",50,["महात्मनाम्न पक्षो वा","वितर्को वा न विद्यते","येषाम्न विद्यते पक्षेः","परपक्षः कुतस्तेषाम्"],"अनुष्टुभ् (श्लोकः)"],["1",51,["यस्मिन्नेव समाश्रितो","दष्टः क्लेशविषधरैह्","चलं वानिष्ठितम्चित्तं","न तिष्ठत्यनाश्रितम्"],"अनुष्टुभ् (श्लोकः)"],["1",52,["साश्रय चित्तवान सत्","त्वेः क्लेशोद्भूतो विषो महान्","सदा पृथगजनो हीनः","क्लेशसर्पेन गृहीतः"],""],["1",53,["प्रतिविम्बे यथा रागो","लोके च मोहवन्धनात्","विषयपिन्जरो सक्तो","बालो हि सत्यसम्ज्ञया"],"अनुष्टुभ् (श्लोकः)"],["1",54,["चक्षुर्भ्याम्विषयान्नाम","विम्बज्ञानेन पश्यति","कर्मपङ्केष्वनासक्तो","भावो यथा महात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1",55,["रूपासक्ता जना मुढा","मध्यमा रागवर्जिताः","रूपस्वभावविज्ञो यो","विमुक्तो बुद्धिमान्परः"],"अनुष्टुभ् (श्लोकः)"],["1",56,["विवृत्य सुखचिन्तायाः","वीतरागविवर्जितः","मायापुम्वद्विपश्यनान्न्","इवृतः स भविष्यति"],"अनुष्टुभ् (श्लोकः)"],["1",57,["मिथ्याज्ञानभितप्तो यः","क्लेशसम्दोषभाग्भावेत्","भावाभावौ विकल्पना","दर्थज्ञानम्न जायते"],"अनुष्टुभ् (श्लोकः)"],["1",58,["नाश्रय्ः वीतरागा वै भ","वन्ति रागवर्जिताः","अरागे रागवर्धास्ते","न साश्रया महात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1",59,["येषाम्विविक्तचेतसाम्","चलम्चित्तम्चञ्चलम्","क्लेशसर्पेर्मथितोऽपि","तीणोऽखिन्नो भवाम्बुद्धेः"],"अनुष्टुभ् (श्लोकः)"],["1",60,["शास्त्रेणानेन जनानाम्","पुन्यम्ज्ञानम्च सन्चितम्","पुन्यज्ञानक्रियोद्भूतम्","द्वावाप्तोतु परम्तथा"],"अनुष्टुभ् (श्लोकः)"]]}