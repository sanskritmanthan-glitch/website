{"id":"ishvarapratyabhijnakarika","v":[["1.1",1,["कथं चिदासाद्य महेश्वरस्य","दास्यं जनस्याप्युपकारमिच्छन्","समस्तसंपत्समवाप्तिहेतुं","तत्प्रत्यभिज्ञामुपपादयामि"],"उपजातिः"],["1.1",2,["कर्तरि ज्ञातरि स्वात्मन्य्","आदिसिद्धे महेश्वरे","अजडात्मा निषेधं वा","सिद्धिं वा विदधीत कः"],"अनुष्टुभ् (श्लोकः)"],["1.1",3,["किं तु मोहवशादस्मिन्","दृष्टेऽप्यनुपलक्षिते","शक्त्याविष्करणेनेयं","प्रत्यभिज्ञोपदर्श्यते"],"अनुष्टुभ् (श्लोकः)"],["1.1",4,["तथा हि जडभूतानां","प्रतिष्ठा जीवदाश्रया","ज्ञानं क्रिया च भूतानां","जीवतां जीवनं मतम्"],"अनुष्टुभ् (श्लोकः)"],["1.1",5,["तत्र ज्ञानं स्वतःसिद्धं","क्रिया कायाश्रिता सती","परैरप्युपलक्ष्येत","तयान्यज्ञानमूह्यते"],"अनुष्टुभ् (श्लोकः)"],["1.2",1,["ननु स्वलक्षणाभासं","ज्ञानमेकं परं पुनः","साभिलापं विकल्पाख्यं","बहुधा नापि तद्द्वयम्"],"अनुष्टुभ् (श्लोकः)"],["1.2",2,["नित्यस्य कस्य चिद्द्रष्टुस्","तस्यात्रानवभासतः","अहंप्रतीतिरप्येषा","शरीराद्यवसायिनी"],"अनुष्टुभ् (श्लोकः)"],["1.2",3,["अथानुभवविध्वंसे","स्मृतिस्तदनुरोधिनी","कथं भवेन्न नित्यः स्याद्","आत्मा यद्यनुभावकः"],"अनुष्टुभ् (श्लोकः)"],["1.2",4,["सत्याप्यात्मनि दृङ्नाशात्","तद्द्वारा दृष्टवस्तुषु","स्मृतिः केनाथ यत्रैवा-","-नुभवस्तत्पदैव सा"],"अनुष्टुभ् (श्लोकः)"],["1.2",5,["यतो हि पूर्वानुभव-","संस्कारात्स्मृतिसंभवः","यद्येवमन्तर्गडुना","कोऽर्थः स्यात्स्थायिनात्मना"],"अनुष्टुभ् (श्लोकः)"],["1.2",6,["ततो भिन्नेषु धर्मेषु","तत्स्वरूपाविशेषतह्","संस्कारात्स्मृइतिसिद्धौ स्यात्","स्मर्ता द्रष्टेव कल्पितः"],"अनुष्टुभ् (श्लोकः)"],["1.2",7,["ज्ञानं च चित्स्वरूपं चेत्","तदनित्यं किमात्मवत्","अथापि जडमेतस्य","कथमर्थप्रकाशता"],"अनुष्टुभ् (श्लोकः)"],["1.2",8,["अथार्थस्य यथा रूपं","धत्ते बुद्धिस्तथात्मनः","चैतन्यमजडा सैवं","जाड्ये नार्थप्रकासता"],"अनुष्टुभ् (श्लोकः)"],["1.2",9,["क्रियाप्यर्थस्य कायादेस्","तत्तद्देशादिजातता","नान्यादृष्टेर्न साप्येका","क्रमिकैकस्य चोचिता"],"अनुष्टुभ् (श्लोकः)"],["1.2",10,["तत्र तत्र स्थिते तत्तद्","भवतीत्येव दृश्यते","नान्यन्नान्योऽस्ति संबन्धः","कार्यकारणभावतः"],"अनुष्टुभ् (श्लोकः)"],["1.2",11,["द्विष्ठस्यानेकरूपत्वात्","सिद्धस्यान्यानपेक्षणात्","पारतन्त्र्याद्ययोगाच्च","तेन कर्तापि कल्पितः"],"अनुष्टुभ् (श्लोकः)"],["1.3",1,["सत्यं किं तु स्मृतिज्ञानं","पूर्वानुभवसंस्कृतेः","जातमप्यात्मनिष्ठं तन्","नाद्यानुभववेदकम्"],"अनुष्टुभ् (श्लोकः)"],["1.3",2,["दृक्स्वाभासैव नान्येन","वेद्या रूपदृशेव दृक्","रसे संस्कारजत्वं तु","तत्तुल्यत्वं न तद्गतिः"],"अनुष्टुभ् (श्लोकः)"],["1.3",3,["अथातद्विषयत्वेऽपि","स्मृतेस्तदवसायतः","दृष्टालम्बनता भ्रान्त्या","तदेतदसमञ्जसम्"],"अनुष्टुभ् (श्लोकः)"],["1.3",4,["स्मृतितैव कथं तावद्","भ्रान्तेश्चार्थस्थितिः कथम्","पूर्वानुभवसंकारा-","-पेक्षा च किमितीष्यते"],"अनुष्टुभ् (श्लोकः)"],["1.3",5,["भ्रान्तित्वे चावसायस्य","न जडाद्विषयस्थितिः","ततोऽजाड्ये निजोल्लेख-","निष्ठान्नार्थस्थितिस्ततः"],"अनुष्टुभ् (श्लोकः)"],["1.3",6,["एवमन्योन्यभिन्नानाम्","अपरस्परवेदिनाम्","ज्ञानानामनुसंधान-","जन्मा नश्येज्जनस्थितिः"],"अनुष्टुभ् (श्लोकः)"],["1.3",7,["न चेदन्तःकृतानन्त-","विश्वरूपो महेश्वरः","स्यादेकश्चिद्वपुर्ज्ञान-","स्मृत्यपोहनशक्तिमान्"],"अनुष्टुभ् (श्लोकः)"],["1.4",1,["स हि पूर्वानुभूतार्थो-","-पलब्धा परतोऽपि सन्","विमृशन्स इति स्वैरी","स्मरतीत्यपदिश्यते"],"अनुष्टुभ् (श्लोकः)"],["1.4",2,["भासयेच्च स्वकालेऽर्थात्","पूर्वाभासितमामृशन्","स्वलक्षणं घटाभास-","मात्रेणाथाखिलात्मना"],"अनुष्टुभ् (श्लोकः)"],["1.4",3,["न च युक्तं स्मृतेर्भेदे","स्मर्यमाणस्य भासनम्","तेनैक्यं भिन्नकालानां","संविदां वेदितैष सः"],"अनुष्टुभ् (श्लोकः)"],["1.4",4,["नैव ह्यनुभवो भाति","स्मृतौ पूर्वोऽर्थवत्पृथक्","प्रागन्वभूवमहमित्य्","आत्मारोहणभासनात्"],"अनुष्टुभ् (श्लोकः)"],["1.4",5,["योगिनामपि भासन्ते","न दृशो दर्शनान्तरे","स्वसंविदेकमानास्ता","भान्ति मेयपदेऽपि वा"],"अनुष्टुभ् (श्लोकः)"],["1.4",6,["स्मर्यते यद्दृगासीन्मे","सैवमित्यपि भेदतः","तद्व्याकरणमेवास्या","मया दृष्टमिति स्मृतेः"],"अनुष्टुभ् (श्लोकः)"],["1.4",7,["या च पश्याम्यहमिमं","घटोऽयमिति वावसा","मन्यते समवेतं साप्य्","अवसातरि दर्शनम्"],"अनुष्टुभ् (श्लोकः)"],["1.4",8,["तन्मया दृश्यते दृष्टो","ऽयं स इत्यामृशत्यपि","ग्राह्यग्राहकताभिन्नाव्","अर्थौ भातः पमातरि"],"अनुष्टुभ् (श्लोकः)"],["1.5",1,["वर्तमानावभासानां","भावानामवभासनम्","अन्तःस्थितवतामेव","घटते बहिरात्मना"],"अनुष्टुभ् (श्लोकः)"],["1.5",2,["प्रागिवार्थोऽप्रकाशः स्यात्","प्रकाशात्मतया विना","न च प्रकाशो भिन्नः स्याद्","आत्मार्थस्य प्रकाशता"],"अनुष्टुभ् (श्लोकः)"],["1.5",3,["भिन्ने प्रकाशे चाभिन्ने","संकरो विषयस्य तत्","प्रकाशात्मा प्रकाश्योऽर्थो","नाप्रकाशश्च सिद्ध्यति"],"अनुष्टुभ् (श्लोकः)"],["1.5",4,["तत्तदाकस्मिकाभासो","बाह्यं चेदनुमापयेत्","न ह्यभिन्नस्य बोधस्य","विचित्राभासहेतुता"],"अनुष्टुभ् (श्लोकः)"],["1.5",5,["न वासनाप्रबोधोऽत्र","विचित्रो हेतुतामियात्","तस्यापि तत्प्रबोधस्य","वैचित्र्ये किम्निबन्धनम्"],"अनुष्टुभ् (श्लोकः)"],["1.5",6,["स्यादेतदवभासेषु","तेष्वेवावसिते सति","व्यवहारे किमन्येन","बाह्येनानुपपत्तिना"],"अनुष्टुभ् (श्लोकः)"],["1.5",7,["चिदात्मैव हि देवोऽन्तः-","स्थितमिच्छावशाद्बहिः","योगीव निरुपादानम्","अर्थजातं प्रकाशयेत्"],"अनुष्टुभ् (श्लोकः)"],["1.5",8,["अनुमानमनाभात-","पूर्वे नैवेष्टमिन्द्रियम्","आभातमेव बीजादेर्","आभासाद्धेतुवस्तुनः"],"अनुष्टुभ् (श्लोकः)"],["1.5",9,["आभासः पुनराभासद्","बाह्यस्यासीत्कथं चन","अर्थस्य नैव तेनास्य","सिद्धिर्नाप्यनुमानतः"],"अनुष्टुभ् (श्लोकः)"],["1.5",10,["स्वामिनश्चात्मसंस्थस्य","भावजातस्य भासनम्","अस्त्येव न विना तस्माद्","इच्छामर्शः प्रवर्तते"],"अनुष्टुभ् (श्लोकः)"],["1.5",11,["स्वभावमवभासस्य","विमर्शं विदुरन्यथा","प्रकाशोऽर्थोपरक्तोऽपि","स्फटिकादिजडोपमः"],"अनुष्टुभ् (श्लोकः)"],["1.5",12,["आत्मात एव चैतन्यं","चित्क्रिया चितिकर्तृता","तात्पर्येणोदितस्तेन","जडात्स हि विलक्षणः"],"अनुष्टुभ् (श्लोकः)"],["1.5",13,["चितिः प्रत्यवमर्शात्मा","परा वाक्स्वरसोदिता","स्वातन्त्र्यमेतन्मुख्यं तद्","ऐश्वर्यं परमात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1.5",14,["सा स्फुरत्ता महासत्ता","देशकालाविशेषिनी","सैषा सारतया प्रोक्ता","हृदयं परमेष्ठिनः"],"अनुष्टुभ् (श्लोकः)"],["1.5",15,["आत्मानमत एवायं","ज्ञेयीकुर्यात्पृथक्स्थिति","ज्ञेयं न तु तदौन्मुख्यात्","खण्ड्येतास्य स्वतन्त्रता"],"अनुष्टुभ् (श्लोकः)"],["1.5",16,["स्वातन्त्र्यामुक्तात्मानं","स्वातन्त्र्यादद्वयात्मनः","प्रभुरीशादिसंकल्पैर्","निर्माय व्यवहारयेत्"],"अनुष्टुभ् (श्लोकः)"],["1.5",17,["नाहन्तादिपरामर्श-","भेदादस्यानयतात्मनः","अहंमृश्यतयाइवास्य","सृष्तेस्तिङ्वाच्यकर्मवत्"],""],["1.5",18,["मायाशक्त्या विभोः सैव","भिन्नसंवेद्यगोचरा","कथिता ज्ञानसंकल्पा-","-ध्यवसायादिनामभिः"],"अनुष्टुभ् (श्लोकः)"],["1.5",19,["साक्षात्कारक्षणेऽप्यस्ति","विमर्शः कथमन्यथा","धावनाद्युपपद्येत","प्रतिसंधानवर्जितम्"],"अनुष्टुभ् (श्लोकः)"],["1.5",20,["घटोऽयमित्यध्यवसा","नामरूपातिरेकिणी","परेशशक्तिरात्मेव","भासते न त्विदन्तया"],"अनुष्टुभ् (श्लोकः)"],["1.5",21,["केवलं भिन्नसम्वेद्य-","देशकालानुरोधतः","ज्ञानस्मृत्यवसायादि","सक्रमं प्रतिभासते"],"अनुष्टुभ् (श्लोकः)"],["1.6",1,["अहंप्रत्यवमर्शो यः","प्रकाशात्मापि वाग्वपुः","नासौ विकल्पः स ह्युक्तो","द्वयाक्षेपी विनिश्चयः"],"अनुष्टुभ् (श्लोकः)"],["1.6",2,["भिन्नयोरवभासो हि","स्याद्घटाघटयोर्द्वयोः","प्रकाशस्येव नान्यस्य","भेदिनस्त्ववभासनम्"],"अनुष्टुभ् (श्लोकः)"],["1.6",3,["तदतत्प्रतिभाभाजा","मात्रैवातद्व्यपोहनात्","तन्निश्चयनमुक्तो हि","विकल्पो घट इत्ययम्"],"अनुष्टुभ् (श्लोकः)"],["1.6",4,["चित्तत्त्वं मायया हित्वा","भिन्न एवावभाति यः","देहे बुद्धावथ प्राणे","कल्पिते नभसीव वा"],"अनुष्टुभ् (श्लोकः)"],["1.6",5,["प्रमातृत्वेनाहमिति","विमर्शोऽन्यव्यपोहनात्","विकल्प एव स पर-","प्रतियोग्यवभासजः"],"अनुष्टुभ् (श्लोकः)"],["1.6",6,["कादाचित्कावभासे या","पूर्वाभासादियोजना","संस्कारात्कल्पना प्रोक्ता","सापि भिन्नावभासिनि"],"अनुष्टुभ् (श्लोकः)"],["1.6",7,["तदेवं व्यवहारेऽपि","प्रभुर्देहादिमाविशन्","भान्तमेवान्त अर्थौघम्","इच्छया भासयेद्बहिः"],"अनुष्टुभ् (श्लोकः)"],["1.6",8,["एवं स्मृतौ विकल्पे वाप्य्","अपोहनपरायणे","ज्ञाने वाप्यन्तराभासः","स्थित एवेति निश्चितम्"],"अनुष्टुभ् (श्लोकः)"],["1.6",9,["किं तु नैसर्गिको ज्ञाने","बहिराभासनात्मनि","पूर्वानुभवरूपस्तु","स्थितः स स्मरणादिषु"],"अनुष्टुभ् (श्लोकः)"],["1.6",10,["स नैसर्गिक एवास्ति","विकल्पे स्वैरचारिणि","यथाभिमतसंस्थाना-","-भासनाद्बुद्धिगोचरे"],"अनुष्टुभ् (श्लोकः)"],["1.6",11,["अत एव यथाभीष्ट-","समुल्लेखावभासनात्","ज्ञानक्रिये स्फुटे एव","सिद्धे सर्वस्य जीवतः"],"अनुष्टुभ् (श्लोकः)"],["1.7",1,["या चैषा प्रतिभा तत्तत्-","पदार्थक्रमरूषिता","अक्रमानन्तचिद्रूपः","प्रमाता स महेश्वरः"],"अनुष्टुभ् (श्लोकः)"],["1.7",2,["तत्तद्विभिन्नसंवित्ति-","मुखैरेकप्रमातरि","प्रतितिष्ठत्सु भावेषु","ज्ञातेयमुपपद्यते"],"अनुष्टुभ् (श्लोकः)"],["1