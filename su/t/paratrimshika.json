{"id":"paratrimshika","v":[["1",1,["अनुत्तरं कथं देव","स्वतः कौलिकसिद्धिदम्","येन विज्ञातमात्रेण","खेचरीसमतां व्रजेत्"],"अनुष्टुभ् (श्लोकः)"],["1",2,["एतद्गुह्यं महागुह्यं","कथयस्व मम प्रभो","हृदयस्था तु या शक्तिः","कौलिनी कुलनायिका"],"अनुष्टुभ् (श्लोकः)"],["1",3,["शृणु देवि महाभगे","उत्तरस्याप्यनुत्तरम्"],"अनुष्टुभ् (श्लोकः)"],["1",4,["कथयामि न संदेहः","सद्यः कौलिकसिद्धिदम्","कौलिकोऽयं विधिर्देवि","मम हृद्व्योम्न्यवस्थितः"],"अनुष्टुभ् (श्लोकः)"],["1",5,["अथाद्यास्तिथयः सर्वे","स्वरा बिन्द्ववसानकाः","तदन्तः कालयोगेन","सोमसूर्यौ प्रकीर्तितौ"],"अनुष्टुभ् (श्लोकः)"],["1",6,["पृथिव्यादीनि तत्त्वानि","पुरुषान्तानि पञ्चसु","क्रमात्कादिषु वर्गेषु","मकारान्तेषु सुव्रते"],"अनुष्टुभ् (श्लोकः)"],["1",7,["वाय्वग्निसलिलेन्द्राणां","धारणानां चतुष्टयम्","तदूर्ध्वे शादिविख्यातम्","पुरस्ताद्ब्रह्मपञ्चकम्"],"अनुष्टुभ् (श्लोकः)"],["1",8,["अमूला तत्क्रमा ज्ञेया","क्षान्ता सृष्टिरुदाहृता","सर्वेषां चैव मन्त्राणां","विद्यानां च यशस्विनि"],"अनुष्टुभ् (श्लोकः)"],["1",9,["चतुर्दशयुतं भद्रे","तिथीशान्तसमन्वितम्","तृतीयम्ब्रह्म सुश्रोणि","हृदयम्भैरवात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1",10,["एतन्ना योगिनीजातो","ना रुद्रो लभते स्फुटम्","हृदयं देवदेवस्य","सद्यो योगविमोक्षदम्"],"अनुष्टुभ् (श्लोकः)"],["1",11,["अस्योच्चारे कृते सम्यङ्","मन्त्रमुद्रागणो महान्","सद्यः सन्मुखतामेति","स्वदेहावेशलक्षणम्"],"अनुष्टुभ् (श्लोकः)"],["1",12,["मुहूर्तं स्मरते यस्तु","चुम्बके नाभिमुद्रितः","स बध्नाति तदा देहं","मन्त्रमुद्रागणं नरः"],"अनुष्टुभ् (श्लोकः)"],["1",13,["अतीतानागतानर्थान्","पृष्टोऽसौ कथयत्यपि","प्रहराद्यदभिप्रेतं","देवतारूपमुच्चरन्"],"अनुष्टुभ् (श्लोकः)"],["1",14,["सक्षात्पश्यत्यसंदिग्धम्","आकृष्टं रुद्रसक्तिभिः","प्रहरद्वयमात्रेण","व्योमस्थो जायते स्मरन्"],"अनुष्टुभ् (श्लोकः)"],["1",15,["त्रयेण मातरः सर्वा","योगेस्वर्यो महाबलाः","वीरा वीरेस्वराः सिद्धा","बलवान्शाकिनीगणः"],"अनुष्टुभ् (श्लोकः)"],["1",16,["आगत्य समयं दत्त्वा","भैरवेण प्रचोदिताः","यच्छन्ति परमां सिद्धिं","फलं यद्वा समीहितम्"],"अनुष्टुभ् (श्लोकः)"],["1",17,["अनेन सिद्धाः सेत्स्यन्ति","साधयन्ति च मन्त्रिणः"],"अनुष्टुभ् (श्लोकः)"],["1",18,["यत्किंचिद्भैरवे तन्त्रे","सर्वमस्मात्प्रसिध्यति","मन्त्रवीर्यसमावेश","प्रभावान्न नियन्त्रिणा"],"अनुष्टुभ् (श्लोकः)"],["1",19,["अदृष्टम।ङ्दलोऽप्येवम्","यः कश्चिद्वेत्ति तत्त्वतः","स सिद्धिभाग्भवेन्नित्यं","स योगी स च दीक्षीतः"],"अनुष्टुभ् (श्लोकः)"],["1",20,["अनेन ज्ञातमात्रेण","ज्ञायते सर्वशक्तिभिः","शाकिनीकुलसामान्यो","भवेद्योगं विनापि हि"],"अनुष्टुभ् (श्लोकः)"],["1",21,["अविधिज्ञो विधानज्ञो","जायते यजनं प्रति","कालाग्निमादितः कृत्वा","मायान्तम्ब्रह्मदेहगम्"],"अनुष्टुभ् (श्लोकः)"],["1",22,["शिवो विश्वद्यनन्तान्तः","परं शक्तित्रयं मतम्","तदन्तर्वर्ति यत्किंचिच्","छुद्धमार्गे व्यवस्थितम्"],"अनुष्टुभ् (श्लोकः)"],["1",23,["अणुर्विशुद्धमचिराद्","ऐस्वरं ज्ञानमश्नुते","तच्चोदकः शिवो ज्ञेयः","सर्वज्ञः परमेश्वरः"],"अनुष्टुभ् (श्लोकः)"],["1",24,["सर्वगो निर्मलः स्वच्छस्","तृप्तः स्वायतनः शुचिः","यथा न्यग्रोधबीजस्थः","शक्तिरूपो महाद्रुमः"],"अनुष्टुभ् (श्लोकः)"],["1",25,["तथा हृदयबीजस्थं","जगदेतच्चराचरम्","एवं यो वेत्ति तत्त्वेन","तस्य निर्वाणगामिनी"],"अनुष्टुभ् (श्लोकः)"],["1",26,["दीक्षा भवत्यसंदिग्धा","तिलाज्याहुतिवर्जिता","मूर्ध्नि वक्त्रे च हृदये","गुह्ये मुर्तौ तथैव च"],"अनुष्टुभ् (श्लोकः)"],["1",27,["न्यासं क्र्त्वा शिखां बद्ध्वा सप्","तविंसतिमन्त्रिताम्","एकैकेन दिशां बन्धं","दशानामपि कारयेत्"],"अनुष्टुभ् (श्लोकः)"],["1",28,["तालत्रयम्पुरा दत्त्वा","सशब्दं विघ्नशान्तये","शिखासंख्याभिजप्तेन","तोयेनाभ्युक्षयेत्ततः"],"अनुष्टुभ् (श्लोकः)"],["1",29,["पुष्पादिकं क्रमात्सर्वं","लिङ्गं वा स्थ।ङ्दिलं च वा","चतुर्दशाभिजप्तेन","पुष्पेणासनकल्पना"],"अनुष्टुभ् (श्लोकः)"],["1",30,["तत्र सृष्टिं यजेद्वीरः","पुनरेवासनं ततः","सृष्टिं तु सम्पुटीकृत्य","पश्चाद्यजनमारभेत्"],"अनुष्टुभ् (श्लोकः)"],["1",31,["सर्वतत्त्वसुसम्पूर्णाम्","सर्वावयवशोभिताम्","यजेद्देवीं महाभागा","सप्तविंशतिमन्त्रिताम्"],"अनुष्टुभ् (श्लोकः)"],["1",32,["ततः सुगन्धिपुष्पैश्च","यथाशक्त्या समर्चयेत्","पूजयेत्परया भक्त्या","स्वात्मनं च निवेदयेत्"],"अनुष्टुभ् (श्लोकः)"],["1",33,["एवं यजनमाख्यातम्","अग्निकार्येऽप्ययं विधिः","कृतपूजाविधिः सम्यक्","स्मरन्बीजम्प्रसिद्ध्यति"],"अनुष्टुभ् (श्लोकः)"],["1",34,["आद्यन्तरहितम्बीजं","विकसत्तिथिमध्यगम्","हृत्पद्मान्तर्गतं ध्यायेत्","सोमांशुं नित्यमभ्यस्येत्"],"अनुष्टुभ् (श्लोकः)"],["1",35,["यान्यान्कामयते कामांस्","तान्ताञ्च्छीघ्रमवाप्नुयात्","अज्ञः प्रत्यक्षतामेति","सर्वज्ञत्वं न संशयः"],"अनुष्टुभ् (श्लोकः)"],["1",36,["एवं मन्त्रफलावप्तिर्","इत्येतद्रुद्रयामलम्","एतदभ्यासतः सिद्धिः","सर्वज्ञत्वमवाप्यते"],"अनुष्टुभ् (श्लोकः)"]]}