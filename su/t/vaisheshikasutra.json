{"id":"vaisheshikasutra","v":[["1.1",1,["अथातो धर्मं व्याख्यास्यामः"],""],["1.1",2,["यतोऽभ्युदयनिःश्रेयससिद्धिः स धर्मः"],""],["1.1",3,["तद्वचनादाम्नायप्रामाण्यम्"],""],["1.1",4,["पृथिव्यापस्तेजो वायुराकाशं कालो दिगात्मा मन इति द्रव्याणि"],""],["1.1",5,["रूपरसगन्धस्पर्शाः संख्याः परिमाणानि पृथक्त्वं संयोगविभागौ परत्वापरत्वे बुद्धयः सुखदुःखे इच्छाद्वेषौ प्रयत्नश्च गुणाः"],""],["1.1",6,["उत्क्षेपणमवक्षेपणमाकुञ्चनं प्रसारणं गमनमिति कर्माणि"],""],["1.1",7,["सदनित्यं द्रव्यवत्कार्यं कारणं सामान्यविशेषवदिति द्रव्यगुणकर्मणामविशेषः"],""],["1.1",8,["द्रव्याणि द्रव्यान्तरमारभन्ते"],""],["1.1",9,["गुणाश्च गुणान्तरम्"],""],["1.1",10,["कर्म कर्मसाध्यं न विद्यते"],""],["1.1",11,["कार्याविरोधि द्रव्यं कारणाविरोधि च"],""],["1.1",12,["उभय्तथा गुणः"],""],["1.1",13,["कार्यविरोधि कर्म"],""],["1.1",14,["क्रियावद्गुणवत्समवायिकारणमिति द्रव्यलक्षणम्"],""],["1.1",15,["द्रव्याश्रय्यगुणवान्संयोगविभागेष्वकारणमनपेक्ष इति गुणलक्षणम्"],""],["1.1",16,["एकद्रव्यमगुणं संयोगविभागेष्वनपेक्षं कारणमिति कर्मलक्षणम्"],""],["1.1",17,["द्रव्यगुणकर्मणां द्रव्यं कारणं सामान्यम्"],""],["1.1",18,["तथा गुणः"],""],["1.1",19,["संयोगविभागानां कर्म"],""],["1.1",20,["न द्रव्याणां व्यतिरेकात्"],""],["1.1",21,["गुणवैधर्म्यान्न कर्मणां"],""],["1.1",22,["द्रव्याणां द्रव्यं कार्यं सामान्यम्"],""],["1.1",23,["द्वित्वप्रभृतयश्च संख्याः पृथक्त्वं संयोगविभागाश्च"],""],["1.1",24,["असमवायात्सामान्यं कर्म कार्यं न विद्यते"],""],["1.1",25,["संयोगानां द्रव्यम्"],""],["1.1",26,["रूपानां रूपम्"],""],["1.1",27,["गुरुत्वप्रयत्नसंयोगानामुत्क्षेपणम्"],""],["1.1",28,["संयोगविभागाः कर्मणाम्"],""],["1.1",29,["कारणसामान्ये द्रव्यकर्मणां कर्माकारणमुक्तम्"],""],["1.2",1,["कारणाभावात्कार्याभावः"],""],["1.2",2,["न तु कार्याभवात्कारणाभावः"],""],["1.2",3,["सामान्यं विशेष इति बुद्ध्यपेक्षम्"],""],["1.2",4,["भावः सामान्यमेव"],""],["1.2",5,["द्रव्यत्वं गुणत्वं कर्मत्वं च सामान्यानि विशेषाश्च"],""],["1.2",6,["अन्यत्रान्त्येभ्यो विशेषेभ्यः"],""],["1.2",7,["सदिति यतो द्रव्यगुणकर्मसु"],""],["1.2",8,["द्रव्यगुणकर्मभ्योऽर्थान्तरं सत्ता"],""],["1.2",9,["एक