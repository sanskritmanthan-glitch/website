{"id":"vijnanabhairava","v":[["1",1,["श्रुतं देव मया सर्वं","रुद्रयामलसम्भवम्","त्रिकभेदमशेषेण","सारात्सारविभागशः"],"अनुष्टुभ् (श्लोकः)"],["1",2,["अद्यापि न निवृत्तो मे","संशयः परमेश्वर","किं रूपं तत्त्वतो देव","शब्दराशिकलामयम्"],"अनुष्टुभ् (श्लोकः)"],["1",3,["किं वा नवात्मभेदेन","भैरवे भैरवाकृतौ","त्रिशिरोभेदभिन्नं वा","किं वा शक्तित्रयात्मकम्"],"अनुष्टुभ् (श्लोकः)"],["1",4,["नादबिन्दुमयं वापि","किं चन्द्रार्धनिरोधिकाः","चक्रारूढमनच्कं वा","किं वा शक्तिस्वरूपकम्"],"अनुष्टुभ् (श्लोकः)"],["1",5,["परापरायाः सकलम्","अपरायाश्च वा पुनः","पराया यदि तद्वत्स्यात्","परत्वं तद्विरुध्यते"],"अनुष्टुभ् (श्लोकः)"],["1",6,["न हि वर्णविभेदेन","देहभेदेन वा भवेत्","परत्वं निष्कलत्वेन","सकलत्वे न तद्भवेत्"],"अनुष्टुभ् (श्लोकः)"],["1",7,["साधु साधु त्वया पृष्टं","तन्त्रसारमिदम्प्रिये"],"अनुष्टुभ् (श्लोकः)"],["1",8,["गूहनीयतमम्भद्रे","तथापि कथयामि ते","यत्किंचित्सकलं रूपं","भैरवस्य प्रकीर्तितम्"],"अनुष्टुभ् (श्लोकः)"],["1",9,["तदसारतया देवि","विज्ञेयं शक्रजालवत्","मायास्वप्नोपमं चैव","गन्धर्वनगरभ्रमम्"],"अनुष्टुभ् (श्लोकः)"],["1",10,["ध्यानार्थम्भ्रान्तबुद्धीनां","क्रियाडम्बरवर्तिनाम्","केवलं वर्णितम्पुंसां","विकल्पनिहतात्मनाम्"],"अनुष्टुभ् (श्लोकः)"],["1",11,["तत्त्वतो न नवात्मासौ","शब्दराशिर्न भैरवः","न चासौ त्रिशिरा देवो","न च शक्तित्रयात्मकः"],"अनुष्टुभ् (श्लोकः)"],["1",12,["नादबिन्दुमयो वापि","न चन्द्रार्धनिरोधिकाः","न चक्रक्रमसम्भिन्नो","न च शक्तिस्वरूपकः"],"अनुष्टुभ् (श्लोकः)"],["1",13,["अप्रबुद्धमतीनां हि","एता बलविभीषिकाः","मातृमोदकवत्सर्वं","प्रवृत्त्यर्थं उदाहृतम्"],"अनुष्टुभ् (श्लोकः)"],["1",14,["दिक्कालकलनोन्मुक्ता","देशोद्देशाविशेषिनी","व्यपदेष्टुमशक्यासाव्","अकथ्या परमार्थतः"],"अनुष्टुभ् (श्लोकः)"],["1",15,["अन्तःस्वानुभवानन्दा","विकल्पोन्मुक्तगोचरा","यावस्था भरिताकारा","भैरवी भैरवात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1",16,["तद्वपुस्तत्त्वतो ज्ञेयं","विमलं विश्वपूरणम्","एवंविधे परे तत्त्वे","कः पूज्यः कश्च तृप्यति"],"अनुष्टुभ् (श्लोकः)"],["1",17,["एवंविधा भैरवस्य","यावस्था परिगीयते","सा परा पररूपेण","परा देवी प्रकीर्तिता"],"अनुष्टुभ् (श्लोकः)"],["1",18,["शक्तिशक्तिमतोर्यद्वद्","अभेदः सर्वदा स्थितः","अतस्तद्धर्मधर्मित्वात्","परा शक्तिः परात्मनः"],"अनुष्टुभ् (श्लोकः)"],["1",19,["न वह्नेर्दाहिका शक्तिर्","व्यतिरिक्ता विभाव्यते","केवलं ज्ञानसत्तायाम्","प्रारम्भोऽयम्प्रवेशने"],"अनुष्टुभ् (श्लोकः)"],["1",20,["शक्त्यवस्थाप्रविष्टस्य","निर्विभागेन भावना","तदासौ शिवरूपी स्यात्","शैवी मुखमिहोच्यते"],"अनुष्टुभ् (श्लोकः)"],["1",21,["यथालोकेन दीपस्य","किरणैर्भास्करस्य च","ज्ञायते दिग्विभागादि","तद्वच्छक्त्या शिवः प्रिये"],"अनुष्टुभ् (श्लोकः)"],["1",22,["देवदेव त्रिशूलाङ्क","कपालकृतभूषण","दिग्देशकालशून्या च","व्यपदेशविवर्जिता"],"अनुष्टुभ् (श्लोकः)"],["1",23,["कैरुपायैर्मुखं तस्य","परा देवि कथम्भवेत्","यथा सम्यगहं वेद्मि","तथा मे ब्रूहि भैरव"],"अनुष्टुभ् (श्लोकः)"],["1",24,["ऊर्ध्वे प्राणो ह्यधो जीवो","विसर्गात्मा परोच्चरेत्","उत्पत्तिद्वितयस्थाने","भरणाद्भरिता स्थितिः"],"अनुष्टुभ् (श्लोकः)"],["1",25,["मरुतोऽन्तर्बहिर्वापि","वियद्युग्मानिवर्तनात्","भैरव्या भैरवस्येत्थम्","भैरवि व्यज्यते वपुः"],"अनुष्टुभ् (श्लोकः)"],["1",26,["न व्रजेन्न विशेच्छक्तिर्","मरुद्रूपा विकासिते","निर्विकल्पतया मध्ये","तया भैरवरूपता"],"अनुष्टुभ् (श्लोकः)"],["1",27,["कुम्भिता रेचिता वापि","पूरिता वा यदा भवेत्","तदन्ते शान्तनामासौ","शक्त्या शान्तः प्रकाशते"],"अनुष्टुभ् (श्लोकः)"],["1",28,["आमूलात्किरणाभासां","सूक्ष्मात्सूक्ष्मतरात्मिकम्","चिन्तयेत्तां द्विषट्कान्ते","श्याम्यन्तीम्भैरवोदयः"],"अनुष्टुभ् (श्लोकः)"],["1",29,["उद्गच्छन्तीं तडित्रूपाम्","प्रतिचक्रं क्रमात्क्रमम्","ऊर्ध्वं मुष्टित्रयं यावत्","तावदन्ते महोदयः"],"अनुष्टुभ् (श्लोकः)"],["1",30,["क्रमद्वादशकं सम्यग्","द्वादशाक्षरभेदितम्","स्थूलसूक्ष्मपरस्थित्या","मुक्त्वा मुक्त्वान्ततः शिवः"],"अनुष्टुभ् (श्लोकः)"],["1",31,["तयापूर्याशु मूर्धान्तं","भङ्क्त्वा भ्रूक्षेपसेतुना","निर्विकल्पं मनः कृत्वा","सर्वोर्ध्वे सर्वगोद्गमः"],"अनुष्टुभ् (श्लोकः)"],["1",32,["शिखिपक्षैश्चित्ररूपैर्","म।ङ्दलैः शून्यपञ्चकम्","ध्यायतोऽनुत्तरे शून्ये","प्रवेशो हृदये भवेत्"],"अनुष्टुभ् (श्लोकः)"],["1",33,["ईदृशेन क्रमेणैव","यत्र कुत्रापि चिन्तना","शून्ये कुड्ये परे पात्रे","स्वयं लीना वरप्रदा"],"अनुष्टुभ् (श्लोकः)"],["1",34,["कपालान्तर्मनो न्यस्य"