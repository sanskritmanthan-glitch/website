["3",13,["ततः शनैः शनैरेव","रेचयेन्नैव वेगतः","महामुद्रां च तेनैव","वदन्ति विबुधोत्तमाः"],"अनुष्टुभ् (श्लोकः)"],["3",14,["महाक्लेशादयो दोषाः","क्षीयन्ते मरणादयः","महामुद्रां च तेनैव","वदन्ति विबुधोत्तमाः"],"अनुष्टुभ् (श्लोकः)"],["3",15,["चन्द्राङ्गे तु समभ्यस्य","सूर्याङ्गे पुनरभ्यसेत्","यावत्तुल्या भवेत्सङ्ख्या","ततो मुद्रां विसर्जयेत्"],"अनुष्टुभ् (श्लोकः)"],["3",16,["न हि पथ्यमपथ्यं वा","रसाः सर्वेऽपि नीरसाः","अपि भुक्तं विषं घोरं","पीयूषमपि जीर्यति"],"अनुष्टुभ् (श्लोकः)"],["3",17,["क्षयकुष्ठगुदावर्त","गुल्माजीर्णपुरोगमाः","तस्य दोषाः क्षयं यान्ति","महामुद्रां तु योऽभ्यसेत्"],"अनुष्टुभ् (श्लोकः)"],["3",18,["कथितेयं महामुद्रा","महासिद्धिकरा नॄणाम्","गोपनीया प्रयत्नेन","न देया यस्य कस्यचित्"],"अनुष्टुभ् (श्लोकः)"],["3",19,["पार्ष्णिं वामस्य पादस्य","योनिस्थाने नियोजयेत्","वामोरूपरि संस्थाप्य","दक्षिणं चरणं तथा"],"अनुष्टुभ् (श्लोकः)"],["3",20,["पूरयित्वा ततो वायुं","हृदये चुबुकं दृढम्","निष्पीड्यं वायुमाकुञ्च्य","मनोमध्ये नियोजयेत्"],"अनुष्टुभ् (श्लोकः)"],["3",21,["धारयित्वा यथाशक्ति","रेचयेदनिलं शनैः","सव्याङ्गे तु समभ्यस्य","दक्षाङ्गे पुनरभ्यसेत्"],"अनुष्टुभ् (श्लोकः)"],["3",22,["मतमत्र तु केषांचित्","कण्ठबन्धं विवर्जयेत्","राजदन्तस्थजिह्वाया","बन्धः शस्तो भवेदिति"],"अनुष्टुभ् (श्लोकः)"],["3",23,["अयं तु सर्वनाडीनाम्","ऊर्ध्वं गतिनिरोधकः","अयं खलु महाबन्धो","महासिद्धिप्रदायकः"],"अनुष्टुभ् (श्लोकः)"],["3",24,["कालपाशमहाबन्ध","विमोचनविचक्षणः","त्रिवेणीसङ्गमं धत्ते","केदारं प्रापयेन्मनः"],"अनुष्टुभ् (श्लोकः)"],["3",25,["रूपलावण्यसम्पन्ना","यथा स्त्री पुरुषं विना","महामुद्रामहाबन्धौ","निष्फलौ वेधवर्जितौ"],"अनुष्टुभ् (श्लोकः)"],["3",26,["महाबन्धस्थितो योगी","कृत्वा पूरकमेकधीः","वायूनां गतिमावृत्य","निभृतं कण्ठमुद्रया"],"अनुष्टुभ् (श्लोकः)"],["3",27,["समहस्तयुगो भूमौ","स्फिचौ सनाडयेच्छनैः","पुटद्वयमतिक्रम्य","वायुः स्फुरति मध्यगः"],"अनुष्टुभ् (श्लोकः)"],["3",28,["सोमसूर्याग्निसम्बन्धो","जायते चामृताय वै","मृतावस्था समुत्पन्ना","ततो वायुं विरेचयेत्"],"अनुष्टुभ् (श्लोकः)"],["3",29,["महावेधोऽयमभ्यासान्","महासिद्धिप्रदायकः","वलीपलितवेपघ्नः","सेव्यते साधकोत्तमैः"],"अनुष्टुभ् (श्लोकः)"],["3",30,["एतत्त्रयं महागुह्यं","जरामृत्युविनाशनम्","वह्निवृद्धिकरं चैव ह्य्","अणिमादिगुणप्रदम्"],"अनुष्टुभ् (श्लोकः)"],["3",31,["पुण्यसंभारसन्धाय","पापौघभिदुरं सदा","सम्यक्शिक्षावतामेवं","स्वल्पं प्रथमसाधनम्"],"अनुष्टुभ् (श्लोकः)"],["3",32,["कपालकुहरे जिह्वा","प्रविष्टा विपरीतगा","भ्रुवोरन्तर्गता दृष्टिर्","मुद्रा भवति खेचरी"],"अनुष्टुभ् (श्लोकः)"],["3",33,["छेदनचालनदोहैः","कलां क्रमेणाथ वर्धयेत्तावत्","सा यावद्भ्रूमध्यं स्पृश","ति तदा खेचरीसिद्धिः"],"अनुष्टुभ् (श्लोकः)"],["3",34,["स्नुहीपत्रनिभं शस्त्रं","सुतीक्ष्णं स्निग्धनिर्मलम्","समादाय ततस्तेन","रोममात्रं समुच्छिनेत्"],"अनुष्टुभ् (श्लोकः)"],["3",35,["ततः सैन्धवपथ्याभ्यां","चूर्णिताभ्यां प्रघर्षयेत्","पुनः सप्तदिने प्राप्ते","रोममात्रं समुच्छिनेत्"],"अनुष्टुभ् (श्लोकः)"],["3",36,["एवं क्रमेण षण्मासं","नित्यं युक्तः समाचरेत्","षण्मासाद्रसनामूल","शिराबन्धः प्रणश्यति"],"अनुष्टुभ् (श्लोकः)"],["3",37,["कलां पराङ्मुखीं कृत्वा","त्रिपथे परियोजयेत्","सा भवेत्खेचरी मुद्रा","व्योमचक्रं तदुच्यते"],"अनुष्टुभ् (श्लोकः)"],["3",38,["रसनामूर्ध्वगां कृत्वा","क्षणार्धमपि तिष्ठति","विषैर्विमुच्यते योगी","व्याधिमृत्युजरादिभिः"],"अनुष्टुभ् (श्लोकः)"],["3",39,["न रोगो मरणं तन्द्रा","न निद्रा न क्षुधा तृषा","न च मूर्च्छा भवेत्तस्य","यो मुद्रां वेत्ति खेचरीम्"],"अनुष्टुभ् (श्लोकः)"],["3",40,["पीड्यते न स रोगेण","लिप्यते न च कर्मणा","बाध्यते न स कालेन","यो मुद्रां वेत्ति खेचरीम्"],"अनुष्टुभ् (श्लोकः)"],["3",41,["चित्तं चरति खे यस्माज्","जिह्वा चरति खे गता","तेनैषा खेचरी नाम","मुद्रा सिद्धैर्निरूपिता"],"अनुष्टुभ् (श्लोकः)"],["3",42,["खेचर्या मुद्रितं येन","विवरं लम्बिकोर्ध्वतः","न तस्य क्षरते बिन्दुः","कामिन्याः श्लेषितस्य च"],"अनुष्टुभ् (श्लोकः)"],["3",43,["चलितोऽपि यदा बिन्दुः","सम्प्राप्तो योनिमण्डलम्","व्रजत्यूर्ध्वं हृतः शक्त्या","निबद्धो योनिमुद्रया"],"अनुष्टुभ् (श्लोकः)"],["3",44,["ऊर्ध्वजिह्वः स्थिरो भूत्वा","सोमपानं करोति यः","मासार्धेन न सन्देहो","मृत्युं जयति योगवित्"],"अनुष्टुभ् (श्लोकः)"],["3",45,["नित्यं सोमकलापूर्णं","शरीरं यस्य योगिनः","तक्षकेणापि दष्टस्य","विषं तस्य न सर्पति"],"अनुष्टुभ् (श्लोकः)"],["3",46,[