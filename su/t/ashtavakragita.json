{"id":"ashtavakragita","v":[["1",1,["कथं ज्ञानमवाप्तोऽति","कथं मुक्तिर्भविष्यति","वैराग्यं च कथं प्राप्तम्","एतद्ब्रूहि मम प्रभो"],"अनुष्टुभ् (श्लोकः)"],["1",2,["मुक्तिमिच्छसि चेत्तात","विषयान्विषवत्त्यज","क्षमार्जवदयातोष","सत्यं पीयूषवद्भज"],"अनुष्टुभ् (श्लोकः)"],["1",3,["न पृथ्वी न जलं नाग्निर्","न वायुर्द्यौर्न वा भवान्","एषां साक्षिणमात्मानं","चिद्रूपं विद्धि मुक्तये"],"अनुष्टुभ् (श्लोकः)"],["1",4,["यदि देहं पृथक्कृत्य","चिति विश्राम्य तिष्ठसि","अधुनैव सुखी शान्तो","बन्धमुक्तो भविष्यसि"],"अनुष्टुभ् (श्लोकः)"],["1",5,["न त्वं विप्रादिको वर्णो","नाश्रमी नाक्षगोचरः","असङ्गोऽसि निराकारो","विश्वसाक्षी सुखी भव"],"अनुष्टुभ् (श्लोकः)"],["1",6,["धर्माधर्मौ सुखं दुःखं","मानसानि न ते विभो","न कर्तासि न भोक्तासि","मुक्त एवासि सर्वदा"],"अनुष्टुभ् (श्लोकः)"],["1",7,["एको द्रष्टासि सर्वस्य","मुक्तप्रायोऽसि सर्वदा","अयमेव हि ते बन्धो","द्रष्टारं पश्यसीतरम्"],"अनुष्टुभ् (श्लोकः)"],["1",8,["अहं कर्तेत्यहंमान","महाकृष्णाहिदंशितः","नाहं कर्तेति विश्वासा","मृतं पीत्वा सुखी भव"],"अनुष्टुभ् (श्लोकः)"],["1",9,["एको विशुद्धबोधोऽहम्","इति निश्चयवह्निना","प्रज्वाल्याज्ञानगहनं","वीतसोकः सुखी भव"],"अनुष्टुभ् (श्लोकः)"],["1",10,["यत्र विश्वमिदं भाति","कल्पितं रज्जुसर्पवत्","आनन्दपरमानन्दः","स बोधस्त्वं सुखं चर"],"अनुष्टुभ् (श्लोकः)"],["1",11,["मुक्ताभिमानी मुक्तो हि","बद्धो बद्धाभिमान्यपि","किं वदन्तीह सत्येऽयं","या मतिः सा गतिर्भवेत्"],"अनुष्टुभ् (श्लोकः)"],["1",12,["आत्मा साक्षी विभुः पूर्ण","एको मुक्तश्चिदक्रियः","असङ्गो निस्पृहः शान्तो","भ्रमात्संसारवानिव"],"अनुष्टुभ् (श्लोकः)"],["1",13,["कूटस्थं बोधमद्वैतम्","आत्मानं परिभावय","आभासोऽहं भ्रमं मुक्त्वा","भावं बाह्यमथान्तरं"],"अनुष्टुभ् (श्लोकः)"],["1",14,["देहाभिमानपाशेन","चिरं बद्धोऽसि पुत्रक","बोधोऽहं ज्ञानखड्गेन","तन्निष्कृत्य सुखी भव"],"अनुष्टुभ् (श्लोकः)"],["1",15,["निःसङ्गो निष्क्रियोऽसि त्वं","स्वप्रकाशो निरञ्जनः","अयमेव हि ते बन्धः","समाधिमनुतिष्ठसि"],"अनुष्टुभ् (श्लोकः)"],["1",16,["त्वया व्याप्तमिदं विश्वं","त्वयि प्रोतं यथार्थतः","शुद्द्धबुद्धस्वरूपस्त्वं,","मा गमः क्षुद्रचित्तताम्"],"अनुष्टुभ् (श्लोकः)"],["1",17,["निरपेक्षो निर्विकारो","निर्भरः शीतलाशयः","अगाधबुद्धिरक्षुब्धो","भव चिन्मात्रवासनः"],"अनुष्टुभ् (श्लोकः)"],["1",18,["साकारमनृतं विद्धि","निराकारं तु निश्चलम्","एतत्तत्त्वोपदेशेन","न पुनर्भवसम्भवः"],"अनुष्टुभ् (श्लोकः)"],["1",19,["यथैवादर्शमध्यस्थे","रूपेऽन्तः परितस्तु सः","तथैवास्मिन्शरीरेऽन्तः","परितः परमेश्वरः"],"अनुष्टुभ् (श्लोकः)"],["1",20,["एकं सर्वगतं व्योम","बहिरन्तर्यथा घटे","नित्यं निरन्तरं ब्रह्म","सर्वभूतगणे तथा"],"अनुष्टुभ् (श्लोकः)"],["2",1,["अहो निरञ्जनः शान्तो","बोधोऽहं प्रकृतेः परः","एतावन्तमहं कालं","मोहेनैव विडम्बितः"],"अनुष्टुभ् (श्लोकः)"],["2",2,["यथा प्रकाशयाम्येको","देहमेनं तथा जगत्","अतो मम जगत्सर्वम्","अथवा न च किंचन"],"अनुष्टुभ् (श्लोकः)"],["2",3,["सशरीरमहो विश्वं","परित्यज्य मयाधुना","कुतश्चित्कौशलादेव","परमात्मा विलोक्यते"],"अनुष्टुभ् (श्लोकः)"],["2",4,["यथा न तोयतो भिन्नास्","तरङ्गाः फेनबुद्बुदाः","आत्मनो न तथा भिन्नं","विश्वमात्मविनिर्गतम्"],"अनुष्टुभ् (श्लोकः)"],["2",5,["तन्तुमात्रो भवेदेव","पटो यद्वद्विचारितः","आत्मतन्मत्रमेवेदं","तद्वद्विश्वं विचारितम्"],"अनुष्टुभ् (श्लोकः)"],["2",6,["यथैवेक्षुरसे कॢप्ता","तेन व्याप्तैव शर्करा","तथा विश्वं मयि कॢप्तं","मया व्याप्तं निरन्तरम्"],"अनुष्टुभ् (श्लोकः)"],["2",7,["आत्माज्ञानाज्जगद्भाति","आत्मज्ञानान्न भासते","रज्ज्वज्ञानादहिर्भाति","तज्ज्ञानाद्भासते न हि"],"अनुष्टुभ् (श्लोकः)"],["2",8,["प्रकाशो मे निजं रूपं","नातिरिक्तोऽस्म्यहं ततः","यदा प्रकाशते विश्वं","तदाहम्भास एव हि"],"अनुष्टुभ् (श्लोकः)"],["2",9,["अहो विकल्पितं विश्वम्","अज्ञानान्मयि भासते","रूप्यं शुक्तौ फणी रज्जौ","वारि सूर्यकरे यथा"],"अनुष्टुभ् (श्लोकः)"],["2",10,["मत्तो विनिर्गतं विश्वं","मय्येव लयमेष्यति","मृदि कुम्भो जले वीचिः","कनके कटकं यथा"],"अनुष्टुभ् (श्लोकः)"],["2",11,["अहो अहं नमो मह्यं,","विनाशो यस्य नास्ति मे","ब्रह्मादिस्तम्बपर्यन्तं","जगन्नाशेऽपि तिष्ठतः"],"अनुष्टुभ् (श्लोकः)"],["2",12,["अहो अहं नमो मह्यं","एकोऽहं देहवानपि","क्वचिन्न गन्ता नागन्ता","व्याप्य विश्वमवस्थितः"],"अनुष्टुभ् (श्लोकः)"],["2",13,["अहो अहं नमो मह्यं","दक्षो नास्तीह मत्समः","असंस्पृश्य शरीरेण","येन विश्वं चिरं धृतम्"],"अनुष्टुभ् (श्लोकः)"],["2",14,["अहो अहं नमो मह्यं","यस्य मे नास्ति किंचन","अथवा यस्य मे सर्वं","यद्वाङ्मनसगोचरम्"],"अनुष्टुभ् (श्लोकः)"],["2",15,["ज्ञानं ज्ञेयं तथा ज्ञाता","त्रितयं नास्ति वास्तवम्","अज्ञानाद्भाति यत्रेदं","सोऽहमस्मि निरञ्जनः"],"अनुष्टुभ् (श्लोकः)"],["2",16,["द्वैतमूलमहो दुःखं","नान्यत्तस्यास्ति भेषजम्","दृश्यमेतन्मृषा सर्वं","एकोऽहं चिद्रसोऽमलः"],"अनुष्टुभ् (श्लोकः)"],["2",17,["बोधमात्रोऽहमज्ञानाद्","उपधिः कल्पितो मया","एवं विमृशतो नित्यं","निर्विकल्पे स्थितिर्मम"],"अनुष्टुभ् (श्लोकः)"],["2",18,["न मे बन्धोऽस्ति मोक्षो वा","भ्रान्तिः शान्ता निराश्रया","अहो मयि स्थितं विश्वं","वस्तुतो न मयि स्थितम्"],"अनुष्टुभ् (श्लोकः)"],["2",19,["सशरीरमिदं विश्वं","न किंचिदिति निश्चितम्","शुद्धचिन्मात्र आत्मा च","तत्कस्मिन्कल्पनाधुना"],"अनुष्टुभ् (श्लोकः)"],["2",20,["शरीरं स्वर्गनरकौ","बन्धमोक्षौ भयं तथा","कल्पनामात्रमेवैतत्","किं मे कार्यं चिदात्मनः"],"अनुष्टुभ् (श्लोकः)"],["2",21,["अहो जनसमूहेऽपि","न द्वैतं पश्यतो मम","अरण्यमिव संवृत्तं","क्व रतिं करवाण्यहम्"],"अनुष्टुभ् (श्लोकः)"],["2",22,["नाहम्देहो न मे देहो","जीवो नाहम्, अहं हि चित्","अयमेव हि मे बन्ध","आसीत्या जीविते स्पृहा"],"अनुष्टुभ् (श्लोकः)"],["2",23,["अहो भुवनकल्लोलैर्","विचित्रैर्द्राक्समुत्थितम्","मय्यनन्तमहाम्भोधौ","चित्तवाते समुद्यते"],"अनुष्टुभ् (श्लोकः)"],["2",24,["मय्यनन्तमहाम्भोधौ","चित्तवाते प्रशाम्यति","अभाग्याज्जीववणिजो","जगत्पोतो विनश्वरः"],"अनुष्टुभ् (श्लोकः)"],["2",25,["मय्यनन्तमहाम्भोधव्","आश्चर्यं जीववीचयः","उद्यन्ति घ्नन्ति खेलन्ति","प्रविशन्ति स्वभावतः"],"अनुष्टुभ् (श्लोकः)"],["3",1,["अविनाशिनमात्मानम्","एकं विज्ञाय तत्त्वतः","तवात्मज्ञस्य धीरस्य","कथमर्थार्जने रतिः"],"अनुष्टुभ् (श्लोकः)"],["3",2,["आत्माज्ञानादहो प्रीतिर्","विषयभ्रमगोचरे","शुक्तेरज्ञानतो लोभो","यथा रजतविभ्रमे"],"अनुष्टुभ् (श्लोकः)"],["3",3,["विश्वं स्फुरति यत्रेदं","तरङ्गा इव सागरे","सोऽहमस्मीति विज्ञाय,","किं दीन इव धावसि"],"अनुष्टुभ् (श्लोकः)"],["3",4,["श्रुत्वापि शुद्धचैतन्यम्","आत्मानमतिसुन्दरम्","उपस्थेत्यन्तसंसक्तो","मालिन्यमधिगच्छति"],"अनुष्टुभ् (श्लोकः)"],["3",5,["सर्वभूतेषु चात्मानं","सर्वभूतानि चात्मनि","मुनेर्जानत आश्चर्यं","ममत्वमनुवर्तते"],"अनुष्टुभ् (श्लोकः)"],["3",6,["आस्थितः परमाद्वैतं","मोक्षार्थेऽपि व्यवस्थितः","आश्चर्यं कामवशगो","विकलः केलिशिक्षया"],"अनुष्टुभ् (श्लोकः)"],["3",7,["उद्भूतं ज्ञानदुर्मित्रम्","अवधार्यातिदुर्बलः","आश्चर्यं काममाकाङ्क्षेत्","कालमन्तमनुश्रितः"],"अनुष्टुभ् (श्लोकः)"],["3",8,["इहामुत्र विरक्तस्य","नित्यानित्यविवेकिनः","आश्चर्यं मोक्षकामस्य","मोक्षादेव विभीषिका"],"अनुष्टुभ् (श्लोकः)"],["3",9,["धीरस्तु भोज्यमानोऽपि","पीड्यमानोऽपि सर्वदा","आत्मानं केवलं पश्यन्","न तुष्यति न कुप्यति"],"अनुष्टुभ् (श्लोकः)"],["3",10,["चेष्टमानं शरीरं स्वं","पश्यत्यन्यशरीरवत्","संस्तवे चापि निन्दायां","कथं क्षुभ्येत्महाशयः"],"अनुष्टुभ् (श्लोकः)"],["3",11,["मायामात्रमिदं विश्वं","पश्यन्विगतकौतुकः","अपि सन्निहिते मृत्यौ","कथं त्रस्यति धीरधीः"],"अनुष्टुभ् (श्लोकः)"],["3",12,["निःस्पृहं मानसं यस्य","नैराश्येऽपि महात्मनः","तस्यात्मज्ञानतृप्तस्य","तुलना केन जायते"],"अनुष्टुभ् (श्लोकः)"],["3",13,["स्वभावादेव जानानो","दृश्यमेतन्न किंचन","इदं ग्राह्यमिदं त्याज्यं","स किं पश्यति धीरधीः"],"अनुष्टुभ् (श्लोकः)"],["3",14,["अन्तस्त्यक्तकषायस्य","निर्द्वन्द्वस्य निराशिषः","यदृच्छयागतो भोगो","न दुःखाय न तुष्टये"],"अनुष्टुभ् (श्लोकः)"],["4",1,["हन्तात्मज्ञस्य धीरस्य","खेलतो भोगलीलया","न हि संसारवाहीकैर्","मूडैः सह समानता"],"अनुष्टुभ् (श्लोकः)"],["4",2,["यत्पदं प्रेप्सवो दीनाः","शक्राद्याः सर्वदेवताः","अहो तत्र स्थितो योगी","न हर्षमुपगच्छति"],"अनुष्टुभ् (श्लोकः)"],["4",3,["तज्ज्ञस्य पुण्यपापाभ्यां","स्पर्शो ह्यन्तर्न जायते","न ह्याकाशस्य धूमेन","दृश्यमानापि सङ्गति"],"अनुष्टुभ् (श्लोकः)"],["4",4,["आत्मैवेदं जगत्सर्वं","ज्ञातं येन महात्मना","यदृच्छया वर्त्तमानं","तं निषेद्धुं क्षमेत कः"],"अनुष्टुभ् (श्लोकः)"],["4",5,["आब्रह्मस्तम्बपर्यन्ते","भूतग्रामे चतुर्विधे","विज्ञस्यैव हि सामर्थ्यम्","इच्छानिच्छाविवर्जने"],"अनुष्टुभ् (श्लोकः)"],["4",6,["आत्मानमद्वयं कश्चिज्","जानाति जगदीश्वरं","यद्वेत्ति तत्स कुरुते","न भयं तस्य कुत्रचित्"],"अनुष्टुभ् (श्लोकः)"],["5",1,["न ते सङ्गोऽस्ति केनापि","किं शुद्धस्त्यक्तुमिच्छसि","सङ्घातविलयं कुर्वन्न्","एवमेव लयं व्रज"],"अनुष्टुभ् (श्लोकः)"],["5",2,["उदेति भवतो विश्वं","वारिधेरिव बुद्बुदः","इति ज्ञत्वैकमात्मानम्","एवमेव लयं व्रज"],"अनुष्टुभ् (श्लोकः)"],["5",3,["प्रत्यक्षमप्यवस्तुत्वाद्","विश्वं नास्त्यमले त्वयि","रज्जुसर्प इव व्यक्तम्","एवमेव लयं व्रज"],"अनुष्टुभ् (श्लोकः)"],["5",4,["समदुःखसुखः पूर्ण","आशानैराश्ययोः समः","समजीवितमृत्युः सन्न्","एवमेव लयं व्रज"],"अनुष्टुभ् (श्लोकः)"],["6",1,["आकाशवदनन्तोऽहं","घटवत्प्रकृतं जगत्","इति ज्ञानं तथैतस्य","न त्यागो न ग्रहो लयः"],"अनुष्टुभ् (श्लोकः)"],["6",2,["महोदधिरिवाहं स","प्रपञ्चो वीचिसंनिभः","इति ज्ञानं तथैतस्य","न त्यागो न ग्रहो लयः"],"अनुष्टुभ् (श्लोकः)"],["6",3,["अहं स शुक्तिसङ्काशो","रूप्यवद्विश्वकल्पना","इति ज्ञानं तथैतस्य","न त्यागो न ग्रहो लयः"],"अनुष्टुभ् (श्लोकः)"],["6",4,["अहं वा सर्वभूतेषु","सर्वभूतान्यथो मयि","इति ज्ञानं तथैतस्य","न त्यागो न ग्रहो लयः"],"अनुष्टुभ् (श्लोकः)"],["7",1,["मय्यनन्तमहाम्भोधौ","विश्वपोत इतस्ततः","भ्रमति स्वान्तवातेन","न ममास्त्यसहिष्णुता"],"अनुष्टुभ् (श्लोकः)"],["7",2,["मय्यनन्तमहाम्भोधौ","जगद्वीचिः स्वभावतः","उदेतु वस्तमायातु","न मे वृद्धिर्न च क्षतिः"],"अनुष्टुभ् (श्लोकः)"],["7",3,["मय्यनन्तमहाम्भोधौ","विश्वं नाम विकल्पना","अतिशान्तो निराकार","एतदेवाहमास्थितः"],"अनुष्टुभ् (श्लोकः)"],["7",4,["नात्मा भावेषु नो भावस्","तत्रानन्ते निरन्जने","इत्यसक्तोऽस्पृहः शान्त","एतदेवाहमास्तितः"],"अनुष्टुभ् (श्लोकः)"],["7",5,["अहो चिन्मात्रमेवाहम्","इन्द्रजालोपमं जगत्","अतो मम कथं कुत्र","हेयोपादेयकल्पना"],"अनुष्टुभ् (श्लोकः)"],["8",1,["तदा बन्धो यदा चित्तं","किंचिद्वाञ्छति षोचति","किंचिन्मुञ्चति गृह्णाति","किंचिद्धृष्यति कुप्यति"],"अनुष्टुभ् (श्लोकः)"],["8",2,["तदा मुक्तिर्यदा चित्तं","न वाञ्छति न शोचति","न मुञ्चति न गृह्णाति","न हृष्यति न कुप्यति"],"अनुष्टुभ् (श्लोकः)"],["8",3,["तदा बन्धो यदा चित्तं","सक्तं कास्वपि दृष्टिषु","तदा मोक्षो यदा चित्तम्","असक्तं सर्वदृष्टिषु"],"अनुष्टुभ् (श्लोकः)"],["8",4,["यदा नाहं तदा मोक्षो","यदाहं बन्धनं तदा","मत्वेति हेलया किंचित्","मा गृहाण विमुञ्च मा"],"अनुष्टुभ् (श्लोकः)"],["9",1,["कृताकृते च द्वन्द्वानि","कदा शान्तानि कस्य वा","एवं ज्ञात्वेह निर्वेदाद्","भव त्यागपरोऽव्रती"],"अनुष्टुभ् (श्लोकः)"],["9",2,["कस्यापि तात धन्यस्य","लोकचेष्टावलोकना