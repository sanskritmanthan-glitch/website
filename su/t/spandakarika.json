{"id":"spandakarika","v":[["1",1,["यस्योन्मेषनिमेषाभ्यां","जगतः प्रलयोदयौ","तं शक्तिचक्रविभव","प्रभवं शङ्करं स्तुमः"],"अनुष्टुभ् (श्लोकः)"],["1",2,["यत्र स्थितमिदं सर्वं","कार्यं यस्माच्च निर्गतं","तस्यानावृतरूपत्वान्","न निरोधोऽस्ति कुत्रचित्"],"अनुष्टुभ् (श्लोकः)"],["1",3,["जाग्रदादि विभेदेऽपि","तदभिन्ने प्रसर्पति","निवर्तते निजान्नैव","स्वभावादुपलब्धृतः"],"अनुष्टुभ् (श्लोकः)"],["1",4,["अहं सुखी च दुःखी च","रक्तश्च इत्यदिसम्विदः","सुखाद्यवस्थानुस्यूते","वर्तन्तेऽन्यत्र ताः स्फुटम्"],"अनुष्टुभ् (श्लोकः)"],["1",5,["न दुःखं न सुखं यत्र","न ग्राह्यम्ग्राहकं न च","न चास्ति मूढभावोऽपि","तदस्ति परमार्थतः"],"अनुष्टुभ् (श्लोकः)"],["1",6,["यतः करणवर्गोऽयं","विमूढोऽमूढवत्स्वयम्","सहान्तरेण चक्रेण","प्रवृत्तिस्थितिसंहृतिः"],"अनुष्टुभ् (श्लोकः)"],["1",7,["लभते तत्प्रयत्नेन","परीक्ष्यं तत्त्वमादरात्","यतः स्वतन्त्रता तस्य","सर्वत्रेयमकृत्रिमा"],"अनुष्टुभ् (श्लोकः)"],["1",8,["न हीच्छानोदनस्यायम्","प्रेरकत्वेन वर्तते","अपि त्वात्मबलस्पर्शात्","पुरुषस्तत्समो भवेत्"],"अनुष्टुभ् (श्लोकः)"],["1",9,["निजाशुद्ध्यासमर्थस्य","कर्तव्येष्वभिलाषिणः","यदा क्षोभः प्रलीयेत","तदा स्यात्परमम्पदम्"],"अनुष्टुभ् (श्लोकः)"],["1",10,["तदास्याकृत्रिमो धर्मो","ज्ञत्वकर्तृत्वलक्षणह्","यतस्तदेप्सितं सर्वं","जानाति च करोति च"],"अनुष्टुभ् (श्लोकः)"],["1",11,["तमधिष्ठातृभावेन","स्वभावमवलोकयन्","स्मयमान इवास्ते यस्","तस्येयं कुसृतिः कुतः"],"अनुष्टुभ् (श्लोकः)"],["1",12,["नाभावो भाव्यतामेति","न च तत्रास्त्यमूढता","यतोऽभियोगसंस्पर्शात्","तदासिदिति निश्चयह्"],"अनुष्टुभ् (श्लोकः)"],["1",13,["अतस्तत्कृत्रिमं ज्ञेयं","सौषुप्तपदवत्सदा","न त्वेवं स्मर्यमाणत्वं","तत्तत्त्वम्प्रतिपद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",14,["अवस्थायुगलं चात्र","कार्यकर्तृत्वशब्दितम्","कार्यता क्षयिणी तत्र","कर्तृत्वम्पुनरक्षयम्"],"अनुष्टुभ् (श्लोकः)"],["1",15,["कार्योन्मुखः प्रयत्नो यः","केवलं सोऽत्र लुप्यते","तस्मिन्लुप्ते विलुप्तोऽस्मीत्य्","अबुधः प्रतिपद्यते"],"अनुष्टुभ् (श्लोकः)"],["1",16,["न तु योऽन्तर्मुखो भावह्","सर्वज्ञात्वगुणास्पदम्","तस्य लोपः कदाचित्स्याद्","अन्यस्यानुपलम्भनात्"],"अनुष्टुभ् (श्लोकः)"],["1",17,["तस्योपलब्धिः सततं","त्रिपदाव्यभिचारिणी","नित्यं स्यात्सुप्रबुद्धस्य","तदाद्यन्ते परस्य तु"],"अनुष्टुभ् (श्लोकः)"],["1",18,["ज्ञानज्ञेयस्वरूपिण्या","शक्त्या परमया युतः","पदद्वये विभुर्भाति","तदन्यत्र तु चिन्मयः"],"अनुष्टुभ् (श्लोकः)"],["1",19,["गुणादिस्पन्दनिःष्यन्दाः","सामान्यस्पन्दसंश्रयात्","लब्धात्मलाभः सततं","स्युर्ज्ञस्यापरिपन्थिनः"],"अनुष्टुभ् (श्लोकः)"],["1",20,["अप्रबुधधियस्त्वेते","स्वस्थितिस्थगनोद्यताः","पातयन्ति दुरुत्तारे","घोरे संसारवर्त्मनि"],"अनुष्टुभ् (श्लोकः)"],["1",21,["अतः सततमुद्युक्तः","स्पन्दतत्त्वविविक्तये","जाग्रदेव निजम्भावम्","अचिरेणाधिगच्छति"],"अनुष्टुभ् (श्लोकः)"],["1",22,["अतिक्रुद्धः प्रहृष्टो वा","किं करोमीति वा मृशन्","धावन्व यत्पदं गच्छेत्","तत्र स्पन्दः प्रतिष्ठितः"],"अनुष्टुभ् (श्लोकः)"],["1",23,["यामवस्थां समालम्ब्य","यदयम्मम वक्ष्यति","तदवश्यं करिष्येऽहम्","इति संकल्प्य तिष्ठति"],"अनुष्टुभ् (श्लोकः)"],["1",24,["तामश्रित्योर्ध्वमार्गेण","चन्द्रसूर्यावुभावपि","सौषुम्नेऽध्वन्यस्तमितो","हित्वा ब्रह्मा।ङ्दगोचरम्"],"अनुष्टुभ् (श्लोकः)"],["1",25,["तदा तस्मिन्महाव्योम्नि","प्रलीनशशिभास्करे","सौषुप्तपदवन्मूढः","प्रबुद्धः स्यादनावृतः"],"अनुष्टुभ् (श्लोकः)"],["2",1,["तदाक्रम्य बलम्मन्त्राः","सर्वज्ञाबलशालिनः","प्रवर्तन्तेऽधिकाराय","करणानीव देहिनाम्"],"अनुष्टुभ् (श्लोकः)"],["2",2,["तत्रैव सम्प्रलीयन्ते","शान्तरूपा निरञ्जनाः","सहाराधकचित्तेन","तेनैते शिवधर्मिणः"],"अनुष्टुभ् (श्लोकः)"],["2",3,["यस्मात्सर्वमयो जीवः","सर्वभावसमुद्भवात्","तत्संवेदनरूपेण","तादात्म्यप्रतिपत्तितः"],"अनुष्टुभ् (श्लोकः)"],["2",4,["तस्माच्छब्दार्थचिन्तासु","न सावस्था न या शिवः","भोक्तैव भोग्यभावेन","सदा सर्वत्र संस्थितः"],"अनुष्टुभ् (श्लोकः)"],["2",5,["इति वा यस्य संवित्तिः","क्रीडात्वेनाखिलं जगत्","स पश्यन्सततं युक्तो","जीवन्मुक्तो न संशयः"],"अनुष्टुभ् (श्लोकः)"],["2",6,["अयमेवोदयस्तस्य","ध्येयस्य ध्यायिचेतसि","तदात्मतासमापत्तिर्","इच्छतः साधकस्य या"],"अनुष्टुभ् (श्लोकः)"],["2",7,["इयमेवामृतप्राप्तिर्","अयमेवात्मनो ग्रहः","इयं निर्वाणदीक्षा च","शिवसद्भावदायिनि"],"अनुष्टुभ् (श्लोकः)"],["3",1,["यथेच्छाभ्यर्थितो धाता","जाग्रतोऽर्थान्हृदि स्थितान्","सोमसूर्योदयं कृत्वा","सम्पादयति देहिनः"],"अनुष्टुभ् (श्लोकः)"],["3",2,["तथा स्वप्नेऽप्यभीष्टार्थान्","प्रणयस्यानतिक्रमात्","नित्यं स्फुटतरं मध्ये","स्थितोऽवश्यं प्रकाशयेत्"],"अनुष्टुभ् (श्लोकः)"],["3",3,["अन्यथा तु स्वतन्त्रा स्यात्","सृष्टिस्तद्धर्मकत्वतः","सततं लौकिकस्येव","जाग्रत्स्वप्नपदद्वये"],"अनुष्टुभ् (श्लोकः)"],["3",4,["यथा हि अर्थोऽस्फुटो दृष्टः","सावधानेऽपि चेतसि","भूयः स्फुटतरो भाति","स्वबलोद्योगभावितः"],"अनुष्टुभ् (श्लोकः)"],["3",5,["तथा यत्परमार्थेन","येन यत्र यथा स्थितम्","तत्तथा बलमाक्रम्य","न चिरात्सम्प्रवर्तते"],"अनुष्टुभ् (श्लोकः)"],["3",6,["दुर्बलोऽपि तदाक्रम्य","यतः कार्ये प्रवर्तते","आच्छादयेद्बुभुक्षां च","तथा योऽति बुभुक्षितः"],"अनुष्टुभ् (श्लोकः)"],["3",7,["अनेनाधिष्ठिते देहे","यथा सर्वज्ञतादयः","तथा स्वात्मन्यधिष्ठानात्","सर्वत्रैवम्भविष्यति"],"अनुष्टुभ् (श्लोकः)"],["3",8,["ग्लानिर्विलु।ङ्थिका देहे","तस्याश्चाज्ञानतः सृतिः","तदुन्मेषविलुप्तं चेत्","कुतः सा स्यादहेतुका"],"अनुष्टुभ् (श्लोकः)"],["3",9,["एकचिन्ताप्रसक्तस्य","यतः स्यादपरोदयः","उन्मेषः स तु विज्ञेयः","स्वयं तमुपलक्षयेत्"],"अनुष्टुभ् (श्लोकः)"],["3",10,["अतो बिन्दुरतो नादो","रूपमस्मादतो रसः","प्रवर्तन्तेऽचिरेणैव","क्षोभकत्वेन देहिनः"],"अनुष्टुभ् (श्लोकः)"],["3",11,["दिदृक्षयेव सर्वार्थान्","यदा व्याप्यावतिष्ठते","तदा किं बहुनोक्तेन स्व","यमेव अवभोत्स्यते"],"अनुष्टुभ् (श्लोकः)"],["3",12,["प्रबुद्धः सर्वदा तिष्ठेज्","ज्ञानेनालोक्य गोचरम्","एकत्रारोपयेत्सर्वं","ततोऽन्येन न पीड्यते"],"अनुष्टुभ् (श्लोकः)"],["3",13,["शब्दराशिसमुत्थस्य","शक्तिवर्गस्य भोग्यताम्","कलाविलुप्तविभवो","गतः सन्स पशुः स्मृतः"],"अनुष्टुभ् (श्लोकः)"],["3",14,["परामृतरसापायस्","तस्य यः प्रत्ययोद्भवः","तेनास्वतन्त्रतामेति","स च तन्मात्रगोचरः"],"अनुष्टुभ् (श्लोकः)"],["3",15,["स्वरूपावरणे चास्य","शक्तयः सततोत्थिताः","यतः शब्दानुवेधेन","न विना प्रत्ययोद्भवः"],"अनुष्टुभ् (श्लोकः)"],["3",16,["सेयं क्रियात्मिका शक्तिः","शिवस्य पशुवर्तिनी","बन्धयित्री स्वमार्गस्था","ज्ञात सिद्ध्युपपादिका"],"अनुष्टुभ् (श्लोकः)"],["3",17,["तन्मात्रोदयरूपेन","मनोऽहंबुद्धिवर्तिना","पुर्यष्टकेन संरुद्धस्","तदुत्थम्प्रत्ययोद्भवम्"],"अनुष्टुभ् (श्लोकः)"],["3",18,["भुङ्क्ते परवशो भोगं","तद्भावात्संसरेदतः","संसृतिप्रलयस्यास्य","कारणं सम्प्रचक्ष्महे"],"अनुष्टुभ् (श्लोकः)"],["3",19,["यदा त्वेकत्र संरूढस्","तदा तस्य लयोदयौ","नियच्छन्भोक्तृतामेति","ततश्चक्रेश्वरो भवेत्"],"अनुष्टुभ् (श्लोकः)"],["4",1,["अगाधसंशयाम्भोधि","समुत्तरणतारिनीम्","वन्दे विचित्रार्थपदां","चित्रां तां गुरुभारतीम्"],"अनुष्टुभ् (श्लोकः)"],["4",2,["लब्ध्वाप्यलभ्यमेतज्","ज्ञानधनं हृद्गुहान्तकृतनिहितेः","वसुगुप्तवच्छिवाय हि","भवति सदा सर्वलोकस्य"],"आर्या"]]}